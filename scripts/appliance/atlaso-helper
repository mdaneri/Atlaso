    return _wan_feature_settings(parsed)["routing_enabled"]


def _apply_wan_forwarding(parsed: dict[str, list[dict[str, str]]]) -> int:
    """Perform apply WAN forwarding.

    Args:
        parsed: Parsed consumed by apply WAN forwarding.
    """
    value = "1" if _wan_forwarding_required(parsed) else "0"
    WAN_SYSCTL_PATH.write_text(
        "\n".join(
            [
                f"net.ipv4.ip_forward = {value}",
                f"net.ipv6.conf.all.forwarding = {value}",
                "",
            ]
        ),
        encoding="utf-8",
    )
    os.chmod(WAN_SYSCTL_PATH, 0o644)
    for key in ("net.ipv4.ip_forward", "net.ipv6.conf.all.forwarding"):
        sysctl = _run(["sysctl", "-w", f"{key}={value}"])
        print(sysctl.stdout, end="")
        print(sysctl.stderr, end="", file=sys.stderr)
        if sysctl.returncode != 0:
            return sysctl.returncode
    return 0


def _handle_wan(action: str, args: list[str]) -> int:
    """Handle WAN.

    Args:
        action: Action consumed by handle WAN.
        args: Parsed command-line options consumed by the operation.
    """
    if len(args) != 1:
        print(f"wan {action} requires exactly one staged config path", file=sys.stderr)
        return 2
    try:
        config_path = _validate_wan_config_path(args[0])
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    errors = _wan_config_errors(config_path)
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 2
    parsed = _parse_wan_config(config_path)
    feature_settings = _wan_feature_settings(parsed)
    effective_nat_rules = (
        parsed["nat_rules"]
        if feature_settings["effective_nat_enabled"]
        else []
    )
    nat_validation = _validate_wan_nat_config(
        _render_wan_nat_config(effective_nat_rules)
    )
    if action == "validate":
        print(nat_validation.stdout, end="")
        print(nat_validation.stderr, end="", file=sys.stderr)
        if nat_validation.returncode != 0:
            return nat_validation.returncode
        print(
            json.dumps(
                {
                    "wan": "validation ok",
                    "routes": len(parsed["routes"]),
                    "nat_rules": len(parsed["nat_rules"]),
                    "wan_policies": len(parsed["wan_policies"]),
                    "routing_rules": len(parsed["routing_rules"]),
                    **feature_settings,
                    "scope": "ip-rule ip-route nftables tc-netem",
                },
                sort_keys=True,
            )
        )
        return 0
    previous_parsed = (
        _parse_wan_config(WAN_RUNTIME_CONFIG_PATH)
        if WAN_RUNTIME_CONFIG_PATH.is_file()
        else None
    )
    nat_result = _apply_wan_nat(parsed)
    if nat_result != 0:
        return nat_result
    forwarding_result = _apply_wan_forwarding(parsed)
    if forwarding_result != 0:
        return forwarding_result
    target_route_result = _apply_wan_target_routes(parsed)
    if target_route_result != 0:
        return target_route_result
    rule_result = _apply_wan_policy_rules(parsed)
    if rule_result != 0:
        return rule_result
    route_result = _apply_wan_routes_and_qdiscs(parsed, previous_parsed)
    if route_result != 0:
        return route_result
    if action == "apply":
        try:
            _install_wan_runtime(config_path)
        except (OSError, ValueError) as exc:
            print(str(exc), file=sys.stderr)
            return 1
    print(
        json.dumps(
            {
                "wan": "apply complete",
                "routes": len(parsed["routes"]),
                "removed_routes": len(parsed["removed_routes"]),
                "routing_rules": len(parsed["routing_rules"]),
                "nat_rules": len(parsed["nat_rules"]),
                "wan_policies": len(parsed["wan_policies"]),
                **feature_settings,
            },
            sort_keys=True,
        )
    )
    return 0


