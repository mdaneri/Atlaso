def _quiesce_management_handoff_apply() -> dict[str, object]:
    """Stop and verify any surviving transient apply helper before rollback."""
    return _quiesce_management_handoff_unit(MANAGEMENT_HANDOFF_APPLY_UNIT, "apply")


def _recover_management_handoff() -> int:
    """Roll back an interrupted management handoff before Atlaso task recovery."""
    try:
        helper_state = _quiesce_management_handoff_apply()
    except ValueError as exc:
        print(
            json.dumps(
                {
                    "management_handoff": "rollback incomplete",
                    "failing_layer": "interruption serialization",
                    "error": str(exc),
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    if not MANAGEMENT_HANDOFF_STATE_PATH.is_file():
        print(
            json.dumps(
                {
                    "management_handoff": "no interrupted transaction",
                    "rolled_back": False,
                    "helper_state": helper_state,
                },
                sort_keys=True,
            )
        )
        return 0
    try:
        state = json.loads(MANAGEMENT_HANDOFF_STATE_PATH.read_text(encoding="utf-8"))
        evidence = _restore_management_handoff(state)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(
            json.dumps(
                {
                    "management_handoff": "rollback incomplete",
                    "failing_layer": "interruption recovery",
                    "error": str(exc),
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    try:
        _clear_management_handoff_state()
    except OSError as exc:
        print(
            json.dumps(
                {
                    "management_handoff": "rollback incomplete",
                    "failing_layer": "interruption recovery",
                    "error": f"rollback state cleanup failed: {exc}",
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    print(
        json.dumps(
            {
                "management_handoff": "rolled back after interruption",
                "rolled_back": True,
                "helper_state": helper_state,
                **evidence,
            },
            sort_keys=True,
        )
    )
    return 0


def _handle_factory_reset(action: str, args: list[str]) -> int:
    """Handle dedicated complete factory-reset lifecycle operations.

    Args:
        action: Requested factory-reset lifecycle action.
        args: Additional parsed command-line arguments.
    """
    if action == "schedule":
        if len(args) != 1:
            print(
                "factory-reset schedule requires one request-bound credential staging path",
                file=sys.stderr,
            )
            return 2
        if _recover_management_front_door(quiet=True) != 0:
            print(
                "factory-reset admission blocked by incomplete management front-door recovery",
                file=sys.stderr,
            )
            return 1
        return _schedule_factory_reset(args[0])
    if args:
        print(f"factory-reset {action} does not accept a path", file=sys.stderr)
        return 2
    if action == "status":
        print(json.dumps(_factory_reset_state_payload(), sort_keys=True))
        return 0
    if action == "terminate-login-sessions":
        return _terminate_factory_reset_login_sessions()
    if action == "reset-network-runtime":
        return _reset_factory_network_runtime()
    if action == "reset-retained-runtime":
        return _reset_factory_retained_runtime()
    if action == "apply-root-password":
        return _apply_factory_reset_root_password()
    if action == "resume":
        if _recover_management_front_door(quiet=True) != 0:
            print(
                "factory-reset resume blocked by incomplete management front-door recovery",
                file=sys.stderr,
            )
            return 1
        if not ATLASO_FACTORY_RESET_REQUEST_PATH.is_file():
            print(json.dumps(_factory_reset_state_payload(), sort_keys=True))
            return 0
        if _factory_reset_activation_pending():
            result = _schedule_factory_reset_finalizer()
            print(result.stdout, end="")
            print(result.stderr, end="", file=sys.stderr)
            return result.returncode
        result = _factory_reset_runner(boot_resume=True)
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        return result.returncode
    print(f"unsupported factory-reset action: {action}", file=sys.stderr)
    return 2
def _apply_management_handoff(payload: dict) -> int:
    """Apply one reachability-safe, rollback-capable management transition.

    Args:
        payload: Validated handoff payload.
    """
    if _recover_management_front_door(quiet=True) != 0:
        print(
            json.dumps(
                {
                    "management_handoff": "failed before mutation",
                    "failing_layer": "ordinary front-door recovery",
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    try:
        state = _snapshot_management_handoff(payload)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        marker_exists = MANAGEMENT_HANDOFF_STATE_PATH.is_file()
        cleanup_error = ""
        if not marker_exists:
            try:
                _clear_management_handoff_state()
            except OSError as cleanup_exc:
                cleanup_error = f"; snapshot cleanup failed: {cleanup_exc}"
        print(
            json.dumps(
                {
                    "management_handoff": "recovery required" if marker_exists else "failed before mutation",
                    "failing_layer": "snapshot",
                    "error": f"{exc}{cleanup_error}",
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    failing_layer = "snapshot"
    try:
        failing_layer = "previous-path preflight"
        previous_preflight = _management_handoff_readiness(
            list(state["previous_management_addresses"]),
            bool(state["previous_https_enabled"]),
            int(state["previous_management_public_port"]),
        )
        holdovers = _install_management_holdovers(state, payload)
        _write_management_handoff_state(state, "old-path-retained")
        failing_layer = "certificate"
        ca_path = str(payload.get("ca_config_path") or "")
        if ca_path and _handle_ca("apply", [ca_path]) != 0:
            raise ValueError("candidate management certificate apply failed")
        settings_payload = _load_appliance_settings_config(
            Path(str(payload["appliance_settings_config_path"]))
        )
        candidate_https = bool(settings_payload.get("management_https_enabled"))
        candidate_public_port = int(
            settings_payload.get(
                "management_public_https_port" if candidate_https else "management_public_http_port"
            )
            or (443 if candidate_https else 80)
        )
        failing_layer = "network"
        _apply_management_candidate_network(Path(str(payload["network_config_path"])), state)
        previous_firewall = FIREWALL_CONFIG_PATH.read_text(encoding="utf-8") if FIREWALL_CONFIG_PATH.is_file() else ""
        candidate_firewall_path = Path(str(payload["firewall_config_path"]))
        candidate_firewall = candidate_firewall_path.read_text(encoding="utf-8")
        candidate_management_rules = _management_handoff_candidate_firewall_rules(
            Path(str(payload["network_config_path"])),
            candidate_public_port,
            candidate_firewall,
        )
        final_firewall = _management_handoff_firewall_text(
            candidate_firewall,
            candidate_firewall,
            candidate_management_rules=candidate_management_rules,
        )
        transition_path = FIREWALL_APPLY_DIR / "atlaso-management-handoff.nft"
        transition_path.write_text(
            _management_handoff_firewall_text(
                final_firewall,
                previous_firewall,
                candidate_management_rules=candidate_management_rules,
            ),
            encoding="utf-8",
        )
        os.chmod(transition_path, 0o600)
        failing_layer = "firewall"
        if _handle_firewall("apply", [str(transition_path)]) != 0:
            raise ValueError("transitional nftables apply failed")
        failing_layer = "Atlaso upstream"
        upstream_readiness = _management_handoff_upstream_readiness()
        resolver_interface = str(settings_payload.get("management_interface") or "")
        if resolver_interface != str(state.get("candidate_management_interface") or ""):
            raise ValueError("candidate management resolver interface changed after snapshot")
        state["resolver_apply_started"] = True
        _write_management_handoff_state(state, "resolver-applying")
        failing_layer = "resolver"
        resolver = _configure_management_handoff_resolver(settings_payload)
        if resolver.returncode != 0:
            raise ValueError("candidate management resolver apply failed")
        protocol_holdover = _management_handoff_protocol_holdover(state, settings_payload)
        failing_layer = "nginx management front door"
        management_https_result, _restart_delay_seconds = _configure_atlaso_management_https(
            settings_payload,
            site_suffix=protocol_holdover,
            verify_front_door=False,
        )
        if management_https_result != 0:
            raise ValueError("candidate management nginx apply failed")
        if _handle_public_services("apply", [str(payload["public_services_config_path"])]) != 0:
            raise ValueError("candidate public-services nginx apply failed")
        if _nginx_test_command().returncode != 0:
            raise ValueError("candidate nginx validation failed")
        candidate_addresses = _management_handoff_addresses(
            Path(str(payload["network_config_path"])),
            previous_addresses=set(state["previous_management_addresses"]),
            previous_dynamic_families={
                (str(path.get("name") or ""), family)
                for path in state.get("previous_management_paths", [])
                for family in (
                    (["inet"] if path.get("ipv4_method") == "dhcp" else [])
                    + (
                        ["inet6"]
                        if str(path.get("ipv6_enabled") or "").lower() == "true"
                        and not str(path.get("ipv6_cidr") or "")
                        else []
                    )
                )
            },
        )
        failing_layer = "old-path preservation"
        old_readiness = _management_handoff_readiness(
            list(state["previous_management_addresses"]),
            bool(state["previous_https_enabled"]),
            int(state["previous_management_public_port"]),
        )
        failing_layer = "candidate readiness"
        candidate_readiness = _management_handoff_readiness(
            candidate_addresses,
            candidate_https,
            candidate_public_port,
        )
        _write_management_handoff_state(state, "candidate-ready")
        failing_layer = "previous-path retirement"
        for path in holdovers:
            path.unlink(missing_ok=True)
        if _handle_network("apply", [str(payload["network_config_path"])]) != 0:
            raise ValueError("final network apply failed while retiring the previous path")
        failing_layer = "resolver persistence"
        resolver = _configure_management_handoff_resolver(settings_payload)
        if resolver.returncode != 0:
            raise ValueError("candidate management resolver persistence failed after final network apply")
        candidate_physical, _candidate_vlans, _removed = _parse_network_config(
            Path(str(payload["network_config_path"]))
        )
        reconfigure_interfaces = _management_handoff_previous_link_interfaces(state)
        reconfigure_interfaces.update(str(row.get("name") or "") for row in candidate_physical)
        for interface in sorted(reconfigure_interfaces):
            if not interface or not _link_exists(interface):
                continue
            reconfigure = _run(["networkctl", "reconfigure", str(interface)])
            if reconfigure.returncode != 0:
                raise ValueError(f"networkd could not retire the previous path on {interface}")
        if payload.get("wan_config_path"):
            # The final Network regeneration intentionally replaces networkd
            # runtime. Reapply the coupled route intent afterwards so policy
            # rules and default routes survive retirement and reboot.
            failing_layer = "Routes & WAN persistence"
            _apply_management_handoff_wan(payload)
        transition_path.write_text(final_firewall, encoding="utf-8")
        os.chmod(transition_path, 0o600)
        if _handle_firewall("apply", [str(transition_path)]) != 0:
            raise ValueError("final nftables apply failed while retiring the previous path")
        if protocol_holdover:
            failing_layer = "previous-protocol retirement"
            management_https_result, _restart_delay_seconds = _configure_atlaso_management_https(
                settings_payload,
                verify_front_door=False,
            )
            if management_https_result != 0:
                raise ValueError("candidate nginx could not retire the previous protocol listener")
        failing_layer = "post-retirement readiness"
        final_readiness = _management_handoff_readiness(
            candidate_addresses,
            candidate_https,
            candidate_public_port,
        )
        failing_layer = "candidate durability"
        _sync_management_handoff_candidate(state, payload)
        state["candidate_addresses"] = candidate_addresses
        _write_management_handoff_state(state, "awaiting-application-commit")
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        rollback_error = ""
        try:
            rollback = _restore_management_handoff(state)
        except (OSError, ValueError, json.JSONDecodeError) as rollback_exc:
            rollback = {}
            rollback_error = str(rollback_exc)
        if not rollback_error:
            try:
                _clear_management_handoff_state()
            except OSError as cleanup_exc:
                rollback_error = f"rollback state cleanup failed: {cleanup_exc}"
        print(
            json.dumps(
                {
                    "management_handoff": "rolled back" if not rollback_error else "rollback incomplete",
                    "failing_layer": failing_layer,
                    "error": str(exc),
                    "rollback_error": rollback_error,
                    "rollback": rollback,
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    print(
        json.dumps(
            {
                "management_handoff": "awaiting application commit",
                "job_id": state["job_id"],
                "candidate_addresses": candidate_addresses,
                "previous_preflight": previous_preflight,
                "upstream_readiness": upstream_readiness,
                "old_path_readiness": old_readiness,
                "candidate_readiness": candidate_readiness,
                "final_readiness": final_readiness,
                "retired_previous_interfaces": state["previous_management_interfaces"],
            },
            sort_keys=True,
        )
    )
    return 0


def _handle_management_handoff(action: str, args: list[str]) -> int:
    """Handle management handoff validation, apply, and recovery.

    Args:
        action: Action consumed by the handler.
        args: Parsed command-line options consumed by the operation.
    """
    if action == "recover":
        if args:
            print("management-handoff recover does not accept a path", file=sys.stderr)
            return 2
        return _recover_management_handoff()
    if action == "acknowledge":
        if len(args) != 1:
            print("management-handoff acknowledge requires exactly one task id", file=sys.stderr)
            return 2
        return _acknowledge_management_handoff(args[0])
    if len(args) != 1:
        print(f"management-handoff {action} requires exactly one staged manifest", file=sys.stderr)
        return 2
    try:
        manifest_path = _validate_management_handoff_manifest_path(args[0])
        payload = _load_management_handoff_manifest(manifest_path)
        errors = _management_handoff_validation_errors(payload)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    if errors:
        print("\n".join(errors), file=sys.stderr)
        return 2
    if action == "validate":
        print(json.dumps({"management_handoff": "validation ok", "job_id": payload["job_id"]}, sort_keys=True))
        return 0
    return _apply_management_handoff(payload)


def _handle_management_front_door(action: str, args: list[str]) -> int:
    """Handle startup recovery for ordinary management front-door activation.

    Args:
        action: Action consumed by the handler.
        args: Parsed command-line options consumed by the operation.
    """
    if action != "recover" or args:
        print("management-front-door recover does not accept a path", file=sys.stderr)
        return 2
    return _recover_management_front_door()


def _handle_appliance_update(action: str, args: list[str]) -> int:
    """Handle appliance update.

    Args:
        action: Action consumed by handle appliance update.
        args: Parsed command-line options consumed by the operation.
    """
    if action == "quiesce-action":
        if len(args) != 2:
            print("quiesce-action requires exactly one task id and stream", file=sys.stderr)
            return 2
        try:
            evidence = _quiesce_appliance_update_action_unit(args[0], args[1])
        except ValueError as exc:
            print(str(exc), file=sys.stderr)
            return 1
        print(json.dumps(evidence, sort_keys=True))
        return 0

    if action == "status-inspect":
        if args:
            print("status-inspect does not accept arguments", file=sys.stderr)
            return 2
        try:
            recorded = json.loads(
                _read_appliance_update_runtime_file(
                    ATLASO_UPDATE_STATUS_PATH,
                    limit=1024 * 1024,
                )
            )
        except FileNotFoundError:
            print(json.dumps({"state": "absent"}, sort_keys=True))
            return 0
        except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
            print(
                f"Appliance Update status inspection failed: {type(exc).__name__}.",
                file=sys.stderr,
            )
            return 1
        restoration = recorded.get("ui_restoration") if isinstance(recorded, dict) else None
        task_id = str(recorded.get("task_id") or "") if isinstance(recorded, dict) else ""
        state = str(restoration.get("state") or "") if isinstance(restoration, dict) else ""
        if (
            re.fullmatch(r"job_[0-9a-f]{12}", task_id) is None
            or re.fullmatch(r"[0-9a-f]{32}", str(recorded.get("transaction_id") or "")) is None
            or state not in {"held", "pending", "restored"}
        ):
            print("Appliance Update status inspection found invalid durable state.", file=sys.stderr)
            return 1
        print(
            json.dumps(
                {
                    "state": state,
                    "task_id": task_id,
                    "terminal": recorded.get("terminal") is True,
                    "status_activated": recorded.get("status_activated") is True,
                },
                sort_keys=True,
            )
        )
        return 0

    if action == "restart-inspect":
        if len(args) != 1 or re.fullmatch(r"job_[0-9a-f]{12}", args[0]) is None:
            print("restart-inspect requires exactly one task id", file=sys.stderr)
            return 2
        try:
            receipt = json.loads(
                _read_appliance_update_runtime_file(
                    ATLASO_UPDATE_RESTART_RECEIPT_PATH,
                    limit=4096,
                )
            )
        except FileNotFoundError:
            print(json.dumps({"state": "absent"}, sort_keys=True))
            return 0
        except (OSError, UnicodeDecodeError, json.JSONDecodeError, ValueError) as exc:
            print(f"Restart receipt inspection failed: {type(exc).__name__}.", file=sys.stderr)
            return 1
        try:
            receipt_worker_pid = int(receipt.get("worker_pid") or 0)
        except (AttributeError, TypeError, ValueError):
            receipt_worker_pid = 0
        if (
            not isinstance(receipt, dict)
            or str(receipt.get("job_id") or "") != args[0]
            or receipt.get("state") != "completed"
            or receipt_worker_pid <= 0
            or not str(receipt.get("worker_boot_id") or "")
            or not str(receipt.get("worker_start_ticks") or "")
        ):
            print("Restart receipt does not match the task", file=sys.stderr)
            return 1
        print(json.dumps(receipt, sort_keys=True))
        return 0

    if action == "restart-complete":
        if len(args) != 1:
            print("restart-complete requires exactly one task id", file=sys.stderr)
            return 2
        return _complete_atlaso_service_restart(args[0])

    if action in {"status-publish", "status-finish"}:
        if len(args) != 1:
            print(f"{action} requires exactly one task id", file=sys.stderr)
            return 2
        try:
            result = (
                _publish_appliance_update_status(args[0])
                if action == "status-publish"
                else _finish_appliance_update_status(args[0])
            )
        except (OSError, ValueError, sqlite3.Error) as exc:
            print(f"Appliance Update status transition failed: {type(exc).__name__}.", file=sys.stderr)
            return 1
        print(
            json.dumps(
                {
                    "status": result.get("status"),
                    "phase": result.get("phase"),
                    "task_id": result.get("task_id"),
                    "sequence": result.get("sequence"),
                },
                sort_keys=True,
            )
        )
        return 0

    if action == "guard-release":
        if args:
            print("guard-release does not accept arguments", file=sys.stderr)
            return 2
        result = _guard_interrupted_release_startup()
        print(json.dumps(result, indent=2, sort_keys=True))
        if result.get("success") is True:
            return 0
        if result.get("stderr"):
            print(str(result["stderr"]), file=sys.stderr)
        return 75

    if action == "complete-committed-release":
        if args:
            print("complete-committed-release does not accept arguments", file=sys.stderr)
            return 2
        result = _finish_committed_release_after_worker_start()
        print(json.dumps(result, indent=2, sort_keys=True))
        if result.get("success") is True:
            return 0
        if result.get("error"):
            print(str(result["error"]), file=sys.stderr)
        return 75

    if action == "recover-release":
        if args:
            print("recover-release does not accept arguments", file=sys.stderr)
            return 2
        try:
            _cleanup_stale_photon_repository_views()
        except (OSError, ValueError) as exc:
            print(str(exc), file=sys.stderr)
            return 75
        result = _recover_interrupted_release_transaction()
        print(json.dumps(result, indent=2, sort_keys=True))
        if result.get("allow_worker") is True:
            return 0
        if result.get("error"):
            print(str(result["error"]), file=sys.stderr)
        return 75

    if action == "bootstrap-data-disk-safety":
        if len(args) != 1:
            print("bootstrap-data-disk-safety requires exactly one active release path", file=sys.stderr)
            return 2
        try:
            commands = _bootstrap_release_data_disk_safety(Path(args[0]))
        except (OSError, ValueError) as exc:
            print(str(exc), file=sys.stderr)
            return 1
        print(json.dumps({"status": "succeeded", "commands": commands}, indent=2, sort_keys=True))
        return 0

    try:
        config_path = _validate_appliance_update_config_path(args[0])
        payload = _load_appliance_update_config(config_path)
        credentials = _load_appliance_update_credentials(args)
        if action == "check":
            errors = _appliance_update_config_errors(
                payload,
                require_streams=True,
                require_synchronized=False,
            )
        else:
            errors = _appliance_update_config_errors(
                payload,
                require_streams=action != "sync-sources",
            )
    except (IndexError, OSError, ValueError, json.JSONDecodeError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 2

    if action == "check":
        try:
            result = _check_appliance_update(payload, credentials)
        except Exception as exc:  # noqa: BLE001 - helper reports validation/check failures as stderr.
            print(str(exc), file=sys.stderr)
            return 1
        print(json.dumps(result, indent=2, sort_keys=True))
        if any(not command.get("success") for command in result.get("commands", [])) or any(
            isinstance(check, dict) and check.get("state") == "failed"
            for check in result.get("checks", {}).values()
        ):
            return 1
        return 0
    if action == "apply":
        try:
            credential_path = Path(args[1]) if len(args) >= 2 else None
            result = _apply_appliance_update(
                payload,
                credentials,
                credential_path,
            )
        except Exception as exc:  # noqa: BLE001 - helper reports update failures without tracebacks.
            print(str(exc), file=sys.stderr)
            return 1
        print(json.dumps(result, indent=2, sort_keys=True))
        if any(not command.get("success") for command in result.get("commands", [])):
            return 1
        return 0
    if action == "sync-sources":
        try:
            result = _sync_appliance_update_sources(payload, credentials)
        except Exception as exc:  # noqa: BLE001 - helper reports source configuration failures as stderr.
            print(str(exc), file=sys.stderr)
            return 1
        print(json.dumps(result, indent=2, sort_keys=True))
        if result.get("status") != "succeeded" and result.get("error"):
            print(str(result["error"]), file=sys.stderr)
        return 0 if result.get("status") == "succeeded" else 1
    if action == "restart-service":
        return _restart_atlaso_service_after_update(str(payload.get("job_id") or ""))

    print(f"unsupported appliance-update action: {action}", file=sys.stderr)
    return 2


def main(argv: list[str]) -> int:
    """Run the command-line entry point.

    Args:
        argv: Command-line arguments to parse, or ``None`` to use the process arguments.
    """
    if len(argv) < 3:
        return _usage()

    group = argv[1]
    action = argv[2]
    args = argv[3:]
    real_apply = False
    if "--real" in args:
        real_apply = True
        args = [arg for arg in args if arg != "--real"]

    if group not in COMMANDS or action not in COMMANDS[group]:
        return _usage()

    if (group, action) not in NO_PATH_ACTIONS and not args:
        print(f"{group} {action} requires a config or artifact path", file=sys.stderr)
        return 2

    normalized_args: list[str] = []
    try:
        normalized_args = args if (group, action) in NON_PATH_ARGUMENT_ACTIONS else [_validate_path(arg) for arg in args]
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2

    if (group, action) == ("kms", "status"):
        return _handle_kms(action, normalized_args)

    if real_apply and _should_run_real_action_with_systemd(action):
        return _run_real_action_with_systemd(group, action, normalized_args)

    record = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "helper": "atlaso-helper",
        "group": group,
        "action": action,
        "args": normalized_args,
        "dry_run": not real_apply,
    }

    print(json.dumps(record, sort_keys=True))
    if record["dry_run"]:
        return 0

    if group == "staging":
        return _handle_staging(action, normalized_args)
    if group == "firewall":
        return _handle_firewall(action, normalized_args)
    if group == "network":
        return _handle_network(action, normalized_args)
    if group == "management-front-door":
        return _handle_management_front_door(action, normalized_args)
    if group == "management-handoff":
        return _handle_management_handoff(action, normalized_args)
    if group == "wan":
        return _handle_wan(action, normalized_args)
    if group == "dnsmasq":
        return _handle_dnsmasq(action, normalized_args)
    if group == "esxi-pxe":
        return _handle_esxi_pxe(action, normalized_args)
    if group == "esx-storage":
        return _handle_esx_storage(action, normalized_args)
    if group == "appliance-settings":
        return _handle_appliance_settings(action, normalized_args)
    if group == "web-terminal":
        return _handle_web_terminal(action, normalized_args)
    if group == "local-users":
        return _handle_local_users(action, normalized_args)
    if group == "ca":
        return _handle_ca(action, normalized_args)
    if group == "kms":
        return _handle_kms(action, normalized_args)
    if group == "ldap":
        return _handle_ldap(action, normalized_args)
    if group == "ntpd":
        return _handle_ntpd(action, normalized_args)
    if group == "nginx":
        return _handle_nginx(action, normalized_args)
    if group == "vcf-backups":
        return _handle_vcf_backups(action, normalized_args)
    if group == "vcf-offline-depot":
        return _handle_vcf_offline_depot(action, normalized_args)
    if group == "public-services":
        return _handle_public_services(action, normalized_args)
    if group == "appliance-update":
        return _handle_appliance_update(action, normalized_args)
    if group == "automation":
        return _handle_automation(action, normalized_args)
    if group == "appliance-power":
        return _handle_appliance_power(action, normalized_args)
    if group == "factory-reset":
        return _handle_factory_reset(action, normalized_args)
    if group == "console":
        return _handle_console(action, normalized_args)

    print("real helper execution is not implemented for this apply unit", file=sys.stderr)
    return 78


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
