def _nginx_binary() -> str | None:
    """Perform nginx binary.

    """
    return shutil.which("nginx") or ("/usr/sbin/nginx" if Path("/usr/sbin/nginx").exists() else None)


def _install_nginx_include() -> None:
    """Perform install nginx include.

    """
    NGINX_SITES_DIR.mkdir(parents=True, exist_ok=True)
    NGINX_CONF_INCLUDE_PATH.parent.mkdir(parents=True, exist_ok=True)
    include_text = "\n".join(
        [
            "# Managed by Atlaso. Local changes may be overwritten.",
            f"include {NGINX_SITES_DIR}/*.conf;",
            "",
        ]
    )
    current = NGINX_CONF_INCLUDE_PATH.read_text(encoding="utf-8") if NGINX_CONF_INCLUDE_PATH.exists() else ""
    if current != include_text:
        NGINX_CONF_INCLUDE_PATH.write_text(include_text, encoding="utf-8")
        os.chmod(NGINX_CONF_INCLUDE_PATH, 0o644)
    _ensure_nginx_main_config_includes_atlaso()


def _http_block_end_offset(text: str) -> int:
    """Perform HTTP block end offset.

    Args:
        text: Text content consumed by the operation.
    """
    match = re.search(r"(?m)^http\s*\{", text)
    if not match:
        return -1
    depth = 1
    index = match.end()
    while index < len(text):
        char = text[index]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return index
        index += 1
    return -1


def _ensure_nginx_main_config_includes_atlaso() -> None:
    """Ensure nginx main config includes atlaso.

    """
    if not NGINX_MAIN_CONFIG_PATH.exists():
        return
    text = NGINX_MAIN_CONFIG_PATH.read_text(encoding="utf-8")
    include_line = f"    include {NGINX_CONF_INCLUDE_PATH};"
    if str(NGINX_CONF_INCLUDE_PATH) in text:
        return
    end_offset = _http_block_end_offset(text)
    if end_offset < 0:
        return
    prefix = text[:end_offset].rstrip()
    suffix = text[end_offset:]
    next_text = f"{prefix}\n\n    # Managed by Atlaso. Local changes may be overwritten.\n{include_line}\n{suffix}"
    tmp_target = NGINX_MAIN_CONFIG_PATH.with_suffix(".conf.tmp")
    tmp_target.write_text(next_text, encoding="utf-8")
    os.chmod(tmp_target, 0o644)
    tmp_target.replace(NGINX_MAIN_CONFIG_PATH)


def _nginx_test_command() -> subprocess.CompletedProcess[str]:
    """Perform nginx test command.

    """
    nginx = _nginx_binary()
    if nginx is None:
        return subprocess.CompletedProcess(["nginx", "-t"], 127, "", "nginx command not found\n")
    return _run([nginx, "-t"])


def _reload_nginx() -> int:
    """Perform reload nginx.

    """
    commands = [["systemctl", "enable", "--now", "nginx"]]
    reload_result = _run(["systemctl", "reload", "nginx"])
    if reload_result.returncode == 0:
        print(reload_result.stdout, end="")
        print(reload_result.stderr, end="", file=sys.stderr)
        return _run_checked_commands(commands)
    commands.append(["systemctl", "restart", "nginx"])
    return _run_checked_commands(commands)


def _nginx_site_metadata(text: str) -> list[tuple[str, set[str]]]:
    """Perform nginx site metadata.

    Args:
        text: Text content consumed by the operation.
    """
    metadata: list[tuple[str, set[str]]] = []
    for block in re.findall(r"server\s*\{(?P<body>.*?)\n\}", text, flags=re.DOTALL):
        names: set[str] = set()
        listens: set[str] = set()
        for raw in block.splitlines():
            line = raw.strip().rstrip(";")
            if not line or line.startswith("#"):
                continue
            if line.startswith("server_name "):
                names.update(item for item in line.split()[1:] if item != "_")
            elif line.startswith("listen "):
                value = " ".join(part for part in line.split()[1:] if part not in {"ssl", "http2", "default_server"})
                listens.add(value)
        for name in names:
            metadata.append((name, listens))
    return metadata


def _nginx_site_conflict(site_path: Path, text: str) -> str:
    """Perform nginx site conflict.

    Args:
        site_path: Filesystem path used for site.
        text: Text content consumed by the operation.
    """
    if not NGINX_SITES_DIR.exists():
        return ""
    candidate = _nginx_site_metadata(text)
    for other_path in NGINX_SITES_DIR.glob("*.conf"):
        if other_path.resolve() == site_path.resolve() or not other_path.is_file():
            continue
        for name, listens in _nginx_site_metadata(other_path.read_text(encoding="utf-8")):
            for candidate_name, candidate_listens in candidate:
                if name == candidate_name and listens.intersection(candidate_listens):
                    return f"nginx site {site_path.name} duplicates server_name {name} on {', '.join(sorted(listens.intersection(candidate_listens)))}."
    return ""


def _validate_nginx_site_candidate(site_path: Path, text: str | None) -> subprocess.CompletedProcess[str]:
    """Validate one prospective Atlaso nginx site in an isolated config tree.

    Args:
        site_path: Canonical destination used to identify the site filename.
        text: Prospective site text, or ``None`` to validate removal.
    """
    nginx = _nginx_binary()
    if nginx is None:
        return subprocess.CompletedProcess(["nginx", "-t"], 127, "", "nginx command not found\n")
    if text is not None:
        conflict = _nginx_site_conflict(site_path, text)
        if conflict:
            return subprocess.CompletedProcess([nginx, "-t"], 2, "", conflict + "\n")
    if not NGINX_MAIN_CONFIG_PATH.is_file():
        return subprocess.CompletedProcess([nginx, "-t"], 2, "", "nginx main config is missing\n")
    with tempfile.TemporaryDirectory(prefix="atlaso-nginx-preflight-") as temporary:
        root = Path(temporary)
        nginx_root = root / "nginx"
        sites_root = root / "sites.d"
        shutil.copytree(NGINX_MAIN_CONFIG_PATH.parent, nginx_root)
        if NGINX_SITES_DIR.is_dir():
            shutil.copytree(NGINX_SITES_DIR, sites_root)
        else:
            sites_root.mkdir()
        candidate_path = sites_root / site_path.name
        if text is None:
            candidate_path.unlink(missing_ok=True)
        else:
            candidate_path.write_text(text, encoding="utf-8")
        include_path = nginx_root / "conf.d" / NGINX_CONF_INCLUDE_PATH.name
        include_path.parent.mkdir(parents=True, exist_ok=True)
        include_path.write_text(
            "# Atlaso factory-reset generated-config preflight.\n"
            f"include {sites_root.as_posix()}/*.conf;\n",
            encoding="utf-8",
        )
        main_path = nginx_root / NGINX_MAIN_CONFIG_PATH.name
        main_text = main_path.read_text(encoding="utf-8")
        if str(NGINX_CONF_INCLUDE_PATH) not in main_text:
            end_offset = _http_block_end_offset(main_text)
            if end_offset < 0:
                return subprocess.CompletedProcess([nginx, "-t"], 2, "", "nginx http block is invalid\n")
            main_text = (
                main_text[:end_offset].rstrip()
                + f"\n\n    include {include_path.as_posix()};\n"
                + main_text[end_offset:]
            )
        main_text = main_text.replace("/etc/nginx/", f"{nginx_root.as_posix()}/")
        main_text = main_text.replace(str(NGINX_CONF_INCLUDE_PATH), include_path.as_posix())
        main_path.write_text(main_text, encoding="utf-8")
        return _run([nginx, "-t", "-c", str(main_path), "-p", f"{nginx_root}{os.sep}"])


def _install_nginx_site(site_path: Path, text: str) -> int:
    """Perform install nginx site.

    Args:
        site_path: Filesystem path used for site.
        text: Text content consumed by the operation.
    """
    nginx = _nginx_binary()
    if nginx is None:
        print("nginx command not found", file=sys.stderr)
        return 127
    _install_nginx_include()
    conflict = _nginx_site_conflict(site_path, text)
    if conflict:
        print(conflict, file=sys.stderr)
        return 2
    previous = site_path.read_text(encoding="utf-8") if site_path.exists() else None
    site_path.parent.mkdir(parents=True, exist_ok=True)
    tmp_target = site_path.with_suffix(".conf.tmp")
    tmp_target.write_text(text, encoding="utf-8")
    os.chmod(tmp_target, 0o644)
    tmp_target.replace(site_path)
    validation = _nginx_test_command()
    print(validation.stdout, end="")
    print(validation.stderr, end="", file=sys.stderr)
    if validation.returncode != 0:
        if previous is None:
            site_path.unlink(missing_ok=True)
        else:
            site_path.write_text(previous, encoding="utf-8")
            os.chmod(site_path, 0o644)
        return validation.returncode
    return _reload_nginx()


def _remove_nginx_site(site_path: Path) -> int:
    """Remove nginx site.

    Args:
        site_path: Filesystem path used for site.
    """
    if not site_path.exists():
        return 0
    _install_nginx_include()
    site_path.unlink()
    validation = _nginx_test_command()
    print(validation.stdout, end="")
    print(validation.stderr, end="", file=sys.stderr)
    if validation.returncode != 0:
        return validation.returncode
    return _reload_nginx()


def _validate_public_services_config_path(path_value: str) -> Path:
    """Validate public services config path.

    Args:
        path_value: Candidate path value to validate.
    """
    path = Path(_validate_path(path_value)).resolve()
    if path.suffix != ".conf":
        raise ValueError("Public services nginx config path must end with .conf")
    if not path.is_relative_to(PUBLIC_SERVICES_APPLY_DIR):
        raise ValueError(f"Public services nginx config must be staged under {PUBLIC_SERVICES_APPLY_DIR}")
    if not path.is_file():
        raise ValueError(f"Public services nginx config does not exist: {path}")
    return path


def _public_services_config_errors(
    path: Path,
    *,
    staged_ca_path: Path | None = None,
) -> list[str]:
    """Perform public services config errors.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
        staged_ca_path: Bundled CA payload that will install referenced TLS material.
    """
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        return [str(exc)]
    errors: list[str] = []
    if "IP-scoped public service front door" not in text:
        errors.append("Public services nginx config must be generated by Atlaso.")
    if _nginx_directive(text, "root"):
        errors.append("Public services nginx config must not expose a broad server root.")
    if "/registry" in text:
        errors.append("Public services nginx config must not add registry proxy locations.")
    if "location = /terminal/ws {" in text and "# Terminal-only HTTPS front door." in text:
        for required in [
            "location = /login {",
            "location = /logout {",
            "location = /terminal {",
            "location = /terminal/tickets {",
            "location = /terminal/ws {",
            "location ^~ /static/ {",
            "proxy_set_header X-Atlaso-Listener-Address $server_addr;",
            "proxy_set_header Upgrade $http_upgrade;",
            'proxy_set_header Connection "upgrade";',
        ]:
            if required not in text:
                errors.append(f"Public services web terminal config must include {required}.")
        if "location / { return 404; }" not in text and "location / {\n    return 404;" not in text:
            errors.append("Public services web terminal config must keep the catch-all route closed.")
        for forbidden in ["location = /dashboard", "location ^~ /api", "location /api", "location = /settings"]:
            if forbidden in text:
                errors.append(f"Public services web terminal config must not expose {forbidden}.")
    if "# IP-scoped management HTTPS front door." in text:
        for required in [
            "location = /terminal/ws {",
            "location = /ui/management/terminal/ws {",
            "proxy_set_header Upgrade $http_upgrade;",
            'proxy_set_header Connection "upgrade";',
        ]:
            if required not in text:
                errors.append(
                    f"Public services management config must include {required}."
                )
    if "OIDC HTTPS front door." in text:
        for required in [
            "location ^~ /identity/ {",
            "proxy_set_header X-Forwarded-Proto https;",
            "proxy_set_header X-Atlaso-Listener-Address $server_addr;",
        ]:
            if required not in text:
                errors.append(
                    f"Public services OIDC HTTPS config must include {required}."
                )
        if "location / { return 404; }" not in text and "location / {\n    return 404;" not in text:
            errors.append(
                "Public services OIDC HTTPS config must keep the catch-all route closed."
            )
    if "/PROD/" in text or "location = /PROD" in text or "location ~ ^/PROD/" in text:
        if "IP-scoped HTTPS public services front door." not in text:
            errors.append("Public services nginx config may expose VCF Offline Depot paths only in the IP-scoped HTTPS front door.")
        aliases = _nginx_directive(text, "alias")
        prod_alias = next((alias for alias in aliases if _public_services_prod_alias_path(alias) == VCF_DEPOT_PROD_PATH), "")
        if not prod_alias:
            errors.append(f"Public services VCF Offline Depot alias must point at {VCF_DEPOT_PROD_PATH}.")
        for required in [
            "location = /PROD",
            "return 301 /PROD/;",
            "location = /PROD/login",
            "location = /PROD/logout",
            "location = /PROD/",
            "location ~ ^/PROD/.*/$",
            "location ~ ^/PROD/(?!login$|logout$|auth-check$)(.+[^/])$",
        ]:
            if required not in text:
                errors.append(f"Public services VCF Offline Depot config must include {required}.")
        if _vcf_depot_auth_required(text) and "proxy_pass http://127.0.0.1:8000/PROD/auth-failure;" not in text:
            errors.append("Authenticated public services VCF Offline Depot config must return 401 to non-browser clients.")
    for forbidden in [
        "location = /manifest.webmanifest",
        "location = /service-worker.js",
        "location = /requests/login",
        "location = /requests/logout",
        "location = /ca",
        "location ^~ /ca/",
        "location = /requests",
        "location ^~ /requests/",
    ]:
        if forbidden in text and "CA portal HTTPS front door." not in text:
            errors.append("Public services HTTP config may serve only ESXi PXE paths.")
            break
    esxi_http_alias = ESXI_PXE_HTTP_BASE.as_posix().rstrip("/")
    if "location /pxe/esxi/" in text and f"alias {esxi_http_alias}/;" not in text:
        errors.append(f"Public services ESXi PXE location must alias {ESXI_PXE_HTTP_BASE}.")
    if "location /pxe/esxi/ks/" in text and "proxy_pass http://127.0.0.1:8000;" not in text:
        errors.append("Public services ESXi Kickstart location must proxy to Atlaso.")
    if "location /pxe/esxi/claim/" in text and "proxy_pass http://127.0.0.1:8000;" not in text:
        errors.append("Public services ESXi boot-claim location must proxy to Atlaso.")
    if "CA portal HTTPS front door." in text:
        for required in [
            "location = / {",
            "location = /ca",
            "location ^~ /ca/",
            "location = /requests",
            "location ^~ /requests/",
            "location ^~ /static/",
            "location = /favicon.ico",
            "proxy_set_header X-Forwarded-Proto https;",
        ]:
            if required not in text:
                errors.append(f"Public services CA HTTPS config must include {required}.")
        server_names = _nginx_directive(text, "server_name")
        for server_name in server_names:
            for name in server_name.split():
                normalized = name.strip().strip(".").lower()
                if normalized == "_":
                    continue
                try:
                    ip_interface(f"{normalized}/32" if ":" not in normalized else f"{normalized}/128")
                    continue
                except ValueError:
                    pass
                if not HOSTNAME_PATTERN.fullmatch(normalized):
                    errors.append(f"Public services server_name {name} must be a valid DNS name or address.")
    for directive, label, private in [
        ("ssl_certificate", "Public services certificate", False),
        ("ssl_certificate_key", "Public services private key", True),
    ]:
        for value in _nginx_directive(text, directive):
            try:
                cert_path = _ca_managed_path(value, directive)
                staged_pem = None
                if staged_ca_path is not None:
                    staged_pem = _staged_ca_path_material(
                        staged_ca_path,
                        cert_path,
                        private_key=private,
                    )
                if staged_pem is not None:
                    errors.extend(_pem_errors(staged_pem, label, private_key=private))
                elif not cert_path.is_file():
                    errors.append(f"{label} does not exist: {cert_path}")
                else:
                    errors.extend(_pem_errors(cert_path.read_text(encoding="utf-8"), label, private_key=private))
            except (OSError, ValueError) as exc:
                errors.append(str(exc))
    return errors


def _public_services_prod_alias_path(alias: str) -> Path:
    """Perform public services prod alias path.

    Args:
        alias: Alias consumed by public services prod alias path.
    """
    normalized = alias.strip().rstrip("/")
    if normalized.endswith("/$1"):
        normalized = normalized[:-3]
    return Path(normalized)


def _handle_public_services(action: str, args: list[str]) -> int:
    """Handle public services.

    Args:
        action: Action consumed by handle public services.
        args: Parsed command-line options consumed by the operation.
    """
    if len(args) != 1:
        print(f"public-services {action} requires exactly one staged nginx config path", file=sys.stderr)
        return 2
    try:
        config_path = _validate_public_services_config_path(args[0])
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    errors = _public_services_config_errors(config_path)
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 2
    if action == "validate":
        print(json.dumps({"public_services": "validation ok", "config_path": str(config_path)}, sort_keys=True))
        return 0
    if action == "preflight":
        text = config_path.read_text(encoding="utf-8")
        result = _validate_nginx_site_candidate(
            NGINX_PUBLIC_SERVICES_SITE_PATH,
            text if "server {" in text else None,
        )
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        return result.returncode
    if action == "apply":
        text = config_path.read_text(encoding="utf-8")
        if "server {" not in text:
            result = _remove_nginx_site(NGINX_PUBLIC_SERVICES_SITE_PATH)
        else:
            if _vcf_depot_auth_required(text) and _write_vcf_depot_htpasswd(_vcf_depot_auth_username(text)) != 0:
                return 2
            result = _install_nginx_site(NGINX_PUBLIC_SERVICES_SITE_PATH, text)
        if result != 0:
            return result
        print(json.dumps({"public_services": "apply complete", "site_path": str(NGINX_PUBLIC_SERVICES_SITE_PATH)}, sort_keys=True))
        return 0
    print(f"unsupported public-services action: {action}", file=sys.stderr)
    return 2


def _management_proxy_location(upstream_host: str, upstream_port: int, forwarded_proto: str) -> list[str]:
    """Perform management proxy location.

    Args:
        upstream_host: Upstream host consumed by management proxy location.
        upstream_port: Upstream port consumed by management proxy location.
        forwarded_proto: Forwarded proto consumed by management proxy location.
    """
    return [
        "  client_max_body_size 1g;",
        _release_maintenance_condition(),
        "  location / {",
        f"    proxy_pass http://{upstream_host}:{upstream_port};",
        "    proxy_http_version 1.1;",
        "    proxy_set_header Host $host;",
        "    proxy_set_header X-Real-IP $remote_addr;",
        "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;",
        f"    proxy_set_header X-Forwarded-Proto {forwarded_proto};",
        "    proxy_set_header X-Atlaso-Listener-Address $server_addr;",
        '    proxy_set_header X-Atlaso-Depot-Basic-User "";',
        "    proxy_set_header Upgrade $http_upgrade;",
        '    proxy_set_header Connection "upgrade";',
        "  }",
    ]


def _management_ca_download_locations(upstream_host: str, upstream_port: int) -> list[str]:
    """Perform management CA download locations.

    Args:
        upstream_host: Upstream host consumed by management CA download locations.
        upstream_port: Upstream port consumed by management CA download locations.
    """
    lines: list[str] = []
    for path in ("/ca/downloads/root-ca.pem", "/ca/downloads/ca-bundle.pem"):
        lines.extend(
            [
                f"  location = {path} {{",
                f"    proxy_pass http://{upstream_host}:{upstream_port};",
                "    proxy_http_version 1.1;",
                "    proxy_set_header Host $host;",
                "    proxy_set_header X-Real-IP $remote_addr;",
                "    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;",
                "    proxy_set_header X-Forwarded-Proto http;",
                "  }",
            ]
        )
    return lines


def _management_nginx_config(payload: dict, cert_path: Path | None = None, key_path: Path | None = None) -> str:
    """Perform management nginx config.

    Args:
        payload: Validated request or task payload consumed by the operation.
        cert_path: Filesystem path used for cert.
        key_path: Filesystem path used for key.
    """
    fqdn = str(payload["fqdn"])
    https_enabled = bool(payload.get("management_https_enabled"))
    public_http_port = int(payload.get("management_public_http_port") or 80)
    public_https_port = int(payload.get("management_public_https_port") or 443)
    upstream_host = str(payload.get("management_upstream_host") or "127.0.0.1")
    upstream_port = int(payload.get("management_upstream_port") or payload.get("management_http_port") or 8000)
    lines = ["# Managed by Atlaso. Local changes may be overwritten."]
    if not https_enabled:
        lines.extend(
            [
                "server {",
                f"  listen {public_http_port} default_server;",
                f"  listen [::]:{public_http_port} default_server;",
                f"  server_name {fqdn} _;",
                *_management_proxy_location(upstream_host, upstream_port, "http"),
                "}",
                "",
            ]
        )
        return "\n".join(lines)
    lines.extend(
        [
            "server {",
            _release_maintenance_condition(),
            f"  listen {public_http_port} default_server;",
            f"  listen [::]:{public_http_port} default_server;",
            "  server_name _;",
            *_management_ca_download_locations(upstream_host, upstream_port),
            "  location / {",
            "    return 308 https://$host$request_uri;",
            "  }",
            "}",
            "",
            "server {",
            f"  listen {public_https_port} ssl default_server;",
            f"  listen [::]:{public_https_port} ssl default_server;",
            f"  server_name {fqdn};",
            f"  ssl_certificate {cert_path};",
            f"  ssl_certificate_key {key_path};",
            *_management_proxy_location(upstream_host, upstream_port, "https"),
            "}",
            "",
        ]
    )
    return "\n".join(lines)


def _configure_atlaso_management_https(
    payload: dict,
    *,
    site_suffix: str = "",
    verify_front_door: bool = True,
) -> tuple[int, int | None]:
    """Install the management front door without interrupting its upstream.

    Args:
        payload: Validated request or task payload consumed by the operation.
        site_suffix: Additional transitional server blocks installed in the same site.
        verify_front_door: Whether to prove the ordinary current-address path.
    """
    enabled = bool(payload.get("management_https_enabled"))
    port = int(payload.get("management_upstream_port") or payload.get("management_http_port") or 8000)
    upstream_host = str(payload.get("management_upstream_host") or "127.0.0.1")
    cert_path: Path | None = None
    key_path: Path | None = None
    if enabled:
        cert_path = _ca_managed_path(str(payload["management_https_cert_path"]), "management_https_cert_path")
        key_path = _ca_managed_path(str(payload["management_https_key_path"]), "management_https_key_path")
        _grant_atlaso_service_key_read(key_path)
    site_text = _management_nginx_config(payload, cert_path, key_path).rstrip() + "\n"
    if site_suffix.strip():
        site_text += "\n" + site_suffix.strip() + "\n"

    if _factory_reset_runtime_cleanup_is_admitted():
        verify_front_door = False

    # Ordinary Appliance Settings apply runs inside the Atlaso worker. Restarting
    # Atlaso from this helper waits for that active job to exit and leaves nginx
    # with no upstream in the meantime. Prove the already-running desired
    # upstream before publishing nginx; protected address/protocol changes use
    # the wider management handoff and perform equivalent checks around this call.
    if verify_front_door:
        try:
            _management_handoff_upstream_readiness(
                upstream_host=upstream_host,
                upstream_port=port,
            )
        except ValueError as exc:
            print(f"management upstream preflight failed: {exc}", file=sys.stderr)
            return 1, None

    tracked_paths = (
        NGINX_MANAGEMENT_SITE_PATH,
        NGINX_CONF_INCLUDE_PATH,
        NGINX_MAIN_CONFIG_PATH,
        ATLASO_SERVICE_HTTPS_DROPIN_PATH,
    )
    if verify_front_door:
        if _recover_management_front_door(quiet=True) != 0:
            print("management front-door recovery is incomplete", file=sys.stderr)
            return 1, None
    previous_files = {path: _runtime_file_snapshot(path) for path in tracked_paths}
    if verify_front_door:
        try:
            _persist_management_front_door_state(tracked_paths)
        except (OSError, ValueError, shutil.Error) as exc:
            print(
                f"management front-door snapshot persistence failed: {type(exc).__name__}",
                file=sys.stderr,
            )
            return 1, None
    next_text = _atlaso_service_loopback_dropin(upstream_host, port)
    ATLASO_SERVICE_DROPIN_DIR.mkdir(parents=True, exist_ok=True)
    current_text = ATLASO_SERVICE_HTTPS_DROPIN_PATH.read_text(encoding="utf-8") if ATLASO_SERVICE_HTTPS_DROPIN_PATH.exists() else ""
    changed = False
    if current_text != next_text:
        tmp_target = ATLASO_SERVICE_HTTPS_DROPIN_PATH.with_suffix(".conf.tmp")
        tmp_target.write_text(next_text, encoding="utf-8")
        os.chmod(tmp_target, 0o644)
        tmp_target.replace(ATLASO_SERVICE_HTTPS_DROPIN_PATH)
        changed = True
    if changed:
        try:
            daemon_reload = _run(["systemctl", "daemon-reload"])
        except (OSError, subprocess.SubprocessError) as exc:
            rollback_errors = (
                _rollback_management_front_door(previous_files)
                if verify_front_door
                else _restore_management_front_door_files(previous_files)
            )
            detail = f"management systemd daemon-reload raised {type(exc).__name__}"
            if rollback_errors:
                detail += "; rollback failed: " + ", ".join(rollback_errors)
            print(detail, file=sys.stderr)
            return 1, None
        print(daemon_reload.stdout, end="")
        print(daemon_reload.stderr, end="", file=sys.stderr)
        if daemon_reload.returncode != 0:
            rollback_errors = (
                _rollback_management_front_door(previous_files)
                if verify_front_door
                else _restore_management_front_door_files(previous_files)
            )
            if rollback_errors:
                print(
                    "management front-door rollback failed after systemd reload error: "
                    + ", ".join(rollback_errors),
                    file=sys.stderr,
                )
            return daemon_reload.returncode, None

    try:
        site_apply = _install_nginx_site(NGINX_MANAGEMENT_SITE_PATH, site_text)
    except (OSError, subprocess.SubprocessError) as exc:
        rollback_errors = (
            _rollback_management_front_door(previous_files)
            if verify_front_door
            else _restore_management_front_door_files(previous_files)
        )
        detail = f"management nginx activation raised {type(exc).__name__}"
        if rollback_errors:
            detail += "; rollback failed: " + ", ".join(rollback_errors)
        print(detail, file=sys.stderr)
        return 1, None
    if site_apply != 0:
        rollback_errors = (
            _rollback_management_front_door(previous_files)
            if verify_front_door
            else _restore_management_front_door_files(previous_files)
        )
        if rollback_errors:
            print(
                "management front-door rollback failed after nginx activation error: "
                + ", ".join(rollback_errors),
                file=sys.stderr,
            )
        return site_apply, None

    if verify_front_door:
        https_enabled = bool(payload.get("management_https_enabled"))
        public_port = int(
            payload.get(
                "management_public_https_port" if https_enabled else "management_public_http_port"
            )
            or (443 if https_enabled else 80)
        )
        try:
            _management_handoff_readiness(
                [str(payload["management_ip"])],
                https_enabled,
                public_port,
                upstream_host=upstream_host,
                upstream_port=port,
            )
        except (KeyError, OSError, ValueError, subprocess.SubprocessError) as exc:
            rollback_errors = (
                _rollback_management_front_door(previous_files)
                if verify_front_door
                else _restore_management_front_door_files(previous_files)
            )
            detail = f"management front-door readiness failed: {exc}"
            if rollback_errors:
                detail += "; rollback failed: " + ", ".join(rollback_errors)
            print(detail, file=sys.stderr)
            return 1, None

    if verify_front_door:
        try:
            _sync_management_front_door_candidates(tracked_paths)
            cleanup_failures = _clear_management_front_door_state(
                final_phase="candidate-committed"
            )
        except OSError as exc:
            rollback_errors = _rollback_management_front_door(previous_files)
            detail = f"management front-door commit persistence failed: {type(exc).__name__}"
            if rollback_errors:
                detail += "; rollback failed: " + ", ".join(rollback_errors)
            print(detail, file=sys.stderr)
            return 1, None
        if cleanup_failures:
            print(
                "management front-door candidate committed; deferred cleanup: "
                + ", ".join(cleanup_failures),
                file=sys.stderr,
            )

    # The shipped service already runs on the desired loopback endpoint. The
    # drop-in makes that endpoint durable for a future boot; reloading systemd
    # is sufficient and deliberately does not restart the active worker.
    return 0, None


def _runtime_file_snapshot(path: Path) -> tuple[bytes | None, int | None]:
    """Capture bytes and mode for one rollback-owned runtime file.

    Args:
        path: Runtime file that may be changed by front-door activation.

    Returns:
        Previous bytes and permission mode, or two ``None`` values when absent.
    """
    if not path.exists():
        return None, None
    return path.read_bytes(), stat.S_IMODE(path.stat().st_mode)


def _restore_management_front_door_files(
    snapshots: dict[Path, tuple[bytes | None, int | None]],
) -> list[str]:
    """Restore the previous nginx and Atlaso service configuration.

    Args:
        snapshots: Runtime paths mapped to their pre-activation bytes and modes.

    Returns:
        Bounded names of rollback layers that did not complete.
    """
    failures: list[str] = []
    for path, (content, mode) in snapshots.items():
        try:
            if content is None:
                existed = path.exists() or path.is_symlink()
                path.unlink(missing_ok=True)
                if existed:
                    _fsync_directory(path.parent)
                continue
            path.parent.mkdir(parents=True, exist_ok=True)
            temporary = path.with_name(f".{path.name}.atlaso-rollback")
            try:
                temporary.write_bytes(content)
                os.chmod(temporary, mode if mode is not None else 0o600)
                _fsync_file(temporary)
                temporary.replace(path)
                _fsync_directory(path.parent)
            finally:
                temporary.unlink(missing_ok=True)
        except OSError:
            failures.append(path.name)
    try:
        daemon_reload = _run(["systemctl", "daemon-reload"])
    except (OSError, subprocess.SubprocessError):
        failures.append("systemd daemon-reload")
    else:
        if daemon_reload.returncode != 0:
            failures.append("systemd daemon-reload")
    try:
        nginx_validation = _nginx_test_command()
    except (OSError, subprocess.SubprocessError):
        failures.append("nginx validation")
    else:
        if nginx_validation.returncode != 0:
            failures.append("nginx validation")
        else:
            try:
                reload_status = _reload_nginx()
            except (OSError, subprocess.SubprocessError):
                failures.append("nginx reload")
            else:
                if reload_status != 0:
                    failures.append("nginx reload")
    return failures


def _open_management_front_door_state_directory(*, create: bool) -> int | None:
    """Open the root-owned front-door state directory without following links.

    Args:
        create: Whether to create the state directory when it is absent.

    Returns:
        A securely opened POSIX directory descriptor, or ``None`` elsewhere.
    """
    if os.name != "posix":
        if MANAGEMENT_FRONT_DOOR_STATE_DIR.is_symlink():
            raise ValueError("management front-door state directory is unsafe")
        if create:
            MANAGEMENT_FRONT_DOOR_STATE_DIR.mkdir(parents=True, exist_ok=True)
        if not MANAGEMENT_FRONT_DOOR_STATE_DIR.is_dir():
            raise FileNotFoundError(MANAGEMENT_FRONT_DOOR_STATE_DIR)
        if MANAGEMENT_FRONT_DOOR_STATE_DIR.resolve() != MANAGEMENT_FRONT_DOOR_STATE_DIR:
            raise ValueError("management front-door state directory is unsafe")
        os.chmod(MANAGEMENT_FRONT_DOOR_STATE_DIR, 0o700)
        return None

    parent = MANAGEMENT_FRONT_DOOR_STATE_DIR.parent
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    parent_descriptor = os.open(parent, flags)
    try:
        parent_stat = os.fstat(parent_descriptor)
        if (
            not stat.S_ISDIR(parent_stat.st_mode)
            or parent_stat.st_uid != 0
            or parent_stat.st_mode & 0o022
        ):
            raise ValueError("management front-door state parent is unsafe")
        if create:
            try:
                os.mkdir(MANAGEMENT_FRONT_DOOR_STATE_DIR.name, 0o700, dir_fd=parent_descriptor)
            except FileExistsError:
                pass
        directory_descriptor = os.open(
            MANAGEMENT_FRONT_DOOR_STATE_DIR.name,
            flags,
            dir_fd=parent_descriptor,
        )
    finally:
        os.close(parent_descriptor)
    try:
        directory_stat = os.fstat(directory_descriptor)
        if not stat.S_ISDIR(directory_stat.st_mode) or directory_stat.st_uid != 0:
            raise ValueError("management front-door state directory is unsafe")
        if directory_stat.st_mode & 0o077:
            raise ValueError("management front-door state directory must use mode 0700")
        return directory_descriptor
    except Exception:
        os.close(directory_descriptor)
        raise


def _read_management_front_door_member(
    directory_descriptor: int | None,
    directory: Path,
    name: str,
) -> bytes:
    """Read one root-owned regular recovery file without following links.

    Args:
        directory_descriptor: Secure POSIX descriptor for the containing directory.
        directory: Containing path used on non-POSIX test hosts.
        name: Single recovery filename to read.

    Returns:
        Validated file bytes.
    """
    if Path(name).name != name:
        raise ValueError("management front-door recovery filename is invalid")
    if directory_descriptor is None:
        path = directory / name
        metadata = path.lstat()
        if path.is_symlink() or not stat.S_ISREG(metadata.st_mode):
            raise ValueError("management front-door recovery file is unsafe")
        return path.read_bytes()
    descriptor = os.open(
        name,
        os.O_RDONLY | os.O_NOFOLLOW,
        dir_fd=directory_descriptor,
    )
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_uid != 0
            or metadata.st_nlink != 1
            or metadata.st_mode & 0o077
            or metadata.st_size > 1024 * 1024
        ):
            raise ValueError("management front-door recovery file is unsafe")
        with os.fdopen(descriptor, "rb", closefd=False) as stream:
            return stream.read()
    finally:
        os.close(descriptor)


def _persist_management_front_door_state(paths: tuple[Path, ...]) -> None:
    """Persist ordinary front-door rollback files before runtime mutation.

    Args:
        paths: Exact nginx and Atlaso service files owned by the transaction.
    """
    directory_descriptor = _open_management_front_door_state_directory(create=True)
    if directory_descriptor is not None:
        os.close(directory_descriptor)
    _fsync_directory(MANAGEMENT_FRONT_DOOR_STATE_DIR.parent)
    MANAGEMENT_FRONT_DOOR_BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(MANAGEMENT_FRONT_DOOR_BACKUP_DIR, 0o700)
    _fsync_directory(MANAGEMENT_FRONT_DOOR_STATE_DIR)
    snapshots: list[dict[str, object]] = []
    for index, path in enumerate(paths):
        item: dict[str, object] = {"path": str(path), "existed": path.exists()}
        if path.exists():
            metadata = path.stat()
            backup = MANAGEMENT_FRONT_DOOR_BACKUP_DIR / f"{index:02d}.backup"
            shutil.copy2(path, backup)
            os.chmod(backup, 0o600)
            _fsync_file(backup)
            item.update(
                {
                    "backup": str(backup),
                    "mode": stat.S_IMODE(metadata.st_mode),
                    "uid": metadata.st_uid,
                    "gid": metadata.st_gid,
                }
            )
        snapshots.append(item)
    _fsync_directory(MANAGEMENT_FRONT_DOOR_BACKUP_DIR)
    _durable_management_handoff_state_write(
        {"schema": 1, "phase": "prepared", "snapshots": snapshots},
        MANAGEMENT_FRONT_DOOR_STATE_PATH,
    )


def _clear_management_front_door_state(*, final_phase: str) -> list[str]:
    """Commit a terminal phase before best-effort rollback-state cleanup.

    Args:
        final_phase: Durable outcome that prevents any later snapshot restore.

    Returns:
        Bounded cleanup layers that remain safe to retry.
    """
    if final_phase not in {"candidate-committed", "rollback-complete"}:
        raise ValueError("management front-door terminal phase is invalid")
    _durable_management_handoff_state_write(
        {"schema": 1, "phase": final_phase},
        MANAGEMENT_FRONT_DOOR_STATE_PATH,
    )
    failures: list[str] = []
    if MANAGEMENT_FRONT_DOOR_BACKUP_DIR.is_dir():
        try:
            shutil.rmtree(MANAGEMENT_FRONT_DOOR_BACKUP_DIR)
            _fsync_directory(MANAGEMENT_FRONT_DOOR_STATE_DIR)
        except OSError:
            failures.append("backup cleanup")
            return failures
    try:
        MANAGEMENT_FRONT_DOOR_STATE_PATH.unlink(missing_ok=True)
        _fsync_directory(MANAGEMENT_FRONT_DOOR_STATE_DIR)
    except OSError:
        failures.append("marker cleanup")
        return failures
    # Once the terminal marker unlink is durable, leftover empty directories
    # are harmless housekeeping. Do not report a retry condition that no
    # longer has a marker proving whether restore is forbidden.
    try:
        MANAGEMENT_FRONT_DOOR_STATE_DIR.rmdir()
    except OSError:
        return failures
    try:
        _fsync_directory(MANAGEMENT_FRONT_DOOR_STATE_DIR.parent)
    except OSError:
        pass
    return failures


def _rollback_management_front_door(
    snapshots: dict[Path, tuple[bytes | None, int | None]],
) -> list[str]:
    """Restore in-memory snapshots and retire durable state only on success.

    Args:
        snapshots: Runtime paths mapped to pre-activation bytes and modes.

    Returns:
        Bounded names of rollback layers that did not complete.
    """
    failures = _restore_management_front_door_files(snapshots)
    if failures:
        return failures
    try:
        cleanup_failures = _clear_management_front_door_state(
            final_phase="rollback-complete"
        )
    except (OSError, ValueError):
        failures.append("rollback state commit")
    else:
        if cleanup_failures:
            print(
                "management front-door rollback complete; deferred cleanup: "
                + ", ".join(cleanup_failures),
                file=sys.stderr,
            )
    return failures


def _load_management_front_door_state() -> dict:
    """Load and constrain one ordinary front-door rollback marker."""
    directory_descriptor = _open_management_front_door_state_directory(create=False)
    try:
        marker = _read_management_front_door_member(
            directory_descriptor,
            MANAGEMENT_FRONT_DOOR_STATE_DIR,
            MANAGEMENT_FRONT_DOOR_STATE_PATH.name,
        )
    finally:
        if directory_descriptor is not None:
            os.close(directory_descriptor)
    state = json.loads(marker.decode("utf-8"))
    phase = state.get("phase")
    if state.get("schema") != 1 or phase not in {
        "prepared",
        "candidate-committed",
        "rollback-complete",
    }:
        raise ValueError("management front-door rollback marker is invalid")
    if phase != "prepared":
        return {"schema": 1, "phase": phase, "snapshots": []}
    snapshots = state.get("snapshots")
    allowed = {
        str(NGINX_MANAGEMENT_SITE_PATH),
        str(NGINX_CONF_INCLUDE_PATH),
        str(NGINX_MAIN_CONFIG_PATH),
        str(ATLASO_SERVICE_HTTPS_DROPIN_PATH),
    }
    if not isinstance(snapshots, list) or {
        str(item.get("path")) for item in snapshots if isinstance(item, dict)
    } != allowed:
        raise ValueError("management front-door rollback paths are invalid")
    if len(snapshots) != len(allowed) or any(not isinstance(item, dict) for item in snapshots):
        raise ValueError("management front-door rollback snapshot set is invalid")
    for item in snapshots:
        if bool(item.get("existed")):
            backup = Path(str(item.get("backup", "")))
            if backup.parent != MANAGEMENT_FRONT_DOOR_BACKUP_DIR:
                raise ValueError("management front-door rollback backup is invalid")
            state_descriptor = _open_management_front_door_state_directory(create=False)
            if state_descriptor is not None:
                try:
                    backup_descriptor = os.open(
                        MANAGEMENT_FRONT_DOOR_BACKUP_DIR.name,
                        os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                        dir_fd=state_descriptor,
                    )
                    try:
                        backup_stat = os.fstat(backup_descriptor)
                        if (
                            not stat.S_ISDIR(backup_stat.st_mode)
                            or backup_stat.st_uid != 0
                            or backup_stat.st_mode & 0o077
                        ):
                            raise ValueError("management front-door backup directory is unsafe")
                        item["backup_content"] = _read_management_front_door_member(
                            backup_descriptor,
                            MANAGEMENT_FRONT_DOOR_BACKUP_DIR,
                            backup.name,
                        )
                    finally:
                        os.close(backup_descriptor)
                finally:
                    os.close(state_descriptor)
            else:
                item["backup_content"] = _read_management_front_door_member(
                    None,
                    MANAGEMENT_FRONT_DOOR_BACKUP_DIR,
                    backup.name,
                )
    return state


def _restore_management_front_door_snapshot(item: dict) -> None:
    """Restore one securely loaded durable ordinary front-door snapshot.

    Args:
        item: Validated snapshot metadata and backup bytes.
    """
    path = Path(str(item["path"]))
    if not bool(item.get("existed")):
        _durable_management_handoff_unlink(path)
        return
    content = item.get("backup_content")
    if not isinstance(content, bytes):
        raise ValueError("management front-door backup content is missing")
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.atlaso-rollback")
    try:
        temporary.write_bytes(content)
        os.chmod(temporary, int(item.get("mode", 0o600)))
        if os.name == "posix":
            os.chown(temporary, int(item.get("uid", 0)), int(item.get("gid", 0)))
        _fsync_file(temporary)
        temporary.replace(path)
        _fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def _sync_management_front_door_candidates(paths: tuple[Path, ...]) -> None:
    """Persist every proven candidate file before committing its marker.

    Args:
        paths: Exact nginx and Atlaso service files owned by the transaction.
    """
    parents: set[Path] = set()
    for path in paths:
        if path.is_symlink() or not path.is_file():
            raise OSError(f"management front-door candidate is unsafe: {path.name}")
        _fsync_file(path)
        parents.add(path.parent)
    for parent in sorted(parents, key=str):
        _fsync_directory(parent)


def _recover_management_front_door(*, quiet: bool = False) -> int:
    """Restore an interrupted ordinary front-door activation before startup.

    Args:
        quiet: Whether to suppress the successful no-state result.
    """
    if not MANAGEMENT_FRONT_DOOR_STATE_PATH.exists() and not MANAGEMENT_FRONT_DOOR_STATE_PATH.is_symlink():
        if not quiet:
            print(json.dumps({"management_front_door": "no recovery required"}, sort_keys=True))
        return 0
    failures: list[str] = []
    try:
        state = _load_management_front_door_state()
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        failures.append(f"state load: {type(exc).__name__}")
        state = {"snapshots": []}
    phase = str(state.get("phase") or "")
    if not failures and phase in {"candidate-committed", "rollback-complete"}:
        try:
            cleanup_failures = _clear_management_front_door_state(final_phase=phase)
        except (OSError, ValueError) as exc:
            cleanup_failures = [f"state cleanup: {type(exc).__name__}"]
        if cleanup_failures and not quiet:
            print(
                json.dumps(
                    {
                        "management_front_door": phase,
                        "deferred_cleanup": cleanup_failures,
                    },
                    sort_keys=True,
                ),
                file=sys.stderr,
            )
        elif not quiet:
            print(json.dumps({"management_front_door": phase}, sort_keys=True))
        return 0
    for index, item in enumerate(state.get("snapshots", [])):
        try:
            _restore_management_front_door_snapshot(item)
        except (KeyError, OSError, TypeError, ValueError, shutil.Error) as exc:
            failures.append(f"snapshot {index}: {type(exc).__name__}")
    if not failures:
        failures.extend(_restore_management_front_door_files({}))
    if not failures:
        try:
            cleanup_failures = _clear_management_front_door_state(
                final_phase="rollback-complete"
            )
        except (OSError, ValueError) as exc:
            failures.append(f"state commit: {type(exc).__name__}")
        else:
            if cleanup_failures and not quiet:
                print(
                    json.dumps(
                        {
                            "management_front_door": "rollback complete",
                            "deferred_cleanup": cleanup_failures,
                        },
                        sort_keys=True,
                    ),
                    file=sys.stderr,
                )
    if failures:
        print(
            json.dumps(
                {
                    "management_front_door": "rollback incomplete",
                    "failing_layers": failures[:8],
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    if not quiet:
        print(json.dumps({"management_front_door": "rollback complete"}, sort_keys=True))
    return 0


def _root_ssh_config(enabled: bool) -> str:
    """Perform root SSH config.

    Args:
        enabled: Whether the associated resource or behavior is enabled.
    """
    lines = [
        "# Managed by Atlaso. Local changes may be overwritten.",
        f"PermitRootLogin {'yes' if enabled else 'no'}",
    ]
    if enabled:
        lines.extend(["PasswordAuthentication yes", "KbdInteractiveAuthentication yes"])
    lines.append("")
    return "\n".join(lines)


def _sshd_main_config_with_dropin_include(
    text: str,
    include_line: str,
    *,
    unset_global_options: set[str] | None = None,
) -> str:
    """Return an sshd main config with one pre-Match drop-in include.

    Args:
        text: Current sshd main configuration.
        include_line: Isolated or installed drop-in include directive.
        unset_global_options: Global directives delegated to Atlaso drop-ins.
    """
    unset_options = {option.lower() for option in (unset_global_options or set())}
    next_lines: list[str] = []
    in_match_block = False
    for line in text.splitlines():
        stripped = line.strip()
        lower = stripped.lower()
        if lower.startswith("include ") and "sshd_config.d/*.conf" in lower:
            continue
        if lower.startswith("match "):
            in_match_block = True
        option = lower.split(None, 1)[0] if lower and not lower.startswith("#") else ""
        if not in_match_block and option in unset_options:
            next_lines.append(f"# Atlaso manages this directive through {SSHD_ROOT_LOGIN_CONFIG_PATH.name}: {line}")
            continue
        next_lines.append(line)
    insert_at = next(
        (index for index, line in enumerate(next_lines) if line.strip().lower().startswith("match ")),
        len(next_lines),
    )
    next_lines.insert(insert_at, include_line)
    return "\n".join(next_lines).rstrip() + "\n"


def _validate_sshd_dropin_candidates(
    replacements: dict[Path, str | None],
    *,
    unset_global_options: set[str] | None = None,
) -> subprocess.CompletedProcess[str]:
    """Validate prospective sshd drop-ins in an isolated config tree.

    Args:
        replacements: Canonical drop-in paths mapped to prospective content or removal.
        unset_global_options: Global directives delegated to Atlaso drop-ins.
    """
    sshd = shutil.which("sshd") or ("/usr/sbin/sshd" if Path("/usr/sbin/sshd").exists() else None)
    if sshd is None:
        return subprocess.CompletedProcess(["sshd", "-t"], 127, "", "sshd command not found\n")
    try:
        main_text = SSHD_MAIN_CONFIG_PATH.read_text(encoding="utf-8")
    except OSError as exc:
        return subprocess.CompletedProcess([sshd, "-t"], 2, "", f"{exc}\n")
    with tempfile.TemporaryDirectory(prefix="atlaso-sshd-preflight-") as temporary:
        root = Path(temporary)
        dropins = root / "sshd_config.d"
        if SSHD_CONFIG_DIR.is_dir():
            shutil.copytree(SSHD_CONFIG_DIR, dropins)
        else:
            dropins.mkdir()
        for destination, candidate_text in replacements.items():
            candidate_path = dropins / destination.name
            if candidate_text is None:
                candidate_path.unlink(missing_ok=True)
            else:
                candidate_path.write_text(candidate_text, encoding="utf-8")
        main_path = root / "sshd_config"
        main_path.write_text(
            _sshd_main_config_with_dropin_include(
                main_text,
                f"Include {dropins.as_posix()}/*.conf",
                unset_global_options=unset_global_options,
            ),
            encoding="utf-8",
        )
        return _run([sshd, "-t", "-f", str(main_path)])


def _ensure_sshd_dropin_include(*, unset_global_options: set[str] | None = None) -> int:
    """Ensure sshd dropin include.

    Args:
        unset_global_options: Unset global options consumed by ensure sshd dropin include.
    """
    try:
        current_text = SSHD_MAIN_CONFIG_PATH.read_text(encoding="utf-8")
    except OSError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    next_text = _sshd_main_config_with_dropin_include(
        current_text,
        "Include /etc/ssh/sshd_config.d/*.conf",
        unset_global_options=unset_global_options,
    )
    if current_text == next_text:
        return 0
    SSHD_MAIN_CONFIG_PATH.write_text(next_text, encoding="utf-8")
    os.chmod(SSHD_MAIN_CONFIG_PATH, 0o644)
    return 0


def _configure_root_ssh(enabled: bool) -> int:
    """Perform configure root SSH.

    Args:
        enabled: Whether the associated resource or behavior is enabled.
    """
    SSHD_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    include_result = _ensure_sshd_dropin_include(
        unset_global_options={"PermitRootLogin", "PasswordAuthentication", "KbdInteractiveAuthentication"}
    )
    if include_result != 0:
        return include_result
    previous = SSHD_ROOT_LOGIN_CONFIG_PATH.read_text(encoding="utf-8") if SSHD_ROOT_LOGIN_CONFIG_PATH.exists() else None
    tmp_target = SSHD_ROOT_LOGIN_CONFIG_PATH.with_suffix(".conf.tmp")
    tmp_target.write_text(_root_ssh_config(enabled), encoding="utf-8")
    os.chmod(tmp_target, 0o644)
    tmp_target.replace(SSHD_ROOT_LOGIN_CONFIG_PATH)
    validation = _validate_sshd_config()
    print(validation.stdout, end="")
    print(validation.stderr, end="", file=sys.stderr)
    if validation.returncode != 0:
        if previous is None:
            SSHD_ROOT_LOGIN_CONFIG_PATH.unlink(missing_ok=True)
        else:
            SSHD_ROOT_LOGIN_CONFIG_PATH.write_text(previous, encoding="utf-8")
            os.chmod(SSHD_ROOT_LOGIN_CONFIG_PATH, 0o644)
        return validation.returncode
    restart = _run(["systemctl", "restart", "sshd"])
    print(restart.stdout, end="")
    print(restart.stderr, end="", file=sys.stderr)
    return restart.returncode


def _configure_web_terminal(enabled: bool) -> int:
    """Perform configure web terminal.

    Args:
        enabled: Whether the associated resource or behavior is enabled.
    """
    SSHD_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    include_result = _ensure_sshd_dropin_include()
    if include_result != 0:
        return include_result
    previous = SSHD_WEB_TERMINAL_CONFIG_PATH.read_text(encoding="utf-8") if SSHD_WEB_TERMINAL_CONFIG_PATH.exists() else None
    if enabled:
        WEB_TERMINAL_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        os.chmod(WEB_TERMINAL_CONFIG_DIR, 0o755)
        ssh_keygen = shutil.which("ssh-keygen")
        if ssh_keygen is None:
            print("ssh-keygen command not found", file=sys.stderr)
            return 127
        if not WEB_TERMINAL_CA_KEY_PATH.exists():
            generated = _run([ssh_keygen, "-q", "-t", "ed25519", "-N", "", "-C", "Atlaso web terminal CA", "-f", str(WEB_TERMINAL_CA_KEY_PATH)])
            if generated.returncode != 0:
                print(generated.stderr or generated.stdout, end="", file=sys.stderr)
                return generated.returncode
        os.chmod(WEB_TERMINAL_CA_KEY_PATH, 0o600)
        os.chmod(WEB_TERMINAL_CA_PUBLIC_KEY_PATH, 0o644)
        SSHD_WEB_TERMINAL_CONFIG_PATH.write_text(
            "# Managed by Atlaso. Passwordless browser terminal certificates.\n"
            f"TrustedUserCAKeys {WEB_TERMINAL_CA_PUBLIC_KEY_PATH}\n",
            encoding="utf-8",
        )
        os.chmod(SSHD_WEB_TERMINAL_CONFIG_PATH, 0o644)
        WEB_TERMINAL_REQUEST_DIR.mkdir(parents=True, exist_ok=True)
        service_account = pwd.getpwnam(ATLASO_SERVICE_USER)
        _chown_path(WEB_TERMINAL_RUNTIME_DIR, service_account.pw_uid, service_account.pw_gid)
        _chown_path(WEB_TERMINAL_REQUEST_DIR, service_account.pw_uid, service_account.pw_gid)
        os.chmod(WEB_TERMINAL_RUNTIME_DIR, 0o750)
        os.chmod(WEB_TERMINAL_REQUEST_DIR, 0o750)
    else:
        SSHD_WEB_TERMINAL_CONFIG_PATH.unlink(missing_ok=True)
    validation = _validate_sshd_config()
    if validation.returncode != 0:
        if previous is None:
            SSHD_WEB_TERMINAL_CONFIG_PATH.unlink(missing_ok=True)
        else:
            SSHD_WEB_TERMINAL_CONFIG_PATH.write_text(previous, encoding="utf-8")
            os.chmod(SSHD_WEB_TERMINAL_CONFIG_PATH, 0o644)
        print(validation.stderr or validation.stdout, end="", file=sys.stderr)
        return validation.returncode
    restart = _run(["systemctl", "restart", "sshd"])
    print(restart.stdout, end="")
    print(restart.stderr, end="", file=sys.stderr)
    return restart.returncode


def _validate_web_terminal_request_path(path_value: str) -> Path:
    """Validate web terminal request path.

    Args:
        path_value: Candidate path value to validate.
    """
    path = Path(_validate_path(path_value)).resolve()
    if path.suffix != ".json" or not path.is_relative_to(WEB_TERMINAL_REQUEST_DIR):
        raise ValueError(f"web terminal request must be JSON staged under {WEB_TERMINAL_REQUEST_DIR}")
    if not path.is_file():
        raise ValueError(f"web terminal request does not exist: {path}")
    return path


def _handle_web_terminal(action: str, args: list[str]) -> int:
    """Handle web terminal.

    Args:
        action: Action consumed by handle web terminal.
        args: Parsed command-line options consumed by the operation.
    """
    if action == "status":
        if args:
            return 2
        print(json.dumps({"enabled": SSHD_WEB_TERMINAL_CONFIG_PATH.is_file() and WEB_TERMINAL_CA_KEY_PATH.is_file()}, sort_keys=True))
        return 0
    if action != "sign" or len(args) != 1:
        print("web-terminal sign requires one staged request path", file=sys.stderr)
        return 2
    if not SSHD_WEB_TERMINAL_CONFIG_PATH.is_file() or not WEB_TERMINAL_CA_KEY_PATH.is_file():
        print("web terminal is not applied", file=sys.stderr)
        return 2
    try:
        request_path = _validate_web_terminal_request_path(args[0])
        payload = json.loads(request_path.read_text(encoding="utf-8"))
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    username = str(payload.get("username") or "").strip().lower()
    session_id = str(payload.get("session_id") or "").strip()
    public_key = str(payload.get("public_key") or "").strip()
    if not LOCAL_USERS_USERNAME_PATTERN.fullmatch(username) or username in LOCAL_USERS_RESERVED_USERNAMES:
        print("web terminal username is not allowed", file=sys.stderr)
        return 2
    if not re.fullmatch(r"ssh-ed25519 [A-Za-z0-9+/=]+(?: [^\r\n]+)?", public_key):
        print("web terminal public key must be an OpenSSH Ed25519 key", file=sys.stderr)
        return 2
    if not re.fullmatch(r"[A-Za-z0-9_-]{8,80}", session_id):
        print("web terminal session id is invalid", file=sys.stderr)
        return 2
    try:
        account = pwd.getpwnam(username)
    except KeyError:
        print("web terminal user must exist", file=sys.stderr)
        return 2
    if account.pw_shell not in LOCAL_USERS_ALLOWED_SHELLS - {"/sbin/nologin"}:
        print("web terminal user must have an interactive shell", file=sys.stderr)
        return 2
    ssh_keygen = shutil.which("ssh-keygen")
    if ssh_keygen is None:
        print("ssh-keygen command not found", file=sys.stderr)
        return 127
    with tempfile.TemporaryDirectory(prefix="atlaso-web-terminal-") as temp_dir:
        public_path = Path(temp_dir) / "session.pub"
        public_path.write_text(public_key + "\n", encoding="utf-8")
        result = _run(
            [
                ssh_keygen, "-q", "-s", str(WEB_TERMINAL_CA_KEY_PATH), "-I", f"atlaso-{session_id}",
                "-n", username, "-V", "-5s:+60s", "-O", "source-address=127.0.0.1/32",
                "-O", "no-port-forwarding", "-O", "no-agent-forwarding", "-O", "no-x11-forwarding",
                "-O", "no-user-rc", str(public_path),
            ]
        )
        certificate_path = Path(temp_dir) / "session-cert.pub"
        if result.returncode != 0 or not certificate_path.is_file():
            print(result.stderr or result.stdout or "ssh-keygen did not issue a certificate", end="", file=sys.stderr)
            return result.returncode or 2
        print(certificate_path.read_text(encoding="utf-8").strip())
    request_path.unlink(missing_ok=True)
    return 0


def _apply_hostname(fqdn: str) -> int:
    """Perform apply hostname.

    Args:
        fqdn: Fqdn consumed by apply hostname.
    """
    hostnamectl = shutil.which("hostnamectl")
    if hostnamectl is not None:
        result = _run([hostnamectl, "set-hostname", fqdn])
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        return result.returncode

    hostname_path = Path("/etc/hostname")
    hostname_path.write_text(f"{fqdn}\n", encoding="utf-8")
    os.chmod(hostname_path, 0o644)
    hostname = shutil.which("hostname")
    if hostname is None:
        print("hostnamectl and hostname commands not found", file=sys.stderr)
        return 127
    result = _run([hostname, fqdn])
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def _configure_powercli_ceip(enabled: bool) -> tuple[int, str]:
    """Perform configure powercli ceip.

    Args:
        enabled: Whether the associated resource or behavior is enabled.
    """
    pwsh = shutil.which("pwsh")
    if pwsh is None:
        return 0, "skipped: PowerShell is not installed"
    enabled_literal = "$true" if enabled else "$false"
    script = (
        '$ErrorActionPreference = "Stop"; '
        '$module = Get-Module -Name VCF.PowerCLI -ListAvailable | Sort-Object Version -Descending | Select-Object -First 1; '
        "if (-not $module) { Write-Output 'VCF.PowerCLI is not installed'; exit 3 }; "
        'Import-Module $module.Path -Force; '
        f"Set-PowerCLIConfiguration -ParticipateInCeip {enabled_literal} -Scope AllUsers -Confirm:$false | Out-Null; "
        '$configured = Get-PowerCLIConfiguration -Scope AllUsers; '
        f"if ([bool]$configured.ParticipateInCEIP -ne {enabled_literal}) {{ throw 'PowerCLI CEIP verification failed' }}; "
        '$configured | Select-Object Scope,ParticipateInCEIP | ConvertTo-Json -Compress'
    )
    result = _run(
        [
            pwsh,
            "-NoLogo",
            "-NoProfile",
            "-NonInteractive",
            "-EncodedCommand",
            _powershell_encoded_command(script),
        ]
    )
    if result.returncode == 3 and "VCF.PowerCLI is not installed" in result.stdout:
        return 0, "skipped: VCF.PowerCLI is not installed"
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    if result.returncode != 0:
        return result.returncode, "failed"
    return 0, f"applied: AllUsers ParticipateInCEIP={'true' if enabled else 'false'}"


def _apply_vcf_download_tool_ceip(enabled: bool) -> tuple[int, str]:
    """Perform apply VCF download tool ceip.

    Args:
        enabled: Whether the associated resource or behavior is enabled.
    """
    tool_candidates = [
        VCF_DEPOT_RUNTIME_TOOL_DIR / "vcf-download-tool",
        VCF_DEPOT_RUNTIME_TOOL_DIR / "bin" / "vcf-download-tool",
    ]
    if not any(path.is_file() for path in tool_candidates):
        return 0, "skipped: VCF Download Tool is not installed"
    telemetry_path = VCF_DEPOT_RUNTIME_TOOL_DIR / "conf" / "telemetry" / "telemetry.flag"
    try:
        telemetry_path.parent.mkdir(parents=True, exist_ok=True)
        telemetry_path.write_text(
            f"obtu.telemetry.config={'ENABLE' if enabled else 'DISABLE'}\n",
            encoding="utf-8",
        )
        os.chmod(telemetry_path.parent, 0o750)
        os.chmod(telemetry_path, 0o600)
        try:
            account = pwd.getpwnam(ATLASO_SERVICE_USER)
        except KeyError:
            account = None
        if account is not None:
            _chown_path(telemetry_path.parent, account.pw_uid, account.pw_gid)
            _chown_path(telemetry_path, account.pw_uid, account.pw_gid)
    except OSError as exc:
        print(f"VCF Download Tool CEIP configuration failed: {exc}", file=sys.stderr)
        return 2, "failed"
    return 0, f"applied: obtu.telemetry.config={'ENABLE' if enabled else 'DISABLE'}"


def _validate_atlaso_service_dropin(text: str) -> subprocess.CompletedProcess[str]:
    """Validate a generated Atlaso service drop-in as a complete temporary unit.

    Args:
        text: Prospective systemd drop-in content.
    """
    systemd_analyze = shutil.which("systemd-analyze")
    if systemd_analyze is None:
        return subprocess.CompletedProcess(
            ["systemd-analyze", "verify"],
            127,
            "",
            "systemd-analyze command not found\n",
        )
    with tempfile.TemporaryDirectory(prefix="atlaso-systemd-preflight-") as temporary:
        unit_path = Path(temporary) / "atlaso-factory-reset-preflight.service"
        unit_path.write_text(
            "[Unit]\nDescription=Atlaso factory-reset preflight\n"
            "[Service]\nType=simple\nExecStart=/bin/true\n"
            + text,
            encoding="utf-8",
        )
        return _run([systemd_analyze, "verify", str(unit_path)])


def _preflight_appliance_settings(payload: dict) -> subprocess.CompletedProcess[str]:
    """Validate every generated appliance-settings artifact without host mutation.

    Args:
        payload: Parsed appliance-settings apply payload.
    """
    web_terminal_text = None
    if bool(payload.get("web_terminal_enabled")):
        web_terminal_text = (
            "# Managed by Atlaso. Passwordless browser terminal certificates.\n"
            f"TrustedUserCAKeys {WEB_TERMINAL_CA_PUBLIC_KEY_PATH}\n"
        )
    sshd = _validate_sshd_dropin_candidates(
        {
            SSHD_ROOT_LOGIN_CONFIG_PATH: _root_ssh_config(bool(payload.get("root_ssh_enabled"))),
            SSHD_WEB_TERMINAL_CONFIG_PATH: web_terminal_text,
        },
        unset_global_options={"PermitRootLogin", "PasswordAuthentication", "KbdInteractiveAuthentication"},
    )
    if sshd.returncode != 0:
        return sshd
    resolver_mode = str(payload["resolver_mode"])
    resolver_servers = [str(server) for server in payload["resolver_servers"]]
    resolver_domains = ["~."] if resolver_mode == "local_dns" else []
    if NETWORKD_MGMT_CONFIG_PATH.is_file():
        try:
            _management_resolver_candidate(
                NETWORKD_MGMT_CONFIG_PATH.read_text(encoding="utf-8"),
                resolver_servers,
                resolver_domains,
            )
        except (OSError, ValueError) as exc:
            return subprocess.CompletedProcess(
                ["networkd", "preflight"],
                2,
                "",
                f"{exc}\n",
            )
    cert_path: Path | None = None
    key_path: Path | None = None
    if bool(payload.get("management_https_enabled")):
        try:
            cert_path = _ca_managed_path(str(payload["management_https_cert_path"]), "management_https_cert_path")
            key_path = _ca_managed_path(str(payload["management_https_key_path"]), "management_https_key_path")
        except ValueError as exc:
            return subprocess.CompletedProcess(["nginx", "preflight"], 2, "", f"{exc}\n")
    nginx = _validate_nginx_site_candidate(
        NGINX_MANAGEMENT_SITE_PATH,
        _management_nginx_config(payload, cert_path, key_path),
    )
    if nginx.returncode != 0:
        return nginx
    return _validate_atlaso_service_dropin(
        _atlaso_service_loopback_dropin(
            str(payload.get("management_upstream_host") or "127.0.0.1"),
            int(payload.get("management_upstream_port") or payload.get("management_http_port") or 8000),
        )
    )


def _handle_appliance_settings(action: str, args: list[str]) -> int:
    """Handle appliance settings.

    Args:
        action: Action consumed by handle appliance settings.
        args: Parsed command-line options consumed by the operation.
    """
    if len(args) != 1:
        print(f"appliance-settings {action} requires exactly one staged JSON config path", file=sys.stderr)
        return 2
    try:
        config_path = _validate_appliance_settings_config_path(args[0])
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    errors = _appliance_settings_config_errors(config_path)
    if action == "validate":
        if errors:
            for error in errors:
                print(error, file=sys.stderr)
            return 2
        payload = _load_appliance_settings_config(config_path)
        print(
            json.dumps(
                {
                    "appliance_settings": "validation ok",
                    "resolver_mode": payload["resolver_mode"],
                    "management_https_enabled": bool(payload.get("management_https_enabled")),
                    "web_terminal_enabled": bool(payload.get("web_terminal_enabled")),
                    "root_ssh_enabled": bool(payload.get("root_ssh_enabled")),
                    "vmware_ceip_enabled": bool(payload.get("vmware_ceip_enabled")),
                    "management_interface": payload["management_interface"],
                    "scope": "systemd-resolved, Atlaso management UI, root SSH login, web terminal trust, and VMware CEIP",
                },
                sort_keys=True,
            )
        )
        return 0
    if action == "preflight":
        if errors:
            for error in errors:
                print(error, file=sys.stderr)
            return 2
        result = _preflight_appliance_settings(_load_appliance_settings_config(config_path))
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        return result.returncode
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 2

    payload = _load_appliance_settings_config(config_path)
    fqdn = str(payload["fqdn"])
    management_interface = str(payload["management_interface"])
    resolver_mode = str(payload["resolver_mode"])
    resolver_servers = [str(server) for server in payload["resolver_servers"]]
    domains = ["~."] if resolver_mode == "local_dns" else []
    hostname = _apply_hostname(fqdn)
    if hostname != 0:
        return hostname
    resolver = _configure_dhcp_resolver(management_interface) if resolver_mode == "dhcp" else _configure_resolver(management_interface, resolver_servers, domains)
    if resolver.returncode != 0:
        return resolver.returncode
    root_ssh = _configure_root_ssh(bool(payload.get("root_ssh_enabled")))
    if root_ssh != 0:
        return root_ssh
    web_terminal = _configure_web_terminal(bool(payload.get("web_terminal_enabled")))
    if web_terminal != 0:
        return web_terminal
    vmware_ceip_enabled = bool(payload.get("vmware_ceip_enabled"))
    powercli_ceip, powercli_ceip_status = _configure_powercli_ceip(vmware_ceip_enabled)
    if powercli_ceip != 0:
        return powercli_ceip
    vcfdt_ceip, vcfdt_ceip_status = _apply_vcf_download_tool_ceip(vmware_ceip_enabled)
    if vcfdt_ceip != 0:
        return vcfdt_ceip
    management_https, management_restart_delay_seconds = _configure_atlaso_management_https(payload)
    if management_https != 0:
        return management_https
    result_payload = {
        "appliance_settings": "apply complete",
        "fqdn": fqdn,
        "management_https_enabled": bool(payload.get("management_https_enabled")),
        "root_ssh_enabled": bool(payload.get("root_ssh_enabled")),
        "web_terminal_enabled": bool(payload.get("web_terminal_enabled")),
        "web_terminal_interfaces": payload.get("web_terminal_interfaces") or [],
        "vmware_ceip_enabled": vmware_ceip_enabled,
        "vmware_ceip_products": {
            "vcf_powercli": powercli_ceip_status,
            "vcf_download_tool": vcfdt_ceip_status,
        },
        "resolver_mode": resolver_mode,
        "resolver_servers": resolver_servers,
    }
    if management_restart_delay_seconds is not None:
        result_payload["management_status_transition"] = {
            "kind": "planned_service_restart",
            "restart_delay_seconds": management_restart_delay_seconds,
        }
    print(
        json.dumps(result_payload, sort_keys=True)
    )
    return 0


def _validate_local_users_config_path(path_value: str) -> Path:
    """Validate local users config path.

    Args:
        path_value: Candidate path value to validate.
    """
    path = Path(_validate_path(path_value)).resolve()
    if path.suffix != ".json":
        raise ValueError("local users config path must end with .json")
    if not path.is_relative_to(LOCAL_USERS_APPLY_DIR):
        raise ValueError(f"local users config must be staged under {LOCAL_USERS_APPLY_DIR}")
    if not path.is_file():
        raise ValueError(f"local users config does not exist: {path}")
    return path


def _load_local_users_config(path: Path) -> dict:
    """Load local users config.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    with path.open("r", encoding="utf-8") as handle:
        payload = json.load(handle)
    if not isinstance(payload, dict):
        raise ValueError("local users config must be a JSON object")
    return payload


def _local_user_home(username: str) -> str:
    """Perform local user home.

    Args:
        username: Atlaso account name associated with the operation.
    """
    return (LOCAL_USERS_HOME_BASE / username).as_posix()


def _managed_local_usernames() -> list[str]:
    """Return Atlaso-managed usernames from the root-owned OS account inventory."""
    usernames: list[str] = []
    for account in pwd.getpwall():
        username = str(getattr(account, "pw_name", "") or "").strip().lower()
        home = str(getattr(account, "pw_dir", "") or "").strip()
        if home != _local_user_home(username):
            continue
        if not LOCAL_USERS_USERNAME_PATTERN.fullmatch(username) or username in LOCAL_USERS_RESERVED_USERNAMES:
            raise ValueError(f"local users operating-system inventory entry is unsafe: {username}")
        usernames.append(username)
    return sorted(set(usernames))


def _local_user_password_policy_errors(password: str, username: str, policy: dict) -> list[str]:
    """Perform local user password policy errors.

    Args:
        password: Password consumed by local user password policy errors.
        username: Atlaso account name associated with the operation.
        policy: Policy consumed by local user password policy errors.
    """
    errors: list[str] = []
    try:
        min_length = int(policy.get("min_length", 12))
    except (TypeError, ValueError):
        min_length = 12
    if len(password) < min_length:
        errors.append(f"local user {username} password must be at least {min_length} characters.")
    if policy.get("require_uppercase", True) and not any(character.isupper() for character in password):
        errors.append(f"local user {username} password must include an uppercase letter.")
    if policy.get("require_lowercase", True) and not any(character.islower() for character in password):
        errors.append(f"local user {username} password must include a lowercase letter.")
    if policy.get("require_number", True) and not any(character.isdigit() for character in password):
        errors.append(f"local user {username} password must include a number.")
    if policy.get("require_special", True) and not any(not character.isalnum() for character in password):
        errors.append(f"local user {username} password must include a special character.")
    normalized_username = username.strip().lower()
    if policy.get("disallow_username", True) and normalized_username and normalized_username in password.lower():
        errors.append(f"local user {username} password must not contain the username.")
    return errors


def _local_users_config_errors(path: Path) -> list[str]:
    """Perform local users config errors.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    errors: list[str] = []
    try:
        payload = _load_local_users_config(path)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        return [str(exc)]
    if payload.get("managed_by") != "Atlaso":
        errors.append("local users config must be rendered by Atlaso.")
    if payload.get("version") != 1:
        errors.append("local users config version must be 1.")
    policy = payload.get("password_policy", {})
    if policy and not isinstance(policy, dict):
        errors.append("local users password_policy must be an object.")
        policy = {}
    if isinstance(policy, dict):
        try:
            min_length = int(policy.get("min_length", 12))
        except (TypeError, ValueError):
            errors.append("local users password_policy min_length must be a number.")
        else:
            if min_length < 8 or min_length > 128:
                errors.append("local users password_policy min_length must be between 8 and 128.")
        for key in ("require_uppercase", "require_lowercase", "require_number", "require_special", "disallow_username"):
            if key in policy and not isinstance(policy.get(key), bool):
                errors.append(f"local users password_policy {key} must be true or false.")
    removed_users = payload.get("removed_users", [])
    if not isinstance(removed_users, list):
        errors.append("local users removed_users must be a list.")
    else:
        for index, removed_username in enumerate(removed_users):
            username = str(removed_username or "").strip().lower()
            if not LOCAL_USERS_USERNAME_PATTERN.fullmatch(username):
                errors.append(f"removed local user {username or index} is not a valid Photon OS username.")
            if username in LOCAL_USERS_RESERVED_USERNAMES:
                errors.append(f"removed local user {username} is reserved by Photon OS or Atlaso.")
    users = payload.get("users")
    if not isinstance(users, list):
        return [*errors, "local users config requires a users list."]
    seen: set[str] = set()
    for index, row in enumerate(users):
        if not isinstance(row, dict):
            errors.append(f"local user row {index} must be an object.")
            continue
        username = str(row.get("username") or "").strip().lower()
        if username in seen:
            errors.append(f"duplicate local user {username}.")
        seen.add(username)
        if not LOCAL_USERS_USERNAME_PATTERN.fullmatch(username):
            errors.append(f"local user {username or index} is not a valid Photon OS username.")
        if username in LOCAL_USERS_RESERVED_USERNAMES:
            errors.append(f"local user {username} is reserved by Photon OS or Atlaso.")
        if row.get("home") != _local_user_home(username):
            errors.append(f"local user {username} home must be {_local_user_home(username)}.")
        shell = str(row.get("shell") or "").strip()
        if shell not in LOCAL_USERS_ALLOWED_SHELLS:
            errors.append(f"local user {username} shell must be one of {', '.join(sorted(LOCAL_USERS_ALLOWED_SHELLS))}.")
        if not isinstance(row.get("enabled"), bool):
            errors.append(f"local user {username} enabled must be true or false.")
        password = row.get("password")
        if password is not None and (not isinstance(password, str) or not password):
            errors.append(f"local user {username} pending password must be a non-empty string when present.")
        elif isinstance(password, str):
            errors.extend(_local_user_password_policy_errors(password, username, policy))
        if "unlock_requested" in row and not isinstance(row.get("unlock_requested"), bool):
            errors.append(f"local user {username} unlock_requested must be true or false.")
    return errors


def _local_users_payload(path: Path) -> dict:
    """Perform local users payload.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    return _load_local_users_config(path)


def _command_path(command: str) -> str | None:
    """Perform command path.

    Args:
        command: Command and arguments to execute.
    """
    found = shutil.which(command)
    if found:
        return found
    fallback = f"/usr/sbin/{command}"
    if Path(fallback).exists():
        return fallback
    return None


def _os_user_exists(username: str) -> bool:
    """Perform operating-system user exists.

    Args:
        username: Atlaso account name associated with the operation.
    """
    id_command = _command_path("id")
    return id_command is not None and _run([id_command, username]).returncode == 0


def _run_and_forward(command: list[str], *, account_command: bool = True) -> int:
    """Run and forward.

    Args:
        command: Command and arguments to execute.
        account_command: Whether account command applies to the operation.
    """
    result = _run_account_command(command) if account_command else _run(command)
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def _ensure_os_user(username: str, home: str, shell: str) -> int:
    """Ensure operating-system user.

    Args:
        username: Atlaso account name associated with the operation.
        home: Home consumed by ensure operating-system user.
        shell: Shell consumed by ensure operating-system user.
    """
    id_command = _command_path("id")
    useradd = _command_path("useradd")
    if id_command is None:
        print("id command not found", file=sys.stderr)
        return 127
    if _os_user_exists(username):
        return 0
    if useradd is None:
        print("useradd command not found", file=sys.stderr)
        return 127
    LOCAL_USERS_HOME_BASE.mkdir(parents=True, exist_ok=True)
    return _run_and_forward([useradd, "--home-dir", home, "--create-home", "--shell", shell, username])


def _set_os_user_shell(username: str, shell: str) -> int:
    """Perform set operating-system user shell.

    Args:
        username: Atlaso account name associated with the operation.
        shell: Shell consumed by set operating-system user shell.
    """
    usermod = _command_path("usermod")
    if usermod is None:
        print("usermod command not found", file=sys.stderr)
        return 127
    return _run_and_forward([usermod, "--shell", shell, username])


def _ensure_os_user_role_groups(username: str, role: str) -> int:
    """Ensure operating-system user role groups.

    Args:
        username: Atlaso account name associated with the operation.
        role: Role consumed by ensure operating-system user role groups.
    """
    id_command = _command_path("id")
    if id_command is None:
        print("id command not found", file=sys.stderr)
        return 127
    usermod = _command_path("usermod")
    groups_result = _run([id_command, "-nG", username])
    if groups_result.returncode != 0:
        print(groups_result.stdout, end="")
        print(groups_result.stderr, end="", file=sys.stderr)
        return groups_result.returncode
    groups = set(groups_result.stdout.split())
    if role == "admin":
        if "wheel" in groups:
            return 0
        if usermod is None:
            print("usermod command not found", file=sys.stderr)
            return 127
        return _run_and_forward([usermod, "--append", "--groups", "wheel", username])
    if "wheel" not in groups:
        return 0
    gpasswd = _command_path("gpasswd")
    if gpasswd is None:
        print("gpasswd command not found", file=sys.stderr)
        return 127
    return _run_and_forward([gpasswd, "--delete", username, "wheel"])


def _unlock_os_user(username: str) -> int:
