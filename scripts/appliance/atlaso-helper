def _systemd_unit_logs(unit: str) -> int:
    """Perform systemd unit logs.

    Args:
        unit: Unit consumed by systemd unit logs.
    """
    journalctl = shutil.which("journalctl")
    if journalctl is None:
        print("journalctl command not found", file=sys.stderr)
        return 127
    result = _run([journalctl, "-u", unit, "-n", "500", "--no-pager", "--output=short-iso"])
    if result.stdout:
        print(result.stdout, end="" if result.stdout.endswith("\n") else "\n")
    if result.stderr:
        print(result.stderr, file=sys.stderr, end="" if result.stderr.endswith("\n") else "\n")
    return result.returncode


def _management_resolver_candidate(
    text: str,
    servers: list[str],
    domains: list[str],
) -> str:
    """Return networkd content with prospective resolver values.

    Args:
        text: Current generated networkd configuration.
        servers: Prospective resolver addresses.
        domains: Prospective route-only search domains.

    Returns:
        Updated networkd content used by factory-reset preflight.
    """
    lines = text.splitlines()
    updated: list[str] = []
    in_network = False
    inserted = False
    for line in lines:
        stripped = line.strip()
        if stripped == "[Network]":
            in_network = True
            updated.append(line)
            continue
        if in_network and stripped.startswith("[") and stripped.endswith("]"):
            if not inserted:
                updated.extend([f"DNS={server}" for server in servers])
                updated.extend([f"Domains={domain}" for domain in domains])
                inserted = True
            in_network = False
        if in_network and (stripped.startswith("DNS=") or stripped.startswith("Domains=")):
            continue
        updated.append(line)
    if in_network and not inserted:
        updated.extend([f"DNS={server}" for server in servers])
        updated.extend([f"Domains={domain}" for domain in domains])
        inserted = True
    if not inserted:
        raise ValueError("management networkd config is missing a [Network] section")
    return "\n".join(updated).rstrip() + "\n"


def _management_resolver_network_path(interface_name: str) -> Path | None:
    """Return the generated networkd file for the effective resolver link.

    Args:
        interface_name: Host network-interface name affected by the operation.

    Returns:
        The matching generated networkd path, when it exists.
    """
    candidates = [
        *sorted(NETWORKD_CONFIG_DIR.glob(f"{MANAGEMENT_HANDOFF_HOLDOVER_PREFIX}*.network")),
        NETWORKD_MGMT_CONFIG_PATH,
        NETWORKD_CONFIG_DIR / _networkd_managed_filename(interface_name, "network"),
    ]
    for path in candidates:
        if not path.is_file():
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        if re.search(rf"(?m)^Name={re.escape(interface_name)}\s*$", text):
            return path
    return None


def _write_management_resolver(
    interface_name: str,
    servers: list[str],
    domains: list[str],
) -> None:
    """Write management resolver.

    Args:
        interface_name: Host network-interface name affected by the operation.
