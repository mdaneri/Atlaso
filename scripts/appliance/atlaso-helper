    return str(ATLASO_VENV_PYTHON_PATH if ATLASO_VENV_PYTHON_PATH.exists() else sys.executable)


def _command_payload(
    command: list[str], *, success_codes: set[int] | None = None, env: dict[str, str] | None = None
) -> dict:
    """Perform command payload.

    Args:
        command: Command and arguments to execute.
        success_codes: Success codes consumed by command payload.
        env: Environment variables supplied to the child process.
    """
    result = _run(command, env=env) if env is not None else _run(command)
    success_codes = success_codes or {0}
    stdout = result.stdout[-4000:]
    stderr = result.stderr[-4000:]
    if env:
        sensitive_values = [str(env.get("LF_REPO_USER") or ""), str(env.get("LF_REPO_SECRET") or "")]
        for key in ("PIP_INDEX_URL", "PIP_EXTRA_INDEX_URL"):
            for value in str(env.get(key) or "").split():
                parsed = urlparse(value)
                sensitive_values.extend([value, unquote(parsed.username or ""), unquote(parsed.password or "")])
        for value in sorted({value for value in sensitive_values if value}, key=len, reverse=True):
            stdout = stdout.replace(value, "[redacted]")
            stderr = stderr.replace(value, "[redacted]")
    return {
        "command": command,
        "returncode": result.returncode,
        "success": result.returncode in success_codes,
        "stdout": stdout,
        "stderr": stderr,
    }


def _url_origin(url: str) -> tuple[str, str, int | None]:
    """Perform URL origin.

    Args:
        url: URL contacted or emitted by the operation.
    """
    parsed = urlparse(url)
    port = parsed.port
    if port is None:
        port = 443 if parsed.scheme.lower() == "https" else 80 if parsed.scheme.lower() == "http" else None
    return parsed.scheme.lower(), (parsed.hostname or "").lower(), port


class _UpdateRedirectHandler(HTTPRedirectHandler):
    def __init__(self, *, authenticated_origin: tuple[str, str, int | None] | None) -> None:
        """Perform init.

        Args:
            authenticated_origin: Authenticated origin consumed by init.
        """
        super().__init__()
        self.authenticated_origin = authenticated_origin

    def redirect_request(self, req, fp, code, msg, headers, newurl):  # type: ignore[no-untyped-def]  # urllib defines this compatibility hook without a typed parameter contract.
        """Perform redirect request.

        Args:
            req: Req consumed by redirect request.
            fp: Fp consumed by redirect request.
            code: Code consumed by redirect request.
            msg: Msg consumed by redirect request.
            headers: Headers consumed by redirect request.
            newurl: Newurl consumed by redirect request.
        """
        redirect_url = urljoin(req.full_url, newurl)
        source_origin = _url_origin(req.full_url)
        target_origin = _url_origin(redirect_url)
        if source_origin[0] == "https" and target_origin[0] != "https":
            raise ValueError("update downloads cannot redirect from HTTPS to a less secure scheme")
        if self.authenticated_origin is not None and target_origin != self.authenticated_origin:
            raise ValueError("authenticated update downloads cannot redirect to another origin")
        return super().redirect_request(req, fp, code, msg, headers, redirect_url)


def _fetch_http_bytes(url: str, credential: dict[str, str] | None = None) -> bytes:
    """Perform fetch HTTP bytes.

    Args:
        url: URL contacted or emitted by the operation.
        credential: Credential consumed by fetch HTTP bytes.
    """
    parsed = urlparse(url)
    if parsed.scheme not in {"http", "https"} or not parsed.netloc:
        raise ValueError(f"unsupported update URL: {url}")
    request: str | Request = url
    authenticated_origin: tuple[str, str, int | None] | None = None
    if credential and str(credential.get("secret") or ""):
        token = base64.b64encode(
            f"{credential.get('username', '')}:{credential['secret']}".encode("utf-8")
        ).decode("ascii")
        request = Request(url, headers={"Authorization": f"Basic {token}"})
        authenticated_origin = _url_origin(url)
    opener = build_opener(_UpdateRedirectHandler(authenticated_origin=authenticated_origin))
    with opener.open(request, timeout=60) as response:
        return response.read()


def _source_credential(source: dict, credentials: dict[str, dict[str, str]]) -> dict[str, str] | None:
