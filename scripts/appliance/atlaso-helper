def _sha256_file(path: Path) -> str:
    """Perform sha256 file.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    with path.open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


