def _run_default_gateway_route_replace(gateway: str, interface_name: str, table_id: int | None = None) -> int:
    """Run default gateway route replace.

    Args:
        gateway: Gateway consumed by run default gateway route replace.
        interface_name: Host network-interface name affected by the operation.
        table_id: Stable identifier of the associated table resource.
    """
    try:
        gateway_address = ip_address(gateway)
    except ValueError:
        print(f"invalid gateway for {interface_name}: {gateway}", file=sys.stderr)
        return 2
    prefix = ["ip", "-6", "route"] if gateway_address.version == 6 else ["ip", "route"]
    command = [*prefix, "replace", "default", "via", gateway, "dev", interface_name]
    if table_id is not None:
        command.extend(["table", str(table_id)])
    result = _run(command)
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def _run_default_gateway_route_delete(interface_name: str, table_id: int | None, version: int) -> int:
    """Run default gateway route delete.

    Args:
        interface_name: Host network-interface name affected by the operation.
        table_id: Stable identifier of the associated table resource.
        version: Atlaso or artifact version being validated or produced.
    """
    prefix = ["ip", "-6", "route"] if version == 6 else ["ip", "route"]
    command = [*prefix, "del", "default", "dev", interface_name]
    if table_id is not None:
        command.extend(["table", str(table_id)])
    result = _run(command)
    if result.returncode == 2:
        return 0
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def _runtime_default_gateways_for_interface(interface_name: str) -> list[str]:
    """Perform runtime default gateways for interface.

    Args:
        interface_name: Host network-interface name affected by the operation.
    """
    gateways: list[str] = []
    for prefix in (["ip", "route"], ["ip", "-6", "route"]):
        try:
            result = _run([*prefix, "show", "default", "dev", interface_name])
        except OSError:
            continue
        if result.returncode != 0:
            continue
        for line in result.stdout.splitlines():
            parts = line.split()
            if parts[:1] == ["default"] and "via" in parts:
                gateway = parts[parts.index("via") + 1]
                if gateway not in gateways:
                    gateways.append(gateway)
    return gateways


def _management_default_gateways_for_target(target: dict[str, str]) -> list[str]:
    """Perform management default gateways for target.

    Args:
        target: Target resource or location affected by the operation.
    """
    target_networks = _target_networks(target)
    if "gateway" in target or "ipv6_gateway" in target:
        configured = [target.get(key, "").strip() for key in ("gateway", "ipv6_gateway")]
        return _usable_management_default_gateways(target_networks, [gateway for gateway in configured if gateway])
    candidates: list[str] = []
    interface_name = target.get("name", "")
    preserved = _read_existing_management_network_values()
    management_names = set(preserved.get("Name", []))
    if not management_names or interface_name in management_names:
        candidates.extend(preserved.get("Gateway", []))
    candidates.extend(_runtime_default_gateways_for_interface(interface_name))
    return _usable_management_default_gateways(target_networks, candidates)


def _apply_wan_target_routes(parsed: dict[str, list[dict[str, str]]]) -> int:
    """Perform apply WAN target routes.

    Args:
        parsed: Parsed consumed by apply WAN target routes.
    """
    if shutil.which("ip") is None:
        print("ip command not found", file=sys.stderr)
        return 127
    targets = parsed["targets"]
    routing_enabled = _wan_feature_settings(parsed)["routing_enabled"]
    network_owners = _target_network_owners(targets)
    for index, target in enumerate(targets):
        table_id = _target_route_table_id(target)
        interface_name = target.get("name", "")
        management = target.get("routing_domain", "lab") == "management"
        if not management and not routing_enabled:
            for network in _target_networks(target):
                result = _run_target_route_delete(network, interface_name, table_id)
                if result != 0:
                    return result
            continue
        gateways = _management_default_gateways_for_target(target) if management else []
        gateways_by_version = {ip_address(gateway).version: gateway for gateway in gateways}
        for network in _target_networks(target):
            if network_owners[network] != index:
                result = _run_target_route_delete(network, interface_name, table_id)
                if result != 0:
                    return result
                continue
            network_version = ip_network(network, strict=False).version
            if management and network_version not in gateways_by_version:
                result = _run_target_route_delete(network, interface_name, table_id)
                if result != 0:
                    return result
                continue
            result = _run_target_route_replace(network, interface_name, table_id)
            if result != 0:
                return result
        if management:
            network_versions = {ip_network(network, strict=False).version for network in _target_networks(target)}
            for version in network_versions:
                gateway = gateways_by_version.get(version)
                if gateway is None:
                    result = _run_default_gateway_route_delete(interface_name, table_id, version)
                    if result != 0:
                        return result
                    continue
                result = _run_default_gateway_route_replace(gateway, interface_name, table_id)
                if result != 0:
                    return result
            for gateway in gateways_by_version.values():
                result = _run_default_gateway_route_replace(gateway, interface_name)
                if result != 0:
                    return result
            if (
                "gateway" in target
                and not target.get("gateway", "").strip()
                and target.get("ipv4_method", "static").strip().lower() == "static"
            ):
                result = _run_default_gateway_route_delete(interface_name, None, 4)
                if result != 0:
                    return result
            if "ipv6_gateway" in target and not target.get("ipv6_gateway", "").strip() and target.get("ipv6_cidr", "").strip():
                result = _run_default_gateway_route_delete(interface_name, None, 6)
                if result != 0:
                    return result
    return 0


def _run_rule_replace(source_network: str, table_id: int, priority: int) -> int:
    """Run rule replace.

    Args:
        source_network: Source network consumed by run rule replace.
        table_id: Stable identifier of the associated table resource.
        priority: Priority consumed by run rule replace.
    """
    prefix = _rule_command_prefix(source_network)
    delete = _run([*prefix, "del", "priority", str(priority)])
    if delete.returncode not in {0, 2}:
        print(delete.stdout, end="")
        print(delete.stderr, end="", file=sys.stderr)
        return delete.returncode
    add = _run([*prefix, "add", "from", source_network, "table", str(table_id), "priority", str(priority)])
    print(add.stdout, end="")
    print(add.stderr, end="", file=sys.stderr)
    return add.returncode


def _run_rule_priority_delete(prefix: list[str], priority: int) -> int:
    """Run rule priority delete.

    Args:
        prefix: Prefix consumed by run rule priority delete.
        priority: Priority consumed by run rule priority delete.
    """
    result = _run([*prefix, "del", "priority", str(priority)])
    if result.returncode in {0, 2}:
        return 0
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def _cleanup_wan_policy_rules() -> int:
    """Perform cleanup WAN policy rules.

    """
    prefixes = [["ip", "rule"], ["ip", "-6", "rule"]]
    for base_priority in (MANAGEMENT_ROUTE_RULE_PRIORITY, LAB_ROUTE_RULE_PRIORITY):
        for priority in range(base_priority, base_priority + ROUTE_RULE_PRIORITY_WINDOW):
            for prefix in prefixes:
                result = _run_rule_priority_delete(prefix, priority)
                if result != 0:
                    return result
    return 0


def _apply_wan_policy_rules(parsed: dict[str, list[dict[str, str]]]) -> int:
    """Perform apply WAN policy rules.

    Args:
        parsed: Parsed consumed by apply WAN policy rules.
    """
    if shutil.which("ip") is None:
        print("ip command not found", file=sys.stderr)
        return 127
    cleanup_result = _cleanup_wan_policy_rules()
    if cleanup_result != 0:
        return cleanup_result
    targets = parsed["targets"]
    routing_enabled = _wan_feature_settings(parsed)["routing_enabled"]
    network_owners = _target_network_owners(targets)
    for index, target in enumerate(targets):
        domain = target.get("routing_domain", "lab")
        if domain != "management" and not routing_enabled:
            continue
        table_id = _target_route_table_id(target)
        base_priority = MANAGEMENT_ROUTE_RULE_PRIORITY if domain == "management" else LAB_ROUTE_RULE_PRIORITY
        management_gateway_versions = (
            {ip_address(gateway).version for gateway in _management_default_gateways_for_target(target)}
            if domain == "management"
            else set()
        )
        for source_network in _target_networks(target):
            if network_owners[source_network] != index:
                continue
            if domain == "management" and ip_network(source_network, strict=False).version not in management_gateway_versions:
                continue
            result = _run_rule_replace(source_network, table_id, base_priority + index)
            if result != 0:
                return result
    return 0


def _run_route_delete(destination: str, interface_name: str) -> int:
    """Run route delete.

    Args:
        destination: Destination object or location receiving the result.
        interface_name: Host network-interface name affected by the operation.
    """
    command = [*_route_command_prefix(destination), "del", destination, "dev", interface_name, "table", str(LAB_ROUTE_TABLE_ID)]
    result = _run(command)
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    if result.returncode == 2:
        return 0
    return result.returncode


def _mirrored_wan_default_keys(
    parsed: dict[str, list[dict[str, str]]] | None,
) -> set[tuple[str, str]]:
    """Return defaults previously mirrored into the host main table.

    Args:
        parsed: Parsed last-applied Routes & WAN configuration, when available.
    """
    if not parsed:
        return set()
    targets = {target.get("name", ""): target for target in parsed["targets"]}
    mirrored: set[tuple[str, str]] = set()
    for route in parsed["routes"]:
        if not _wan_bool(route.get("enabled", ""), default=True):
            continue
        interface_name = route.get("interface", "")
        if not _wan_bool(
            targets.get(interface_name, {}).get("management_ui", "false")
        ):
            continue
        try:
            destination = ip_network(route["destination_cidr"], strict=False)
        except (KeyError, ValueError):
            continue
        if destination.prefixlen == 0:
            mirrored.add((str(destination), interface_name))
    return mirrored


def _apply_wan_routes_and_qdiscs(
    parsed: dict[str, list[dict[str, str]]],
    previous_parsed: dict[str, list[dict[str, str]]] | None = None,
) -> int:
    """Perform apply WAN routes and qdiscs.

    Args:
        parsed: Parsed consumed by apply WAN routes and qdiscs.
        previous_parsed: Parsed last-applied state used to retire host defaults.
    """
    if shutil.which("ip") is None:
        print("ip command not found", file=sys.stderr)
        return 127
    if shutil.which("tc") is None:
        print("tc command not found", file=sys.stderr)
        return 127
    targets = {target.get("name", ""): target for target in parsed["targets"]}
    feature_settings = _wan_feature_settings(parsed)
    routing_enabled = feature_settings["routing_enabled"]
    wan_simulation_enabled = feature_settings["wan_simulation_enabled"]
    previously_mirrored_defaults = _mirrored_wan_default_keys(previous_parsed)
    policies = {policy["name"]: policy for policy in parsed["wan_policies"]}
    touched_qdisc_targets: set[str] = set()
    for route in parsed["routes"]:
        destination = route["destination_cidr"]
        interface_name = route["interface"]
        try:
            destination_network = ip_network(destination, strict=False)
        except ValueError:
            destination_network = None
        management_ui_default = bool(
            destination_network is not None
            and destination_network.prefixlen == 0
            and _wan_bool(
                targets.get(interface_name, {}).get("management_ui", "false")
            )
        )
        previously_mirrored_default = (
            str(destination_network),
            interface_name,
        ) in previously_mirrored_defaults if destination_network is not None else False
        saved_enabled = _wan_bool(route.get("enabled", ""), default=True)
        enabled = saved_enabled and routing_enabled
        if not enabled:
            # A disabled feature may preserve an enabled route whose target is
            # omitted from current intent. Skip a genuinely absent link, whose
            # routes and qdisc vanished with it, but retain cleanup for a live
            # interface that merely became ineligible (for example, a trunk).
            if interface_name not in targets and not _link_exists(interface_name):
                continue
            delete_result = _run_route_delete(destination, interface_name)
            if delete_result != 0:
                return delete_result
            if not saved_enabled and (management_ui_default or previously_mirrored_default):
                main_delete = _run(
                    [*_route_command_prefix(destination), "del", destination, "dev", interface_name]
                )
                if main_delete.returncode not in {0, 2}:
                    return main_delete.returncode
            elif saved_enabled and management_ui_default:
                main_command = [*_route_command_prefix(destination), "replace", destination]
                if route.get("gateway"):
                    main_command.extend(["via", route["gateway"]])
                main_command.extend(
                    [
                        "dev",
                        interface_name,
                        "metric",
                        str(int(route.get("metric", "100") or "100")),
                    ]
                )
                main_result = _run(main_command)
                print(main_result.stdout, end="")
                print(main_result.stderr, end="", file=sys.stderr)
                if main_result.returncode != 0:
                    return main_result.returncode
            elif previously_mirrored_default:
                main_delete = _run(
                    [*_route_command_prefix(destination), "del", destination, "dev", interface_name]
                )
                if main_delete.returncode not in {0, 2}:
                    return main_delete.returncode
            touched_qdisc_targets.add(interface_name)
            continue
        command = [*_route_command_prefix(destination), "replace", destination]
        if route.get("gateway"):
            command.extend(["via", route["gateway"]])
        command.extend(["dev", interface_name, "metric", str(int(route.get("metric", "100") or "100")), "table", str(LAB_ROUTE_TABLE_ID)])
        result = _run(command)
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        if result.returncode != 0:
            return result.returncode
        if management_ui_default:
            main_command = command[:-2]
            main_result = _run(main_command)
            print(main_result.stdout, end="")
            print(main_result.stderr, end="", file=sys.stderr)
            if main_result.returncode != 0:
                return main_result.returncode
        elif previously_mirrored_default:
            main_delete = _run(
                [*_route_command_prefix(destination), "del", destination, "dev", interface_name]
            )
            if main_delete.returncode not in {0, 2}:
                return main_delete.returncode
        touched_qdisc_targets.add(interface_name)
    for route in parsed["removed_routes"]:
        delete_result = _run_route_delete(route["destination_cidr"], route["interface"])
        if delete_result != 0:
            return delete_result
        try:
            removed_destination = ip_network(route["destination_cidr"], strict=False)
        except ValueError:
            removed_destination = None
        removed_key = (
            str(removed_destination),
            route["interface"],
        ) if removed_destination is not None else ("", "")
        if (
            removed_destination is not None
            and removed_destination.prefixlen == 0
            and (
                _wan_bool(
                    targets.get(route["interface"], {}).get("management_ui", "false")
                )
                or removed_key in previously_mirrored_defaults
            )
        ):
            main_delete = _run(
                [
                    *_route_command_prefix(route["destination_cidr"]),
                    "del",
                    route["destination_cidr"],
                    "dev",
                    route["interface"],
                ]
            )
            if main_delete.returncode not in {0, 2}:
                return main_delete.returncode
        touched_qdisc_targets.add(route["interface"])
    for route in parsed["removed_main_defaults"]:
        command = [
            *_route_command_prefix(route["destination_cidr"]),
            "del",
            route["destination_cidr"],
        ]
        if route.get("gateway"):
            command.extend(["via", route["gateway"]])
        command.extend(["dev", route["interface"]])
        if route.get("metric"):
            command.extend(["metric", str(int(route["metric"]))])
        main_delete = _run(command)
        if main_delete.returncode not in {0, 2}:
            return main_delete.returncode
    policy_by_target: dict[str, dict[str, str]] = {}
    for route in parsed["routes"]:
        if not wan_simulation_enabled or not _wan_bool(
            route.get("enabled", ""), default=True
        ):
            continue
        policy_name = route.get("wan_policy", "")
        policy = policies.get(policy_name)
        if policy and _wan_bool(policy.get("enabled", ""), default=True):
            policy_by_target[route["interface"]] = policy
    for interface_name in sorted(touched_qdisc_targets | set(policy_by_target)):
        policy = policy_by_target.get(interface_name)
        if policy:
            command = ["tc", "qdisc", "replace", "dev", interface_name, "root", "netem", *_wan_netem_args(policy)]
        else:
            command = ["tc", "qdisc", "del", "dev", interface_name, "root"]
        result = _run(command)
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        if result.returncode != 0 and not (command[2] == "del" and result.returncode == 2):
            return result.returncode
    return 0


def _install_wan_runtime(config_path: Path) -> None:
    """Persist the applied WAN intent and install its boot replay unit.

    Args:
        config_path: Validated WAN configuration that reached runtime.
    """
    WAN_RUNTIME_CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    runtime_temporary = WAN_RUNTIME_CONFIG_PATH.with_suffix(".conf.tmp")
    runtime_temporary.write_text(config_path.read_text(encoding="utf-8"), encoding="utf-8")
    os.chmod(runtime_temporary, 0o644)
    runtime_temporary.replace(WAN_RUNTIME_CONFIG_PATH)
    WAN_SERVICE_PATH.write_text(
        "\n".join(
            [
                "[Unit]",
                "Description=Atlaso Routes and WAN runtime",
                "After=network-online.target",
                "Wants=network-online.target",
                "",
                "[Service]",
                "Type=oneshot",
                f"ExecStart=/opt/atlaso/bin/atlaso-helper wan restore --real {WAN_RUNTIME_CONFIG_PATH}",
                "RemainAfterExit=yes",
                "",
                "[Install]",
                "WantedBy=multi-user.target",
                "",
            ]
        ),
        encoding="utf-8",
    )
    os.chmod(WAN_SERVICE_PATH, 0o644)
    _fsync_file(WAN_RUNTIME_CONFIG_PATH)
    _fsync_file(WAN_SERVICE_PATH)
    _fsync_directory(WAN_RUNTIME_CONFIG_DIR)
    _fsync_directory(WAN_SERVICE_PATH.parent)
    _run(["systemctl", "daemon-reload"])
    enable = _run(["systemctl", "enable", WAN_SERVICE_PATH.name])
    if enable.returncode != 0:
        raise ValueError("Routes & WAN boot replay service could not be enabled")


