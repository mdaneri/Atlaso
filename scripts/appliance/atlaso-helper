def _handle_staging(action: str, args: list[str]) -> int:
    """Handle staging.

    Args:
        action: Action consumed by handle staging.
        args: Parsed command-line options consumed by the operation.
    """
    if action != "prepare":
        print(f"unsupported staging action: {action}", file=sys.stderr)
        return 2
    try:
        target = Path(_validate_path(args[0])).resolve()
    except (IndexError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    if not target.is_relative_to(ATLASO_APPLY_DIR):
        print(f"staging path must be under {ATLASO_APPLY_DIR}", file=sys.stderr)
        return 2
    directory = target if target.suffix == "" else target.parent
    if not directory.is_relative_to(ATLASO_APPLY_DIR):
        print(f"staging directory must be under {ATLASO_APPLY_DIR}", file=sys.stderr)
        return 2
    try:
        ATLASO_APPLY_DIR.mkdir(parents=True, exist_ok=True)
        directory.mkdir(parents=True, exist_ok=True)
        shutil.chown(ATLASO_APPLY_DIR, user="atlaso", group="atlaso")
        os.chmod(ATLASO_APPLY_DIR, 0o755)
        shutil.chown(directory, user="atlaso", group="atlaso")
        os.chmod(directory, 0o750)
        if target.exists() and target.is_file():
            shutil.chown(target, user="atlaso", group="atlaso")
            os.chmod(target, 0o600)
    except OSError as exc:
        print(f"unable to prepare staging path {target}: {exc}", file=sys.stderr)
        return 1
    print(json.dumps({"staging": "prepared", "path": str(target), "directory": str(directory)}, sort_keys=True))
    return 0


