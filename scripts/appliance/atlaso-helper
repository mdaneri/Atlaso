def _kms_service_identity_available() -> tuple[bool, bool]:
    """Perform KMS service identity available.

    """
    try:
        grp.getgrnam(KMS_SERVICE_USER)
        group_available = True
    except KeyError:
        group_available = False
    try:
        pwd.getpwnam(KMS_SERVICE_USER)
        account_available = True
    except KeyError:
        account_available = False
    return group_available, account_available


def _ensure_kms_service_identity() -> tuple[object, object]:
    """Ensure KMS service identity.

    """
    group_available, account_available = _kms_service_identity_available()
    if not group_available:
        groupadd = _command_path("groupadd")
        if groupadd is None:
            raise ValueError("groupadd command not found for KMS service-account reconciliation.")
        created_group = _run([groupadd, "--system", KMS_SERVICE_USER])
        if created_group.returncode != 0:
            raise ValueError("Could not reconcile the atlaso-kmip system group.")
    if not account_available:
        useradd = _command_path("useradd")
        if useradd is None:
            raise ValueError("useradd command not found for KMS service-account reconciliation.")
        created_account = _run(
            [
                useradd,
                "--system",
                "--gid",
                KMS_SERVICE_USER,
                "--home-dir",
                str(KMS_STATE_DIR),
                "--shell",
                "/sbin/nologin",
                KMS_SERVICE_USER,
            ]
        )
        if created_account.returncode != 0:
            raise ValueError("Could not reconcile the atlaso-kmip system account.")
    try:
        return pwd.getpwnam(KMS_SERVICE_USER), grp.getgrnam(KMS_SERVICE_USER)
    except KeyError as exc:
        raise ValueError("KMS service-account reconciliation did not create a usable identity.") from exc


def _install_kms_credential() -> None:
    """Perform install KMS credential.

    """
    try:
        source_lines = ATLASO_ENV_PATH.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        raise ValueError("Atlaso appliance environment is unavailable.") from exc
    secret_value = ""
    for raw_line in source_lines:
        candidate = raw_line.strip()
        if candidate.startswith("export "):
            candidate = candidate.removeprefix("export ").lstrip()
        if candidate.startswith("ATLASO_SECRETS_KEY="):
            secret_value = candidate.partition("=")[2].strip()
            if (
                len(secret_value) >= 2
                and secret_value[0] == secret_value[-1]
                and secret_value[0] in {'"', "'"}
            ):
                secret_value = secret_value[1:-1]
            break
    if not secret_value:
        raise ValueError("ATLASO_SECRETS_KEY is missing from the Atlaso appliance environment.")
    systemd_creds = _command_path("systemd-creds")
    if systemd_creds is None:
        raise ValueError("systemd-creds is required to protect the KMS runtime credential.")
    encrypted = _run_with_input(
        [
            str(systemd_creds),
            "encrypt",
            f"--name={KMS_CREDENTIAL_NAME}",
            "-",
            "-",
        ],
        secret_value,
    )
    if encrypted.returncode != 0 or not encrypted.stdout.strip():
        raise ValueError("Could not encrypt the KMS runtime credential.")
    KMS_CREDENTIAL_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = KMS_CREDENTIAL_PATH.with_suffix(".tmp")
    temporary.write_text(encrypted.stdout, encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.chown(temporary, 0, 0)
    os.replace(temporary, KMS_CREDENTIAL_PATH)


def _handle_ca_inner(action: str, args: list[str]) -> int:
    """Handle CA inner.

    Args:
        action: Action consumed by handle CA inner.
        args: Parsed command-line options consumed by the operation.
    """
    try:
        config_path = _validate_ca_config_path(args[0])
    except (IndexError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    errors = _ca_payload_errors(config_path)
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 2
    if action == "validate":
        print(json.dumps({"ca": "validation complete", "config_path": str(config_path)}, sort_keys=True))
        return 0
    payload = _load_ca_payload(config_path)
    root = payload["root"]
    root_cert = str(root["certificate_pem"])
    root_cert_path = _ca_managed_path(str(root["root_cert_path"]), "root_cert_path")
    legacy_root_path = _ca_managed_path(str(root["legacy_root_cert_path"]), "legacy_root_cert_path")
    bundle_path = _ca_managed_path(str(root["ca_bundle_path"]), "ca_bundle_path")
    crl_path_value = str(root.get("crl_path") or "")
    crl_pem = str(root.get("crl_pem") or "")
    _write_secret_file(root_cert_path, root_cert, 0o644)
    _write_secret_file(legacy_root_path, root_cert, 0o644)
    _write_secret_file(bundle_path, root_cert, 0o644)
    written = [str(root_cert_path), str(legacy_root_path), str(bundle_path)]
    removed: list[str] = []
    if crl_path_value:
        crl_path = _ca_managed_path(crl_path_value, "crl_path")
        if crl_pem:
            _write_secret_file(crl_path, crl_pem, 0o644)
            written.append(str(crl_path))
        elif crl_path.exists():
            crl_path.unlink()
            removed.append(str(crl_path))
    for certificate in payload["certificates"]:
        cert_path_value = str(certificate.get("cert_path") or "")
        key_path_value = str(certificate.get("key_path") or "")
        chain_path_value = str(certificate.get("chain_path") or "")
        if cert_path_value:
            cert_path = _ca_managed_path(cert_path_value, "cert_path")
            _write_secret_file(cert_path, str(certificate["certificate_pem"]), 0o644)
            written.append(str(cert_path))
        if chain_path_value:
            chain_path = _ca_managed_path(chain_path_value, "chain_path")
            _write_secret_file(chain_path, str(certificate.get("chain_pem") or certificate["certificate_pem"]), 0o644)
            written.append(str(chain_path))
        if key_path_value and certificate.get("private_key_pem"):
            key_path = _ca_managed_path(key_path_value, "key_path")
            _write_secret_file(key_path, str(certificate["private_key_pem"]), 0o600)
            if key_path == LDAP_KEY_PATH.resolve():
                try:
                    _grant_ldap_private_key_read(key_path)
                except (LookupError, OSError) as exc:
                    print(f"Could not preserve slapd access to the LDAP private key: {exc}", file=sys.stderr)
                    return 1
            if key_path.is_relative_to((KMS_CONFIG_DIR / "certs").resolve()):
                try:
                    _grant_kms_private_key_read(key_path)
                except (LookupError, OSError, ValueError) as exc:
                    print(f"Could not preserve atlaso-kmip access to the KMIP private key: {exc}", file=sys.stderr)
                    return 1
            if key_path.is_relative_to(NTP_CERT_DIR.resolve()):
                try:
                    _grant_ntpd_private_key_read(key_path)
                except (LookupError, OSError) as exc:
                    print(f"Could not preserve ntpd access to the NTS private key: {exc}", file=sys.stderr)
                    return 1
            written.append(str(key_path))
    print(json.dumps({"ca": "apply complete", "config_path": str(config_path), "written_files": written, "removed_files": removed}, sort_keys=True))
    return 0


def _handle_ca(action: str, args: list[str]) -> int:
    """Handle CA.

    Args:
        action: Action consumed by handle CA.
        args: Parsed command-line options consumed by the operation.
    """
    config_path: Path | None = None
    result: int | None = None
    if action in {"validate", "apply"} and len(args) == 1:
        try:
            config_path = _validate_ca_config_path(args[0])
        except ValueError:
            pass
    try:
        result = _handle_ca_inner(action, args)
        return result
    finally:
        if config_path is not None and (action == "apply" or (action == "validate" and result != 0)):
            config_path.unlink(missing_ok=True)




def _validate_dnsmasq_config(path: Path) -> subprocess.CompletedProcess[str]:
    """Validate dnsmasq config.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    required_upstream_error = _dnsmasq_required_upstream_error(path)
    if required_upstream_error:
        return subprocess.CompletedProcess(
            ["dnsmasq", "--test", f"--conf-file={path}"],
            2,
            "",
            f"{required_upstream_error}\n",
        )
    dnsmasq = shutil.which("dnsmasq")
    if dnsmasq is None:
        return subprocess.CompletedProcess(["dnsmasq", "--test", f"--conf-file={path}"], 127, "", "dnsmasq command not found\n")
    return _run([dnsmasq, "--test", f"--conf-file={path}"])


def _dnsmasq_required_upstream_error(path: Path) -> str:
    """Perform dnsmasq required upstream error.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    lines = [line.strip() for line in path.read_text(encoding="utf-8").splitlines()]
    if "# atlaso-dhcp-upstream-required" not in lines:
        return ""
    for line in lines:
        if not line.startswith("server="):
            continue
        candidate = line.split("=", 1)[1].strip()
        if not candidate or candidate.startswith("/"):
            continue
        try:
            parsed = ip_address(candidate)
        except ValueError:
            continue
        if not parsed.is_loopback and not parsed.is_link_local:
            return ""
    return "dnsmasq requires a usable management DHCP upstream server, but none was rendered"


def _dnsmasq_config_uses_dnssec(path: Path) -> bool:
    """Perform dnsmasq config uses dnssec.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip().lower()
        if line == "dnssec":
            return True
    return False


def _dnsmasq_supports_dnssec() -> tuple[bool, str]:
    """Perform dnsmasq supports dnssec.

    """
    dnsmasq = shutil.which("dnsmasq")
    if dnsmasq is None:
        return False, "dnsmasq command not found"
    result = _run([dnsmasq, "--version"])
    output = f"{result.stdout}\n{result.stderr}".lower()
    if result.returncode != 0:
        return False, (result.stderr or result.stdout or "dnsmasq --version failed").strip()
    if "no-dnssec" in output:
        return False, "installed dnsmasq reports no-DNSSEC"
    if "dnssec" in output:
        return True, ""
    return False, "installed dnsmasq does not report DNSSEC support"


def _find_dnsmasq_trust_anchor_file() -> Path | None:
    """Perform find dnsmasq trust anchor file.

    """
    for candidate in DNSMASQ_DNSSEC_TRUST_ANCHOR_CANDIDATES:
        if candidate.is_file():
            return candidate
    return None


def _prepare_dnsmasq_dnssec(path: Path) -> tuple[bool, str]:
    """Perform prepare dnsmasq dnssec.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    if not _dnsmasq_config_uses_dnssec(path):
        return True, ""
    supported, detail = _dnsmasq_supports_dnssec()
    if not supported:
        return False, f"DNSSEC validation is enabled, but {detail}."
    anchor_path = _find_dnsmasq_trust_anchor_file()
    if anchor_path is None:
        candidates = ", ".join(str(candidate) for candidate in DNSMASQ_DNSSEC_TRUST_ANCHOR_CANDIDATES)
        return False, f"DNSSEC validation is enabled, but no package trust-anchor file was found. Checked: {candidates}."
    DNSMASQ_APPLY_DIR.mkdir(parents=True, exist_ok=True)
    shutil.copy2(anchor_path, DNSMASQ_DNSSEC_TRUST_ANCHORS_PATH)
    try:
        shutil.chown(DNSMASQ_DNSSEC_TRUST_ANCHORS_PATH, user="atlaso", group="atlaso")
    except LookupError:
        pass
    os.chmod(DNSMASQ_DNSSEC_TRUST_ANCHORS_PATH, 0o644)
    return True, ""


def _dnsmasq_tftp_roots(path: Path) -> list[Path]:
    """Perform dnsmasq tftp roots.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    roots: list[Path] = []
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or not line.startswith("tftp-root="):
            continue
        value = line.split("=", 1)[1].strip()
        if value:
            roots.append(Path(value))
    return roots


def _prepare_dnsmasq_tftp_roots(path: Path) -> None:
    """Perform prepare dnsmasq tftp roots.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    allowed_root = ESXI_TFTP_ROOT.resolve()
    for root in _dnsmasq_tftp_roots(path):
        if root.resolve() != allowed_root:
            raise ValueError(f"dnsmasq TFTP root must be {ESXI_TFTP_ROOT}")
        root.mkdir(parents=True, exist_ok=True)
        try:
            shutil.chown(root, user="atlaso", group="atlaso")
        except LookupError:
            pass


