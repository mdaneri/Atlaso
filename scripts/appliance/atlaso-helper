                input_text,
            )
    return _run_with_input(command, input_text)


def _systemd_run_action_unit_name() -> str:
    """Return a collision-resistant unit name reset can inventory exactly."""
    return f"{SYSTEMD_RUN_ACTION_UNIT_PREFIX}-{uuid.uuid4().hex}"


def _appliance_update_action_unit_name(job_id: str, stream: str) -> str:
    """Return the fixed systemd identity for one Appliance Update stream.

    Args:
        job_id: Exact Appliance Update parent identifier.
        stream: Single update stream executed by the helper.
    """
    if re.fullmatch(r"job_[0-9a-f]{12}", job_id) is None:
        raise ValueError("Appliance Update helper action task identity is invalid")
    if stream not in {"photon_os", "powershell_modules", "atlaso_release"}:
        raise ValueError("Appliance Update helper action stream identity is invalid")
    identity = hashlib.sha256(f"{job_id}:{stream}".encode("utf-8")).hexdigest()[:32]
    return f"{SYSTEMD_RUN_ACTION_UNIT_PREFIX}-{identity}"


def _appliance_update_status_unit_name(job_id: str) -> str:
    """Return the fixed systemd identity for one task's status transitions.

    Args:
        job_id: Exact Appliance Update parent identifier.
    """
    if re.fullmatch(r"job_[0-9a-f]{12}", job_id) is None:
        raise ValueError("Appliance Update status transition task identity is invalid")
    identity = hashlib.sha256(f"{job_id}:status-transition".encode("utf-8")).hexdigest()[:32]
    return f"{SYSTEMD_RUN_ACTION_UNIT_PREFIX}-{identity}"


def _appliance_update_action_unit_from_config(args: list[str]) -> str | None:
    """Return a fixed helper unit when the manifest contains one exact stream.

    Args:
        args: Normalized helper arguments whose first value is the update manifest.
    """
    if not args:
        return None
    try:
        payload = json.loads(Path(args[0]).read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None
    selected = payload.get("selected_streams") if isinstance(payload, dict) else None
    if not isinstance(selected, list) or len(selected) != 1:
        return None
    try:
        return _appliance_update_action_unit_name(
            str(payload.get("job_id") or ""),
            str(selected[0] or ""),
        )
    except ValueError:
        return None


def _should_run_real_action_with_systemd(action: str) -> bool:
    """Perform should run real action with systemd.

    Args:
        action: Action consumed by should run real action with systemd.
    """
    return (
        action in SYSTEMD_RUN_REAL_ACTIONS
        and os.environ.get("ATLASO_HELPER_USE_SYSTEMD_RUN") == "1"
        and os.environ.get(SYSTEMD_RUN_CHILD_ENV) != "1"
        and shutil.which("systemd-run") is not None
    )


def _appliance_update_powershell_environment() -> dict[str, str]:
    """Perform appliance update powershell environment.

    """
    directories = [
        ATLASO_POWERSHELL_HOME,
        ATLASO_POWERSHELL_HOME / ".cache",
        ATLASO_POWERSHELL_HOME / ".config",
        ATLASO_POWERSHELL_HOME / ".local",
        ATLASO_POWERSHELL_HOME / ".local" / "share",
    ]
    for directory in directories:
        directory.mkdir(parents=True, exist_ok=True)
        directory.chmod(0o700)
    env = os.environ.copy()
    env.update(
        {
            "HOME": str(ATLASO_POWERSHELL_HOME),
            "XDG_CACHE_HOME": str(ATLASO_POWERSHELL_HOME / ".cache"),
            "XDG_CONFIG_HOME": str(ATLASO_POWERSHELL_HOME / ".config"),
            "XDG_DATA_HOME": str(ATLASO_POWERSHELL_HOME / ".local" / "share"),
        }
    )
    return env


def _run_real_action_with_systemd(group: str, action: str, args: list[str]) -> int:
    """Run real action with systemd.

    Args:
        group: Group consumed by run real action with systemd.
        action: Action consumed by run real action with systemd.
        args: Parsed command-line options consumed by the operation.
    """
    helper_path = str(Path(__file__).resolve())
    unit_name = _systemd_run_action_unit_name()
    if group == "appliance-update":
        if action == "apply":
            unit_name = _appliance_update_action_unit_from_config(args) or unit_name
        elif action in {"status-publish", "status-finish"}:
            if len(args) != 1:
                print(f"{action} requires exactly one task id", file=sys.stderr)
                return 2
            try:
                unit_name = _appliance_update_status_unit_name(args[0])
                _quiesce_appliance_update_status_unit(args[0])
            except ValueError as exc:
                print(f"Appliance Update status transition serialization failed: {exc}", file=sys.stderr)
                return 1
    command = [
        shutil.which("systemd-run") or "systemd-run",
        "--quiet",
        "--wait",
        "--pipe",
        "--collect",
        "--service-type=exec",
        f"--setenv={SYSTEMD_RUN_CHILD_ENV}=1",
        f"--unit={unit_name}",
    ]
    if group == "management-handoff" and action in {"apply", "recover"}:
        unit = MANAGEMENT_HANDOFF_APPLY_UNIT
        if action == "recover":
            unit = MANAGEMENT_HANDOFF_RECOVERY_UNIT
            try:
                _quiesce_management_handoff_unit(unit, "recovery")
            except ValueError as exc:
                print(
                    json.dumps(
                        {
                            "management_handoff": "rollback incomplete",
                            "failing_layer": "interruption serialization",
                            "error": str(exc),
                        },
                        sort_keys=True,
                    ),
                    file=sys.stderr,
                )
                return 1
        command.append(f"--unit={unit.removesuffix('.service')}")
    if group == "appliance-update":
        powershell_env = _appliance_update_powershell_environment()
        command.extend(
            [
                f"--property=WorkingDirectory={ATLASO_POWERSHELL_HOME}",
                f"--setenv=HOME={powershell_env['HOME']}",
                f"--setenv=XDG_CACHE_HOME={powershell_env['XDG_CACHE_HOME']}",
                f"--setenv=XDG_CONFIG_HOME={powershell_env['XDG_CONFIG_HOME']}",
                f"--setenv=XDG_DATA_HOME={powershell_env['XDG_DATA_HOME']}",
            ]
        )
    elif group == "appliance-settings":
        command.extend(
            [
                "--setenv=HOME=/root",
                "--setenv=XDG_CACHE_HOME=/root/.cache",
                "--setenv=XDG_CONFIG_HOME=/root/.config",
                "--setenv=XDG_DATA_HOME=/root/.local/share",
            ]
        )
    command.extend([helper_path, group, action, "--real", *args])
    result = _run(command)
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def _chown_path(path: Path, uid: int, gid: int) -> None:
    """Perform chown path.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
        uid: Uid consumed by chown path.
        gid: Gid consumed by chown path.
    """
    chown = getattr(os, "chown", None)
    if chown is not None:
        chown(path, uid, gid)


def _usage() -> int:
    """Perform usage.

    """
    groups = ", ".join(sorted(COMMANDS))
    print("usage: atlaso-helper <group> <action> [--real] [path]", file=sys.stderr)
    print(f"groups: {groups}", file=sys.stderr)
