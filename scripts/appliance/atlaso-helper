def _grant_atlaso_service_key_read(key_path: Path) -> None:
    """Perform grant atlaso service key read.

    Args:
        key_path: Filesystem path used for key.
    """
    os.chmod(key_path, 0o640)
    try:
        shutil.chown(key_path, user="root", group="atlaso")
    except (LookupError, OSError):
