def _validated_update_https_url(
    value: object, label: str, *, max_length: int | None = None
) -> str:
    """Perform validated update HTTPS URL.

    Args:
        value: Candidate value consumed by validated update HTTPS URL.
        label: Human-readable label used to identify the result.
        max_length: Optional maximum number of URL characters.
    """
    url = str(value or "").strip()
    parsed = urlparse(url)
    if (
        parsed.scheme != "https"
        or not parsed.netloc
        or parsed.username
        or parsed.password
        or (max_length is not None and len(url) > max_length)
        or any(character.isspace() or ord(character) < 32 for character in url)
    ):
        raise ValueError(f"{label} must be an HTTPS URL without embedded credentials")
    return url


def _validated_update_timestamp(value: object, label: str) -> str:
    """Perform validated update timestamp.

    Args:
        value: Candidate value consumed by validated update timestamp.
        label: Human-readable label used to identify the result.
    """
    timestamp = str(value or "").strip()
    try:
        parsed = datetime.fromisoformat(timestamp.replace("Z", "+00:00"))
    except ValueError as exc:
        raise ValueError(f"{label} must be an ISO 8601 timestamp") from exc
    if parsed.tzinfo is None:
        raise ValueError(f"{label} must include a timezone")
    return timestamp


def _verify_signed_update_document(raw_document: bytes, raw_signature: bytes, *, kind: str) -> dict:
    """Perform verify signed update document.

    Args:
        raw_document: Raw document consumed by verify signed update document.
        raw_signature: Raw signature consumed by verify signed update document.
        kind: Kind consumed by verify signed update document.
    """
    try:
        signature_document = json.loads(raw_signature.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError(f"{kind} detached signature is not valid JSON: {exc}") from exc
    if not isinstance(signature_document, dict) or signature_document.get("schema_version") != 1:
        raise ValueError(f"{kind} detached signature schema is unsupported")
    key_id = str(signature_document.get("key_id") or "").strip()
    if re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", key_id) is None:
        raise ValueError(f"{kind} detached signature key id is invalid")
    try:
        signature = base64.b64decode(str(signature_document.get("signature") or ""), validate=True)
    except ValueError as exc:
        raise ValueError(f"{kind} detached signature is not valid base64") from exc
    if len(signature) != 64:
        raise ValueError(f"{kind} detached Ed25519 signature must be 64 bytes")
    public_key = ATLASO_UPDATE_TRUST_DIR / f"{key_id}.pem"
    if not public_key.is_file():
        raise ValueError(f"{kind} signing key {key_id} is not trusted")
    openssl = _command_path("openssl")
    if openssl is None:
        raise ValueError("openssl is required to verify signed Atlaso releases")
    with tempfile.TemporaryDirectory(prefix="atlaso-signature-") as temporary:
        document_path = Path(temporary) / "document.json"
        signature_path = Path(temporary) / "document.sig"
        document_path.write_bytes(raw_document)
        signature_path.write_bytes(signature)
        result = _run(
            [
                openssl,
                "pkeyutl",
                "-verify",
                "-pubin",
                "-inkey",
                str(public_key),
                "-rawin",
                "-in",
                str(document_path),
                "-sigfile",
                str(signature_path),
            ]
        )
    if result.returncode != 0:
        raise ValueError(f"{kind} detached signature is invalid")
    try:
        document = json.loads(raw_document.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError(f"signed {kind} manifest is not valid JSON: {exc}") from exc
    if not isinstance(document, dict):
        raise ValueError(f"signed {kind} manifest must be an object")
    if document.get("signing_key_id") != key_id:
        raise ValueError(f"{kind} manifest and detached signature key ids do not match")
    return document


def _validate_channel_manifest(channel: dict) -> dict:
    """Validate channel manifest.

    Args:
        channel: Candidate channel to validate.
    """
    if channel.get("schema_version") != 2 or channel.get("kind") != "atlaso-channel":
        raise ValueError("Atlaso channel manifest schema is unsupported")
    if channel.get("channel") not in {"stable", "preview", "development"}:
        raise ValueError("Atlaso channel name is invalid")
    if re.fullmatch(r"[0-9a-f]{40}", str(channel.get("git_commit") or "").lower()) is None:
        raise ValueError("Atlaso channel git commit is invalid")
    _validated_update_https_url(channel.get("release_manifest_url"), "Atlaso release manifest URL")
    if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", str(channel.get("version") or "")) is None:
        raise ValueError("Atlaso channel version must use X.Y.Z semantic versioning")
    _validated_update_timestamp(channel.get("issued_at"), "Atlaso channel issue time")
    if not str(channel.get("signing_key_id") or "").strip():
        raise ValueError("Atlaso channel manifest missing signing_key_id")
    return channel


def _validate_release_manifest(release: dict) -> dict:
    """Validate release manifest.

    Args:
        release: Candidate release to validate.
    """
    if release.get("schema_version") != 2 or release.get("kind") != "atlaso-release":
        raise ValueError("Atlaso release manifest schema is unsupported")
    updater_protocol = release.get("updater_protocol")
    if (
        not isinstance(updater_protocol, int)
        or isinstance(updater_protocol, bool)
        or updater_protocol < 1
        or updater_protocol > 2
    ):
        raise ValueError("Atlaso release updater protocol is missing or unsupported")
    database_schema_version = release.get("database_schema_version")
    if (
        not isinstance(database_schema_version, int)
        or isinstance(database_schema_version, bool)
        or database_schema_version < 1
    ):
        raise ValueError("Atlaso release database schema version must be a positive integer")
    if re.fullmatch(r"[0-9a-f]{40}", str(release.get("git_commit") or "").lower()) is None:
        raise ValueError("Atlaso release git commit is invalid")
    python_abis = release.get("supported_python_abis")
    if (
        not isinstance(python_abis, list)
        or not python_abis
        or any(str(value) not in SUPPORTED_RELEASE_PYTHON_ABIS for value in python_abis)
        or len(set(python_abis)) != len(python_abis)
    ):
        raise ValueError("Atlaso release supported Python ABIs are invalid")
    bundle = release.get("bundle")
    if not isinstance(bundle, dict):
        raise ValueError("Atlaso release bundle metadata is missing")
    _validated_update_https_url(bundle.get("url"), "Atlaso release bundle URL")
    if re.fullmatch(r"[0-9a-f]{64}", str(bundle.get("sha256") or "").lower()) is None:
        raise ValueError("Atlaso release bundle SHA256 is invalid")
    if not isinstance(bundle.get("size"), int) or int(bundle["size"]) <= 0:
        raise ValueError("Atlaso release bundle size is invalid")
    content_hashes = release.get("content_hashes")
    if not isinstance(content_hashes, dict) or not content_hashes:
        raise ValueError("Atlaso release content hashes are missing")
    for name, digest in content_hashes.items():
        path = PurePosixPath(str(name))
        if not str(name) or path.is_absolute() or "\\" in str(name) or ".." in path.parts:
            raise ValueError("Atlaso release content hashes contain an unsafe path")
        if re.fullmatch(r"[0-9a-f]{64}", str(digest).lower()) is None:
            raise ValueError(f"Atlaso release content hash is invalid for {name}")
    if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", str(release.get("version") or "")) is None:
        raise ValueError("Atlaso release version must use X.Y.Z semantic versioning")
    summary = release.get("summary")
    if summary is not None and (
        not isinstance(summary, str)
        or not summary.strip()
        or len(summary) > 240
        or "\n" in summary
        or "\r" in summary
    ):
        raise ValueError("Atlaso release summary must be one non-empty line of at most 240 characters")
    release_notes_url = release.get("release_notes_url")
    if release_notes_url is not None:
        _validated_update_https_url(
            release_notes_url,
            "Atlaso release notes URL",
            max_length=UPDATE_RELEASE_NOTES_URL_MAX_LENGTH,
        )
    _validated_update_timestamp(release.get("built_at"), "Atlaso release build time")
    if not str(release.get("signing_key_id") or "").strip():
        raise ValueError("Atlaso release manifest missing signing_key_id")
    return release


def _credential_for_related_url(
    source_url: str, target_url: str, credential: dict[str, str] | None
) -> dict[str, str] | None:
    """Perform credential for related URL.

    Args:
        source_url: URL used for source.
        target_url: URL used for target.
        credential: Credential consumed by credential for related URL.
    """
    if not credential:
        return None
    source = urlparse(source_url)
    target = urlparse(target_url)
    return credential if (source.scheme, source.netloc) == (target.scheme, target.netloc) else None


def _download_signed_release(
    channel_url: str, credential: dict[str, str] | None = None
) -> tuple[dict, dict, dict[str, str] | None]:
    """Perform download signed release.

    Args:
        channel_url: URL used for channel.
        credential: Credential consumed by download signed release.
    """
    raw_channel = _fetch_http_bytes(channel_url, credential)
    raw_channel_signature = _fetch_http_bytes(f"{channel_url}.sig", credential)
    channel = _validate_channel_manifest(
        _verify_signed_update_document(raw_channel, raw_channel_signature, kind="channel")
    )
    release_url = str(channel["release_manifest_url"])
    release_credential = _credential_for_related_url(channel_url, release_url, credential)
    raw_release = _fetch_http_bytes(release_url, release_credential)
    raw_release_signature = _fetch_http_bytes(f"{release_url}.sig", release_credential)
    release = _validate_release_manifest(
        _verify_signed_update_document(raw_release, raw_release_signature, kind="release")
    )
    if release.get("version") != channel.get("version") or release.get("git_commit") != channel.get("git_commit"):
        raise ValueError("Atlaso channel pointer does not match its immutable release manifest")
    abi = _current_python_abi()
    if abi not in release["supported_python_abis"]:
        raise ValueError(f"Atlaso release {release['version']} does not support appliance Python ABI {abi}")
    return channel, release, release_credential


def _download_signed_release_from_sources(
    payload: dict, credentials: dict[str, dict[str, str]]
) -> tuple[dict, dict, str, dict[str, str] | None]:
    """Perform download signed release from sources.

    Args:
        payload: Validated request or task payload consumed by the operation.
        credentials: Credentials consumed by download signed release from sources.
    """
    failures: list[str] = []
    for channel_url, source in _atlaso_manifest_sources(payload):
        credential = _source_credential(source, credentials)
        try:
            channel, release, release_credential = _download_signed_release(channel_url, credential)
            return channel, release, str(channel["release_manifest_url"]), release_credential
        except Exception as exc:  # noqa: BLE001 - configured release mirrors are ordered failover sources.
            failures.append(f"{channel_url}: {exc}")
    raise ValueError("No enabled signed Atlaso release source succeeded: " + " ; ".join(failures))


def _restore_atlaso_venv_permissions() -> None:
    """Perform restore atlaso venv permissions.

    """
    venv = ATLASO_VENV_PYTHON_PATH.parents[1]
    if not venv.exists():
        return
    for root, dirs, files in os.walk(venv):
        for dirname in dirs:
            try:
                Path(root, dirname).chmod(0o755)
            except OSError:
                pass
        for filename in files:
            path = Path(root, filename)
            mode = 0o755 if path.parent.name == "bin" else 0o644
            try:
                path.chmod(mode)
            except OSError:
                pass


def _write_update_info(info: dict) -> None:
    """Write update info.

    Args:
        info: Info consumed by write update info.
    """
    APPLIANCE_UPDATE_INFO_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp_path = APPLIANCE_UPDATE_INFO_PATH.with_suffix(".tmp")
    tmp_path.write_text(json.dumps(info, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp_path.chmod(0o644)
    _fsync_file(tmp_path)
    os.replace(tmp_path, APPLIANCE_UPDATE_INFO_PATH)
    _fsync_directory(APPLIANCE_UPDATE_INFO_PATH.parent)


def _powershell_encoded_command(script: str) -> str:
    """Perform powershell encoded command.

    Args:
        script: Script consumed by powershell encoded command.
    """
    return base64.b64encode(script.encode("utf-16-le")).decode("ascii")


def _powershell_literal(value: str) -> str:
    """Perform powershell literal.

    Args:
        value: Candidate value consumed by powershell literal.
    """
    return "'" + value.replace("'", "''") + "'"


def _is_reserved_psgallery_name(value: str) -> bool:
    """Return whether a source name is reserved by PowerShellGet.

    Args:
        value: Candidate PowerShell repository name.
    """
    return value.strip().casefold() == PSGALLERY_NAME.casefold()


def _is_canonical_psgallery_url(value: str) -> bool:
    """Return whether a URL is the canonical PowerShell Gallery endpoint.

    Args:
        value: Candidate PowerShell repository URL.
    """
    parsed = urlparse(value.strip())
    try:
        port = parsed.port
    except ValueError:
        return False
    return (
        parsed.scheme.casefold() == "https"
        and (parsed.hostname or "").casefold() == "www.powershellgallery.com"
        and port is None
        and parsed.path in {"/api/v2", "/api/v2/"}
        and not parsed.params
        and not parsed.query
        and not parsed.fragment
        and parsed.username is None
        and parsed.password is None
    )


def _validate_reserved_psgallery_sources(definitions: list[object]) -> None:
    """Reject invalid reserved-gallery definitions before any host mutation.

    Args:
        definitions: Appliance Update source definitions from the staged manifest.

    Raises:
        ValueError: If PSGallery is paired with a noncanonical endpoint.
    """
    for source in definitions:
        if (
            not isinstance(source, dict)
            or source.get("kind") != "powershell"
            or source.get("enabled") is not True
        ):
            continue
        name = str(source.get("name") or "").strip()
        url = str(source.get("url") or "").strip()
        if _is_reserved_psgallery_name(name) and not _is_canonical_psgallery_url(url):
            raise ValueError(
                f"{PSGALLERY_NAME} is reserved for the built-in PowerShell Gallery. "
                f"Use {PSGALLERY_SOURCE_URL}, or choose a different repository name for a custom endpoint."
            )


def _powershell_repository_sync_script(name: str, url: str, policy: str) -> str:
    """Return the fail-closed PowerShellGet synchronization script.

    Args:
        name: Desired repository name.
        url: Desired repository endpoint.
        policy: Desired PowerShellGet installation policy.
    """
    reserved_gallery = _is_reserved_psgallery_name(name)
    registration = (
        "Register-PSRepository -Default -InstallationPolicy $policy"
        if reserved_gallery
        else "Register-PSRepository -Name $name -SourceLocation $url -InstallationPolicy $policy"
    )
    reconciliation = (
        "if (-not [string]::Equals(([string]$existing.SourceLocation).TrimEnd('/'), $url.TrimEnd('/'), [System.StringComparison]::OrdinalIgnoreCase)) { "
        "Unregister-PSRepository -Name $existing.Name -ErrorAction Stop; "
        "Register-PSRepository -Default -InstallationPolicy $policy "
        "} else { Set-PSRepository -Name $existing.Name -InstallationPolicy $policy }"
        if reserved_gallery
        else "Set-PSRepository -Name $existing.Name -SourceLocation $url -InstallationPolicy $policy"
    )
    return (
        '$ErrorActionPreference = "Stop"; '
        f"$name = {_powershell_literal(name)}; $url = {_powershell_literal(url)}; "
        f"$policy = {_powershell_literal(policy)}; "
        "$credentialArgs = if ($env:LF_REPO_SECRET) { $credential = New-Object System.Management.Automation.PSCredential($env:LF_REPO_USER, (ConvertTo-SecureString $env:LF_REPO_SECRET -AsPlainText -Force)); @{Credential=$credential} } else { @{} }; "
        "$existing = Get-PSRepository -Name $name -ErrorAction SilentlyContinue; "
        f"if (-not $existing) {{ {registration} }} "
        f"else {{ {reconciliation} }}; "
        "$repository = Get-PSRepository -Name $name -ErrorAction Stop; "
        "$actualUrl = ([string]$repository.SourceLocation).TrimEnd('/'); "
        "$expectedUrl = $url.TrimEnd('/'); "
        "if (-not [string]::Equals($actualUrl, $expectedUrl, [System.StringComparison]::OrdinalIgnoreCase)) { throw 'Registered repository location does not match Atlaso desired state' }; "
        "if (-not [string]::Equals([string]$repository.InstallationPolicy, $policy, [System.StringComparison]::OrdinalIgnoreCase)) { throw 'Registered repository installation policy does not match Atlaso desired state' }; "
        "$probe = Find-Module -Repository $repository.Name @credentialArgs -ErrorAction Stop | Select-Object -First 1; "
        "if (-not $probe) { throw 'PowerShell repository probe returned no modules' }; "
        "$repository | Select-Object Name,SourceLocation,InstallationPolicy,@{Name='ProbeSucceeded';Expression={$true}} | ConvertTo-Json -Compress"
    )


def _managed_photon_sources(payload: dict) -> list[dict]:
    """Return enabled Photon repositories owned by Atlaso.

    Args:
        payload: Validated Appliance Update request or task payload.
    """
    definitions = payload.get("source_definitions") or []
    if not isinstance(definitions, list):
        raise ValueError("source_definitions must be a list")
    return [
        source
        for source in definitions
        if isinstance(source, dict)
        and source.get("kind") == "photon"
        and source.get("enabled") is True
        and isinstance(source.get("settings"), dict)
        and source["settings"].get("managed") is True
    ]


def _render_managed_photon_repositories(
    sources: list[dict],
    credentials: dict[str, dict[str, str]],
    *,
    include_credentials: bool,
) -> str:
    """Render managed Photon repository definitions.

    Args:
        sources: Enabled managed Photon repository definitions.
        credentials: Protected credentials keyed by source identifier.
        include_credentials: Whether to add credentials for one transient TDNF call.
    """
    sections: list[str] = []
    for source in sources:
        source_name = str(source.get("name") or "atlaso")
        if any(ord(character) < 32 or ord(character) == 127 for character in source_name):
            raise ValueError("managed Photon source name must not contain control characters")
        source_id = re.sub(
            r"[^a-z0-9_.-]+", "-", source_name.lower()
        ).strip("-")
        if not source_id:
            raise ValueError("managed Photon source name must contain a usable repository identifier")
        source_url = str(source.get("url") or "").strip()
        if any(ord(character) < 32 or ord(character) == 127 for character in source_url):
            raise ValueError(f"managed Photon source {source_id} URL must not contain control characters")
        parsed = urlparse(source_url)
        if parsed.scheme not in {"http", "https"} or not parsed.netloc:
            raise ValueError(f"managed Photon source {source_id} must use an HTTP(S) base URL")
        if parsed.username is not None or parsed.password is not None:
            raise ValueError(f"managed Photon source {source_id} URL must not include embedded credentials")
        settings = source["settings"]
        lines = [
            f"[{source_id}]",
            f"name={source_name}",
            f"baseurl={source_url}",
            "enabled=1",
            f"gpgcheck={1 if settings.get('gpgcheck', True) else 0}",
            f"sslverify={1 if settings.get('tls_verify', True) else 0}",
        ]
        gpgkey = str(settings.get("gpgkey") or "").strip()
        if gpgkey:
            if any(ord(character) < 32 or ord(character) == 127 for character in gpgkey):
                raise ValueError(
                    f"managed Photon source {source_id} GPG key must not contain control characters"
                )
            for location in gpgkey.split():
                parsed_location = urlparse(location)
                if parsed_location.username is not None or parsed_location.password is not None:
                    raise ValueError(
                        f"managed Photon source {source_id} GPG key URL must not include embedded credentials"
                    )
            lines.append(f"gpgkey={gpgkey}")
        credential = _source_credential(source, credentials)
        if credential:
            combined = str(credential.get("username") or "") + str(credential["secret"])
            if any(character in combined for character in "\r\n"):
                raise ValueError(
                    f"managed Photon source {source_id} credentials must not contain line breaks"
                )
            if include_credentials:
                lines.extend(
                    [
                        f"username={credential.get('username', '')}",
                        f"password={credential['secret']}",
                    ]
                )
        sections.append("\n".join(lines))
    return "\n\n".join(sections) + ("\n" if sections else "")


def _photon_repository_runtime_root() -> Path:
    """Return the verified volatile root for authenticated repository views."""
    try:
        metadata = PHOTON_REPOSITORY_RUNTIME_ROOT.lstat()
    except OSError as exc:
        raise ValueError("volatile Photon repository credential storage is unavailable") from exc
    if (
        PHOTON_REPOSITORY_RUNTIME_ROOT.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
        or (os.name == "posix" and metadata.st_uid != 0)
        or (os.name == "posix" and metadata.st_mode & 0o022)
    ):
        raise ValueError("volatile Photon repository credential storage is unsafe")
    return PHOTON_REPOSITORY_RUNTIME_ROOT


def _process_start_identity(pid: int) -> str:
    """Return Linux process start ticks for a PID, or an empty value when absent.

    Args:
        pid: Operating-system process identifier.
    """
    if os.name != "posix":
        return ""
    try:
        fields = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8").rsplit(")", 1)[1].split()
    except (IndexError, OSError):
        return ""
    start_ticks = fields[19] if len(fields) > 19 else ""
    return start_ticks if start_ticks.isdigit() else ""


def _cleanup_stale_photon_repository_views(*, force: bool = False) -> None:
    """Remove inactive root-owned authenticated repository views from volatile storage.

    Args:
        force: Remove every validated view under an exclusive recovery transaction.
    """
    runtime_root = _photon_repository_runtime_root()
    pattern = re.compile(
        r"^atlaso-tdnf-repositories-([0-9]+)-([0-9]+)-[a-z0-9_-]+$"
    )
    for candidate in runtime_root.glob("atlaso-tdnf-repositories-*"):
        match = pattern.fullmatch(candidate.name)
        if match is None:
            continue
        try:
            metadata = candidate.lstat()
        except FileNotFoundError:
            continue
        if (
            candidate.is_symlink()
            or not stat.S_ISDIR(metadata.st_mode)
            or (os.name == "posix" and metadata.st_uid != 0)
            or (os.name == "posix" and metadata.st_mode & 0o077)
        ):
            raise ValueError("stale Photon repository credential storage is unsafe")
        owner_pid = int(match.group(1))
        owner_start_identity = match.group(2)
        if not force and _process_start_identity(owner_pid) == owner_start_identity:
            continue
        shutil.rmtree(candidate)


@contextmanager
def _temporary_photon_repository_options(
    payload: dict,
    credentials: dict[str, dict[str, str]],
):
    """Yield TDNF options for a root-only, volatile authenticated repository view.

    Args:
        payload: Validated Appliance Update request or task payload.
        credentials: Protected credentials keyed by source identifier.
    """
    sources = _managed_photon_sources(payload)
    if not any(_source_credential(source, credentials) for source in sources):
        yield []
        return

    runtime_root = _photon_repository_runtime_root()
    _cleanup_stale_photon_repository_views()
    process_start_identity = _process_start_identity(os.getpid()) or str(time.monotonic_ns())
    with tempfile.TemporaryDirectory(
        prefix=f"atlaso-tdnf-repositories-{os.getpid()}-{process_start_identity}-",
        dir=runtime_root,
    ) as directory:
        repository_dir = Path(directory)
        os.chmod(repository_dir, 0o700)
        for existing in sorted(MANAGED_PHOTON_REPO_PATH.parent.glob("*.repo")):
            if existing == MANAGED_PHOTON_REPO_PATH:
                continue
            (repository_dir / existing.name).symlink_to(existing)
        # Credentials exist only in volatile, root-only storage and are removed
        # immediately after the individual TDNF command completes.
        _write_appliance_update_runtime_file(
            repository_dir / MANAGED_PHOTON_REPO_PATH.name,
            _render_managed_photon_repositories(
                sources, credentials, include_credentials=True
            ),
            mode=0o600,
        )
        yield [f"--setopt=repodir={repository_dir}"]


def _photon_command_payload(
    payload: dict,
    credentials: dict[str, dict[str, str]],
    command: list[str],
    **kwargs,
) -> dict:
    """Run one TDNF command with transient Photon repository credentials.

    Args:
        payload: Validated Appliance Update request or task payload.
        credentials: Protected credentials keyed by source identifier.
        command: TDNF executable and arguments.
        **kwargs: Additional command-capture options.
    """
    with _temporary_photon_repository_options(payload, credentials) as options:
        return _command_payload([command[0], *options, *command[1:]], **kwargs)


def _sync_appliance_update_sources(payload: dict, credentials: dict[str, dict[str, str]] | None = None) -> dict:
    """Perform sync appliance update sources.

    Args:
        payload: Validated request or task payload consumed by the operation.
        credentials: Credentials consumed by sync appliance update sources.
    """
    credentials = credentials or {}
    definitions = payload.get("source_definitions") or []
    if not isinstance(definitions, list):
        raise ValueError("source_definitions must be a list")
    _validate_reserved_psgallery_sources(definitions)
    commands: list[dict] = []
    source_results: list[dict] = []

    def record_source_result(source: dict, *, success: bool) -> None:
        """Perform record source result.

        Args:
            source: Source object or location from which data is obtained.
            success: Whether success applies to the operation.
        """
        source_results.append(
            {
                "id": source.get("id"),
                "kind": str(source.get("kind") or ""),
                "name": str(source.get("name") or ""),
                "success": success,
            }
        )

    managed_photon = _managed_photon_sources(payload)
    photon_path = MANAGED_PHOTON_REPO_PATH
    if managed_photon:
        _write_appliance_update_runtime_file(
            photon_path,
            _render_managed_photon_repositories(
                managed_photon, credentials, include_credentials=False
            ),
            mode=0o644,
        )
        commands.append({"command": ["write", str(photon_path)], "returncode": 0, "success": True, "stdout": f"wrote {len(managed_photon)} managed Photon repositories", "stderr": ""})
        for source in managed_photon:
            record_source_result(source, success=True)
    elif photon_path.exists():
        photon_path.unlink()
        commands.append({"command": ["remove", str(photon_path)], "returncode": 0, "success": True, "stdout": "removed managed Photon repository file", "stderr": ""})

    pwsh = _command_path("pwsh")
    try:
        previous_state = json.loads(UPDATE_SOURCE_STATE_PATH.read_text(encoding="utf-8")) if UPDATE_SOURCE_STATE_PATH.exists() else {}
    except (OSError, json.JSONDecodeError):
        previous_state = {}
    previous_powershell_names = {
        str(value).casefold(): str(value)
        for value in previous_state.get("powershell_repositories", [])
        if str(value).strip()
    } if isinstance(previous_state, dict) else {}
    current_powershell_names: dict[str, str] = {}
    for source in definitions:
        if not isinstance(source, dict) or source.get("kind") != "powershell" or source.get("enabled") is not True:
            continue
        name = str(source.get("name") or "").strip()
        url = str(source.get("url") or "").strip()
        if not name:
            raise ValueError("PowerShell source name is required")
        name_key = name.casefold()
        if pwsh is None:
            commands.append({"command": ["pwsh"], "returncode": 127, "success": False, "stdout": "", "stderr": "pwsh command not found"})
            record_source_result(source, success=False)
            if name_key in previous_powershell_names:
                current_powershell_names[name_key] = previous_powershell_names[name_key]
            continue
        parsed = urlparse(url)
        if parsed.scheme not in {"http", "https"} or not parsed.netloc:
            raise ValueError(f"PowerShell source {name} must use an HTTP(S) URL")
        host = str(parsed.hostname or "").strip()
        try:
            socket.getaddrinfo(
                host,
                parsed.port or (443 if parsed.scheme == "https" else 80),
                type=socket.SOCK_STREAM,
            )
        except socket.gaierror as exc:
            commands.append(
                {
                    "command": ["resolve", host],
                    "returncode": 1,
                    "success": False,
                    "stdout": "",
                    "stderr": f"PowerShell repository {name} host {host} could not be resolved: {exc}",
                }
            )
            record_source_result(source, success=False)
            if name_key in previous_powershell_names:
                current_powershell_names[name_key] = previous_powershell_names[name_key]
            continue
        trusted = bool((source.get("settings") or {}).get("trusted")) if isinstance(source.get("settings"), dict) else False
        policy = "Trusted" if trusted else "Untrusted"
        credential = _source_credential(source, credentials)
        script = _powershell_repository_sync_script(name, url, policy)
        env = _appliance_update_powershell_environment()
        if credential:
            env.update({"LF_REPO_USER": str(credential.get("username") or ""), "LF_REPO_SECRET": str(credential["secret"])})
        command = _command_payload(
            [pwsh, "-NoLogo", "-NoProfile", "-NonInteractive", "-EncodedCommand", _powershell_encoded_command(script)],
            env=env,
        )
        commands.append(command)
        source_succeeded = bool(command.get("success"))
        record_source_result(source, success=source_succeeded)
        # Once PowerShellGet runs, registration may have completed before a
        # readback or probe failure. Retain ownership so a later disable,
        # deletion, or reset still reconciles the possibly-created repository;
        # source_results remains the authoritative synchronization outcome.
        current_powershell_names[name_key] = (
            PSGALLERY_NAME if _is_reserved_psgallery_name(name) else name
        )
    if pwsh is not None:
        for name_key in sorted(previous_powershell_names.keys() - current_powershell_names.keys()):
            name = previous_powershell_names[name_key]
            script = (
                '$ErrorActionPreference = "Stop"; '
                f"$name = {_powershell_literal(name)}; "
                "$existing = Get-PSRepository -Name $name -ErrorAction SilentlyContinue; "
                "if ($existing) { Unregister-PSRepository -Name $name }; "
                "[pscustomobject]@{Name=$name;Removed=[bool]$existing} | ConvertTo-Json -Compress"
            )
            command = _command_payload(
                [pwsh, "-NoLogo", "-NoProfile", "-NonInteractive", "-EncodedCommand", _powershell_encoded_command(script)],
                env=_appliance_update_powershell_environment(),
            )
            commands.append(command)
            if not command.get("success"):
                current_powershell_names[name_key] = name
    UPDATE_SOURCE_STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    UPDATE_SOURCE_STATE_PATH.write_text(
        json.dumps(
            {
                "powershell_repositories": sorted(
                    current_powershell_names.values(), key=str.casefold
                )
            },
            indent=2,
            sort_keys=True,
        )
        + "\n",
        encoding="utf-8",
    )
    UPDATE_SOURCE_STATE_PATH.chmod(0o600)
    failed_commands = [command for command in commands if not command.get("success")]
    result = {
        "status": "failed" if failed_commands else "succeeded",
        "commands": commands,
        "source_results": source_results,
    }
    if failed_commands:
        result["error"] = str(failed_commands[0].get("stderr") or failed_commands[0].get("stdout") or "Repository synchronization failed.").strip()
    return result


def _failed_update_check(remediation: str, *, current: str = "", target: str = "") -> dict:
    """Return one normalized failed update check.

    Args:
        remediation: Sanitized operator action that can resolve the failure.
        current: Current stream state when known.
        target: Target stream state when known.
    """
    return {
        "state": "failed",
        "current": current,
        "target": target,
        "change_count": 0,
        "changes": [],
        "details_incomplete": False,
        "summary": "The update check did not complete.",
        "remediation": remediation,
    }


def _unsynchronized_update_sources(
    payload: dict,
    kind: str,
    *,
    repository_names: set[str] | None = None,
) -> list[str]:
    """Return enabled managed repositories that are not synchronized.

    Args:
        payload: Validated Appliance Update task payload.
        kind: Source kind to inspect.
        repository_names: Optional referenced repository-name filter.
    """
    definitions = payload.get("source_definitions")
    if not isinstance(definitions, list):
        return []
    return sorted(
        str(source.get("name") or "configured repository").strip()
        for source in definitions
        if isinstance(source, dict)
        and source.get("kind") == kind
        and source.get("enabled") is True
        and (kind != "photon" or bool((source.get("settings") or {}).get("managed")))
        and (
            repository_names is None
            or str(source.get("name") or "").strip() in repository_names
        )
        and source.get("validation_status") != "valid"
    )


def _parse_tdnf_update_rows(stdout: str) -> list[dict[str, str]]:
    """Parse the stable package rows emitted by ``tdnf check-update``.

    Args:
        stdout: Standard output emitted by ``tdnf check-update``.
    """
    rows: list[dict[str, str]] = []
    arch_suffix = re.compile(r"\.(?:x86_64|noarch|aarch64|i[3-6]86|src)$")
    for raw_line in stdout.splitlines():
        line = raw_line.strip()
        if not line or line.startswith(("Refreshing", "Metadata", "Obsoleting", "Installing", "Name ")):
            continue
        fields = line.split()
        if len(fields) < 3 or not any(character.isdigit() for character in fields[1]):
            continue
        package = arch_suffix.sub("", fields[0])
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9+_.-]*", package):
            continue
        rows.append({"name": package, "target": fields[1], "repository": fields[2]})
    return rows


def _json_command_stdout(command: dict) -> dict:
    """Return a command's compact JSON stdout object.

    Args:
        command: Captured helper command result.
    """
    try:
        payload = json.loads(str(command.get("stdout") or "{}"))
    except json.JSONDecodeError:
        return {}
    return payload if isinstance(payload, dict) else {}


def _update_version_key(value: str) -> tuple:
    """Return a deterministic comparison key for package and module versions.

    Args:
        value: Package or module version text.
    """
    return tuple(
        (0, int(part)) if part.isdigit() else (1, part.casefold())
        for part in re.split(r"[.+_-]", value or "")
    )


def _check_appliance_update(payload: dict, credentials: dict[str, dict[str, str]] | None = None) -> dict:
    """Check appliance update.

    Args:
        payload: Validated request or task payload consumed by the operation.
        credentials: Credentials consumed by check appliance update.
    """
    credentials = credentials or {}
    selected = set(payload.get("selected_streams") or [])
    sources = payload.get("sources") or {}
    commands: list[dict] = []
    checks: dict[str, object] = {}
    if "photon_os" in selected:
        unsynchronized = _unsynchronized_update_sources(payload, "photon")
        if unsynchronized:
            checks["photon_os"] = _failed_update_check(
                f"Synchronize repositories for {', '.join(unsynchronized)} and check Photon OS again."
            )
        else:
            tdnf = _command_path("tdnf") or "tdnf"
            makecache = _photon_command_payload(
                payload, credentials, [tdnf, "makecache"], success_codes={0}
            )
            commands.append(makecache)
            check_command = _photon_command_payload(
                payload,
                credentials,
                [tdnf, "check-update"],
                success_codes={0, 100},
                stdout_limit=100000,
            )
            full_check_stdout = str(check_command.get("stdout") or "")
            commands.append(check_command)
            compatibility = _photon_python_compatibility(payload, credentials)
            commands.append(compatibility)
            if not makecache["success"] or not check_command["success"] or not compatibility["success"]:
                checks["photon_os"] = _failed_update_check(
                    "Review the Photon check output, correct repository or Python compatibility errors, and check again."
                )
            elif check_command["returncode"] == 0:
                checks["photon_os"] = {
                    "state": "up_to_date",
                    "current": "Installed Photon OS packages",
                    "target": "Current repository state",
                    "change_count": 0,
                    "changes": [],
                    "details_incomplete": False,
                    "summary": "Photon OS packages are up to date.",
                    "remediation": "",
                }
            else:
                candidates = _parse_tdnf_update_rows(full_check_stdout)
                stored_candidates = candidates[:100]
                installed_versions: dict[str, str] = {}
                if stored_candidates:
                    rpm = _command_path("rpm") or "rpm"
                    rpm_query = _command_payload(
                        [rpm, "-q", "--qf", "%{NAME}\t%{EPOCHNUM}:%{VERSION}-%{RELEASE}\\n", *[row["name"] for row in stored_candidates]],
                        stdout_limit=50000,
                    )
                    commands.append(rpm_query)
                    if rpm_query["success"]:
                        for line in str(rpm_query.get("stdout") or "").splitlines():
                            name, separator, version = line.partition("\t")
                            if separator:
                                installed_versions[name.strip()] = version.strip()
                changes = [
                    {
                        "name": row["name"],
                        "current": installed_versions.get(row["name"], "installed version unavailable"),
                        "target": row["target"],
                        "action": "upgrade",
                        "summary": f"{row['name']} from {row['repository']}",
                    }
                    for row in stored_candidates
                ]
                details_incomplete = (
                    len(candidates) > 100
                    or not candidates
                    or len(installed_versions) != len({row["name"] for row in stored_candidates})
                )
                checks["photon_os"] = {
                    "state": "available",
                    "current": "Installed Photon OS packages",
                    "target": f"{len(candidates)} package update{'s' if len(candidates) != 1 else ''}",
                    "change_count": len(candidates),
                    "changes": changes,
                    "details_incomplete": details_incomplete,
                    "summary": (
                        f"{len(candidates)} Photon OS package update{'s are' if len(candidates) != 1 else ' is'} available."
                        if candidates
                        else "Photon reported available updates, but package details could not be parsed completely."
                    ),
                    "remediation": "",
                }
                check_command["stdout"] = full_check_stdout[-4000:]
    if "powershell_modules" in selected:
        pwsh = _command_path("pwsh") or "pwsh"
        default_repository = str(sources.get("powershell_repository_name") or "").strip()
        modules = [
            module
            for module in payload.get("powershell_modules") or []
            if isinstance(module, dict)
        ]
        module_repositories = [
            str(module.get("repository_name") or default_repository).strip()
            for module in modules
        ]
        referenced_repositories = {
            repository for repository in module_repositories if repository
        }
        unsynchronized = _unsynchronized_update_sources(
            payload,
            "powershell",
            repository_names=referenced_repositories,
        )
        repository_missing = any(not repository for repository in module_repositories)
        module_checks: list[dict] = []
        if repository_missing or unsynchronized:
            names = ", ".join(unsynchronized) or "the configured PowerShell repository"
            checks["powershell_modules"] = _failed_update_check(
                f"Synchronize repositories for {names} and check PowerShell Modules again."
            )
        for module in modules if not unsynchronized and not repository_missing else []:
            name = str(module.get("name") or "").strip()
            target = str(module.get("target_version") or "").strip()
            repository = str(module.get("repository_name") or default_repository).strip()
            source = next((item for item in _enabled_sources(payload, "powershell") if str(item.get("name") or "") == repository), {})
            expected_url = str(source.get("url") or sources.get("powershell_repository_url") or "").strip()
            script = (
                '$ErrorActionPreference = "Stop"; '
                "$credentialArgs = if ($env:LF_REPO_SECRET) { $credential = New-Object System.Management.Automation.PSCredential($env:LF_REPO_USER, (ConvertTo-SecureString $env:LF_REPO_SECRET -AsPlainText -Force)); @{Credential=$credential} } else { @{} }; "
                f"$repository = Get-PSRepository -Name {_powershell_literal(repository)} -ErrorAction Stop; "
                f"if ([string]$repository.SourceLocation -ne {_powershell_literal(expected_url)}) {{ throw 'Registered repository location does not match Atlaso desired state' }}; "
                f"$installed = @(Get-Module -Name {_powershell_literal(name)} -ListAvailable | Sort-Object Version -Descending | ForEach-Object {{ $_.Version.ToString() }}); "
                f"$module = Find-Module -Name {_powershell_literal(name)} -Repository {_powershell_literal(repository)}"
                + (f" -RequiredVersion {_powershell_literal(target)}" if target else "")
                + " @credentialArgs"
                + "; [pscustomobject]@{Name=$module.Name; AvailableVersion=$module.Version.ToString(); Repository=$module.Repository; InstalledVersions=$installed} | ConvertTo-Json -Compress"
            )
            credential = _source_credential(source, credentials)
            env = _appliance_update_powershell_environment()
            if credential:
                env.update({"LF_REPO_USER": str(credential.get("username") or ""), "LF_REPO_SECRET": str(credential["secret"])})
            command_args = [pwsh, "-NoLogo", "-NoProfile", "-NonInteractive", "-EncodedCommand", _powershell_encoded_command(script)]
            command = _command_payload(command_args, env=env)
            commands.append(command)
            detail = _json_command_stdout(command)
            installed_value = detail.get("InstalledVersions")
            installed = [str(value) for value in installed_value] if isinstance(installed_value, list) else [str(installed_value)] if installed_value else []
            available_version = str(detail.get("AvailableVersion") or target)
            if not command["success"] or not available_version:
                module_checks.append({"name": name, "success": False})
                continue
            highest_installed = max(installed, key=_update_version_key) if installed else ""
            action = (
                "add"
                if not installed
                else "current"
                if available_version in installed
                else "upgrade"
                if _update_version_key(available_version) > _update_version_key(highest_installed)
                else "side-by-side"
            )
            module_checks.append(
                {
                    "name": name,
                    "current": ", ".join(installed) or "Not installed",
                    "target": available_version,
                    "action": action,
                    "summary": f"{action.replace('-', ' ')} {name}",
                    "success": True,
                }
            )
        if "powershell_modules" not in checks:
            failed = [row for row in module_checks if not row.get("success")]
            changes = [
                {key: row[key] for key in ("name", "current", "target", "action", "summary") if key in row}
                for row in module_checks
                if row.get("success") and row.get("action") != "current"
            ]
            if failed:
                checks["powershell_modules"] = _failed_update_check(
                    "Review the PowerShell repository/module lookup output, synchronize repositories if needed, and check again."
                )
            else:
                checks["powershell_modules"] = {
                    "state": "available" if changes else "up_to_date",
                    "current": f"{len(module_checks)} managed module{'s' if len(module_checks) != 1 else ''}",
                    "target": f"{len(changes)} module change{'s' if len(changes) != 1 else ''}",
                    "change_count": len(changes),
                    "changes": changes,
                    "details_incomplete": False,
                    "summary": f"{len(changes)} managed PowerShell module change{'s are' if len(changes) != 1 else ' is'} available." if changes else "Managed PowerShell modules are up to date.",
                    "remediation": "",
                }
    if "atlaso_release" in selected:
        try:
            channel, release, manifest_url, _credential = _download_signed_release_from_sources(payload, credentials)
            current = str((payload.get("current") or {}).get("base_version") or "")
            target = str(release.get("version") or "")
            available = _update_version_key(target) > _update_version_key(current)
            checks["atlaso_release"] = {
                "state": "available" if available else "up_to_date",
                "current": current,
                "target": target,
                "change_count": 1 if available else 0,
                "changes": [{"name": "Atlaso", "current": current, "target": target, "action": "upgrade"}] if available else [],
                "details_incomplete": False,
                "summary": str(release.get("summary") or f"Signed Atlaso release {target} at {str(release.get('git_commit') or '')[:12]}"),
                "release_notes_url": str(release.get("release_notes_url") or ""),
                "remediation": "",
                "channel": channel.get("channel"),
                "git_commit": release.get("git_commit"),
                "supported_python_abis": release.get("supported_python_abis"),
                "signing_key_id": release.get("signing_key_id"),
                "manifest_url": manifest_url,
                "bundle_sha256": (release.get("bundle") or {}).get("sha256"),
            }
        except Exception as exc:  # noqa: BLE001 - each selected stream records its own check failure.
            checks["atlaso_release"] = _failed_update_check(
                "Review the signed release source error, correct the repository or trust configuration, and check again."
            )
            commands.append(
                {
                    "command": ["signed-atlaso-release-check"],
                    "returncode": 1,
                    "success": False,
                    "stdout": "",
                    "stderr": str(exc)[:4000],
                }
            )
    return {"checks": checks, "commands": commands}


def _apply_powershell_modules(payload: dict, credentials: dict[str, dict[str, str]] | None = None) -> list[dict]:
    """Perform apply powershell modules.

    Args:
        payload: Validated request or task payload consumed by the operation.
        credentials: Credentials consumed by apply powershell modules.
    """
    credentials = credentials or {}
    sources = payload.get("sources") or {}
    default_repository = str(sources.get("powershell_repository_name") or "").strip()
    pwsh = _command_path("pwsh") or "pwsh"
    commands: list[dict] = []
    for module in payload.get("powershell_modules") or []:
        name = str(module.get("name") or "").strip()
        target = str(module.get("target_version") or "").strip()
        policy = str(module.get("policy") or "pinned")
        repository = str(module.get("repository_name") or default_repository).strip()
        version_argument = f" -RequiredVersion {_powershell_literal(target)}" if policy == "pinned" and target else ""
        ceip_enabled = bool((payload.get("policy") or {}).get("vmware_ceip_enabled", False))
        ceip_script = ""
        if name.casefold() == "vcf.powercli":
            ceip_literal = "$true" if ceip_enabled else "$false"
            ceip_script = (
                f"Set-PowerCLIConfiguration -ParticipateInCeip {ceip_literal} -Scope AllUsers -Confirm:$false | Out-Null; "
                "$configured = Get-PowerCLIConfiguration -Scope AllUsers; "
                f"if ([bool]$configured.ParticipateInCEIP -ne {ceip_literal}) {{ throw 'PowerCLI CEIP verification failed' }}; "
            )
        script = (
            '$ErrorActionPreference = "Stop"; '
            "$credentialArgs = if ($env:LF_REPO_SECRET) { $credential = New-Object System.Management.Automation.PSCredential($env:LF_REPO_USER, (ConvertTo-SecureString $env:LF_REPO_SECRET -AsPlainText -Force)); @{Credential=$credential} } else { @{} }; "
            f"Install-Module -Name {_powershell_literal(name)} -Repository {_powershell_literal(repository)}"
            f"{version_argument} @credentialArgs -Scope AllUsers -Force -AllowClobber -AcceptLicense -Confirm:$false; "
            f"$module = Get-Module -Name {_powershell_literal(name)} -ListAvailable | Sort-Object Version -Descending | Select-Object -First 1; "
            "if (-not $module) { throw 'Installed module could not be found' }; Import-Module $module.Path -Force; "
            f"{ceip_script}"
            "$module | Select-Object Name,Version,Path | ConvertTo-Json -Compress"
        )
        source = next((item for item in _enabled_sources(payload, "powershell") if str(item.get("name") or "") == repository), {})
        credential = _source_credential(source, credentials)
        env = _appliance_update_powershell_environment()
        if credential:
            env.update({"LF_REPO_USER": str(credential.get("username") or ""), "LF_REPO_SECRET": str(credential["secret"])})
        command_args = [pwsh, "-NoLogo", "-NoProfile", "-NonInteractive", "-EncodedCommand", _powershell_encoded_command(script)]
        commands.append(_command_payload(command_args, env=env))
    if any(command.get("success") for command in commands):
        chmod = _command_path("chmod") or "chmod"
        commands.append(
            _command_payload(
                [
                    chmod,
                    "0755",
                    str(POWERSHELL_SYSTEM_ROOT),
                    str(POWERSHELL_MODULE_ROOT),
                ]
            )
        )
        commands.append(
            _command_payload(
                [
                    chmod,
                    "-R",
                    "a+rX,go-w",
                    str(POWERSHELL_MODULE_ROOT),
                ]
            )
        )
    return commands


def _active_release_metadata() -> tuple[Path, dict]:
    """Perform active release metadata.

    """
    if not ATLASO_CURRENT_LINK.is_symlink():
        raise ValueError("Install a signed Atlaso release before applying Photon OS updates")
    release_root = ATLASO_CURRENT_LINK.resolve()
    metadata_path = release_root / "bundle-metadata.json"
    try:
        metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError("Active Atlaso release metadata is unavailable") from exc
    if not isinstance(metadata, dict):
        raise ValueError("Active Atlaso release metadata is invalid")
    return release_root, metadata


def _candidate_photon_python_abi(
    payload: dict | None = None,
    credentials: dict[str, dict[str, str]] | None = None,
) -> tuple[dict, str]:
    """Perform candidate photon python abi.

    Args:
        payload: Validated Appliance Update request or task payload.
        credentials: Protected credentials keyed by source identifier.
    """
    tdnf = _command_path("tdnf") or "tdnf"
    command = _photon_command_payload(
        payload or {}, credentials or {}, [tdnf, "repoquery", "python3"]
    )
    if not command["success"]:
        return command, ""
    versions = [
        (int(match.group(1)), int(match.group(2)))
        for match in re.finditer(
            r"(?m)^python3-([0-9]+)\.([0-9]+)(?:\.[0-9]+)?-",
            command["stdout"],
        )
    ]
    if not versions:
        command["success"] = False
        command["returncode"] = 1
        command["stderr"] = "Could not determine the candidate Photon python3 ABI from repository metadata."
        return command, ""
    major, minor = max(versions)
    return command, f"cp{major}{minor}"


def _photon_python_compatibility(
    payload: dict | None = None,
    credentials: dict[str, dict[str, str]] | None = None,
) -> dict:
    """Perform photon python compatibility.

    Args:
        payload: Validated Appliance Update request or task payload.
        credentials: Protected credentials keyed by source identifier.
    """
    try:
        _release_root, metadata = _active_release_metadata()
    except ValueError as exc:
        return {
            "command": ["photon-python-compatibility"],
            "returncode": 1,
            "success": False,
            "stdout": "",
            "stderr": str(exc),
            "compatibility": {},
        }
    query, candidate = _candidate_photon_python_abi(payload, credentials)
    supported = [str(value) for value in metadata.get("supported_python_abis", [])]
    query["compatibility"] = {
        "candidate_python_abi": candidate,
        "supported_python_abis": supported,
        "active_release": metadata.get("version"),
    }
    if query["success"] and candidate not in supported:
        query["success"] = False
        query["returncode"] = 1
        query["stderr"] = (
            f"Photon proposes Python ABI {candidate}, but active Atlaso release "
            f"{metadata.get('version')} supports {', '.join(supported) or 'none'}."
        )
    return query


def _rebuild_active_release_for_python(previous_abi: str) -> tuple[list[dict], bool]:
    """Perform rebuild active release for python.

    Args:
        previous_abi: Previous abi restored or compared by the operation.
    """
    current_abi = _current_python_abi()
    if current_abi == previous_abi:
        return [], False
    release_root, metadata = _active_release_metadata()
    supported = [str(value) for value in metadata.get("supported_python_abis", [])]
    if current_abi not in supported:
        raise ValueError(
            f"Photon changed Python from {previous_abi} to unsupported ABI {current_abi}; "
            "automatic RPM rollback is not available"
        )
    commands = [_service_command("stop", "atlaso.service", "atlaso-console.service")]
    if commands[-1]["success"]:
        commands.extend(_install_release_venv(release_root, current_abi))
    if all(command["success"] for command in commands):
        commands.append(_service_command("start", "atlaso.service", "atlaso-console.service"))
        commands.append(_wait_for_atlaso_health())
        commands.append(
            _service_command(
                "is-active",
                "atlaso.service",
                "atlaso-worker.service",
                "atlaso-console.service",
            )
        )
    if not all(command["success"] for command in commands):
        raise ValueError(
            f"Photon changed Python from {previous_abi} to {current_abi}, but the active "
            "Atlaso release environment could not be reconstructed. Automatic RPM rollback is not available."
        )
    return commands, True


def _safe_extract_release(bundle_path: Path, destination: Path) -> None:
    """Return a safe extract release.

    Args:
        bundle_path: Filesystem path used for bundle.
        destination: Destination object or location receiving the result.
    """
    with tarfile.open(bundle_path, "r:gz") as archive:
        for member in archive.getmembers():
            member_path = PurePosixPath(member.name)
            if member_path.is_absolute() or ".." in member_path.parts or member.issym() or member.islnk():
                raise ValueError(f"Atlaso release bundle contains unsafe member {member.name}")
        archive.extractall(destination, filter="data")


def _validate_release_content(release: dict, root: Path) -> None:
    """Validate release content.

    Args:
        release: Candidate release to validate.
        root: Repository or filesystem root searched by the operation.
    """
    expected = release["content_hashes"]
    actual_files = {
        path.relative_to(root).as_posix(): path
        for path in root.rglob("*")
        if path.is_file()
    }
    if set(actual_files) != set(expected):
        missing = sorted(set(expected) - set(actual_files))
        extra = sorted(set(actual_files) - set(expected))
        raise ValueError(f"Atlaso release content set mismatch; missing={missing}; extra={extra}")
    for relative, path in actual_files.items():
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        if not hmac.compare_digest(digest, str(expected[relative]).lower()):
            raise ValueError(f"Atlaso release content SHA256 mismatch for {relative}")


def _install_release_venv(release_root: Path, abi: str) -> list[dict]:
    """Perform install release venv.

    Args:
        release_root: Filesystem path associated with release root.
        abi: Abi consumed by install release venv.
    """
    wheelhouse = release_root / "wheelhouse" / abi
    lock_path = wheelhouse / "requirements-wheelhouse.lock"
    application_wheels = sorted((release_root / "packages").glob("atlaso-*.whl"))
    if not wheelhouse.is_dir() or not any(wheelhouse.glob("*.whl")):
        raise ValueError(f"Atlaso release does not contain wheelhouse {abi}")
    if not lock_path.is_file() or len(application_wheels) != 1:
        raise ValueError("Atlaso release is missing its dependency lock or application wheel")
    venv_path = release_root / ".venv"
    temporary_venv = release_root / ".venv-new"
    if temporary_venv.exists():
        shutil.rmtree(temporary_venv)
    commands: list[dict] = []
    create = _command_payload([sys.executable, "-m", "venv", str(temporary_venv)])
    commands.append(create)
    if not create["success"]:
        return commands
    python = temporary_venv / "bin" / "python"
    env = os.environ.copy()
    env.update({"PIP_CONFIG_FILE": "/dev/null", "PIP_DISABLE_PIP_VERSION_CHECK": "1", "PIP_NO_INDEX": "1"})
    dependency_install = _command_payload(
        [
            str(python),
            "-m",
            "pip",
            "install",
            "--no-index",
            "--find-links",
            str(wheelhouse),
            "--require-hashes",
            "-r",
            str(lock_path),
        ],
        env=env,
    )
    commands.append(dependency_install)
    if not dependency_install["success"]:
        return commands
    application_install = _command_payload(
        [str(python), "-m", "pip", "install", "--no-index", "--no-deps", str(application_wheels[0])],
        env=env,
    )
    commands.append(application_install)
    if not application_install["success"]:
        return commands
    commands.extend(
        [
            _command_payload([str(python), "-m", "pip", "check"], env=env),
            _command_payload(
                [
                    str(python),
                    "-c",
                    "import atlaso.app.main, atlaso.app.worker, atlaso.app.appliance_console",
                ],
                env=env,
            ),
        ]
    )
    if not all(command["success"] for command in commands):
        return commands
    if venv_path.exists():
        shutil.rmtree(venv_path)
    os.replace(temporary_venv, venv_path)
    for root, directories, files in os.walk(venv_path):
        for directory in directories:
            Path(root, directory).chmod(0o755)
        for filename in files:
            path = Path(root, filename)
            path.chmod(0o755 if path.parent.name == "bin" else 0o644)
    return commands


def _atomic_symlink(target: Path, link: Path) -> None:
    """Perform atomic symlink.

    Args:
        target: Target resource or location affected by the operation.
        link: Filesystem path associated with link.
    """
    temporary = link.with_name(f".{link.name}.tmp")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    os.replace(temporary, link)
    _fsync_directory(link.parent)


def _fsync_directory(path: Path) -> None:
    """Persist directory-entry changes on appliance filesystems.

    Args:
        path: Directory whose entry changes must reach durable storage.
    """
    if os.name != "posix":
        return
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _fsync_file(path: Path) -> None:
    """Persist one regular file before an atomic rename.

    Args:
        path: Regular file to flush to durable storage.
    """
    if os.name != "posix":
        return
    with path.open("rb") as handle:
        os.fsync(handle.fileno())


def _sync_release_transaction_backups(
    backup_root: Path,
    database_backup: Path,
    file_backups: list[tuple[Path | None, Path]],
) -> None:
    """Flush every rollback backup and directory entry before checkpoint publication.

    Args:
        backup_root: Bounded transaction backup directory.
        database_backup: Complete SQLite backup for the transaction.
        file_backups: Installed-asset backup and destination pairs.

    Raises:
        ValueError: If a declared backup is missing or outside the transaction root.
    """
    resolved_root = backup_root.resolve(strict=True)
    if backup_root.is_symlink() or not database_backup.is_file() or database_backup.is_symlink():
        raise ValueError("release transaction database backup is not a regular file")
    backup_files = [database_backup]
    backup_files.extend(backup for backup, _destination in file_backups if backup is not None)
    directories: set[Path] = set()
    for backup in backup_files:
        if not backup.is_file() or backup.is_symlink():
            raise ValueError("release transaction asset backup is not a regular file")
        resolved_backup = backup.resolve(strict=True)
        if not resolved_backup.is_relative_to(resolved_root):
            raise ValueError("release transaction asset backup is outside the backup root")
        _fsync_file(resolved_backup)
        parent = resolved_backup.parent
        while True:
            directories.add(parent)
            if parent == resolved_root:
                break
            parent = parent.parent
    for directory in sorted(directories, key=lambda item: len(item.parts), reverse=True):
        _fsync_directory(directory)
    _fsync_directory(resolved_root.parent)


def _active_release_root() -> Path:
    """Perform active release root.

    """
    if not ATLASO_CURRENT_LINK.is_symlink():
        raise ValueError("Atlaso current release link is missing")
    if not ATLASO_VENV_LINK.is_symlink():
        raise ValueError("Atlaso virtualenv link is missing")
    release_root = ATLASO_CURRENT_LINK.resolve()
    if ATLASO_VENV_LINK.resolve() != (release_root / ".venv").resolve():
        raise ValueError("Atlaso virtualenv link does not match the active release")
    return release_root


def _sqlite_backup(destination: Path) -> None:
    """Perform sqlite backup.

    Args:
        destination: Destination object or location receiving the result.
    """
    destination.parent.mkdir(parents=True, exist_ok=True)
    if not ATLASO_DATABASE_PATH.exists():
        return
    source = sqlite3.connect(ATLASO_DATABASE_PATH)
    backup = sqlite3.connect(destination)
    try:
        source.backup(backup)
        backup.commit()
    finally:
        backup.close()
        source.close()
    destination.chmod(0o600)


def _restore_sqlite_backup(source: Path) -> None:
    """Perform restore sqlite backup.

    Args:
        source: Source object or location from which data is obtained.
    """
    if not source.is_file():
        raise FileNotFoundError("Atlaso release database backup is unavailable")
    for suffix in ("", "-wal", "-shm"):
        Path(f"{ATLASO_DATABASE_PATH}{suffix}").unlink(missing_ok=True)
    shutil.copy2(source, ATLASO_DATABASE_PATH)


def _service_command(action: str, *units: str) -> dict:
    """Perform service command.

    Args:
        action: Action consumed by service command.
        *units: Additional positional arguments accepted by the callable.
    """
    systemctl = _command_path("systemctl") or "systemctl"
    return _command_payload([systemctl, action, *units])


def _wait_for_atlaso_health(timeout_seconds: int = 60) -> dict:
    """Perform wait for atlaso health.

    Args:
        timeout_seconds: Timeout duration in seconds.
    """
    deadline = time.monotonic() + timeout_seconds
    error = ""
    while time.monotonic() < deadline:
        try:
            with urlopen("http://127.0.0.1:8000/openapi.json", timeout=3) as response:
                if response.status == 200:
                    return {
                        "command": ["health-check", "http://127.0.0.1:8000/openapi.json"],
                        "returncode": 0,
                        "success": True,
                        "stdout": "Atlaso OpenAPI readiness passed.",
                        "stderr": "",
                    }
        except Exception as exc:  # noqa: BLE001 - readiness retries until its bounded deadline.
            error = str(exc)
        time.sleep(1)
    return {
        "command": ["health-check", "http://127.0.0.1:8000/openapi.json"],
        "returncode": 1,
        "success": False,
        "stdout": "",
        "stderr": f"Atlaso readiness did not pass within {timeout_seconds} seconds: {error}",
    }


def _release_data_disk_platform() -> str:
    """Select the signed data-disk policy that matches the installed appliance.

    New portable artifacts carry a verified first-boot provider marker and share
    the four-disk policy. Appliances installed before that contract retain their
    legacy VMware or three-disk Hyper-V policy across an update.

    Raises:
        ValueError: If platform evidence is missing, malformed, or contradictory.
    """
    marker = ATLASO_GUEST_AGENT_MARKER_PATH
    if marker.is_symlink():
        raise ValueError("Atlaso guest-agent platform marker must not be a symlink")
    if marker.exists():
        if not marker.is_file():
            raise ValueError("Atlaso guest-agent platform marker must be an ordinary file")
        try:
            marker_lines = marker.read_text(encoding="utf-8").splitlines()
        except OSError as exc:
            raise ValueError("Atlaso guest-agent platform marker cannot be read") from exc
        if len(marker_lines) != 1 or marker_lines[0] not in {
            "platform=vmware",
            "platform=qemu",
            "platform=hyperv",
            "platform=baremetal",
        }:
            raise ValueError("Atlaso guest-agent platform marker is invalid")
        return "virtualization"

    evidence: set[str] = set()
    if ATLASO_VMWARE_OVF_UNIT_PATH.is_file():
        evidence.add("vmware")
    if ATLASO_HYPERV_GENERATOR_PATH.is_symlink():
        try:
            if os.readlink(ATLASO_HYPERV_GENERATOR_PATH) == "/dev/null":
                evidence.add("hyperv")
        except OSError:
            pass

    if ATLASO_DATA_DISK_POLICY_PATH.is_file():
        policy = ATLASO_DATA_DISK_POLICY_PATH.read_text(encoding="utf-8")
        if "ATLASO_DEPOT_SCSI_TUPLE=0:2:0" in policy and "ATLASO_BACKUP_SCSI_TUPLE=0:3:0" in policy:
            evidence.add("vmware")
        if "ATLASO_DEPOT_SCSI_TUPLE=0:0:1" in policy and "ATLASO_BACKUP_SCSI_TUPLE=0:0:2" in policy:
            evidence.add("hyperv")

    vendor = (
        ATLASO_DMI_SYS_VENDOR_PATH.read_text(encoding="utf-8").strip().casefold()
        if ATLASO_DMI_SYS_VENDOR_PATH.is_file()
        else ""
    )
    product = (
        ATLASO_DMI_PRODUCT_NAME_PATH.read_text(encoding="utf-8").strip().casefold()
        if ATLASO_DMI_PRODUCT_NAME_PATH.is_file()
        else ""
    )
    if "vmware" in vendor or "vmware" in product:
        evidence.add("vmware")
    if "microsoft" in vendor and product == "virtual machine":
        evidence.add("hyperv")

    if len(evidence) != 1:
        detail = ", ".join(sorted(evidence)) or "none"
        raise ValueError(f"Atlaso release cannot select a data-disk policy from platform evidence: {detail}")
    return evidence.pop()


def _install_release_owned_files(
    release_root: Path,
    backup_root: Path,
    *,
    before_install: Callable[[list[tuple[Path | None, Path]]], None] | None = None,
) -> list[tuple[Path | None, Path]]:
    """Perform install release owned files.

    Args:
        release_root: Filesystem path associated with release root.
        backup_root: Filesystem path associated with backup root.
        before_install: Durable checkpoint callback invoked after backup and before mutation.
    """
    data_disk_platform = _release_data_disk_platform()
    owned = [
        (release_root / "bin/atlaso-helper", Path("/opt/atlaso/bin/atlaso-helper"), 0o755),
        (release_root / "THIRD_PARTY_NOTICES.md", ATLASO_NOTICE_PATH, 0o644),
        (release_root / "systemd/atlaso.service", Path("/etc/systemd/system/atlaso.service"), 0o644),
        (release_root / "systemd/atlaso-worker.service", Path("/etc/systemd/system/atlaso-worker.service"), 0o644),
        (release_root / "systemd/atlaso-console.service", Path("/etc/systemd/system/atlaso-console.service"), 0o644),
        *_release_first_boot_owned_files(release_root),
        *_release_data_disk_owned_files(release_root, data_disk_platform),
    ]
    trust = release_root / "trust"
    if trust.is_dir():
        for key in trust.glob("*.pem"):
            owned.append((key, ATLASO_UPDATE_TRUST_DIR / key.name, 0o644))

    backups: list[tuple[Path | None, Path]] = []
    for source, destination, _mode in owned:
        if not source.is_file():
            raise ValueError(f"Atlaso release is missing {source.relative_to(release_root)}")
        if (
            destination.parent == ATLASO_UPDATE_TRUST_DIR
            and destination.exists()
            and destination.read_bytes() != source.read_bytes()
        ):
            raise ValueError(f"Atlaso release cannot replace trusted key {destination.stem}")
        backup = backup_root / Path(*destination.parts[1:])
        if destination.exists():
            backup.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(destination, backup)
            backups.append((backup, destination))
        else:
            backups.append((None, destination))

    if before_install is not None:
        before_install(backups)
    try:
        for source, destination, mode in owned:
            destination.parent.mkdir(parents=True, exist_ok=True)
            temporary = destination.with_suffix(destination.suffix + ".update")
            shutil.copy2(source, temporary)
            temporary.chmod(mode)
            os.replace(temporary, destination)
    except Exception as exc:
        restore_results = _restore_release_owned_files(backups)
        if not all(item.get("success") for item in restore_results):
            raise ValueError("Atlaso release asset installation failed and rollback was incomplete") from exc
        raise
    return backups


def _release_first_boot_owned_files(release_root: Path) -> list[tuple[Path, Path, int]]:
    """Return first-boot executables and units owned by signed appliance updates.

    Args:
        release_root: Verified extracted release root.
    """

    return [
        (release_root / "bin/atlaso-select-guest-agent", ATLASO_GUEST_AGENT_SELECTOR_PATH, 0o755),
        (
            release_root / "bin/atlaso-initialize-machine-identity.py",
            ATLASO_MACHINE_IDENTITY_INITIALIZER_PATH,
            0o755,
        ),
        (
            release_root / "systemd/atlaso-guest-agent-select.service",
            ATLASO_GUEST_AGENT_SELECT_UNIT_PATH,
            0o644,
        ),
    ]


def _release_data_disk_owned_files(release_root: Path, platform: str) -> list[tuple[Path, Path, int]]:
    """Return every release asset required by the data-disk safety boundary.

    Args:
        release_root: Verified extracted release root.
        platform: Exact signed policy name selected from installed-appliance evidence.
    """
    unit_name = "atlaso-data-disks.service" if platform == "virtualization" else "atlaso-data-disks-legacy.service"
    return [
        (release_root / "bin/atlaso-mount-data-disks", ATLASO_MOUNT_DATA_DISKS_PATH, 0o755),
        (release_root / f"systemd/{unit_name}", ATLASO_DATA_DISK_UNIT_PATH, 0o644),
        (
            release_root / "systemd/atlaso.service.d/atlaso-data-disks.conf",
            ATLASO_SERVICE_DATA_DISK_DROPIN_PATH,
            0o644,
        ),
        (release_root / "systemd/atlaso-bootstrap-https.service", ATLASO_BOOTSTRAP_HTTPS_UNIT_PATH, 0o644),
        (
            release_root / "systemd/nginx.service.d/atlaso-data-disks.conf",
            ATLASO_NGINX_DATA_DISK_DROPIN_PATH,
            0o644,
        ),
        (release_root / "udev/99-atlaso-disk-identity.rules", ATLASO_DISK_IDENTITY_UDEV_PATH, 0o644),
        (release_root / f"data-disks/{platform}.conf", ATLASO_DATA_DISK_POLICY_PATH, 0o644),
    ]


def _data_disk_safety_bootstrap_is_complete() -> bool:
    """Return whether the one-time previous-updater compatibility bridge completed."""
    if ATLASO_DATA_DISK_BOOTSTRAP_MARKER_PATH.is_symlink():
        return False
    try:
        payload = json.loads(ATLASO_DATA_DISK_BOOTSTRAP_MARKER_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    return payload == {"schema_version": 1, "status": "complete"}


def _record_data_disk_safety_bootstrap_complete() -> None:
    """Atomically persist completion of the previous-updater compatibility bridge."""
    marker = ATLASO_DATA_DISK_BOOTSTRAP_MARKER_PATH
    marker.parent.mkdir(parents=True, exist_ok=True)
    temporary = marker.with_name(f".{marker.name}.{uuid.uuid4().hex}.tmp")
    try:
        temporary.write_text(
            json.dumps({"schema_version": 1, "status": "complete"}, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        temporary.chmod(0o600)
        os.replace(temporary, marker)
    finally:
        temporary.unlink(missing_ok=True)


def _bootstrap_release_data_disk_safety(release_root: Path) -> list[dict]:
    """Transactionally migrate, install, and validate safety for a previous updater.

    Args:
        release_root: Active verified release root selected by the previous updater.

    Raises:
        ValueError: If the root is not active or the transaction cannot validate or roll back.
    """
    resolved_release = release_root.resolve(strict=True)
    if not ATLASO_CURRENT_LINK.is_symlink() or ATLASO_CURRENT_LINK.resolve(strict=True) != resolved_release:
        raise ValueError("data-disk safety bootstrap requires the active Atlaso release")
    if not resolved_release.is_relative_to(ATLASO_RELEASES_DIR.resolve(strict=True)):
        raise ValueError("data-disk safety bootstrap release is outside the signed release directory")
    if _data_disk_safety_bootstrap_is_complete():
        return []
    metadata_path = resolved_release / "bundle-metadata.json"
    if metadata_path.is_file():
        try:
            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as exc:
            raise ValueError("data-disk safety bootstrap release metadata is invalid") from exc
        if isinstance(metadata, dict) and metadata.get("bootstrap") is True:
            version = metadata.get("version")
            if not isinstance(version, str) or resolved_release.name != f"bootstrap-{version}":
                raise ValueError("data-disk safety bootstrap image-release identity is invalid")
            # Image provisioning installs and validates these assets directly from the staged repository.
            # The pre-start hook exists only to bridge signed candidates through an older updater.
            _record_data_disk_safety_bootstrap_complete()
            return []
    assets = _release_data_disk_owned_files(resolved_release, _release_data_disk_platform())
    for source, _destination, _mode in assets:
        if not source.is_file():
            raise ValueError(f"Atlaso release is missing {source.relative_to(resolved_release)}")

    backup_root = ATLASO_UPDATE_BACKUP_DIR / f"data-disk-bootstrap-{uuid.uuid4().hex}"
    backup_root.mkdir(parents=True)
    backup_root.chmod(0o700)
    database_backup = backup_root / "atlaso.db"
    database_backed_up = False
    backups: list[tuple[Path | None, Path]] = []
    temporary_paths: list[Path] = []
    commands: list[dict] = []
    systemctl = _command_path("systemctl") or "systemctl"
    try:
        database_backed_up = ATLASO_DATABASE_PATH.is_file()
        if database_backed_up:
            _sqlite_backup(database_backup)
        for _source, destination, _mode in assets:
            backup = backup_root.joinpath(*destination.parts[1:])
            if destination.exists():
                backup.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(destination, backup)
                backups.append((backup, destination))
            else:
                backups.append((None, destination))
        for source, destination, mode in assets:
            destination.parent.mkdir(parents=True, exist_ok=True)
            if (
                destination.is_file()
                and destination.read_bytes() == source.read_bytes()
                and destination.stat().st_mode & 0o777 == mode
            ):
                continue
            temporary = destination.with_suffix(destination.suffix + ".bootstrap")
            temporary_paths.append(temporary)
            shutil.copy2(source, temporary)
            temporary.chmod(mode)
            os.replace(temporary, destination)
        _migrate_release_esx_storage_claims(backup_root, backups)
        commands = _refresh_release_data_disk_identity(validate=True)
        if not all(command["success"] for command in commands):
            raise ValueError("release data-disk safety bootstrap validation failed")
        commands.append(_command_payload([systemctl, "daemon-reload"]))
        if not all(command["success"] for command in commands):
            raise ValueError("release data-disk safety bootstrap daemon reload failed")
        _record_data_disk_safety_bootstrap_complete()
        return commands
    except Exception as exc:
        rollback_errors: list[str] = []
        try:
            if database_backed_up:
                _restore_sqlite_backup(database_backup)
        except OSError as rollback_exc:
            rollback_errors.append(f"database restore failed: {rollback_exc}")
        for backup, destination in reversed(backups):
            try:
                if backup is None:
                    destination.unlink(missing_ok=True)
                else:
                    shutil.copy2(backup, destination)
            except OSError as rollback_exc:
                rollback_errors.append(f"asset restore failed for {destination}: {rollback_exc}")
        rollback_commands = _refresh_release_data_disk_identity(validate=False)
        rollback_commands.append(_command_payload([systemctl, "daemon-reload"]))
        rollback_errors.extend(
            str(command.get("stderr") or "data-disk safety rollback command failed")
            for command in rollback_commands
            if not command["success"]
        )
        if rollback_errors:
            raise ValueError(
                "release data-disk safety bootstrap failed and rollback was incomplete: "
                + "; ".join(rollback_errors)
            ) from exc
        raise ValueError("release data-disk safety bootstrap failed; prior safety state restored") from exc
    finally:
        for temporary in temporary_paths:
            temporary.unlink(missing_ok=True)
        shutil.rmtree(backup_root, ignore_errors=True)


def _restore_release_owned_files(backups: list[tuple[Path | None, Path]]) -> list[dict]:
    """Restore every release-owned asset independently and return bounded evidence.

    Args:
        backups: Filesystem path associated with backups.
    """
    results: list[dict] = []
    for backup, destination in backups:
        try:
            if backup is None:
                destination.unlink(missing_ok=True)
            else:
                shutil.copy2(backup, destination)
        except Exception as exc:  # noqa: BLE001 - later rollback assets must still be attempted.
            results.append(
                _release_check(
                    "asset_restore",
                    False,
                    f"Release asset restore raised {type(exc).__name__}.",
                    destination=str(destination),
                )
            )
        else:
            results.append(
                _release_check(
                    "asset_restore",
                    True,
                    "Release asset restore completed.",
                    destination=str(destination),
                )
            )
    return results


def _validated_release_recovery_context(finalizer: dict) -> dict[str, object]:
    """Validate and return the bounded rollback context from a provisional finalizer.

    Args:
        finalizer: Root-owned provisional release transaction evidence.

    Raises:
        ValueError: If any recovery path or field is outside the release transaction contract.
    """
    recovery = finalizer.get("transaction_recovery")
    if not isinstance(recovery, dict) or recovery.get("schema_version") != 1:
        raise ValueError("provisional release finalizer has no supported recovery manifest")
    releases_root = ATLASO_RELEASES_DIR.resolve(strict=True)
    backups_root = ATLASO_UPDATE_BACKUP_DIR.resolve(strict=True)
    previous = Path(str(recovery.get("previous_release") or "")).resolve(strict=True)
    candidate = Path(str(recovery.get("candidate_release") or "")).resolve(strict=True)
    backup_root = Path(str(recovery.get("backup_root") or "")).resolve(strict=True)
    database_backup = Path(str(recovery.get("database_backup") or "")).resolve(strict=True)
    if previous.parent != releases_root or candidate.parent != releases_root or previous == candidate:
        raise ValueError("provisional release recovery directories are outside the release root")
    if not previous.is_dir() or previous.is_symlink() or not candidate.is_dir() or candidate.is_symlink():
        raise ValueError("provisional release recovery requires ordinary release directories")
    if not backup_root.is_dir() or backup_root.is_symlink() or not backup_root.is_relative_to(backups_root):
        raise ValueError("provisional release backup root is invalid")
    if database_backup != (backup_root / "atlaso.db").resolve(strict=True):
        raise ValueError("provisional release database backup is invalid")
    database_backed_up = recovery.get("database_backed_up") is True
    if not database_backed_up:
        raise ValueError("provisional release recovery has no complete database backup")

    allowed_destinations = {
        Path("/opt/atlaso/bin/atlaso-helper"),
        ATLASO_NOTICE_PATH,
        Path("/etc/systemd/system/atlaso.service"),
        Path("/etc/systemd/system/atlaso-worker.service"),
        Path("/etc/systemd/system/atlaso-console.service"),
        ATLASO_MOUNT_DATA_DISKS_PATH,
        ATLASO_DATA_DISK_UNIT_PATH,
        ATLASO_SERVICE_DATA_DISK_DROPIN_PATH,
        ATLASO_BOOTSTRAP_HTTPS_UNIT_PATH,
        ATLASO_NGINX_DATA_DISK_DROPIN_PATH,
        ATLASO_DISK_IDENTITY_UDEV_PATH,
        ATLASO_DATA_DISK_POLICY_PATH,
        ESX_STORAGE_DISK_ALLOWLIST_PATH,
    }
    raw_file_backups = recovery.get("file_backups")
    if not isinstance(raw_file_backups, list) or not raw_file_backups:
        raise ValueError("provisional release recovery has no installed-asset manifest")
    file_backups: list[tuple[Path | None, Path]] = []
    for item in raw_file_backups:
        if not isinstance(item, dict):
            raise ValueError("provisional release installed-asset manifest is invalid")
        destination = Path(str(item.get("destination") or ""))
        trusted_key = (
            destination.parent == ATLASO_UPDATE_TRUST_DIR
            and destination.suffix == ".pem"
            and destination.name not in {"", ".", ".."}
        )
        if destination not in allowed_destinations and not trusted_key:
            raise ValueError("provisional release installed-asset destination is not allowlisted")
        backup_text = str(item.get("backup") or "")
        if backup_text:
            backup = Path(backup_text).resolve(strict=True)
            expected_backup = backup_root.joinpath(*destination.parts[1:]).resolve(strict=True)
            if backup != expected_backup or not backup.is_file():
                raise ValueError("provisional release installed-asset backup is invalid")
        else:
            backup = None
        file_backups.append((backup, destination))
    return {
        "previous": previous,
        "candidate": candidate,
        "backup_root": backup_root,
        "database_backup": database_backup,
        "file_backups": file_backups,
    }


def _run_candidate_release_recovery(candidate: Path) -> dict:
    """Run rollback bookkeeping once through the retained candidate release.

    Args:
        candidate: Validated candidate release retained until bookkeeping completes.

    Returns:
        Sanitized command evidence for the one-shot candidate worker.
    """
    python = candidate / ".venv/bin/python"
    systemd_run = shutil.which("systemd-run")
    if not python.is_file() or systemd_run is None or not ATLASO_ENV_PATH.is_file():
        return _release_check(
            "candidate_recovery_bookkeeping",
            False,
            "Candidate recovery requires its Python environment, systemd-run, and the Atlaso environment file.",
        )
    command = [
        systemd_run,
        "--quiet",
        "--wait",
        "--pipe",
        "--collect",
        "--service-type=exec",
        f"--unit=atlaso-release-recovery-{os.getpid()}",
        f"--uid={ATLASO_SERVICE_USER}",
        f"--gid={ATLASO_SERVICE_USER}",
        f"--property=WorkingDirectory={ATLASO_STATE_DIR}",
        f"--property=EnvironmentFile={ATLASO_ENV_PATH}",
        "--setenv=HOME=/var/lib/atlaso",
        f"--setenv=LOGNAME={ATLASO_SERVICE_USER}",
        f"--setenv=USER={ATLASO_SERVICE_USER}",
        "--setenv=PYTHONDONTWRITEBYTECODE=1",
        "--setenv=ATLASO_RELEASE_RECOVERY_ONLY=1",
        str(python),
        "-m",
        "atlaso.app.worker",
    ]
    result = _run(command, timeout=1800)
    return {
        "command": command,
        "returncode": result.returncode,
        "success": result.returncode == 0,
        "stdout": result.stdout[-4000:],
        "stderr": result.stderr[-4000:],
        "layer": "candidate_recovery_bookkeeping",
    }


def _complete_committed_release_activation(parsed: dict) -> dict:
    """Finish a release whose database and active release may no longer be rolled back.

    Args:
        parsed: Durable activation-commit evidence written while maintenance was held.
    """
    commands = [command for command in parsed.get("commands", []) if isinstance(command, dict)]
    job_id = str(parsed.get("job_id") or "")
    try:
        context = _validated_release_recovery_context(parsed)
        candidate = context["candidate"]
        assert isinstance(candidate, Path)
        receipt = json.loads((candidate / ".release-manifest.json").read_text(encoding="utf-8"))
        if not isinstance(receipt, dict):
            raise ValueError("candidate release receipt is not an object")
        gate_job_id = ATLASO_UPDATE_RESTART_GATE_PATH.read_text(encoding="utf-8").strip()
        if not job_id or gate_job_id != job_id:
            raise ValueError("release restart gate does not match committed activation")
        if _active_release_root().resolve(strict=True) != candidate.resolve(strict=True):
            raise ValueError("committed candidate is no longer the active release")
        maintenance = _set_release_maintenance(True)
        commands.append(maintenance)
        if not maintenance.get("success"):
            raise ValueError("committed activation could not retain maintenance mode")
        durable = _sync_release_activation()
        commands.append(durable)
        if not durable.get("success"):
            raise ValueError("committed activation could not be persisted")
        internal, internal_commands = _release_activation_verification(
            candidate,
            receipt,
            maintenance_expected=True,
            include_front_door=False,
        )
        commands.extend(internal_commands)
        if not internal.get("success"):
            raise ValueError(
                "committed activation failed internal verification at "
                f"{internal.get('failure_layer') or 'unknown'}"
            )
        maintenance_cleanup = _set_release_maintenance(False)
        commands.append(maintenance_cleanup)
        if not maintenance_cleanup.get("success"):
            raise ValueError("committed activation could not open the management front door")
        activation, activation_commands = _release_activation_verification(candidate, receipt)
        commands.extend(activation_commands)
        if not activation.get("success"):
            raise ValueError(
                "committed activation failed host-facing verification at "
                f"{activation.get('failure_layer') or 'unknown'}"
            )
        definitive = {
            **parsed,
            "status": "succeeded",
            "rolled_back": False,
            "service_health": True,
            "commands": commands,
            "active_release_verification": activation,
            "finished_at": datetime.now(timezone.utc).isoformat(),
        }
        _write_release_finalizer(definitive)
        _write_update_info(definitive)
        _set_release_restart_gate(False)
        return {**definitive, "success": True, "allow_worker": True}
    except Exception as exc:  # noqa: BLE001 - committed activation must fail forward.
        maintenance = _set_release_maintenance(True)
        commands.append(maintenance)
        committed = {
            **parsed,
            "status": "activation_committed",
            "success": False,
            "rolled_back": False,
            "failure_layer": "committed_activation",
            "commands": commands,
            "error": f"Committed Atlaso release activation requires retry: {type(exc).__name__}.",
        }
        try:
            _write_release_finalizer(committed)
            _write_update_info(committed)
        except OSError:
            pass
        return {**committed, "allow_worker": False}


def _finish_committed_release_after_worker_start() -> dict:
    """Wait for the rebooted candidate worker, then finish forward activation."""
    try:
        parsed = json.loads(ATLASO_UPDATE_FINALIZER_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        return {
            "status": "activation_committed",
            "success": False,
            "allow_worker": False,
            "error": f"Committed activation evidence could not be read: {type(exc).__name__}.",
        }
    if not isinstance(parsed, dict) or str(parsed.get("status") or "") != "activation_committed":
        return {
            "status": "activation_committed",
            "success": False,
            "allow_worker": False,
            "error": "Committed activation evidence is no longer pending.",
        }
    context = _validated_release_recovery_context(parsed)
    candidate = context["candidate"]
    assert isinstance(candidate, Path)
    commands = [command for command in parsed.get("commands", []) if isinstance(command, dict)]
    worker_activation = _wait_for_worker_activation(
        expected_version=str(parsed.get("candidate_version") or ""),
        expected_release=candidate,
        expected_job_id=str(parsed.get("job_id") or ""),
        previous_pid=0,
        timeout_seconds=300,
    )
    commands.append(worker_activation)
    parsed = {**parsed, "commands": commands, "worker_restart": worker_activation}
    if not worker_activation.get("success"):
        parsed.update(
            {
                "success": False,
                "rolled_back": False,
                "failure_layer": "committed_worker_activation",
                "error": "Committed activation could not prove the rebooted candidate worker.",
            }
        )
        _write_release_finalizer(parsed)
        _write_update_info(parsed)
        return {**parsed, "allow_worker": False}
    return _complete_committed_release_activation(parsed)


def _schedule_committed_release_completion(job_id: str) -> dict:
    """Schedule root-owned forward completion and return its exact process owner.

    Args:
        job_id: Appliance Update job used to derive the stable transient-unit name.
    """
    unit = f"atlaso-release-forward-{hashlib.sha256(job_id.encode('utf-8')).hexdigest()[:16]}"
    scheduled = _command_payload(
        [
            "systemd-run",
            "--unit",
            unit,
            "--collect",
            "--no-block",
            "--property=Type=oneshot",
            "--property=TimeoutStartSec=30min",
            "/opt/atlaso/bin/atlaso-helper",
            "appliance-update",
            "complete-committed-release",
            "--real",
        ]
    )
    if not scheduled.get("success"):
        return scheduled
    for _attempt in range(50):
        owner = _running_worker_process_identity(_service_main_pid(f"{unit}.service"))
        if owner:
            return {**scheduled, "unit": f"{unit}.service", "owner": owner}
        time.sleep(0.1)
    return {
        **scheduled,
        "returncode": 1,
        "success": False,
        "stderr": "Committed activation completion did not publish a live process identity.",
        "unit": f"{unit}.service",
    }


def _recover_interrupted_release_transaction() -> dict:
    """Rollback a stale provisional release transaction before the worker starts."""
    status_guard = _guard_appliance_update_status_startup()
    if status_guard.get("success") is not True:
        return {
            "status": "status_recovery_failed",
            "success": False,
            "allow_worker": False,
            "error": str(
                status_guard.get("error")
                or "Update-only status recovery must complete before the worker starts."
            ),
        }
    try:
        parsed = json.loads(ATLASO_UPDATE_FINALIZER_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"status": "not_required", "success": True, "allow_worker": True}
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        return {
            "status": "recovery_failed",
            "success": False,
            "allow_worker": False,
            "error": f"Release recovery finalizer could not be read: {type(exc).__name__}.",
        }
    if not isinstance(parsed, dict):
        return {
            "status": "recovery_failed",
            "success": False,
            "allow_worker": False,
            "error": "Release recovery finalizer is not a JSON object.",
        }
    status = str(parsed.get("status") or "")
    if status == "activation_committed":
        recovery = parsed.get("transaction_recovery")
        owner = recovery.get("owner") if isinstance(recovery, dict) else None
        if _release_transaction_owner_alive(owner):
            return {
                "status": "transaction_active",
                "success": True,
                "allow_worker": True,
                "job_id": str(parsed.get("job_id") or ""),
            }
        commands = [command for command in parsed.get("commands", []) if isinstance(command, dict)]
        job_id = str(parsed.get("job_id") or "")
        try:
            _validated_release_recovery_context(parsed)
            _set_release_restart_gate(True, job_id)
            maintenance = _set_release_maintenance(True)
            commands.append(maintenance)
            if not maintenance.get("success"):
                raise ValueError("committed activation could not restore maintenance mode")
            scheduled = _schedule_committed_release_completion(job_id)
            commands.append(scheduled)
            if not scheduled.get("success"):
                raise ValueError("committed activation completion could not be scheduled")
            forward_owner = scheduled.get("owner")
            if not isinstance(forward_owner, dict):
                raise ValueError("committed activation completion has no live process identity")
            pending_recovery = dict(recovery) if isinstance(recovery, dict) else {}
            pending_recovery["owner"] = forward_owner
            pending = {
                **parsed,
                "commands": commands,
                "transaction_recovery": pending_recovery,
            }
            _write_release_finalizer(pending)
            _write_update_info(pending)
            return {
                **pending,
                "status": "activation_committed",
                "success": True,
                "allow_worker": True,
            }
        except Exception as exc:  # noqa: BLE001 - pre-start recovery must fail closed.
            failed = {
                **parsed,
                "status": "activation_committed",
                "success": False,
                "rolled_back": False,
                "commands": commands,
                "failure_layer": "committed_activation_handoff",
                "error": f"Committed activation handoff requires retry: {type(exc).__name__}.",
            }
            try:
                _write_release_finalizer(failed)
                _write_update_info(failed)
            except OSError:
                pass
            return {**failed, "allow_worker": False}
    provisional = status in {"transaction_pending", "restart_pending", "rollback_pending"}
    if not provisional:
        if ATLASO_UPDATE_RESTART_GATE_PATH.exists():
            definitive = status == "succeeded" or (
                status == "failed" and parsed.get("rolled_back") is True
            )
            try:
                gate_job_id = ATLASO_UPDATE_RESTART_GATE_PATH.read_text(encoding="utf-8").strip()
            except OSError as exc:
                return {
                    "status": "recovery_failed",
                    "success": False,
                    "allow_worker": False,
                    "error": f"Release restart gate could not be read: {type(exc).__name__}.",
                }
            finalizer_job_id = str(parsed.get("job_id") or "")
            if not definitive or not finalizer_job_id or gate_job_id != finalizer_job_id:
                return {
                    "status": "recovery_failed",
                    "success": False,
                    "allow_worker": False,
                    "error": "Release restart gate has no matching definitive transaction evidence.",
                }
            _set_release_restart_gate(False)
        return {"status": "not_required", "success": True, "allow_worker": True}
    recovery = parsed.get("transaction_recovery")
    owner = recovery.get("owner") if isinstance(recovery, dict) else None
    if _release_transaction_owner_alive(owner):
        allow_worker = status == "restart_pending"
        return {
            "status": "transaction_active",
            "success": allow_worker,
            "allow_worker": allow_worker,
            "job_id": str(parsed.get("job_id") or ""),
        }

    commands = [command for command in parsed.get("commands", []) if isinstance(command, dict)]
    rollback_failures: list[str] = []

    def recovery_action(layer: str, action: Callable[[], object]) -> tuple[bool, object | None]:
        """Run one reboot-recovery action and preserve sanitized evidence.

        Args:
            layer: Stable recovery layer represented by the action.
            action: Recovery operation to execute.
        """
        try:
            result = action()
        except Exception as exc:  # noqa: BLE001 - recovery must retain every failure.
            evidence = _release_check(
                f"reboot_rollback_{layer}",
                False,
                f"Reboot rollback {layer.replace('_', ' ')} raised {type(exc).__name__}.",
            )
            commands.append(evidence)
            rollback_failures.append(str(evidence["layer"]))
            return False, None
        if isinstance(result, list):
            commands.extend(item for item in result if isinstance(item, dict))
            success = all(isinstance(item, dict) and item.get("success") for item in result)
        elif isinstance(result, dict):
            result.setdefault("layer", f"reboot_rollback_{layer}")
            commands.append(result)
            success = bool(result.get("success"))
        else:
            success = True
            commands.append(
                _release_check(
                    f"reboot_rollback_{layer}",
                    True,
                    f"Reboot rollback {layer.replace('_', ' ')} completed.",
                )
            )
        if not success:
            rollback_failures.append(f"reboot_rollback_{layer}")
        return success, result

    try:
        context = _validated_release_recovery_context(parsed)
    except (OSError, ValueError) as exc:
        evidence = _release_check(
            "reboot_rollback_manifest",
            False,
            f"Reboot rollback manifest validation failed: {exc}",
        )
        commands.append(evidence)
        rollback_failures.append(str(evidence["layer"]))
        return {
            "status": "recovery_failed",
            "success": False,
            "allow_worker": False,
            "rolled_back": False,
            "commands": commands,
            "rollback_failures": rollback_failures,
            "error": evidence["stderr"],
        }

    previous = context["previous"]
    candidate = context["candidate"]
    database_backup = context["database_backup"]
    file_backups = context["file_backups"]
    assert isinstance(previous, Path)
    assert isinstance(candidate, Path)
    assert isinstance(database_backup, Path)
    assert isinstance(file_backups, list)
    job_id = str(parsed.get("job_id") or "")
    gate_held, _ = recovery_action(
        "worker_restart_gate_hold",
        lambda: _set_release_restart_gate(True, job_id),
    )
    maintenance_held, _ = recovery_action("maintenance_hold", lambda: _set_release_maintenance(True))
    services_stopped, _ = recovery_action(
        "service_stop",
        lambda: _service_command("stop", "atlaso.service", "atlaso-console.service"),
    )
    link_restored, _ = recovery_action("release_link", lambda: _atomic_symlink(previous, ATLASO_CURRENT_LINK))
    database_restored, _ = recovery_action("database_restore", lambda: _restore_sqlite_backup(database_backup))
    assets_restored, _ = recovery_action("asset_restore", lambda: _restore_release_owned_files(file_backups))
    data_disk_restored, _ = recovery_action(
        "data_disk_identity",
        lambda: _refresh_release_data_disk_identity(validate=False),
    )
    systemd_reloaded, _ = recovery_action("systemd_reload", lambda: _service_command("daemon-reload"))
    services_started, _ = recovery_action(
        "service_start",
        lambda: _service_command("start", "atlaso.service", "atlaso-console.service"),
    )
    health_ready, _ = recovery_action("internal_health", _wait_for_atlaso_health)
    service_state_ready, service_state = recovery_action(
        "service_state",
        lambda: _service_command("is-active", "atlaso.service", "atlaso-console.service", "nginx.service"),
    )
    pre_cleanup_ready = all(
        (
            services_stopped,
            gate_held,
            maintenance_held,
            link_restored,
            database_restored,
            assets_restored,
            data_disk_restored,
            systemd_reloaded,
            services_started,
            health_ready,
            service_state_ready,
        )
    )
    durable_ready, _ = recovery_action("durable_activation", _sync_release_activation)
    previous_version = str(parsed.get("previous_version") or _release_root_version(previous))
    try:
        activation, activation_commands = _release_activation_verification(
            previous,
            {"version": previous_version},
            require_receipt=False,
            include_worker=False,
            maintenance_expected=True,
            include_front_door=False,
        )
        commands.extend(activation_commands)
    except Exception as exc:  # noqa: BLE001 - preserve fail-closed recovery evidence.
        activation = {
            "success": False,
            "candidate_version": previous_version,
            "failure_layer": "reboot_rollback_activation_verification",
        }
        evidence = _release_check(
            "reboot_rollback_activation_verification",
            False,
            f"Reboot rollback activation verification raised {type(exc).__name__}.",
        )
        commands.append(evidence)
        rollback_failures.append(str(evidence["layer"]))
    rollback_ready = bool(
        pre_cleanup_ready
        and durable_ready
        and activation.get("success")
    )
    if not rollback_ready:
        recovery_action("maintenance_fail_closed", lambda: _set_release_maintenance(True))
    error = "Atlaso release activation was interrupted by a host restart and required rollback."
    provisional = {
        **parsed,
        "status": "rollback_pending",
        "success": False,
        "rolled_back": False,
        "failure_layer": "reboot_recovery",
        "rollback_health": rollback_ready,
        "bookkeeping_pending": rollback_ready,
        "rollback_service_checks": service_state if isinstance(service_state, dict) else {},
        "commands": commands,
        "active_release_verification": activation,
        "rollback_failures": list(dict.fromkeys(rollback_failures)),
        "error": error,
    }
    try:
        _write_release_finalizer(provisional)
    except OSError as exc:
        maintenance = _set_release_maintenance(True)
        commands.append(maintenance)
        incomplete = {
            **provisional,
            "status": "rollback_pending",
            "rolled_back": False,
            "rollback_health": False,
            "bookkeeping_pending": False,
            "commands": commands,
            "rollback_failures": list(
                dict.fromkeys([*rollback_failures, "reboot_rollback_finalizer"])
            ),
        }
        try:
            _write_update_info(incomplete)
        except OSError:
            pass
        return {
            "status": "recovery_failed",
            "success": False,
            "allow_worker": False,
            "rolled_back": False,
            "commands": commands,
            "rollback_failures": incomplete["rollback_failures"],
            "error": f"Reboot rollback evidence could not be persisted: {type(exc).__name__}.",
        }
    try:
        _write_update_info(provisional)
    except OSError as exc:
        maintenance = _set_release_maintenance(True)
        commands.append(maintenance)
        provisional = {
            **provisional,
            "status": "rollback_pending",
            "rolled_back": False,
            "rollback_health": False,
            "bookkeeping_pending": False,
            "commands": commands,
            "rollback_failures": list(
                dict.fromkeys([*rollback_failures, "reboot_rollback_status"])
            ),
        }
        while True:
            try:
                _write_release_finalizer(provisional)
                break
            except OSError:
                # Never admit candidate bookkeeping without both provisional
                # rollback records; systemd may retry while maintenance and the
                # restart gate keep the restored worker and front door closed.
                time.sleep(1)
        return {
            "status": "recovery_failed",
            "success": False,
            "allow_worker": False,
            "rolled_back": False,
            "commands": commands,
            "rollback_failures": provisional["rollback_failures"],
            "error": f"Reboot rollback status could not be persisted: {type(exc).__name__}.",
        }
    if rollback_ready:
        bookkeeping_ready, _ = recovery_action(
            "candidate_bookkeeping",
            lambda: _run_candidate_release_recovery(candidate),
        )
        if not bookkeeping_ready:
            rollback_ready = False
            recovery_action("maintenance_fail_closed", lambda: _set_release_maintenance(True))
            provisional.update(
                {
                    "status": "rollback_pending",
                    "rolled_back": False,
                    "rollback_health": False,
                    "bookkeeping_pending": False,
                    "failure_layer": "reboot_recovery_bookkeeping",
                    "error": (
                        "Atlaso release rollback is healthy, but candidate-version recovery bookkeeping "
                        "did not complete."
                    ),
                }
            )
    if rollback_ready:
        maintenance_ready, _ = recovery_action(
            "maintenance_cleanup",
            lambda: _set_release_maintenance(False),
        )
        try:
            exposed_activation, exposed_commands = _release_activation_verification(
                previous,
                {"version": previous_version},
                require_receipt=False,
                include_worker=False,
            )
            commands.extend(exposed_commands)
        except Exception as exc:  # noqa: BLE001 - preserve fail-closed recovery evidence.
            exposed_activation = {
                "success": False,
                "candidate_version": previous_version,
                "failure_layer": "reboot_rollback_front_door_verification",
            }
            evidence = _release_check(
                "reboot_rollback_front_door_verification",
                False,
                f"Reboot rollback front-door verification raised {type(exc).__name__}.",
            )
            commands.append(evidence)
            rollback_failures.append(str(evidence["layer"]))
        rollback_ready = bool(maintenance_ready and exposed_activation.get("success"))
        if not rollback_ready:
            recovery_action("maintenance_fail_closed", lambda: _set_release_maintenance(True))
            provisional.update(
                {
                    "rollback_health": False,
                    "bookkeeping_pending": False,
                    "failure_layer": "reboot_recovery_front_door",
                    "active_release_verification": exposed_activation,
                    "error": "Atlaso release rollback bookkeeping completed, but the front door is not ready.",
                }
            )
    provisional["commands"] = commands
    provisional["rollback_failures"] = list(dict.fromkeys(rollback_failures))
    if not rollback_ready:
        try:
            _write_release_finalizer(provisional)
            _write_update_info(provisional)
        except OSError as exc:
            return {
                "status": "recovery_failed",
                "success": False,
                "allow_worker": False,
                "commands": commands,
                "rollback_failures": list(
                    dict.fromkeys([*rollback_failures, "reboot_rollback_finalizer"])
                ),
                "error": f"Reboot rollback evidence could not be persisted: {type(exc).__name__}.",
            }
        return {
            "status": "rollback_pending",
            "success": False,
            "allow_worker": False,
            "rolled_back": False,
            "commands": commands,
            "rollback_failures": provisional["rollback_failures"],
            "error": str(provisional["error"]),
        }
    definitive = {
        **provisional,
        "status": "failed",
        "rolled_back": True,
        "rollback_health": True,
        "bookkeeping_pending": False,
        "active_release_verification": exposed_activation,
        "finished_at": datetime.now(timezone.utc).isoformat(),
    }
    try:
        _write_release_finalizer(definitive)
        _write_update_info(definitive)
    except OSError as exc:
        return {
            "status": "recovery_failed",
            "success": False,
            "allow_worker": False,
            "commands": commands,
            "rollback_failures": list(dict.fromkeys([*rollback_failures, "reboot_rollback_finalizer"])),
            "error": f"Reboot rollback evidence could not be persisted: {type(exc).__name__}.",
        }
    _set_release_restart_gate(False)
    if ATLASO_CURRENT_LINK.is_symlink() and ATLASO_CURRENT_LINK.resolve(strict=True) == previous:
        shutil.rmtree(candidate, ignore_errors=True)
    return {
        "status": definitive["status"],
        "success": rollback_ready,
        "allow_worker": rollback_ready,
        "rolled_back": rollback_ready,
        "commands": commands,
        "rollback_failures": definitive["rollback_failures"],
        "error": str(definitive["error"]),
    }


def _guard_interrupted_release_startup() -> dict:
    """Hold the management front door before services start for stale release work."""
    status_guard = _guard_appliance_update_status_startup()
    if status_guard.get("success") is not True:
        return status_guard
    try:
        parsed = json.loads(ATLASO_UPDATE_FINALIZER_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return _release_check("release_startup_guard", True, "No release recovery is pending.")
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        ATLASO_UPDATE_MAINTENANCE_PATH.parent.mkdir(parents=True, exist_ok=True)
        ATLASO_UPDATE_MAINTENANCE_PATH.touch(mode=0o644, exist_ok=True)
        return _release_check(
            "release_startup_guard",
            False,
            f"Release recovery evidence is unreadable; maintenance remains held: {type(exc).__name__}.",
        )
    if not isinstance(parsed, dict):
        ATLASO_UPDATE_MAINTENANCE_PATH.parent.mkdir(parents=True, exist_ok=True)
        ATLASO_UPDATE_MAINTENANCE_PATH.touch(mode=0o644, exist_ok=True)
        return _release_check(
            "release_startup_guard",
            False,
            "Release recovery evidence is invalid; maintenance remains held.",
        )
    status = str(parsed.get("status") or "")
    recovery = parsed.get("transaction_recovery")
    pending = bool(
        status
        in {
            "transaction_pending",
            "restart_pending",
            "rollback_pending",
            "activation_committed",
        }
        or (
            status == "failed"
            and parsed.get("rolled_back") is not True
            and isinstance(recovery, dict)
        )
    )
    if not pending:
        return _release_check("release_startup_guard", True, "No provisional release recovery is pending.")
    ATLASO_UPDATE_MAINTENANCE_PATH.parent.mkdir(parents=True, exist_ok=True)
    ATLASO_UPDATE_MAINTENANCE_PATH.touch(mode=0o644, exist_ok=True)
    if not NGINX_MANAGEMENT_SITE_PATH.is_file():
        return _release_check(
            "release_startup_guard",
            False,
            "The management nginx site is unavailable; maintenance remains held.",
        )
    try:
        previous = NGINX_MANAGEMENT_SITE_PATH.read_text(encoding="utf-8")
        guarded = _management_site_with_release_maintenance_guards(previous)
    except (OSError, ValueError):
        return _release_check(
            "release_startup_guard",
            False,
            "The management nginx site could not be guarded; maintenance remains held.",
        )
    if guarded != previous:
        NGINX_MANAGEMENT_SITE_PATH.write_text(guarded, encoding="utf-8")
        os.chmod(NGINX_MANAGEMENT_SITE_PATH, 0o644)
        validation = _nginx_test_command()
        if validation.returncode != 0:
            NGINX_MANAGEMENT_SITE_PATH.write_text(previous, encoding="utf-8")
            os.chmod(NGINX_MANAGEMENT_SITE_PATH, 0o644)
            return _release_check(
                "release_startup_guard",
                False,
                "The guarded management nginx configuration is invalid; maintenance remains held.",
            )
    return _release_check(
        "release_startup_guard",
        True,
        "Provisional release recovery is guarded by maintenance before service startup.",
    )


def _refresh_release_data_disk_identity(*, validate: bool) -> list[dict]:
    """Reload disk identity rules and optionally validate the installed policy.

    Args:
        validate: Whether to run the release-owned data-disk preflight.
    """
    udevadm = _command_path("udevadm") or "udevadm"
    commands = [
        _command_payload([udevadm, "control", "--reload-rules"]),
        _command_payload([udevadm, "trigger", "--subsystem-match=block", "--action=add"]),
    ]
    if all(command["success"] for command in commands):
        commands.append(_command_payload([udevadm, "settle"]))
    if validate and all(command["success"] for command in commands):
        commands.append(_command_payload([ATLASO_MOUNT_DATA_DISKS_PATH.as_posix()]))
    return commands


def _migrate_release_esx_storage_claims(
    backup_root: Path,
    backups: list[tuple[Path | None, Path]],
    *,
    before_mutation: Callable[[list[tuple[Path | None, Path]]], None] | None = None,
) -> None:
    """Migrate and claim boot-safe mounted ESX disks configured by an older release.

    Args:
        backup_root: Transaction backup root used for rollback.
        backups: Release-owned file backups extended before any claim mutation.
        before_mutation: Durable checkpoint callback invoked after backup and before mutation.
    """
    if not ATLASO_DATABASE_PATH.is_file():
        return
    connection = sqlite3.connect(f"file:{ATLASO_DATABASE_PATH}?mode=ro", uri=True)
    try:
        table = connection.execute(
            "select 1 from sqlite_master where type = 'table' and name = 'esx_storage_volumes'"
        ).fetchone()
        if table is None:
            return
        configured = connection.execute(
            "select source_type, stable_device_id, filesystem_uuid, mount_path "
            "from esx_storage_volumes where source_type in ('mounted_ext4', 'blank_disk') and applied = 1"
        ).fetchall()
    finally:
        connection.close()
    if not configured:
        return

    inventory = _esx_storage_inventory()
    claims: list[str] = []
    identity_migrations: list[tuple[str, str, str, str, str]] = []
    for source_type, stable_id, configured_uuid, configured_mount in configured:
        mount_path = PurePosixPath(str(configured_mount or ""))
        stored_device = _esx_storage_resolved_by_id_device(str(stable_id or ""))
        matches = [
            entry
            for entry in inventory
            if entry.get("candidate_type") == "mounted_ext4"
            and _esx_storage_resolved_by_id_device(str(entry.get("stable_device_id") or "")) == stored_device
            and str(entry.get("filesystem_uuid") or "") == str(configured_uuid or "")
            and str(mount_path) in [str(path) for path in entry.get("mount_paths", [])]
        ]
        if len(matches) != 1:
            raise ValueError(f"configured mounted ESX Storage disk no longer has one exact identity: {stable_id}")
        safety_errors = _esx_storage_mounted_disk_errors(matches[0], mount_path=mount_path)
        if safety_errors:
            raise ValueError(f"configured mounted ESX Storage disk is not boot-safe: {', '.join(safety_errors)}")
        migrated_identity = str(matches[0]["stable_device_id"])
        values = (str(configured_uuid), migrated_identity, str(mount_path), str(source_type))
        if any(character in value for value in values for character in "\t\r\n"):
            raise ValueError("configured mounted ESX Storage disk has an unsupported identity or mount path")
        claims.append("\t".join(values))
        identity_migrations.append(
            (str(source_type), migrated_identity, str(stable_id), str(configured_uuid), str(configured_mount))
        )

    destination = ESX_STORAGE_DISK_ALLOWLIST_PATH
    backup = backup_root / Path(*destination.parts[1:])
    if destination.exists():
        backup.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(destination, backup)
        backups.append((backup, destination))
        existing = destination.read_text(encoding="utf-8").splitlines()
    else:
        backups.append((None, destination))
        existing = []
    if before_mutation is not None:
        before_mutation(backups)
    migrated_uuids = {claim.split("\t", 1)[0] for claim in claims}
    retained_claims = [
        line
        for line in existing
        if line.strip() and line.split("\t", 1)[0] not in migrated_uuids
    ]
    merged = list(dict.fromkeys(retained_claims + claims))
    with sqlite3.connect(ATLASO_DATABASE_PATH) as connection:
        for source_type, migrated_identity, stable_id, configured_uuid, configured_mount in identity_migrations:
            if migrated_identity == stable_id:
                continue
            updated = connection.execute(
                "update esx_storage_volumes set stable_device_id = ? "
                "where source_type = ? and applied = 1 and stable_device_id = ? "
                "and filesystem_uuid = ? and mount_path = ?",
                (migrated_identity, source_type, stable_id, configured_uuid, configured_mount),
            )
            if updated.rowcount != 1:
                raise ValueError(f"configured mounted ESX Storage disk changed during identity migration: {stable_id}")
        _migrate_release_esx_storage_baseline(connection, identity_migrations)
        _write_secret_file(destination, "\n".join(merged) + "\n", 0o644)


def _migrate_release_esx_storage_baseline(
    connection: sqlite3.Connection,
    identity_migrations: list[tuple[str, str, str, str, str]],
) -> None:
    """Move applied ESX aliases inside a verified baseline without hiding other drift.

    Args:
        connection: Open appliance database connection participating in the migration transaction.
        identity_migrations: Verified source type, new alias, old alias, UUID, and mount tuples.
    """
    migrations = {
        (source_type, stable_id, configured_uuid, configured_mount): migrated_identity
        for source_type, migrated_identity, stable_id, configured_uuid, configured_mount in identity_migrations
        if migrated_identity != stable_id
    }
    if not migrations:
        return
    settings_table = connection.execute(
        "select 1 from sqlite_master where type = 'table' and name = 'settings'"
    ).fetchone()
    if settings_table is None:
        return
    row = connection.execute(
        "select value from settings where key = ?",
        ("appliance_apply.baselines.v1",),
    ).fetchone()
    if row is None:
        return
    try:
        baselines = json.loads(str(row[0]))
        baseline = baselines["esx_storage"]
        preview = json.loads(str(baseline["config_preview"]))
    except (json.JSONDecodeError, KeyError, TypeError):
        return
    if not isinstance(baselines, dict) or not isinstance(baseline, dict) or not isinstance(preview, dict):
        return
    old_preview = str(baseline.get("config_preview") or "")
    old_snapshot = {
        "unit_id": "esx_storage",
        "summary": baseline.get("summary", []),
        "config_path": baseline.get("config_path", ""),
        "config_preview": old_preview,
        "snapshot_marker": None,
    }
    old_hash = hashlib.sha256(
        json.dumps(old_snapshot, sort_keys=True, default=str, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    if str(baseline.get("snapshot_hash") or "") != old_hash:
        return
    changed = False
    for volume in preview.get("volumes", []):
        if not isinstance(volume, dict):
            continue
        key = (
            str(volume.get("source_type") or ""),
            str(volume.get("stable_device_id") or ""),
            str(volume.get("filesystem_uuid") or ""),
            str(volume.get("mount_path") or ""),
        )
        migrated_identity = migrations.get(key)
        if migrated_identity is not None:
            volume["stable_device_id"] = migrated_identity
            changed = True
    if not changed:
        return
    baseline["config_preview"] = json.dumps(preview, indent=2, sort_keys=True)
    new_snapshot = {
        **old_snapshot,
        "config_preview": baseline["config_preview"],
    }
    baseline["snapshot_hash"] = hashlib.sha256(
        json.dumps(new_snapshot, sort_keys=True, default=str, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    connection.execute(
        "update settings set value = ? where key = ?",
        (json.dumps(baselines, indent=2, sort_keys=True), "appliance_apply.baselines.v1"),
    )


def _esx_storage_resolved_by_id_device(value: str) -> Path:
    """Resolve a stable by-id alias to its exact block-device path.

    Args:
        value: Candidate stable device alias.

    Raises:
        ValueError: If the alias is not an available `/dev/disk/by-id` link.
    """
    identity = Path(value)
    if not value.startswith("/dev/disk/by-id/") or not identity.exists():
        raise ValueError(f"configured mounted ESX Storage identity is unavailable: {value}")
    return identity.resolve(strict=True)


def _appliance_update_status_task(
    job_id: str,
    *,
    allow_terminal: bool = False,
) -> dict[str, object]:
    """Read one bounded Appliance Update hierarchy from the durable database.

    Args:
        job_id: Exact Appliance Update parent identifier.
        allow_terminal: Whether terminal reconciliation may read the task.

    Raises:
        ValueError: If the identifier or durable task contract is invalid.
    """
    if re.fullmatch(r"job_[0-9a-f]{12}", job_id) is None:
        raise ValueError("appliance update status task id is invalid")
    if not ATLASO_DATABASE_PATH.is_file():
        raise ValueError("appliance update database is unavailable")
    connection = sqlite3.connect(f"file:{ATLASO_DATABASE_PATH}?mode=ro", uri=True)
    connection.row_factory = sqlite3.Row
    try:
        job = connection.execute(
            "select id, type, status, progress_percent, created_at, started_at, finished_at, "
            "task_config_json from jobs where id = ?",
            (job_id,),
        ).fetchone()
        if job is None or str(job["type"]) != "appliance-update":
            raise ValueError("appliance update status task was not found")
        steps = connection.execute(
            "select id, component_key, label, position, status, progress_percent, result, "
            "created_at, started_at, finished_at from job_steps where job_id = ? order by position, id",
            (job_id,),
        ).fetchall()
    finally:
        connection.close()
    try:
        config = json.loads(str(job["task_config_json"] or "{}"))
    except json.JSONDecodeError as exc:
        raise ValueError("appliance update task contract is invalid") from exc
    if not isinstance(config, dict):
        raise ValueError("appliance update task contract is invalid")
    if int(config.get("schema_version") or 0) != 2 or str(config.get("mode") or "") != "run":
        raise ValueError("appliance update status requires a current installation task")
    transaction_id = str(config.get("status_transaction_id") or "")
    if re.fullmatch(r"[0-9a-f]{32}", transaction_id) is None:
        raise ValueError("appliance update task has no durable status transaction identity")
    allowed_streams = {"photon_os", "powershell_modules", "atlaso_release"}
    selected = config.get("selected_streams")
    execution_order = config.get("execution_order")
    if (
        not isinstance(selected, list)
        or not isinstance(execution_order, list)
        or not 1 <= len(selected) <= 3
        or len(set(str(value) for value in selected)) != len(selected)
        or set(str(value) for value in selected) != set(str(value) for value in execution_order)
        or any(str(value) not in allowed_streams for value in selected)
    ):
        raise ValueError("appliance update status stream contract is invalid")
    expected_order = [str(value) for value in execution_order]
    current_order = [
        stream
        for stream in ("photon_os", "powershell_modules", "atlaso_release")
        if stream in set(expected_order)
    ]
    legacy_order = [
        stream
        for stream in ("atlaso_release", "powershell_modules", "photon_os")
        if stream in set(expected_order)
    ]
    legacy_contract = config.get("status_legacy_execution_order") is True
    if expected_order != current_order and not (
        legacy_contract and expected_order == legacy_order
    ):
        raise ValueError("appliance update status execution order is invalid")
    children: list[dict[str, object]] = []
    for step in steps:
        component = str(step["component_key"] or "")
        if component not in allowed_streams:
            raise ValueError("appliance update task contains an unexpected status child")
        try:
            step_result = json.loads(str(step["result"] or "{}"))
        except json.JSONDecodeError:
            step_result = {}
        children.append(
            {
                "id": str(step["id"]),
                "component_key": component,
                "label": str(step["label"] or component)[:80],
                "position": int(step["position"] or 0),
                "status": str(step["status"] or "pending"),
                "progress_percent": max(0, min(100, int(step["progress_percent"] or 0))),
                "created_at": str(step["created_at"] or ""),
                "started_at": str(step["started_at"] or ""),
                "finished_at": str(step["finished_at"] or ""),
                "apply_started": bool(
                    isinstance(step_result, dict) and step_result.get("apply_started") is True
                ),
            }
        )
    if not children:
        raise ValueError("appliance update task has no status children")
    if (
        [str(child["component_key"]) for child in children] != expected_order
        or [int(child["position"]) for child in children] != list(range(1, len(children) + 1))
        or any(
            str(child["id"]) != f"{job_id}:{child['component_key']}"
            for child in children
        )
        or any(
            str(child["status"]) not in {"pending", "running", "succeeded", "failed", "skipped"}
            for child in children
        )
    ):
        raise ValueError("appliance update status child hierarchy is invalid")
    parent_status = str(job["status"] or "pending")
    if parent_status not in {"pending", "running", "succeeded", "failed"}:
        raise ValueError("appliance update status parent state is invalid")
    if parent_status in {"succeeded", "failed"} and not allow_terminal:
        raise ValueError("terminal appliance update status may only be reconciled")
    running_component = next(
        (str(child["component_key"]) for child in children if child["status"] == "running"),
        "",
    )
    phase = {
        "photon_os": "installing_photon_os",
        "powershell_modules": "installing_powershell_modules",
        "atlaso_release": "activating_atlaso_release",
    }.get(running_component, "preparing")
    try:
        finalizer = json.loads(ATLASO_UPDATE_FINALIZER_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        finalizer = {}
    if isinstance(finalizer, dict) and str(finalizer.get("job_id") or "") == job_id:
        finalizer_status = str(finalizer.get("status") or "")
        if finalizer_status in {"restart_pending", "activation_committed"}:
            phase = "restarting_or_recovering"
        elif finalizer_status == "rollback_pending":
            phase = "rolling_back"
    if parent_status == "succeeded":
        phase = "succeeded"
    elif parent_status == "failed":
        phase = "failed"
    active_release = ""
    try:
        if ATLASO_CURRENT_LINK.is_symlink():
            active_release = ATLASO_CURRENT_LINK.resolve(strict=True).name[:80]
    except OSError:
        active_release = ""
    return {
        "schema_version": 1,
        "task_id": job_id,
        "transaction_id": transaction_id,
        "status": parent_status,
        "phase": phase,
        "progress_percent": max(0, min(100, int(job["progress_percent"] or 0))),
        "created_at": str(job["created_at"] or ""),
        "started_at": str(job["started_at"] or ""),
        "finished_at": str(job["finished_at"] or ""),
        "active_release": active_release,
        "children": children,
        "terminal": parent_status in {"succeeded", "failed"},
    }


def _render_appliance_update_status_html(snapshot: dict[str, object]) -> str:
    """Render the self-contained, public-safe update-only status document.

    Args:
        snapshot: Validated bounded status snapshot.
    """
    phase_labels = {
        "preparing": "Preparing appliance update",
        "installing_photon_os": "Installing Photon OS",
        "installing_powershell_modules": "Installing PowerShell Modules",
        "activating_atlaso_release": "Activating Atlaso Release",
        "restarting_or_recovering": "Restarting and reconciling Atlaso",
        "rolling_back": "Rolling back Atlaso Release",
        "succeeded": "Appliance update succeeded",
        "failed": "Appliance update failed",
    }
    phase = str(snapshot.get("phase") or "preparing")
    rows = []
    for child in snapshot.get("children", []):
        if not isinstance(child, dict):
            continue
        rows.append(
            "<li class=\"step\"><span><strong>"
            + html.escape(str(child.get("label") or "Update stream"))
            + "</strong><small>"
            + html.escape(str(child.get("status") or "pending"))
            + "</small></span><span class=\"percent\">"
            + str(max(0, min(100, int(child.get("progress_percent") or 0))))
            + "%</span></li>"
        )
    task_id = html.escape(str(snapshot.get("task_id") or ""))
    progress = max(0, min(100, int(snapshot.get("progress_percent") or 0)))
    title = html.escape(phase_labels.get(phase, "Appliance update in progress"))
    return f"""<!doctype html>
<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">
<meta http-equiv=\"refresh\" content=\"3\"><title>{title} · Atlaso</title>
<style>:root{{color-scheme:dark;background:#07121f;color:#f4f7fb;font:16px system-ui,sans-serif}}body{{margin:0;min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at top,#17334f,#07121f 55%)}}main{{width:min(42rem,calc(100% - 2rem));background:#0d2033;border:1px solid #31506b;border-radius:1rem;padding:clamp(1.25rem,4vw,2.5rem);box-shadow:0 1rem 3rem #0008}}.brand{{font-weight:800;letter-spacing:.12em;color:#73d6ff}}h1{{font-size:clamp(1.5rem,4vw,2.25rem);margin:.75rem 0 .5rem}}p{{color:#bfd0df}}code{{word-break:break-all;color:#dff6ff}}progress{{width:100%;height:1rem;accent-color:#35bff5}}ol{{list-style:none;padding:0;margin:1.5rem 0 0;display:grid;gap:.65rem}}.step{{display:flex;justify-content:space-between;gap:1rem;align-items:center;border-top:1px solid #29445d;padding:.85rem 0}}small{{display:block;color:#a9bdcf;text-transform:capitalize;margin-top:.2rem}}.percent{{font-variant-numeric:tabular-nums}}footer{{font-size:.875rem;color:#9eb1c1;margin-top:1.5rem}}@media (prefers-contrast:more){{main{{border-width:2px}}}}</style></head>
<body><main aria-labelledby=\"update-title\"><div class=\"brand\">ATLASO</div><h1 id=\"update-title\">{title}</h1>
<p>The appliance control plane is temporarily unavailable while this durable task completes.</p><p>Task <code>{task_id}</code></p>
<progress max=\"100\" value=\"{progress}\" aria-label=\"Parent task progress\">{progress}%</progress><p>{progress}% complete</p>
<ol aria-label=\"Ordered update streams\">{''.join(rows)}</ol><footer role=\"status\">This page refreshes every 3 seconds. Retry ordinary appliance actions after the task becomes terminal.</footer></main></body></html>\n"""


def _write_appliance_update_status_files(snapshot: dict[str, object]) -> dict[str, object]:
    """Atomically publish one monotonic root-owned status snapshot and page.

    Args:
        snapshot: Bounded task hierarchy read from the durable database.
    """
    ATLASO_UPDATE_STATUS_DIR.parent.mkdir(parents=True, exist_ok=True)
    parent_metadata = ATLASO_UPDATE_STATUS_DIR.parent.lstat()
    enforce_root_owner = bool(
        os.name == "posix"
        and getattr(os, "geteuid", lambda: 0)() == 0
    )
    if (
        ATLASO_UPDATE_STATUS_DIR.parent.is_symlink()
        or not stat.S_ISDIR(parent_metadata.st_mode)
        or (enforce_root_owner and parent_metadata.st_uid != 0)
        or (os.name == "posix" and parent_metadata.st_mode & 0o022)
    ):
        raise ValueError("appliance update status parent directory is unsafe")
    if ATLASO_UPDATE_STATUS_DIR.is_symlink():
        raise ValueError("appliance update status directory is unsafe")
    ATLASO_UPDATE_STATUS_DIR.mkdir(mode=0o700, exist_ok=True)
    directory_metadata = ATLASO_UPDATE_STATUS_DIR.lstat()
    if not stat.S_ISDIR(directory_metadata.st_mode):
        raise ValueError("appliance update status directory is unsafe")
    if enforce_root_owner and (
        directory_metadata.st_uid != 0 or directory_metadata.st_mode & 0o077
    ):
        raise ValueError("appliance update status directory is not root-controlled")
    os.chmod(ATLASO_UPDATE_STATUS_DIR, 0o700)
    existing: dict[str, object] = {}
    try:
        flags = os.O_RDONLY
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(ATLASO_UPDATE_STATUS_PATH, flags)
        try:
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or metadata.st_size > 1024 * 1024
                or (enforce_root_owner and metadata.st_uid != 0)
            ):
                raise ValueError("appliance update status snapshot is unsafe")
            with os.fdopen(descriptor, "r", encoding="utf-8", closefd=False) as stream:
                parsed = json.load(stream)
        finally:
            os.close(descriptor)
        existing = parsed if isinstance(parsed, dict) else {}
    except FileNotFoundError:
        existing = {}
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("appliance update status snapshot is unsafe") from exc
    existing_task = str(existing.get("task_id") or "")
    if existing_task and existing_task != snapshot["task_id"] and existing.get("terminal") is not True:
        raise ValueError("another appliance update status transaction is still active")
    if existing_task == snapshot["task_id"]:
        if str(existing.get("transaction_id") or "") != snapshot["transaction_id"]:
            raise ValueError("appliance update status transaction identity changed")
        sequence = int(existing.get("sequence") or 0) + 1
    else:
        sequence = 1
    published = {
        **snapshot,
        "sequence": sequence,
        "generated_at": datetime.now(timezone.utc).isoformat(),
    }
    if existing_task == snapshot["task_id"] and "ui_restoration" not in published:
        restoration = existing.get("ui_restoration")
        if isinstance(restoration, dict):
            published["ui_restoration"] = restoration
    if existing_task == snapshot["task_id"] and "status_activated" not in published:
        published["status_activated"] = existing.get("status_activated") is True
    published.setdefault("status_activated", False)
    if published.get("terminal") is not True and "ui_restoration" not in published:
        published["ui_restoration"] = {
            "state": "held",
            "updated_at": datetime.now(timezone.utc).isoformat(),
        }
    for destination, content, mode in (
        (
            ATLASO_UPDATE_STATUS_PATH,
            json.dumps(published, indent=2, sort_keys=True) + "\n",
            0o600,
        ),
        (
            ATLASO_UPDATE_STATUS_HTML_PATH,
            _render_appliance_update_status_html(published),
            0o644,
        ),
    ):
        destination.parent.mkdir(parents=True, exist_ok=True)
        temporary = destination.with_name(f".{destination.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp")
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        descriptor = os.open(temporary, flags, mode)
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
                stream.write(content)
                stream.flush()
                os.fsync(stream.fileno())
        except Exception:
            temporary.unlink(missing_ok=True)
            raise
        os.replace(temporary, destination)
        os.chmod(destination, mode)
    _fsync_directory(ATLASO_UPDATE_STATUS_DIR)
    if ATLASO_UPDATE_STATUS_HTML_PATH.parent != ATLASO_UPDATE_STATUS_DIR:
        _fsync_directory(ATLASO_UPDATE_STATUS_HTML_PATH.parent)
    return published


def _nginx_block_end(text: str, opening: int) -> int:
    """Return the end offset for one brace-delimited nginx block.

    Args:
        text: Nginx configuration text.
        opening: Offset of the opening brace.
    """
    depth = 0
    for index in range(opening, len(text)):
        if text[index] == "{":
            depth += 1
        elif text[index] == "}":
            depth -= 1
            if depth == 0:
                return index + 1
    raise ValueError("nginx configuration contains an unterminated block")


def _write_appliance_update_runtime_file(
    destination: Path,
    content: str,
    *,
    mode: int = 0o644,
) -> None:
    """Atomically replace one root-owned status/runtime file without following links.

    Args:
        destination: Exact root-controlled destination.
        content: UTF-8 text to persist.
        mode: Final POSIX permission bits.
    """
    destination.parent.mkdir(parents=True, exist_ok=True)
    parent_metadata = destination.parent.lstat()
    if (
        destination.parent.is_symlink()
        or not stat.S_ISDIR(parent_metadata.st_mode)
        or (
            os.name == "posix"
            and getattr(os, "geteuid", lambda: 0)() == 0
            and parent_metadata.st_uid != 0
        )
        or (os.name == "posix" and parent_metadata.st_mode & 0o022)
    ):
        raise ValueError("appliance update runtime parent is unsafe")
    temporary = destination.with_name(
        f".{destination.name}.{os.getpid()}.{uuid.uuid4().hex}.tmp"
    )
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(temporary, flags, mode)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(content)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, destination)
        os.chmod(destination, mode)
        _fsync_directory(destination.parent)
    except Exception:
        temporary.unlink(missing_ok=True)
        raise


def _read_appliance_update_runtime_file(path: Path, *, limit: int = 4096) -> str:
    """Read one bounded root-owned runtime file without following links.

    Args:
        path: Exact runtime path.
        limit: Maximum accepted file size.
    """
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    descriptor = os.open(path, flags)
    try:
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_size > limit
            or (
                os.name == "posix"
                and getattr(os, "geteuid", lambda: 0)() == 0
                and metadata.st_uid != 0
            )
        ):
            raise ValueError("appliance update runtime file is unsafe")
        with os.fdopen(descriptor, "r", encoding="utf-8", closefd=False) as stream:
            return stream.read()
    finally:
        os.close(descriptor)


def _site_with_update_status_guards(text: str, *, default_management: bool) -> str:
    """Add update-only routing to every browser UI server block.

    Args:
        text: Applied nginx site text.
        default_management: Whether catch-all locations expose the management listener.
    """
    guarded = text
    if default_management:
        for server, end in reversed(_management_site_server_ranges(guarded)):
            block = guarded[server.start():end]
            if "/ui/management" in block:
                continue
            catchall = re.search(r"(?m)^(?P<indent>[ \t]*)location[ \t]+/[ \t]*\{[ \t]*$", block)
            if catchall is None:
                raise ValueError("management nginx server has no catch-all location")
            absolute_start = server.start() + catchall.start()
            opening = guarded.find("{", absolute_start)
            absolute_end = _nginx_block_end(guarded, opening)
            original = guarded[absolute_start:absolute_end]
            indent = catchall.group("indent")
            newline = "\r\n" if "\r\n" in guarded else "\n"
            clones: list[str] = []
            for path in ("= /ui/management", "^~ /ui/management/", "= /ui/public", "^~ /ui/public/"):
                clone = re.sub(
                    r"(?m)^[ \t]*location[ \t]+/[ \t]*\{[ \t]*$",
                    f"{indent}location {path} {{",
                    original,
                    count=1,
                )
                clones.append(clone)
            guarded = guarded[:absolute_start] + (newline + newline).join(clones) + newline + newline + guarded[absolute_start:]
    condition_pattern = re.compile(
        r"(?m)^(?P<line>(?P<indent>[ \t]*)location[ \t]+(?:=[ \t]+|\^~[ \t]+)?"
        r"/ui/(?:management|public)/?[ \t]*\{[ \t]*)$"
        rf"(?!\r?\n[ \t]*if \(-f {re.escape(str(ATLASO_UPDATE_STATUS_MARKER_PATH))}\))"
    )

    def add_condition(match: re.Match[str]) -> str:
        """Insert the marker check at the start of one human UI location.

        Args:
            match: Matched nginx human-UI location declaration.
        """
        condition = (
            f"{match.group('indent')}  if (-f {ATLASO_UPDATE_STATUS_MARKER_PATH}) "
            "{ return 418; }"
        )
        return f"{match.group('line')}\n{condition}"

    guarded = condition_pattern.sub(add_condition, guarded)
    include_line = f"include {ATLASO_UPDATE_STATUS_NGINX_INCLUDE_PATH};"
    for server, end in reversed(_management_site_server_ranges(guarded)):
        block = guarded[server.start():end]
        indent = f"{server.group('indent')}  "
        server_condition = f"{indent}if (-f {ATLASO_UPDATE_STATUS_MARKER_PATH}) {{ return 418; }}"
        if default_management and ATLASO_UPDATE_READINESS_PATH not in block:
            legacy_start = -1
            search_start = 0
            while True:
                candidate = block.find(server_condition, search_start)
                if candidate < 0:
                    break
                prefix = block[:candidate]
                if prefix.count("{") - prefix.count("}") == 1:
                    legacy_start = candidate
                    break
                search_start = candidate + len(server_condition)
            if legacy_start >= 0:
                legacy_end = legacy_start + len(server_condition)
                if block[legacy_end:legacy_end + 2] == "\r\n":
                    legacy_end += 2
                elif block[legacy_end:legacy_end + 1] == "\n":
                    legacy_end += 1
                absolute_start = server.start() + legacy_start
                absolute_end = server.start() + legacy_end
                guarded = guarded[:absolute_start] + guarded[absolute_end:]
                end -= absolute_end - absolute_start
                block = guarded[server.start():end]
        line_end = guarded.find("\n", server.end())
        insertion = len(guarded) if line_end < 0 else line_end + 1
        additions = []
        if include_line not in block:
            additions.append(f"{indent}{include_line}")
        if default_management:
            variable = "$atlaso_appliance_update_guard"
            trusted_guard = "\n".join(
                [
                    f"{indent}# Keep the release verifier on the applied listener without reopening ordinary routes.",
                    f"{indent}set {variable} 0;",
                    f"{indent}if (-f {ATLASO_UPDATE_STATUS_MARKER_PATH}) {{ set {variable} 1; }}",
                    f"{indent}if ($uri = {ATLASO_UPDATE_READINESS_PATH}) {{ set {variable} 0; }}",
                    f"{indent}if ({variable} = 1) {{ return 418; }}",
                    f"{indent}location = {ATLASO_UPDATE_READINESS_PATH} {{",
                    f"{indent}  allow 127.0.0.1;",
                    f"{indent}  allow ::1;",
                    f"{indent}  deny all;",
                    f"{indent}  proxy_pass http://127.0.0.1:8000/openapi.json;",
                    f"{indent}}}",
                ]
            )
            if ATLASO_UPDATE_READINESS_PATH not in block:
                additions.append(trusted_guard)
        elif re.search(rf"(?m)^{re.escape(server_condition)}$", block) is None:
            additions.append(server_condition)
        if additions:
            guarded = (
                guarded[:insertion]
                + "\n".join(additions)
                + "\n"
                + guarded[insertion:]
            )
    return guarded


def _write_update_status_nginx_include() -> None:
    """Install the fixed internal location used by update-only UI responses."""
    content = "\n".join(
        [
            "# Managed by Atlaso. Local changes may be overwritten.",
            "error_page 418 =503 @atlaso_appliance_update_status;",
            "location @atlaso_appliance_update_status {",
            "  root /;",
            f"  try_files {ATLASO_UPDATE_STATUS_HTML_PATH} =500;",
            "  default_type text/html;",
            '  add_header Cache-Control "no-store, no-cache, must-revalidate" always;',
            '  add_header Pragma "no-cache" always;',
            '  add_header Retry-After "3" always;',
            '  add_header X-Atlaso-Update-Mode "active" always;',
            "}",
            "",
        ]
    )
    _write_appliance_update_runtime_file(
        ATLASO_UPDATE_STATUS_NGINX_INCLUDE_PATH,
        content,
    )


def _appliance_update_status_nginx_sites() -> tuple[tuple[Path, bool], ...]:
    """Return every applied nginx site that must honor the update-only hold."""
    return (
        (NGINX_MANAGEMENT_SITE_PATH, True),
        (NGINX_PUBLIC_SERVICES_SITE_PATH, False),
        (ESXI_PXE_NGINX_SITE_PATH, False),
    )


def _update_status_probe_urls(site_text: str) -> tuple[tuple[str, bool], ...]:
    """Return every applied browser-listener URL that must serve status.

    Args:
        site_text: Guarded nginx site configuration.
    """
    probes: list[tuple[str, bool]] = []
    for server, end in _management_site_server_ranges(site_text):
        block = site_text[server.start():end]
        paths = [
            path
            for path in ("/ui/management", "/ui/public")
            if re.search(rf"location\s+(?:=\s+|\^~\s+)?{re.escape(path)}(?:/)?\s*\{{", block)
        ]
        if not paths:
            # Server-level guards cover machine/protocol-only vhosts even when
            # they intentionally expose no human UI location.
            paths = [ATLASO_UPDATE_LISTENER_PROBE_PATH]
        for listener in re.finditer(
            r"(?m)^\s*listen\s+(?P<endpoint>[^\s;]+)(?P<options>[^;]*);",
            block,
        ):
            endpoint = listener.group("endpoint")
            options = listener.group("options").split()
            ssl_enabled = "ssl" in options
            port_match = re.search(r"(?P<port>\d+)$", endpoint)
            if port_match is None:
                continue
            port = int(port_match.group("port"))
            raw_host = endpoint[: port_match.start()].rstrip(":")
            raw_host = raw_host.strip("[]")
            if raw_host == "::":
                raw_host = "::1"
            elif raw_host in {"", "*", "0.0.0.0"}:
                raw_host = "127.0.0.1"
            try:
                parsed_host = ip_address(raw_host)
            except ValueError:
                continue
            host = f"[{parsed_host}]" if parsed_host.version == 6 else str(parsed_host)
            scheme = "https" if ssl_enabled else "http"
            default_port = 443 if ssl_enabled else 80
            authority = host if port == default_port else f"{host}:{port}"
            for path in paths:
                probe = (f"{scheme}://{authority}{path}", ssl_enabled)
                if probe not in probes:
                    probes.append(probe)
    return tuple(probes)


def _verify_update_status_responses(site_texts: list[str]) -> dict[str, object]:
    """Require consecutive 503 responses from every applied browser listener.

    Args:
        site_texts: Guarded management and public-service nginx sites.
    """
    curl = shutil.which("curl")
    if curl is None:
        raise ValueError("curl is unavailable for update-only listener proof")
    probes: list[tuple[str, bool]] = []
    for site_text in site_texts:
        for probe in _update_status_probe_urls(site_text):
            if probe not in probes:
                probes.append(probe)
    if not probes:
        raise ValueError("no applied browser listeners were found for update-only proof")
    statuses: dict[str, str] = {}
    consecutive = 0
    for attempt in range(10):
        statuses = {
            url: _console_management_http_status(curl, url, insecure=insecure)
            for url, insecure in probes
        }
        if all(status == "503" for status in statuses.values()):
            consecutive += 1
            if consecutive >= 3:
                return {
                    "listener_count": len(statuses),
                    "stable_samples": consecutive,
                    "attempts": attempt + 1,
                }
        else:
            consecutive = 0
        time.sleep(0.2)
    raise ValueError("not every applied browser listener returned a stable update-only response")


def _publish_appliance_update_status(job_id: str) -> dict[str, object]:
    """Publish and activate the update-only browser surface for one task.

    Args:
        job_id: Exact Appliance Update parent identifier.
    """
    snapshot = _write_appliance_update_status_files(_appliance_update_status_task(job_id))
    _write_update_status_nginx_include()
    marker_existed = False
    try:
        marker_job = _read_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH
        ).strip()
        marker_existed = True
    except FileNotFoundError:
        marker_job = ""
    if marker_existed and marker_job != job_id:
        raise ValueError("update-only status marker belongs to another task")
    originals: dict[Path, str] = {}
    guarded_sites: list[str] = []
    try:
        for path, default_management in _appliance_update_status_nginx_sites():
            if not path.is_file():
                if default_management:
                    raise ValueError("applied management nginx site is unavailable")
                continue
            original = path.read_text(encoding="utf-8")
            originals[path] = original
            guarded = _site_with_update_status_guards(
                original,
                default_management=default_management,
            )
            if guarded != original:
                _write_appliance_update_runtime_file(path, guarded)
            guarded_sites.append(guarded)
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH,
            job_id + "\n",
        )
        validation = _nginx_test_command()
        if validation.returncode != 0:
            raise ValueError("update-only nginx configuration did not validate")
        reload_result = _service_command("reload", "nginx.service")
        if reload_result.get("success") is not True:
            raise ValueError("update-only nginx configuration did not reload")
        snapshot["listener_proof"] = _verify_update_status_responses(guarded_sites)
        snapshot["status_activated"] = True
        snapshot = _write_appliance_update_status_files(snapshot)
    except Exception:
        for path, original in originals.items():
            _write_appliance_update_runtime_file(path, original)
        validation = _nginx_test_command()
        reload_result = (
            _service_command("reload", "nginx.service")
            if validation.returncode == 0
            else {"success": False}
        )
        if (
            not marker_existed
            and validation.returncode == 0
            and reload_result.get("success") is True
        ):
            ATLASO_UPDATE_STATUS_MARKER_PATH.unlink(missing_ok=True)
            _fsync_directory(ATLASO_UPDATE_STATUS_MARKER_PATH.parent)
        raise
    return snapshot


def _verify_release_status_completion(
    snapshot: dict[str, object],
    job_id: str,
) -> None:
    """Require definitive release evidence before restoring ordinary UIs.

    Args:
        snapshot: Terminal bounded task hierarchy.
        job_id: Exact Appliance Update parent identifier.
    """
    release_child = next(
        (
            child
            for child in snapshot.get("children", [])
            if isinstance(child, dict) and child.get("component_key") == "atlaso_release"
        ),
        None,
    )
    if release_child is None or release_child.get("apply_started") is not True:
        return

    def pretransaction_failure_is_proven() -> bool:
        """Return whether the current release failed before its transaction began."""
        services = _service_command(
            "is-active",
            "atlaso.service",
            "atlaso-worker.service",
            "atlaso-console.service",
            "nginx.service",
        )
        return bool(
            release_child.get("status") in {"failed", "skipped"}
            and services.get("success") is True
            and not ATLASO_UPDATE_MAINTENANCE_PATH.exists()
            and not ATLASO_UPDATE_RESTART_GATE_PATH.exists()
        )

    try:
        finalizer = json.loads(ATLASO_UPDATE_FINALIZER_PATH.read_text(encoding="utf-8"))
    except FileNotFoundError:
        if pretransaction_failure_is_proven():
            return
        raise ValueError(
            "release transaction evidence is unavailable at status completion"
        ) from None
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("release transaction evidence is unavailable at status completion") from exc
    if not isinstance(finalizer, dict):
        raise ValueError("release transaction evidence is invalid at status completion")
    if (
        str(finalizer.get("job_id") or "") != job_id
        and pretransaction_failure_is_proven()
    ):
        return
    try:
        update_info = json.loads(APPLIANCE_UPDATE_INFO_PATH.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise ValueError("release update-info is unavailable at status completion") from exc
    if not isinstance(update_info, dict):
        raise ValueError("release transaction evidence is invalid at status completion")
    finalizer_status = str(finalizer.get("status") or "")
    definitive = finalizer_status == "succeeded" or (
        finalizer_status == "failed"
        and finalizer.get("rolled_back") is True
        and finalizer.get("rollback_health") is True
    )
    if not definitive or str(finalizer.get("job_id") or "") != job_id:
        raise ValueError("release finalizer does not match terminal task bookkeeping")
    if (
        str(update_info.get("job_id") or "") != job_id
        or str(update_info.get("status") or "") not in {"succeeded", "failed"}
    ):
        raise ValueError("release update-info does not match terminal task bookkeeping")
    if ATLASO_UPDATE_RESTART_GATE_PATH.exists():
        raise ValueError("release restart gate remains active at status completion")
    active_root = _active_release_root()
    expected_version = (
        str(finalizer.get("previous_version") or "")
        if finalizer.get("rolled_back") is True
        else str(finalizer.get("candidate_version") or finalizer.get("release") or "")
    )
    if not expected_version or _release_root_version(active_root) != expected_version:
        raise ValueError("active release does not match definitive transaction evidence")
    if finalizer_status == "succeeded":
        try:
            receipt = json.loads((active_root / ".release-manifest.json").read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError) as exc:
            raise ValueError("active release receipt is unavailable") from exc
        if not isinstance(receipt, dict):
            raise ValueError("active release receipt is invalid")
        receipt_hash = hashlib.sha256(
            json.dumps(receipt, separators=(",", ":"), sort_keys=True).encode("utf-8")
        ).hexdigest()
        if (
            receipt_hash != str(finalizer.get("release_manifest_sha256") or "")
            or str((receipt.get("bundle") or {}).get("sha256") or "")
            != str(finalizer.get("bundle_sha256") or "")
            or str(receipt.get("git_commit") or "")
            != str(finalizer.get("git_commit") or "")
        ):
            raise ValueError("active release receipt does not match definitive evidence")
        verification = finalizer.get("active_release_verification")
        if not isinstance(verification, dict) or verification.get("success") is not True:
            raise ValueError("release activation verification is not definitive")
        if finalizer.get("no_change") is not True:
            worker_restart = finalizer.get("worker_restart")
            if not isinstance(worker_restart, dict) or worker_restart.get("success") is not True:
                raise ValueError("candidate worker startup identity is not definitive")
    services = _service_command(
        "is-active",
        "atlaso.service",
        "atlaso-worker.service",
        "atlaso-console.service",
        "nginx.service",
    )
    if services.get("success") is not True:
        raise ValueError("required appliance services are not active at status completion")


def _ordinary_update_ui_probe_sites() -> list[str]:
    """Return the currently applied browser-listener configurations."""
    sites = []
    for path, _default_management in _appliance_update_status_nginx_sites():
        if path.is_file():
            sites.append(path.read_text(encoding="utf-8"))
    return sites


def _verify_ordinary_update_ui_responses(site_texts: list[str]) -> dict[str, object]:
    """Prove restored browser listeners no longer return gateway/maintenance failures.

    Args:
        site_texts: Applied management/public nginx configurations.
    """
    curl = shutil.which("curl")
    if curl is None:
        raise ValueError("curl is unavailable for ordinary UI restoration proof")
    probes = [probe for text in site_texts for probe in _update_status_probe_urls(text)]
    if not probes:
        raise ValueError("no browser listeners were found for ordinary UI restoration proof")
    statuses = {
        url: _console_management_http_status(curl, url, insecure=insecure)
        for url, insecure in dict.fromkeys(probes)
    }
    if any(status in {"000", "418", "500", "502", "503", "504"} for status in statuses.values()):
        raise ValueError("ordinary browser listeners are not healthy after update restoration")
    return {"listener_count": len(statuses), "status_classes": sorted(set(statuses.values()))}


def _finish_appliance_update_status(job_id: str) -> dict[str, object]:
    """Restore ordinary browser UIs after definitive task completion.

    Args:
        job_id: Exact Appliance Update parent identifier.
    """
    snapshot = _write_appliance_update_status_files(
        _appliance_update_status_task(job_id, allow_terminal=True)
    )
    if snapshot.get("terminal") is not True:
        raise ValueError("appliance update status cannot finish before the parent is terminal")
    children = snapshot.get("children")
    terminal_child_states = {"succeeded", "failed", "skipped"}
    if (
        not isinstance(children, list)
        or not children
        or any(
            not isinstance(child, dict)
            or str(child.get("status") or "") not in terminal_child_states
            for child in children
        )
    ):
        raise ValueError(
            "appliance update status cannot finish before every selected child is terminal"
        )
    _verify_release_status_completion(snapshot, job_id)
    try:
        marker_job = _read_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH
        ).strip()
    except FileNotFoundError:
        restoration = snapshot.get("ui_restoration")
        if isinstance(restoration, dict) and restoration.get("state") == "restored":
            return {**snapshot, "ordinary_ui_restored": True, "already_restored": True}
        if snapshot.get("status_activated") is not True:
            snapshot["ui_restoration"] = {
                "state": "restored",
                "reason": "update_only_surface_not_activated",
                "updated_at": datetime.now(timezone.utc).isoformat(),
            }
            snapshot = _write_appliance_update_status_files(snapshot)
            return {
                **snapshot,
                "ordinary_ui_restored": True,
                "hold_not_activated": True,
            }
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH,
            job_id + "\n",
        )
        marker_job = job_id
    except OSError as exc:
        raise ValueError("update-only status marker is unavailable") from exc
    if marker_job != job_id:
        raise ValueError("update-only status marker belongs to another task")
    snapshot["ui_restoration"] = {
        "state": "pending",
        "updated_at": datetime.now(timezone.utc).isoformat(),
    }
    snapshot = _write_appliance_update_status_files(snapshot)
    ATLASO_UPDATE_STATUS_MARKER_PATH.unlink()
    _fsync_directory(ATLASO_UPDATE_STATUS_MARKER_PATH.parent)
    validation = _nginx_test_command()
    if validation.returncode != 0:
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH,
            job_id + "\n",
        )
        raise ValueError("nginx validation failed while restoring ordinary browser UIs")
    reload_result = _service_command("reload", "nginx.service")
    if reload_result.get("success") is not True:
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH,
            job_id + "\n",
        )
        raise ValueError("nginx reload failed while restoring ordinary browser UIs")
    try:
        restoration_proof = _verify_ordinary_update_ui_responses(
            _ordinary_update_ui_probe_sites()
        )
    except (OSError, ValueError):
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH,
            job_id + "\n",
        )
        _service_command("reload", "nginx.service")
        raise
    snapshot["ui_restoration"] = {
        "state": "restored",
        "updated_at": datetime.now(timezone.utc).isoformat(),
        "listener_proof": restoration_proof,
    }
    try:
        snapshot = _write_appliance_update_status_files(snapshot)
    except Exception:
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH,
            job_id + "\n",
        )
        raise
    return snapshot


def _guard_appliance_update_status_startup() -> dict[str, object]:
    """Recreate the update-only UI hold before nginx starts after reboot."""
    if not ATLASO_UPDATE_STATUS_PATH.is_file():
        return {"success": True, "status": "not_required"}
    try:
        recorded = json.loads(ATLASO_UPDATE_STATUS_PATH.read_text(encoding="utf-8"))
        if not isinstance(recorded, dict):
            raise ValueError("status snapshot is not an object")
        job_id = str(recorded.get("task_id") or "")
        current = _appliance_update_status_task(job_id, allow_terminal=True)
        if str(recorded.get("transaction_id") or "") != current.get("transaction_id"):
            raise ValueError("status transaction identity does not match the durable task")
        restoration = recorded.get("ui_restoration")
        restored = bool(
            isinstance(restoration, dict) and restoration.get("state") == "restored"
        )
        if recorded.get("status_activated") is not True:
            ATLASO_UPDATE_STATUS_MARKER_PATH.unlink(missing_ok=True)
            return {"success": True, "status": "not_activated"}
        if current.get("terminal") is True and restored:
            ATLASO_UPDATE_STATUS_MARKER_PATH.unlink(missing_ok=True)
            return {"success": True, "status": "terminal_restored"}
        _write_appliance_update_status_files(current)
        _write_update_status_nginx_include()
        for path, default_management in _appliance_update_status_nginx_sites():
            if not path.is_file():
                if default_management:
                    raise ValueError("applied management nginx site is unavailable")
                continue
            original = path.read_text(encoding="utf-8")
            guarded = _site_with_update_status_guards(
                original,
                default_management=default_management,
            )
            if guarded != original:
                _write_appliance_update_runtime_file(path, guarded)
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH,
            job_id + "\n",
        )
        validation = _nginx_test_command()
        if validation.returncode != 0:
            raise ValueError("update-only nginx configuration did not validate at startup")
        return {
            "success": True,
            "status": (
                "terminal_pending_restoration"
                if current.get("terminal") is True
                else "guarded"
            ),
            "task_id": job_id,
        }
    except (OSError, ValueError, sqlite3.Error, json.JSONDecodeError) as exc:
        generic = {
            "phase": "failed",
            "task_id": "recovery-required",
            "progress_percent": 0,
            "children": [],
        }
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_HTML_PATH,
            _render_appliance_update_status_html(generic),
        )
        _write_update_status_nginx_include()
        for path, default_management in _appliance_update_status_nginx_sites():
            if not path.is_file():
                continue
            guarded = _site_with_update_status_guards(
                path.read_text(encoding="utf-8"),
                default_management=default_management,
            )
            _write_appliance_update_runtime_file(path, guarded)
        _write_appliance_update_runtime_file(
            ATLASO_UPDATE_STATUS_MARKER_PATH,
            "recovery-required\n",
        )
        validation = _nginx_test_command()
        return {
            "success": validation.returncode == 0,
            "status": "recovery_failed",
            "mutation_blocked": True,
            "error": f"Update-only status recovery requires attention: {type(exc).__name__}.",
        }


def _set_release_maintenance(
    enabled: bool,
    *,
    cleanup_preflight_failure: bool = False,
) -> dict:
    """Perform set release maintenance.

    Args:
        enabled: Whether the associated resource or behavior is enabled.
        cleanup_preflight_failure: Restore the prior front door when initial admission fails before services stop.
    """
    if enabled:
        def abort_enable(result: dict, previous: str | None) -> dict:
            """Attach cleanup only at the initial pre-shutdown admission boundary.

            Args:
                result: Maintenance enablement failure payload to return.
                previous: Applied management nginx site content to restore, when available.
            """
            if cleanup_preflight_failure:
                result["preflight_cleanup"] = _restore_release_maintenance_preflight(previous)
            return result

        ATLASO_UPDATE_MAINTENANCE_PATH.parent.mkdir(parents=True, exist_ok=True)
        ATLASO_UPDATE_MAINTENANCE_PATH.touch(mode=0o644, exist_ok=True)
        if not NGINX_MANAGEMENT_SITE_PATH.is_file():
            failure = _release_maintenance_failure(
                "management_site",
                "The applied management nginx site is unavailable; Atlaso services remain running.",
            )
            return abort_enable(failure, None)
        try:
            previous = NGINX_MANAGEMENT_SITE_PATH.read_text(encoding="utf-8")
        except OSError as exc:
            failure = _release_maintenance_failure(
                "management_site",
                f"The applied management nginx site could not be read ({type(exc).__name__}); Atlaso services remain running.",
            )
            return abort_enable(failure, None)
        try:
            guarded = _management_site_with_release_maintenance_guards(previous)
        except ValueError as exc:
            failure = _release_maintenance_failure(
                "management_site",
                f"The applied management nginx site could not be guarded ({type(exc).__name__}); Atlaso services remain running.",
            )
            return abort_enable(failure, previous)
        if guarded != previous:
            temporary = NGINX_MANAGEMENT_SITE_PATH.with_suffix(".conf.tmp")
            try:
                temporary.write_text(guarded, encoding="utf-8")
                os.chmod(temporary, 0o644)
                temporary.replace(NGINX_MANAGEMENT_SITE_PATH)
            except OSError as exc:
                failure = _release_maintenance_failure(
                    "management_site",
                    f"The guarded management nginx site could not be installed ({type(exc).__name__}); Atlaso services remain running.",
                )
                return abort_enable(failure, previous)
        validation = _nginx_test_command()
        if validation.returncode != 0:
            failure = _release_maintenance_failure(
                "nginx_validation",
                "The guarded management nginx configuration is invalid; Atlaso services remain running.",
                returncode=validation.returncode,
            )
            return abort_enable(failure, previous)
        result = _service_command("reload", "nginx.service")
        result["command"] = ["maintenance", "enable"]
        if not result["success"]:
            result["failure_layer"] = "nginx_reload"
            return abort_enable(result, previous)
        probe = _verify_release_maintenance_response(guarded)
        if not probe["success"]:
            return abort_enable(probe, previous)
        result["maintenance_probe"] = probe
        result["stdout"] = "Atlaso management maintenance response enabled, reloaded, and verified."
        return result
    ATLASO_UPDATE_MAINTENANCE_PATH.parent.mkdir(parents=True, exist_ok=True)
    ATLASO_UPDATE_MAINTENANCE_PATH.touch(mode=0o644, exist_ok=True)
    validation = _nginx_test_command()
    if validation.returncode != 0:
        return {
            "command": ["maintenance", "disable", "nginx", "-t"],
            "returncode": validation.returncode,
            "success": False,
            "stdout": validation.stdout[-4000:],
            "stderr": validation.stderr[-4000:],
        }
    result = _service_command("reload", "nginx.service")
    result["command"] = ["maintenance", "disable", "reload", "nginx.service"]
    if result["success"]:
        ATLASO_UPDATE_MAINTENANCE_PATH.unlink(missing_ok=True)
        result["stdout"] = "Atlaso management maintenance response disabled and nginx reloaded."
    return result


def _restore_release_maintenance_preflight(previous: str | None) -> dict:
    """Restore the live front door after maintenance preflight aborts.

    Args:
        previous: Applied management nginx site captured before preflight, when available.

    Returns:
        Sanitized cleanup evidence. The marker is removed even when validation or reload fails because Atlaso services
        have not been stopped at this boundary.
    """
    restored = previous is None
    validation: subprocess.CompletedProcess[str] | None = None
    reload_result: dict | None = None
    error = ""
    if previous is not None:
        try:
            temporary = NGINX_MANAGEMENT_SITE_PATH.with_suffix(".conf.preflight-restore")
            temporary.write_text(previous, encoding="utf-8")
            os.chmod(temporary, 0o644)
            temporary.replace(NGINX_MANAGEMENT_SITE_PATH)
            restored = True
            validation = _nginx_test_command()
            if validation.returncode == 0:
                reload_result = _service_command("reload", "nginx.service")
            else:
                error = "The restored management nginx site did not validate."
        except OSError as exc:
            error = f"The prior management nginx site could not be restored ({type(exc).__name__})."
    marker_error = ""
    try:
        ATLASO_UPDATE_MAINTENANCE_PATH.unlink(missing_ok=True)
    except OSError as exc:
        marker_error = f"The preflight marker could not be removed ({type(exc).__name__})."
    marker_removed = not ATLASO_UPDATE_MAINTENANCE_PATH.exists()
    validation_success = previous is None or bool(validation and validation.returncode == 0)
    reload_success = previous is None or bool(reload_result and reload_result.get("success"))
    success = bool(restored and marker_removed and validation_success and reload_success)
    if reload_result is not None and not reload_success:
        error = "The restored management nginx site could not be reloaded."
    if marker_error:
        error = marker_error
    return {
        "command": ["maintenance", "preflight-abort", "restore"],
        "returncode": 0 if success else 1,
        "success": success,
        "stdout": (
            "The prior management nginx site was restored and the preflight marker was removed."
            if success
            else "The preflight marker was removed while Atlaso services remained running."
        ),
        "stderr": error,
        "layer": "maintenance_preflight_cleanup",
        "site_restored": restored,
        "marker_removed": marker_removed,
        "nginx_validated": validation_success,
        "nginx_reloaded": reload_success,
    }


def _release_maintenance_condition(*, indent: str = "  ", response_code: int = 503) -> str:
    """Return the nginx condition that closes one management server block.

    Args:
        indent: Whitespace used to indent the condition inside its server block.
        response_code: Internal response selected for the active maintenance marker.
    """
    if response_code not in {418, 503}:
        raise ValueError("release maintenance response code is invalid")
    return (
        f"{indent}if (-f {ATLASO_UPDATE_MAINTENANCE_PATH}) "
        f"{{ return {response_code}; }}"
    )


def _management_site_server_ranges(text: str) -> list[tuple[re.Match[str], int]]:
    """Return every top-level server-block range in an Atlaso management site.

    Args:
        text: Applied Atlaso management nginx configuration.

    Raises:
        ValueError: If the managed site contains no server blocks.
    """
    starts = list(re.finditer(r"(?m)^(?P<indent>[ \t]*)server[ \t]*\{[ \t]*(?:#.*)?$", text))
    if not starts:
        raise ValueError("management nginx site contains no server blocks")
    return [
        (match, starts[index + 1].start() if index + 1 < len(starts) else len(text))
        for index, match in enumerate(starts)
    ]


def _management_site_with_release_maintenance_guards(text: str) -> str:
    """Ensure every applied management server block observes the release marker.

    Args:
        text: Applied Atlaso management nginx configuration.

    Returns:
        The configuration with a maintenance condition in every server block.
    """
    condition_pattern = re.compile(
        rf"(?m)^\s*if\s+\(-f\s+{re.escape(str(ATLASO_UPDATE_MAINTENANCE_PATH))}\)\s*"
        r"\{\s*return\s+(?:418|503);\s*\}\s*$"
    )
    guarded = text
    for match, end in reversed(_management_site_server_ranges(text)):
        block = text[match.start():end]
        update_status_active = (
            str(ATLASO_UPDATE_STATUS_NGINX_INCLUDE_PATH) in block
            and str(ATLASO_UPDATE_STATUS_MARKER_PATH) in block
        )
        response_code = 418 if update_status_active else 503
        existing = condition_pattern.search(block)
        if existing is not None:
            replacement = _release_maintenance_condition(
                indent=re.match(r"^\s*", existing.group(0)).group(0),
                response_code=response_code,
            )
            absolute_start = match.start() + existing.start()
            absolute_end = match.start() + existing.end()
            guarded = guarded[:absolute_start] + replacement + guarded[absolute_end:]
            continue
        line_end = text.find("\n", match.end())
        insertion = len(text) if line_end < 0 else line_end + 1
        newline = "\r\n" if "\r\n" in text else "\n"
        condition = _release_maintenance_condition(
            indent=f"{match.group('indent')}  ",
            response_code=response_code,
        )
        guarded = guarded[:insertion] + condition + newline + guarded[insertion:]
    return guarded


def _release_maintenance_probe_urls(text: str) -> tuple[tuple[str, bool], ...]:
    """Return loopback URLs for every default management listener.

    Args:
        text: Guarded Atlaso management nginx configuration.

    Raises:
        ValueError: If the applied site has no default HTTP or HTTPS listener.
    """
    probes: list[tuple[str, bool]] = []
    for match, end in _management_site_server_ranges(text):
        block = text[match.start():end]
        for listener in re.finditer(r"(?m)^\s*listen\s+(?P<endpoint>\S+)(?P<options>[^;]*);", block):
            options = listener.group("options")
            if "default_server" not in options.split():
                continue
            endpoint = listener.group("endpoint")
            port_match = re.search(r"(?P<port>\d+)$", endpoint)
            if port_match is None:
                continue
            port = int(port_match.group("port"))
            insecure = "ssl" in options.split()
            scheme = "https" if insecure else "http"
            default_port = 443 if insecure else 80
            authority = "127.0.0.1" if port == default_port else f"127.0.0.1:{port}"
            probe = (f"{scheme}://{authority}/openapi.json", insecure)
            if probe not in probes:
                probes.append(probe)
    if not probes:
        raise ValueError("management nginx site contains no default listener")
    return tuple(probes)


def _release_maintenance_failure(layer: str, message: str, *, returncode: int = 1) -> dict:
    """Return one sanitized maintenance-activation failure.

    Args:
        layer: Stable failing layer for operator diagnostics.
        message: Sanitized failure detail.
        returncode: Nonzero helper result associated with the failure.
    """
    return {
        "command": ["maintenance", "enable", layer],
        "returncode": returncode or 1,
        "success": False,
        "stdout": "",
        "stderr": message,
        "failure_layer": layer,
    }


def _verify_release_maintenance_response(
    text: str,
    *,
    samples: int = 3,
    attempts: int = 10,
    retry_interval: float = 0.2,
) -> dict:
    """Prove nginx observes the marker before Atlaso services may stop.

    Args:
        text: Guarded Atlaso management nginx configuration.
        samples: Consecutive 503 samples required from every default listener.
        attempts: Maximum bounded probe rounds allowed while nginx converges.
        retry_interval: Delay between probe rounds.
    """
    curl = shutil.which("curl")
    if curl is None:
        return _release_maintenance_failure(
            "maintenance_probe",
            "curl is unavailable for the nginx maintenance response proof; Atlaso services remain running.",
        )
    try:
        probes = _release_maintenance_probe_urls(text)
    except ValueError as exc:
        return _release_maintenance_failure(
            "maintenance_probe",
            f"The nginx maintenance response could not be targeted ({exc}); Atlaso services remain running.",
        )
    statuses: dict[str, str] = {}
    consecutive = 0
    completed_attempts = 0
    for attempt in range(max(samples, attempts)):
        completed_attempts = attempt + 1
        statuses = {
            url: _console_management_http_status(curl, url, insecure=insecure)
            for url, insecure in probes
        }
        if all(status == "503" for status in statuses.values()):
            consecutive += 1
            if consecutive >= samples:
                break
        else:
            consecutive = 0
        if completed_attempts < max(samples, attempts):
            time.sleep(retry_interval)
    if consecutive < samples:
        return _release_maintenance_failure(
            "maintenance_probe",
            "The applied nginx management listeners did not all return a stable maintenance response; Atlaso services remain running.",
        )
    return {
        "command": ["maintenance", "enable", "probe"],
        "returncode": 0,
        "success": True,
        "stdout": "The applied nginx management listeners returned 503 before Atlaso service shutdown.",
        "stderr": "",
        "layer": "maintenance_probe",
        "listener_count": len(statuses),
        "stable_samples": consecutive,
        "attempts": completed_attempts,
    }


def _write_release_finalizer(payload: dict) -> None:
    """Write release finalizer.

    Args:
        payload: Validated request or task payload consumed by the operation.
    """
    ATLASO_UPDATE_FINALIZER_PATH.parent.mkdir(parents=True, exist_ok=True)
    temporary = ATLASO_UPDATE_FINALIZER_PATH.with_suffix(".tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.chmod(0o644)
    _fsync_file(temporary)
    os.replace(temporary, ATLASO_UPDATE_FINALIZER_PATH)
    _fsync_directory(ATLASO_UPDATE_FINALIZER_PATH.parent)


def _release_transaction_owner() -> dict[str, object]:
    """Return durable identity for the helper process that owns a release transaction."""
    if os.name != "posix":
        return {"boot_id": "non-posix-test", "pid": os.getpid(), "start_ticks": "non-posix-test"}
    try:
        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text(encoding="utf-8").strip()
        process_stat = Path(f"/proc/{os.getpid()}/stat").read_text(encoding="utf-8")
        start_ticks = process_stat.rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError) as exc:
        raise ValueError("release transaction owner identity is unavailable") from exc
    if not boot_id or not start_ticks:
        raise ValueError("release transaction owner identity is incomplete")
    return {
        "boot_id": boot_id,
        "pid": os.getpid(),
        "start_ticks": start_ticks,
    }


def _release_transaction_owner_alive(owner: object) -> bool:
    """Return whether durable owner evidence still identifies the running helper.

    Args:
        owner: Persisted boot, PID, and process-start identity.
    """
    if not isinstance(owner, dict):
        return False
    try:
        pid = int(owner.get("pid") or 0)
        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text(encoding="utf-8").strip()
        process_stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        start_ticks = process_stat.rsplit(")", 1)[1].split()[19]
    except (OSError, ValueError, IndexError):
        return False
    return bool(
        pid > 0
        and boot_id
        and boot_id == str(owner.get("boot_id") or "")
        and start_ticks == str(owner.get("start_ticks") or "")
    )


def _release_transaction_recovery_evidence(
    *,
    previous: Path,
    candidate: Path,
    backup_root: Path,
    database_backup: Path,
    database_backed_up: bool,
    file_backups: list[tuple[Path | None, Path]],
) -> dict[str, object]:
    """Return the bounded root-owned rollback manifest persisted before activation.

    Args:
        previous: Previously active release directory.
        candidate: Candidate release directory being activated.
        backup_root: Transaction backup root.
        database_backup: SQLite backup created before migration.
        database_backed_up: Whether the SQLite backup is complete.
        file_backups: Installed-asset backup and destination pairs.
    """
    return {
        "schema_version": 1,
        "owner": _release_transaction_owner(),
        "previous_release": str(previous.resolve()),
        "candidate_release": str(candidate.resolve()),
        "backup_root": str(backup_root.resolve()),
        "database_backup": str(database_backup.resolve()),
        "database_backed_up": database_backed_up,
        "file_backups": [
            {
                "backup": str(backup.resolve()) if backup is not None else "",
                "destination": str(destination),
            }
            for backup, destination in file_backups
        ],
    }


def _service_main_pid(unit: str) -> int:
    """Return the positive systemd main PID for a service, or zero when unavailable.

    Args:
        unit: Systemd service unit whose running process is inspected.
    """
    result = _run(["systemctl", "show", "--property=MainPID", "--value", unit])
    try:
        pid = int(result.stdout.strip()) if result.returncode == 0 else 0
    except ValueError:
        return 0
    return pid if pid > 0 else 0


def _set_release_restart_gate(enabled: bool, job_id: str = "") -> None:
    """Set or clear the runtime gate that serializes worker recovery with release finalization.

    Args:
        enabled: Whether worker recovery must remain gated.
        job_id: Appliance Update job associated with the active release transaction.
    """
    if enabled:
        temporary = ATLASO_UPDATE_RESTART_GATE_PATH.with_name(
            f"{ATLASO_UPDATE_RESTART_GATE_PATH.name}.{os.getpid()}.tmp"
        )
        temporary.write_text(f"{job_id}\n", encoding="utf-8")
        temporary.chmod(0o644)
        os.replace(temporary, ATLASO_UPDATE_RESTART_GATE_PATH)
        return
    ATLASO_UPDATE_RESTART_GATE_PATH.unlink(missing_ok=True)


def _wait_for_worker_activation(
    *,
    expected_version: str,
    expected_release: Path,
    expected_job_id: str,
    previous_pid: int,
    timeout_seconds: int = 60,
) -> dict:
    """Wait for a restarted candidate worker to publish exact startup identity.

    Args:
        expected_version: Candidate version the restarted worker must report.
        expected_release: Candidate release root the restarted worker must resolve.
        expected_job_id: Release job the restarted worker must bind to its startup marker.
        previous_pid: Worker PID that existed before the transactional restart.
        timeout_seconds: Maximum time to wait for matching startup evidence.
    """
    deadline = time.monotonic() + timeout_seconds
    observed_pid = 0
    observed_version = ""
    observed_release = ""
    observed_job_id = ""
    observed_boot_id = ""
    observed_start_ticks = ""
    while time.monotonic() < deadline:
        observed_pid = _service_main_pid("atlaso-worker.service")
        running_identity = _running_worker_process_identity(observed_pid)
        try:
            marker = json.loads(ATLASO_WORKER_STARTUP_STATUS_PATH.read_text(encoding="utf-8"))
        except (OSError, UnicodeDecodeError, json.JSONDecodeError):
            marker = {}
        if isinstance(marker, dict):
            observed_version = str(marker.get("version") or "").split("+", 1)[0]
            observed_release = str(marker.get("current_release") or "")
            observed_job_id = str(marker.get("release_job_id") or "")
            observed_boot_id = str(marker.get("boot_id") or "")
            observed_start_ticks = str(marker.get("start_ticks") or "")
            try:
                marker_pid = int(marker.get("pid") or 0)
            except (TypeError, ValueError):
                marker_pid = 0
            try:
                release_matches = (
                    Path(observed_release).resolve(strict=True) == expected_release.resolve(strict=True)
                )
            except (OSError, ValueError):
                release_matches = False
            if (
                observed_pid > 0
                and observed_pid != previous_pid
                and marker_pid == observed_pid
                and observed_boot_id == str(running_identity.get("boot_id") or "")
                and observed_start_ticks == str(running_identity.get("start_ticks") or "")
                and observed_version == expected_version
                and observed_job_id == expected_job_id
                and release_matches
            ):
                return _release_check(
                    "worker_restart",
                    True,
                    "The restarted worker published the candidate release identity.",
                    worker_pid=observed_pid,
                    worker_version=observed_version,
                    worker_release=observed_release,
                    release_job_id=observed_job_id,
                    worker_boot_id=observed_boot_id,
                    worker_start_ticks=observed_start_ticks,
                )
        time.sleep(1)
    return _release_check(
        "worker_restart",
        False,
        "The restarted worker did not publish the candidate release identity before timeout.",
        worker_pid=observed_pid,
        worker_version=observed_version,
        worker_release=observed_release,
        release_job_id=observed_job_id,
        worker_boot_id=observed_boot_id,
        worker_start_ticks=observed_start_ticks,
    )


def _running_worker_process_identity(pid: int) -> dict[str, object]:
    """Return boot and process-start identity for the running systemd worker PID.

    Args:
        pid: Main PID reported by systemd for ``atlaso-worker.service``.
    """
    if pid <= 0:
        return {}
    if os.name != "posix":
        return {"boot_id": "non-posix-test", "pid": pid, "start_ticks": "non-posix-test"}
    try:
        boot_id = Path("/proc/sys/kernel/random/boot_id").read_text(encoding="utf-8").strip()
        process_stat = Path(f"/proc/{pid}/stat").read_text(encoding="utf-8")
        start_ticks = process_stat.rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return {}
    if not boot_id or not start_ticks:
        return {}
    return {"boot_id": boot_id, "pid": pid, "start_ticks": start_ticks}


def _release_root_version(release_root: Path) -> str:
    """Return the version declared by an installed release root.

    Args:
        release_root: Installed release directory whose version is inspected.
    """
    for name in (".release-manifest.json", "bundle-metadata.json"):
        try:
            payload = json.loads((release_root / name).read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(payload, dict) and str(payload.get("version") or "").strip():
            return str(payload["version"]).split("+", 1)[0]
    return release_root.name.removeprefix("bootstrap-")


def _release_check(
    layer: str,
    success: bool,
    message: str,
    **evidence: object,
) -> dict:
    """Return one sanitized release-activation check result.

    Args:
        layer: Stable activation layer represented by the check.
        success: Whether the layer satisfied its activation contract.
        message: Sanitized human-readable result detail.
        **evidence: Additional non-secret structured activation evidence.
    """
    return {
        "command": ["release-activation-check", layer],
        "returncode": 0 if success else 1,
        "success": success,
        "stdout": message if success else "",
        "stderr": "" if success else message,
        "layer": layer,
        **evidence,
    }


def _wait_for_openapi_version(
    *,
    layer: str,
    url: str,
    expected_version: str,
    insecure: bool = False,
    timeout_seconds: int = 60,
) -> dict:
    """Wait for one OpenAPI endpoint to report the exact candidate version.

    Args:
        layer: Stable activation layer represented by the endpoint.
        url: Internal or host-facing OpenAPI endpoint to probe.
        expected_version: Exact candidate version required from the endpoint.
        insecure: Whether the local HTTPS probe may bypass CA validation.
        timeout_seconds: Maximum time to wait for the expected version.
    """
    deadline = time.monotonic() + timeout_seconds
    observed_version = ""
    last_error = "endpoint unavailable"
    context = ssl._create_unverified_context() if insecure else None  # noqa: SLF001 - local CA probe.
    while time.monotonic() < deadline:
        try:
            with urlopen(url, timeout=3, context=context) as response:
                payload = json.loads(response.read().decode("utf-8"))
            observed_version = str((payload.get("info") or {}).get("version") or "").split("+", 1)[0]
            if response.status == 200 and observed_version == expected_version:
                return _release_check(
                    layer,
                    True,
                    f"{layer} reported Atlaso {expected_version}.",
                    expected_version=expected_version,
                    observed_version=observed_version,
                )
            last_error = f"reported version {observed_version or 'unknown'}"
        except Exception as exc:  # noqa: BLE001 - bounded readiness retry with sanitized evidence.
            last_error = type(exc).__name__
        time.sleep(1)
    return _release_check(
        layer,
        False,
        f"{layer} did not report candidate Atlaso {expected_version} within {timeout_seconds} seconds ({last_error}).",
        expected_version=expected_version,
        observed_version=observed_version,
    )


def _release_front_door_readiness_url(url: str) -> str:
    """Return the loopback-only nginx path used during an update hold.

    Args:
        url: Applied management-listener OpenAPI URL.
    """
    parsed = urlparse(url)
    if parsed.path != "/openapi.json" or parsed.query or parsed.fragment:
        raise ValueError("management front-door readiness URL is invalid")
    return parsed._replace(path=ATLASO_UPDATE_READINESS_PATH).geturl()


def _release_activation_verification(
    release_root: Path,
    release: dict,
    *,
    require_receipt: bool = True,
    include_worker: bool = True,
    maintenance_expected: bool = False,
    include_front_door: bool = True,
    timeout_seconds: int = 60,
) -> tuple[dict, list[dict]]:
    """Verify durable active-release, service, nginx, and exact-version agreement.

    Args:
        release_root: Installed release directory expected to be active.
        release: Signed release manifest used to validate the active receipt.
        require_receipt: Whether signed receipt identity is mandatory for this verification.
        include_worker: Whether the worker must already be active during verification.
        maintenance_expected: Whether the management front door must remain transactionally closed.
        include_front_door: Whether to require an exact-version response through nginx.
        timeout_seconds: Maximum readiness wait for each OpenAPI endpoint.
    """
    expected_version = str(release.get("version") or "").split("+", 1)[0]
    checks: list[dict] = []
    try:
        active_root = _active_release_root()
        active_matches = active_root.resolve() == release_root.resolve()
        checks.append(
            _release_check(
                "active_release",
                active_matches,
                "Active release and compatibility virtualenv resolve to the candidate."
                if active_matches
                else "Active release or compatibility virtualenv does not resolve to the candidate.",
                current_release=str(active_root),
                compatibility_venv=str(ATLASO_VENV_LINK.resolve()),
            )
        )
    except (OSError, ValueError) as exc:
        active_root = None
        checks.append(_release_check("active_release", False, str(exc)))

    receipt_version = ""
    receipt_sha256 = ""
    receipt_matches = not require_receipt
    try:
        receipt = json.loads((release_root / ".release-manifest.json").read_text(encoding="utf-8"))
        if isinstance(receipt, dict):
            receipt_version = str(receipt.get("version") or "").split("+", 1)[0]
            receipt_sha256 = hashlib.sha256(
                json.dumps(receipt, separators=(",", ":"), sort_keys=True).encode("utf-8")
            ).hexdigest()
            receipt_matches = receipt == release if require_receipt else receipt_version == expected_version
    except (OSError, json.JSONDecodeError):
        receipt_matches = not require_receipt and _release_root_version(release_root) == expected_version
    checks.append(
        _release_check(
            "release_receipt",
            receipt_matches,
            "Signed release receipt matches the candidate."
            if receipt_matches
            else "Signed release receipt does not match the candidate.",
            expected_version=expected_version,
            observed_version=receipt_version,
            receipt_manifest_sha256=receipt_sha256,
        )
    )

    maintenance_removed = not ATLASO_UPDATE_MAINTENANCE_PATH.exists()
    maintenance_ready = not maintenance_removed if maintenance_expected else maintenance_removed
    checks.append(
        _release_check(
            "maintenance_hold" if maintenance_expected else "maintenance_cleanup",
            maintenance_ready,
            "Nginx maintenance mode remains enabled."
            if maintenance_expected and maintenance_ready
            else (
                "Nginx maintenance mode is removed."
                if maintenance_ready
                else "Nginx maintenance mode is not in the required transaction state."
            ),
        )
    )
    nginx = _nginx_test_command()
    checks.append(
        {
            "command": ["nginx", "-t"],
            "returncode": nginx.returncode,
            "success": nginx.returncode == 0,
            "stdout": nginx.stdout[-4000:],
            "stderr": nginx.stderr[-4000:],
            "layer": "nginx_configuration",
        }
    )
    required_services = ["atlaso.service"]
    if include_worker:
        required_services.append("atlaso-worker.service")
    required_services.extend(("atlaso-console.service", "nginx.service"))
    services = _service_command("is-active", *required_services)
    services["layer"] = "service_state"
    services["worker_required"] = include_worker
    checks.append(services)
    checks.append(
        _wait_for_openapi_version(
            layer="internal_openapi",
            url="http://127.0.0.1:8000/openapi.json",
            expected_version=expected_version,
            timeout_seconds=timeout_seconds,
        )
    )
    if include_front_door:
        try:
            _https_enabled, readiness_checks = _console_management_readiness_checks()
            _label, front_door_url, insecure, _expected_status = next(
                check
                for check in readiness_checks
                if check[0].startswith("nginx") and check[1].endswith("/openapi.json")
            )
            if ATLASO_UPDATE_STATUS_MARKER_PATH.exists():
                front_door_url = _release_front_door_readiness_url(front_door_url)
            checks.append(
                _wait_for_openapi_version(
                    layer="management_front_door",
                    url=front_door_url,
                    expected_version=expected_version,
                    insecure=insecure,
                    timeout_seconds=timeout_seconds,
                )
            )
        except (OSError, StopIteration, ValueError) as exc:
            checks.append(_release_check("management_front_door", False, str(exc)))

    failed = next((check for check in checks if not check.get("success")), None)
    checks_by_layer = {str(check.get("layer") or ""): check for check in checks}
    verification = {
        "success": failed is None,
        "candidate_version": expected_version,
        "current_release": str(active_root) if active_root is not None else "",
        "compatibility_venv": str(ATLASO_VENV_LINK.resolve()) if ATLASO_VENV_LINK.exists() else "",
        "receipt_version": receipt_version,
        "receipt_manifest_sha256": receipt_sha256,
        "maintenance_removed": maintenance_removed,
        "nginx_ready": bool(checks_by_layer.get("nginx_configuration", {}).get("success")),
        "services_active": bool(services.get("success")),
        "internal_version": str(checks_by_layer.get("internal_openapi", {}).get("observed_version") or ""),
        "host_facing_version": str(checks_by_layer.get("management_front_door", {}).get("observed_version") or ""),
        "failure_layer": str((failed or {}).get("layer") or ""),
    }
    return verification, checks


def _sync_release_activation() -> dict:
    """Flush release activation changes before definitive success is recorded."""
    try:
        sync = getattr(os, "sync", None)
        if sync is not None:
            sync()
    except OSError as exc:
        return _release_check("durable_activation", False, f"Persisting release activation failed: {exc}")
    return _release_check("durable_activation", True, "Release activation changes were flushed to durable storage.")


def _prune_old_releases(*, current: Path, previous: Path) -> None:
    """Perform prune old releases.

    Args:
        current: Filesystem path associated with current.
        previous: Filesystem path associated with previous.
    """
    keep = {current.resolve(), previous.resolve()}
    for path in ATLASO_RELEASES_DIR.iterdir():
        if not path.is_dir() or path.resolve() in keep:
            continue
        shutil.rmtree(path)


def _apply_atlaso_release(
    payload: dict,
    credentials: dict[str, dict[str, str]] | None = None,
    credential_path: Path | None = None,
) -> tuple[dict, dict, list[dict]]:
    """Perform apply atlaso release.

    Args:
        payload: Validated request or task payload consumed by the operation.
        credentials: Credentials consumed by apply atlaso release.
        credential_path: Protected staged credential file to remove before worker handoff.
    """
    credentials = credentials or {}
    channel, release, release_manifest_url, release_credential = _download_signed_release_from_sources(payload, credentials)
    bundle = release["bundle"]
    bundle_url = str(bundle["url"])
    bundle_credential = _credential_for_related_url(release_manifest_url, bundle_url, release_credential)
    bundle_bytes = _fetch_http_bytes(bundle_url, bundle_credential)
    digest = hashlib.sha256(bundle_bytes).hexdigest()
    if len(bundle_bytes) != int(bundle["size"]):
        raise ValueError("Atlaso release bundle size does not match its signed manifest")
    if not hmac.compare_digest(digest, str(bundle["sha256"]).lower()):
        raise ValueError("Atlaso release bundle SHA256 does not match its signed manifest")
    if credential_path is not None:
        credential_path.unlink(missing_ok=True)
        _fsync_directory(credential_path.parent)

    version = str(release["version"])
    if re.fullmatch(r"[0-9]+\.[0-9]+\.[0-9]+", version) is None:
        raise ValueError("Atlaso release version must use X.Y.Z semantic versioning")
    commands: list[dict] = []
    staging = ATLASO_RELEASES_DIR / f".staging-{version}-{os.getpid()}"
    release_root = ATLASO_RELEASES_DIR / version
    ATLASO_RELEASES_DIR.mkdir(parents=True, exist_ok=True)
    created_release_root = False
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir()
    try:
        bundle_path = staging / "release.tar.gz"
        bundle_path.write_bytes(bundle_bytes)
        extracted = staging / "content"
        extracted.mkdir()
        _safe_extract_release(bundle_path, extracted)
        _validate_release_content(release, extracted)
        (extracted / ".release-manifest.json").write_text(
            json.dumps(release, indent=2, sort_keys=True) + "\n",
            encoding="utf-8",
        )
        install_commands = _install_release_venv(extracted, _current_python_abi())
        commands.extend(install_commands)
        if not all(command["success"] for command in install_commands):
            raise ValueError("Offline Atlaso release environment validation failed")
        bundle_path.unlink()
        content = staging / "content"
        if release_root.exists():
            receipt_path = release_root / ".release-manifest.json"
            try:
                installed_release = json.loads(receipt_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as exc:
                raise ValueError(
                    f"Atlaso release directory {version} has no valid signed-release receipt"
                ) from exc
            if installed_release != release:
                raise ValueError(f"Atlaso release directory {version} already contains different content")
            shutil.rmtree(staging)
        else:
            os.replace(content, release_root)
            _fsync_directory(ATLASO_RELEASES_DIR)
            created_release_root = True
            shutil.rmtree(staging)
    except Exception:
        shutil.rmtree(staging, ignore_errors=True)
        if created_release_root and release_root.exists():
            shutil.rmtree(release_root, ignore_errors=True)
        raise

    previous = _active_release_root()
    previous_version = _release_root_version(previous)
    python_abi = _current_python_abi()
    finalizer_evidence = {
        "job_id": str(payload.get("job_id") or ""),
        "channel": channel.get("channel"),
        "release": version,
        "candidate_version": version,
        "previous_version": previous_version,
        "git_commit": release.get("git_commit"),
        "release_manifest_url": release_manifest_url,
        "release_manifest_sha256": hashlib.sha256(
            json.dumps(release, separators=(",", ":"), sort_keys=True).encode("utf-8")
        ).hexdigest(),
        "verified_key_id": release.get("signing_key_id") or channel.get("signing_key_id"),
        "bundle_sha256": bundle.get("sha256"),
        "bundle_size": bundle.get("size"),
        "content_hashes": release.get("content_hashes"),
        "compatibility": {
            "python_abi": python_abi,
            "supported_python_abis": release.get("supported_python_abis"),
            "supported": python_abi in set(release.get("supported_python_abis") or []),
            "updater_protocol": release.get("updater_protocol"),
            "database_schema_version": release.get("database_schema_version"),
        },
    }
    ATLASO_UPDATE_FINALIZER_PATH.unlink(missing_ok=True)
    if previous.resolve() == release_root.resolve():
        durable = _sync_release_activation()
        commands.append(durable)
        activation, activation_commands = _release_activation_verification(release_root, release)
        commands.extend(activation_commands)
        if not durable["success"] or not activation["success"]:
            failure_layer = "durable_activation" if not durable["success"] else activation["failure_layer"]
            error = f"Active Atlaso release verification failed at {failure_layer}."
            _write_release_finalizer(
                {
                    **finalizer_evidence,
                    "status": "failed",
                    "rolled_back": False,
                    "no_change": True,
                    "failure_layer": failure_layer,
                    "commands": commands,
                    "active_release_verification": activation,
                    "error": error,
                    "finished_at": datetime.now(timezone.utc).isoformat(),
                }
            )
            raise ValueError(error)
        _write_release_finalizer(
            {
                **finalizer_evidence,
                "status": "succeeded",
                "rolled_back": False,
                "no_change": True,
                "commands": commands,
                "active_release_verification": activation,
                "finished_at": datetime.now(timezone.utc).isoformat(),
            }
        )
        return channel, release, commands
    transaction_id = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    backup_root = ATLASO_UPDATE_BACKUP_DIR / transaction_id
    database_backup = backup_root / "atlaso.db"
    backup_root.mkdir(parents=True, exist_ok=True)
    file_backups: list[tuple[Path | None, Path]] = []
    transaction_recovery: dict[str, object] = {}
    maintenance = _set_release_maintenance(True, cleanup_preflight_failure=True)
    commands.append(maintenance)
    if not maintenance["success"]:
        raise ValueError("Could not enter the nginx maintenance response before release transaction")
    database_backed_up = False
    activation_committed = False
    failure_layer = "service_shutdown"
    try:
        stopped = _service_command("stop", "atlaso.service", "atlaso-console.service")
        commands.append(stopped)
        if not stopped["success"]:
            raise ValueError("Could not stop Atlaso services before release transaction")
        _sqlite_backup(database_backup)
        database_backed_up = True
        failure_layer = "systemd_assets"

        def persist_transaction_checkpoint(backups: list[tuple[Path | None, Path]]) -> None:
            """Persist rollback evidence before any release-owned asset is replaced.

            Args:
                backups: Complete installed-asset backup and destination manifest.
            """
            nonlocal transaction_recovery
            _sync_release_transaction_backups(backup_root, database_backup, backups)
            transaction_recovery = _release_transaction_recovery_evidence(
                previous=previous,
                candidate=release_root,
                backup_root=backup_root,
                database_backup=database_backup,
                database_backed_up=database_backed_up,
                file_backups=backups,
            )
            _write_release_finalizer(
                {
                    **finalizer_evidence,
                    "status": "transaction_pending",
                    "rolled_back": False,
                    "transaction_recovery": transaction_recovery,
                    "commands": commands,
                    "started_at": datetime.now(timezone.utc).isoformat(),
                }
            )

        failure_layer = "transaction_checkpoint"
        file_backups = _install_release_owned_files(
            release_root,
            backup_root,
            before_install=persist_transaction_checkpoint,
        )
        failure_layer = "data_disk_identity"
        disk_identity_commands = _refresh_release_data_disk_identity(validate=False)
        commands.extend(disk_identity_commands)
        if not all(command["success"] for command in disk_identity_commands):
            raise ValueError("Candidate Atlaso release failed data-disk identity refresh")
        _migrate_release_esx_storage_claims(
            backup_root,
            file_backups,
            before_mutation=persist_transaction_checkpoint,
        )
        disk_preflight = _command_payload(["/opt/atlaso/bin/atlaso-mount-data-disks"])
        commands.append(disk_preflight)
        if not disk_preflight["success"]:
            raise ValueError("Candidate Atlaso release failed data-disk policy validation")
        failure_layer = "symlink_switch"
        _atomic_symlink(release_root, ATLASO_CURRENT_LINK)
        failure_layer = "systemd_reload"
        daemon_reload = _service_command("daemon-reload")
        commands.append(daemon_reload)
        if not daemon_reload["success"]:
            raise ValueError("Candidate Atlaso release failed systemd daemon reload")
        failure_layer = "candidate_startup"
        candidate_start = _service_command("start", "atlaso.service")
        commands.append(candidate_start)
        if not candidate_start["success"]:
            raise ValueError("Candidate Atlaso release failed to start")
        health = _wait_for_atlaso_health()
        commands.append(health)
        if not health["success"]:
            raise ValueError("Candidate Atlaso release failed service validation")
        console_start = _service_command("start", "atlaso-console.service")
        commands.append(console_start)
        if not console_start["success"]:
            raise ValueError("Candidate Atlaso release console failed to start")
        active_services = _service_command(
            "is-active",
            "atlaso.service",
            "atlaso-worker.service",
            "atlaso-console.service",
        )
        commands.append(active_services)
        if not active_services["success"]:
            raise ValueError("Candidate Atlaso release services are not active")
        failure_layer = "durable_activation"
        durable = _sync_release_activation()
        commands.append(durable)
        if not durable["success"]:
            raise ValueError("Candidate Atlaso release activation could not be persisted")
        activation, activation_commands = _release_activation_verification(
            release_root,
            release,
            maintenance_expected=True,
            include_front_door=False,
        )
        commands.extend(activation_commands)
        if not activation["success"]:
            failure_layer = str(activation.get("failure_layer") or "activation_verification")
            raise ValueError(f"Candidate Atlaso release failed activation verification at {failure_layer}")
        failure_layer = "worker_restart_pending"
        _write_release_finalizer(
            {
                **finalizer_evidence,
                "status": "restart_pending",
                "rolled_back": False,
                "service_health": True,
                "transaction_recovery": transaction_recovery,
                "commands": commands,
                "active_release_verification": activation,
                "started_at": datetime.now(timezone.utc).isoformat(),
            }
        )
        _set_release_restart_gate(True, str(payload.get("job_id") or ""))
        previous_worker_pid = _service_main_pid("atlaso-worker.service")
        failure_layer = "worker_restart"
        worker_restart = _service_command("restart", "atlaso-worker.service")
        commands.append(worker_restart)
        if not worker_restart["success"]:
            raise ValueError("Candidate Atlaso release worker failed to restart")
        worker_activation = _wait_for_worker_activation(
            expected_version=version,
            expected_release=release_root,
            expected_job_id=str(payload.get("job_id") or ""),
            previous_pid=previous_worker_pid,
        )
        commands.append(worker_activation)
        if not worker_activation["success"]:
            raise ValueError("Candidate Atlaso release worker identity could not be proven")
        failure_layer = "post_restart_activation"
        durable = _sync_release_activation()
        commands.append(durable)
        if not durable["success"]:
            raise ValueError("Candidate Atlaso release post-restart activation could not be persisted")
        activation, activation_commands = _release_activation_verification(
            release_root,
            release,
            maintenance_expected=True,
            include_front_door=False,
        )
        commands.extend(activation_commands)
        if not activation["success"]:
            failure_layer = str(activation.get("failure_layer") or "post_restart_activation")
            raise ValueError(f"Candidate Atlaso release failed post-restart verification at {failure_layer}")
        failure_layer = "release_cleanup"
        _prune_old_releases(current=release_root, previous=previous)
        failure_layer = "activation_commit"
        committed = {
            **finalizer_evidence,
            "status": "activation_committed",
            "rolled_back": False,
            "service_health": True,
            "worker_restart": worker_activation,
            "transaction_recovery": transaction_recovery,
            "commands": commands,
            "active_release_verification": activation,
            "started_at": datetime.now(timezone.utc).isoformat(),
        }
        _write_release_finalizer(committed)
        activation_committed = True
        completion = _complete_committed_release_activation(committed)
        commands[:] = [item for item in completion.get("commands", commands) if isinstance(item, dict)]
        if not completion.get("success"):
            raise ValueError(str(completion.get("error") or "Committed Atlaso release activation requires retry."))
    except Exception as exc:
        if activation_committed:
            raise ValueError(
                f"Atlaso release {version} is committed and requires forward activation recovery: {exc}"
            ) from exc
        transaction_error = str(exc)
        rollback_failures: list[dict] = []

        def rollback_action(layer: str, action: Callable[[], object]) -> tuple[bool, object | None]:
            """Run one rollback step without preventing later recovery attempts.

            Args:
                layer: Stable rollback layer represented by the action.
                action: Rollback operation to execute and capture.
            """
            try:
                result = action()
            except Exception as rollback_exc:  # noqa: BLE001 - rollback must continue after every step.
                evidence = _release_check(
                    f"rollback_{layer}",
                    False,
                    f"Rollback {layer.replace('_', ' ')} raised {type(rollback_exc).__name__}.",
                )
                rollback_failures.append(evidence)
                commands.append(evidence)
                return False, None
            if isinstance(result, list):
                commands.extend(item for item in result if isinstance(item, dict))
                success = all(isinstance(item, dict) and item.get("success") for item in result)
                evidence = _release_check(
                    f"rollback_{layer}",
                    success,
                    f"Rollback {layer.replace('_', ' ')} {'completed' if success else 'failed'}.",
                )
                commands.append(evidence)
                if not success:
                    rollback_failures.append(evidence)
                return success, result
            if isinstance(result, dict):
                result.setdefault("layer", f"rollback_{layer}")
                commands.append(result)
                if not result.get("success"):
                    rollback_failures.append(result)
                return bool(result.get("success")), result
            evidence = _release_check(
                f"rollback_{layer}",
                True,
                f"Rollback {layer.replace('_', ' ')} completed.",
            )
            commands.append(evidence)
            return True, result

        def stop_worker_fail_closed() -> list[dict]:
            """Stop and prove the caller inactive before incomplete rollback evidence."""
            attempts = 0
            while True:
                attempts += 1
                stopped = _service_command("stop", "atlaso-worker.service")
                state = _service_command(
                    "show",
                    "--property=ActiveState",
                    "--value",
                    "atlaso-worker.service",
                )
                active_state = str(state.get("stdout") or "").strip()
                inactive = bool(state.get("success") and active_state == "inactive")
                if inactive:
                    verification = {
                        **state,
                        "success": True,
                        "returncode": 0,
                        "stdout": "Atlaso worker ActiveState is inactive.",
                        "stderr": "",
                        "attempts": attempts,
                    }
                    return [stopped, verification]
                time.sleep(1)

        rollback_gate_ready, _rollback_gate_result = rollback_action(
            "worker_restart_gate_hold",
            lambda: _set_release_restart_gate(True, str(payload.get("job_id") or "")),
        )
        if not rollback_gate_ready:
            rollback_action("worker_fail_closed_stop", stop_worker_fail_closed)
        rollback_action(
            "service_stop",
            lambda: _service_command(
                "stop",
                "atlaso.service",
                "atlaso-console.service",
            ),
        )
        rollback_action("release_link", lambda: _atomic_symlink(previous, ATLASO_CURRENT_LINK))
        database_restored = True
        if database_backed_up:
            database_restored, _database_result = rollback_action(
                "database_restore",
                lambda: _restore_sqlite_backup(database_backup),
            )
        assets_restored, _assets_result = rollback_action(
            "asset_restore",
            lambda: _restore_release_owned_files(file_backups),
        )
        data_disk_restored, _data_disk_result = rollback_action(
            "data_disk_identity",
            lambda: _refresh_release_data_disk_identity(validate=False),
        )
        systemd_reloaded, _systemd_result = rollback_action(
            "systemd_reload",
            lambda: _service_command("daemon-reload"),
        )
        services_started, _start_result = rollback_action(
            "service_start",
            lambda: _service_command("start", "atlaso.service", "atlaso-console.service"),
        )
        _health_ok, rollback_health_result = rollback_action("internal_health", _wait_for_atlaso_health)
        rollback_health = (
            rollback_health_result
            if isinstance(rollback_health_result, dict)
            else _release_check("rollback_internal_health", False, "Rollback internal health was unavailable.")
        )
        _services_ok, rollback_services_result = rollback_action(
            "service_state",
            lambda: _service_command(
                "is-active",
                "atlaso.service",
                "atlaso-console.service",
                "nginx.service",
            ),
        )
        rollback_services = (
            rollback_services_result
            if isinstance(rollback_services_result, dict)
            else _release_check("rollback_service_state", False, "Rollback service state was unavailable.")
        )
        rollback_worker_active, rollback_worker_result = rollback_action(
            "worker_state",
            lambda: _service_command("is-active", "atlaso-worker.service"),
        )
        rollback_worker = (
            rollback_worker_result
            if isinstance(rollback_worker_result, dict)
            else _release_check(
                "rollback_worker_state",
                False,
                "Rollback worker service state was unavailable.",
            )
        )
        _link_ok, rollback_link_result = rollback_action(
            "active_release_link",
            lambda: _release_check(
                "rollback_active_release_link",
                ATLASO_CURRENT_LINK.is_symlink()
                and ATLASO_CURRENT_LINK.resolve(strict=True) == previous.resolve(strict=True),
                "The previous Atlaso release link is restored."
                if ATLASO_CURRENT_LINK.is_symlink()
                and ATLASO_CURRENT_LINK.resolve(strict=True) == previous.resolve(strict=True)
                else "The previous Atlaso release link is not restored.",
            ),
        )
        rollback_link = (
            rollback_link_result
            if isinstance(rollback_link_result, dict)
            else _release_check(
                "rollback_active_release_link",
                False,
                "Rollback active-release link evidence was unavailable.",
            )
        )
        rollback_completed = bool(
            database_restored
            and assets_restored
            and rollback_link.get("success", False)
        )
        rollback_pre_cleanup_ready = bool(
            rollback_completed
            and rollback_gate_ready
            and data_disk_restored
            and systemd_reloaded
            and services_started
            and rollback_health.get("success", False)
            and rollback_services.get("success", False)
            and rollback_worker_active
        )
        _durable_ok, rollback_durable_result = rollback_action(
            "durable_activation",
            _sync_release_activation,
        )
        rollback_durable = (
            rollback_durable_result
            if isinstance(rollback_durable_result, dict)
            else _release_check(
                "rollback_durable_activation",
                False,
                "Rollback durability evidence was unavailable.",
            )
        )
        rollback_release = {"version": previous_version}
        try:
            rollback_activation, rollback_activation_commands = _release_activation_verification(
                previous,
                rollback_release,
                require_receipt=False,
                include_worker=False,
                maintenance_expected=True,
                include_front_door=False,
            )
            commands.extend(rollback_activation_commands)
        except Exception as rollback_exc:  # noqa: BLE001 - retain definitive failed rollback evidence.
            evidence = _release_check(
                "rollback_activation_verification",
                False,
                f"Rollback activation verification raised {type(rollback_exc).__name__}.",
            )
            rollback_failures.append(evidence)
            commands.append(evidence)
            rollback_activation = {
                "success": False,
                "candidate_version": previous_version,
                "failure_layer": "rollback_activation_verification",
            }
        if not rollback_activation.get("success", False):
            evidence = _release_check(
                "rollback_activation_verification",
                False,
                "Rollback activation verification did not prove the previous release ready.",
            )
            rollback_failures.append(evidence)
            commands.append(evidence)
        rollback_internal_ready = bool(
            rollback_pre_cleanup_ready
            and rollback_durable.get("success", False)
            and rollback_activation.get("success", False)
        )
        rollback_committed = False
        rollback_ready = False
        rollback_maintenance = _release_check(
            "rollback_maintenance_hold",
            rollback_internal_ready,
            "Maintenance remains enabled until definitive rollback evidence is durable."
            if rollback_internal_ready
            else "Maintenance remains enabled because rollback readiness is incomplete.",
        )
        commands.append(rollback_maintenance)
        if not rollback_internal_ready:
            rollback_action("maintenance_fail_closed", lambda: _set_release_maintenance(True))
            if not any(item.get("layer") == rollback_maintenance["layer"] for item in rollback_failures):
                rollback_failures.append(rollback_maintenance)
            if rollback_gate_ready:
                rollback_action("worker_fail_closed_stop", stop_worker_fail_closed)
        finalizer_restored, _finalizer_result = rollback_action(
            "finalizer_persistence",
            lambda: _write_release_finalizer(
                {
                    **finalizer_evidence,
                    "status": "failed" if rollback_internal_ready else "rollback_pending",
                    "rolled_back": rollback_internal_ready,
                    "failure_layer": failure_layer,
                    "rollback_health": rollback_internal_ready,
                    "host_facing_ready": False,
                    "rollback_service_checks": {
                        "base": rollback_services,
                        "worker": rollback_worker,
                    },
                    "commands": commands,
                    "transaction_recovery": transaction_recovery,
                    "active_release_verification": rollback_activation,
                    "rollback_failures": [
                        str(item.get("layer") or "rollback_unknown")
                        for item in rollback_failures
                    ],
                    "error": transaction_error,
                    "finished_at": datetime.now(timezone.utc).isoformat(),
                }
            ),
        )
        rollback_committed = bool(finalizer_restored and rollback_internal_ready)
        if rollback_committed:
            _maintenance_ok, rollback_maintenance_result = rollback_action(
                "maintenance_cleanup",
                lambda: _set_release_maintenance(False),
            )
            rollback_maintenance = (
                rollback_maintenance_result
                if isinstance(rollback_maintenance_result, dict)
                else _release_check(
                    "rollback_maintenance_cleanup",
                    False,
                    "Rollback maintenance cleanup was unavailable.",
                )
            )
            rollback_front_activation = {
                **rollback_activation,
                "success": False,
                "failure_layer": "maintenance_cleanup",
            }
            if rollback_maintenance.get("success", False):
                try:
                    rollback_front_activation, rollback_front_commands = _release_activation_verification(
                        previous,
                        rollback_release,
                        require_receipt=False,
                        include_worker=False,
                    )
                    commands.extend(rollback_front_commands)
                except Exception as rollback_exc:  # noqa: BLE001 - retain committed rollback evidence.
                    evidence = _release_check(
                        "rollback_front_door_verification",
                        False,
                        f"Rollback front-door verification raised {type(rollback_exc).__name__}.",
                    )
                    rollback_failures.append(evidence)
                    commands.append(evidence)
                    rollback_front_activation = {
                        "success": False,
                        "candidate_version": previous_version,
                        "failure_layer": "rollback_front_door_verification",
                    }
            rollback_ready = bool(
                rollback_maintenance.get("success", False)
                and rollback_front_activation.get("success", False)
            )
            if not rollback_ready:
                rollback_action("maintenance_fail_closed", lambda: _set_release_maintenance(True))
                evidence = _release_check(
                    "rollback_host_facing_readiness",
                    False,
                    "Maintenance remains enabled because rollback host-facing readiness is incomplete.",
                )
                commands.append(evidence)
                rollback_failures.append(evidence)
            else:
                rollback_activation = rollback_front_activation
                finalizer_restored, _finalizer_result = rollback_action(
                    "finalizer_host_facing_persistence",
                    lambda: _write_release_finalizer(
                        {
                            **finalizer_evidence,
                            "status": "failed",
                            "rolled_back": True,
                            "failure_layer": failure_layer,
                            "rollback_health": True,
                            "host_facing_ready": True,
                            "rollback_service_checks": {
                                "base": rollback_services,
                                "worker": rollback_worker,
                            },
                            "commands": commands,
                            "transaction_recovery": transaction_recovery,
                            "active_release_verification": rollback_activation,
                            "rollback_failures": [
                                str(item.get("layer") or "rollback_unknown")
                                for item in rollback_failures
                            ],
                            "error": transaction_error,
                            "finished_at": datetime.now(timezone.utc).isoformat(),
                        }
                    ),
                )
                if not finalizer_restored:
                    rollback_ready = False
                    rollback_action("maintenance_fail_closed", lambda: _set_release_maintenance(True))
        elif not finalizer_restored:
            rollback_action("maintenance_fail_closed", lambda: _set_release_maintenance(True))
            rollback_action("worker_fail_closed_stop", stop_worker_fail_closed)
        rollback_payload = {
            "status": "failed",
            "success": False,
            "release": version,
            "rolled_back": rollback_committed,
            "host_facing_ready": rollback_ready,
            "failure_layer": failure_layer,
            "rollback_health": {
                "openapi": rollback_health,
                "services": {
                    "base": rollback_services,
                    "worker": rollback_worker,
                },
                "maintenance": rollback_maintenance,
                "active_release_verification": rollback_activation,
            },
            "rollback_failures": [
                str(item.get("layer") or "rollback_unknown") for item in rollback_failures
            ],
            "error": transaction_error,
            "finished_at": datetime.now(timezone.utc).isoformat(),
        }
        if not rollback_committed:
            rollback_payload["error"] = (
                f"{transaction_error} Definitive rollback evidence could not be persisted; "
                "rollback remains incomplete."
            )
        rollback_action("status_evidence", lambda: _write_update_info(rollback_payload))
        if rollback_committed:
            rollback_action(
                "worker_restart_gate",
                lambda: _set_release_restart_gate(False),
            )
        rollback_outcome = "was rolled back" if rollback_committed else "rollback was incomplete"
        raise ValueError(
            f"Atlaso release {version} failed and {rollback_outcome}: {transaction_error}"
        ) from exc
    return channel, release, commands


def _apply_appliance_update(
    payload: dict,
    credentials: dict[str, dict[str, str]] | None = None,
    credential_path: Path | None = None,
) -> dict:
    """Perform apply appliance update.

    Args:
        payload: Validated request or task payload consumed by the operation.
        credentials: Credentials consumed by apply appliance update.
        credential_path: Protected staged credential file owned by the active helper call.
    """
    credentials = credentials or {}
    selected = set(payload.get("selected_streams") or [])
    commands: list[dict] = []
    attempted: dict[str, object] = {}
    reboot_recommended = False
    restart_required = False
    if "photon_os" in selected:
        tdnf = _command_path("tdnf") or "tdnf"
        commands.append(
            _photon_command_payload(payload, credentials, [tdnf, "-y", "makecache"])
        )
        transaction = _photon_command_payload(
            payload, credentials, [tdnf, "-y", "update", "--testonly"]
        )
        transaction["inspection_only"] = True
        commands.append(transaction)
        compatibility = _photon_python_compatibility(payload, credentials)
        commands.append(compatibility)
        previous_abi = _current_python_abi()
        update_command: dict | None = None
        if all(command.get("success") for command in commands):
            update_command = _photon_command_payload(
                payload, credentials, [tdnf, "-y", "update"]
            )
            commands.append(update_command)
        if all(command.get("success") for command in commands):
            rebuild_commands, rebuilt = _rebuild_active_release_for_python(previous_abi)
            commands.extend(rebuild_commands)
            restart_required = restart_required or rebuilt
            if not rebuilt:
                commands.append(_service_command("restart", "atlaso.service", "atlaso-console.service"))
                commands.append(_wait_for_atlaso_health())
                commands.append(
                    _service_command(
                        "is-active",
                        "atlaso.service",
                        "atlaso-worker.service",
                        "atlaso-console.service",
                    )
                )
        photon_succeeded = all(command.get("success") for command in commands)
        attempted["photon_os"] = {
            "message": (
                "Photon OS packages updated and Atlaso health checks passed."
                if photon_succeeded
                else "Photon OS maintenance did not leave Atlaso healthy; automatic RPM rollback was not attempted."
            ),
            "python_compatibility": compatibility.get("compatibility", {}),
            "transaction_inspected": transaction.get("success", False),
            "packages_installed": bool(update_command and update_command.get("success")),
            "automatic_rpm_rollback": False,
            "recovery": (
                ""
                if photon_succeeded
                else "Review tdnf history, the recorded command output, and Atlaso service journals before manual recovery."
            ),
        }
        reboot_recommended = bool(update_command and update_command.get("success"))
    if "powershell_modules" in selected and all(command.get("success") for command in commands):
        powershell_commands = _apply_powershell_modules(payload, credentials)
        commands.extend(powershell_commands)
        attempted["powershell_modules"] = "Managed PowerShell modules updated from the configured repository."
    if "atlaso_release" in selected and all(command.get("success") for command in commands):
        channel, release, release_commands = _apply_atlaso_release(
            payload,
            credentials,
            credential_path,
        )
        commands.extend(release_commands)
        attempted["atlaso_release"] = {
            "channel": channel.get("channel"),
            "version": release.get("version"),
            "git_commit": release.get("git_commit"),
            "signing_key_id": release.get("signing_key_id"),
            "supported_python_abis": release.get("supported_python_abis"),
            "bundle_sha256": (release.get("bundle") or {}).get("sha256"),
            "rolled_back": False,
        }
        restart_required = True
    succeeded = all(command.get("success") for command in commands)
    result = {
        "status": "succeeded" if succeeded else "failed",
        "applied": attempted if succeeded else {},
        "attempted": attempted,
        "commands": commands,
        "reboot_recommended": reboot_recommended if succeeded else False,
        "restart_required": restart_required and succeeded,
        "selected_streams": sorted(selected),
        "finished_at": datetime.now(timezone.utc).isoformat(),
        "finalizer_status_path": str(ATLASO_UPDATE_FINALIZER_PATH) if "atlaso_release" in selected else "",
    }
    job_id = str(payload.get("job_id") or "").strip()
    if job_id:
        result["job_id"] = job_id
    if not succeeded:
        failed = [" ".join(command.get("command") or []) for command in commands if not command.get("success")]
        result["error"] = f"One or more appliance update commands failed: {' ; '.join(failed)}"
    _write_update_info(result)
    return result


def _complete_atlaso_service_restart(job_id: str) -> int:
    """Restart every Atlaso service and publish exact worker-startup proof.

    Args:
        job_id: Exact Appliance Update parent identifier.
    """
    if re.fullmatch(r"job_[0-9a-f]{12}", job_id) is None:
        print("Atlaso service restart task identity is invalid", file=sys.stderr)
        return 2
    restart = _service_command(
        "restart",
        "atlaso.service",
        "atlaso-worker.service",
        "atlaso-console.service",
    )
    if restart.get("success") is not True:
        print("Atlaso service restart did not complete", file=sys.stderr)
        return 1
    active = _service_command(
        "is-active",
        "atlaso.service",
        "atlaso-worker.service",
        "atlaso-console.service",
    )
    if active.get("success") is not True:
        print("Atlaso services are not active after restart", file=sys.stderr)
        return 1
    deadline = time.monotonic() + 60
    startup: dict[str, object] = {}
    worker_pid = 0
    worker_started_at = ""
    worker_boot_id = ""
    worker_start_ticks = ""
    while time.monotonic() < deadline:
        try:
            flags = os.O_RDONLY
            if hasattr(os, "O_NOFOLLOW"):
                flags |= os.O_NOFOLLOW
            descriptor = os.open(ATLASO_WORKER_STARTUP_STATUS_PATH, flags)
            try:
                metadata = os.fstat(descriptor)
                expected_uid = (
                    pwd.getpwnam(ATLASO_SERVICE_USER).pw_uid
                    if os.name == "posix"
                    else metadata.st_uid
                )
                if (
                    not stat.S_ISREG(metadata.st_mode)
                    or metadata.st_nlink != 1
                    or metadata.st_size > 4096
                    or metadata.st_uid != expected_uid
                ):
                    raise ValueError("worker startup identity file is unsafe")
                with os.fdopen(descriptor, "r", encoding="utf-8", closefd=False) as stream:
                    loaded = json.load(stream)
            finally:
                os.close(descriptor)
            if not isinstance(loaded, dict):
                raise ValueError("worker startup identity is invalid")
            startup = loaded
            worker_pid = int(startup.get("pid") or 0)
            worker_started_at = str(startup.get("started_at") or "")
            datetime.fromisoformat(worker_started_at)
            worker_boot_id = str(startup.get("boot_id") or "")
            worker_start_ticks = str(startup.get("start_ticks") or "")
            if (
                worker_pid > 0
                and worker_pid == _service_main_pid("atlaso-worker.service")
                and worker_boot_id
                and worker_start_ticks
            ):
                break
        except (OSError, ValueError, TypeError, json.JSONDecodeError):
            pass
        time.sleep(1)
    else:
        print("Worker restart identity is unavailable after service restart", file=sys.stderr)
        return 1
    _write_appliance_update_runtime_file(
        ATLASO_UPDATE_RESTART_RECEIPT_PATH,
        json.dumps(
            {
                "completed_at": datetime.now(timezone.utc).isoformat(),
                "job_id": job_id,
                "state": "completed",
                "worker_pid": worker_pid,
                "worker_boot_id": worker_boot_id,
                "worker_start_ticks": worker_start_ticks,
                "worker_started_at": worker_started_at,
            },
            sort_keys=True,
        )
        + "\n",
    )
    return 0


def _restart_atlaso_service_after_update(job_id: str) -> int:
    """Schedule a delayed all-service restart with a durable receipt.

    Args:
        job_id: Exact Appliance Update parent identifier.
    """
    if re.fullmatch(r"job_[0-9a-f]{12}", job_id) is None:
        print("Atlaso service restart task identity is invalid", file=sys.stderr)
        return 2
    systemd_run = shutil.which("systemd-run")
    if systemd_run is None:
        print("systemd-run is required to schedule the delayed Atlaso service restart", file=sys.stderr)
        return 127
    ATLASO_UPDATE_RESTART_RECEIPT_PATH.unlink(missing_ok=True)
    _fsync_directory(ATLASO_UPDATE_RESTART_RECEIPT_PATH.parent)
    result = _run(
        [
            systemd_run,
            "--quiet",
            "--on-active=3",
            f"--unit=atlaso-update-restart-{datetime.now(timezone.utc).strftime('%Y%m%d%H%M%S%f')}",
            str(Path(__file__).resolve()),
            "appliance-update",
            "restart-complete",
            "--real",
            job_id,
        ]
    )
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def _console_unit_state(unit: str) -> dict[str, object] | None:
    """Perform console unit state.

    Args:
        unit: Unit consumed by console unit state.
    """
    load_state = _run(["systemctl", "show", "--property=LoadState", "--value", unit])
    if load_state.returncode != 0 or load_state.stdout.strip() == "not-found":
        return None
    enabled = _run(["systemctl", "is-enabled", unit])
    active = _run(["systemctl", "is-active", unit])
    return {
        "unit": unit,
        "enabled": enabled.returncode == 0,
        "enabled_state": enabled.stdout.strip() or enabled.stderr.strip(),
        "active": active.returncode == 0,
        "active_state": active.stdout.strip() or active.stderr.strip(),
    }


def _write_console_service_state(payload: dict[str, object]) -> None:
    """Write console service state.

    Args:
        payload: Validated request or task payload consumed by the operation.
    """
    CONSOLE_STATE_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(CONSOLE_STATE_DIR, 0o700)
    temporary = CONSOLE_SERVICE_STATE_PATH.with_suffix(".json.tmp")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    os.chmod(temporary, 0o600)
    os.replace(temporary, CONSOLE_SERVICE_STATE_PATH)


def _disable_console_managed_services() -> int:
    """Perform disable console managed services.

    """
    if CONSOLE_SERVICE_STATE_PATH.exists():
        print(json.dumps({"console": "maintenance isolation already enabled", "state_path": str(CONSOLE_SERVICE_STATE_PATH)}, sort_keys=True))
        return 0
    units = [state for unit in CONSOLE_MANAGED_SERVICE_UNITS if (state := _console_unit_state(unit)) is not None]
    _write_console_service_state(
        {
            "created_at": datetime.now(timezone.utc).isoformat(),
            "preserved": ["atlaso-console.service", "systemd-networkd.service", "systemd-resolved.service", "atlaso-firewall.service"],
            "units": units,
        }
    )
    failures: list[dict[str, object]] = []
    for state in units:
        unit = str(state["unit"])
        result = _run(["systemctl", "disable", "--now", unit])
        if result.returncode != 0:
            failures.append({"unit": unit, "returncode": result.returncode, "error": (result.stderr or result.stdout).strip()})
    payload = {
        "console": "maintenance isolation enabled" if not failures else "maintenance isolation completed with failures",
        "disabled_units": [str(state["unit"]) for state in units],
        "preserved": ["local console", "management networking", "resolver", "firewall"],
        "failures": failures,
        "state_path": str(CONSOLE_SERVICE_STATE_PATH),
    }
    print(json.dumps(payload, sort_keys=True))
    return 1 if failures else 0


def _restore_console_managed_services() -> int:
    """Perform restore console managed services.

    """
    if not CONSOLE_SERVICE_STATE_PATH.exists():
        print(json.dumps({"console": "maintenance isolation is not enabled"}, sort_keys=True))
        return 0
    try:
        payload = json.loads(CONSOLE_SERVICE_STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"unable to read console service state: {exc}", file=sys.stderr)
        return 1
    units = payload.get("units") if isinstance(payload, dict) else None
    if not isinstance(units, list):
        print("console service state does not contain a units list", file=sys.stderr)
        return 1
    failures: list[dict[str, object]] = []
    restored: list[str] = []
    for state in units:
        if not isinstance(state, dict) or str(state.get("unit") or "") not in CONSOLE_MANAGED_SERVICE_UNITS:
            continue
        unit = str(state["unit"])
        commands: list[list[str]] = []
        if bool(state.get("enabled")):
            commands.append(["systemctl", "enable", unit])
        if bool(state.get("active")):
            commands.append(["systemctl", "start", unit])
        unit_failed = False
        for command in commands:
            result = _run(command)
            if result.returncode != 0:
                failures.append({"unit": unit, "returncode": result.returncode, "error": (result.stderr or result.stdout).strip()})
                unit_failed = True
                break
        if not unit_failed:
            restored.append(unit)
    if not failures:
        CONSOLE_SERVICE_STATE_PATH.unlink(missing_ok=True)
    result_payload = {
        "console": "maintenance isolation disabled" if not failures else "maintenance isolation restore failed",
        "restored_units": restored,
        "failures": failures,
        "state_path": str(CONSOLE_SERVICE_STATE_PATH),
    }
    print(json.dumps(result_payload, sort_keys=True))
    return 1 if failures else 0


def _console_recovery_command(label: str, command: list[str]) -> subprocess.CompletedProcess[str]:
    """Run one required management-plane recovery command.

    Args:
        label: Human-readable recovery stage.
        command: Command and arguments to execute.

    Raises:
        ValueError: If the command does not succeed.
    """
    result = _run(command)
    if result.returncode != 0:
        detail = (result.stderr or result.stdout or f"exit code {result.returncode}").strip()
        raise ValueError(f"{label} failed: {detail}")
    return result


def _console_management_http_status(curl: str, url: str, *, insecure: bool = False) -> str:
    """Return one bounded management readiness status code.

    Args:
        curl: Absolute curl executable path.
        url: Loopback URL to probe.
        insecure: Whether to skip certificate trust for the local HTTPS probe.
    """
    command = [
        curl,
        "--silent",
        "--show-error",
        "--output",
        "/dev/null",
        "--write-out",
        "%{http_code}",
        "--connect-timeout",
        "2",
        "--max-time",
        "3",
    ]
    if insecure:
        command.append("--insecure")
    result = _run([*command, url])
    return result.stdout.strip() if result.returncode == 0 else "000"


def _console_management_readiness_checks() -> tuple[bool, tuple[tuple[str, str, bool, str], ...]]:
    """Return readiness checks for the applied nginx management mode.

    Returns:
        Whether management HTTPS is enabled and the matching readiness checks.

    Raises:
        ValueError: If the applied nginx management configuration cannot be read.
    """
    try:
        management_config = NGINX_MANAGEMENT_SITE_PATH.read_text(encoding="utf-8")
    except OSError as exc:
        raise ValueError(f"reading the applied nginx management configuration failed: {exc}") from exc
    if not _console_management_config_contract_is_complete(management_config):
        raise ValueError("the applied nginx management configuration is incomplete")
    https_enabled = bool(re.search(r"(?m)^\s*listen\s+\d+\s+ssl(?:\s+default_server)?;", management_config))
    nginx_checks = (
        ("nginx HTTP redirect", "http://127.0.0.1/", False, "308"),
        ("nginx HTTPS readiness", "https://127.0.0.1/openapi.json", True, "200"),
    ) if https_enabled else (
        ("nginx HTTP readiness", "http://127.0.0.1/openapi.json", False, "200"),
    )
    return https_enabled, (*MANAGEMENT_APPLICATION_READINESS_CHECK, *nginx_checks)


def _console_management_config_contract_is_complete(config: str) -> bool:
    """Return whether an applied management site has a usable front door.

    Args:
        config: Applied nginx management-site text.

    Returns:
        Whether the config contains a default listener and Atlaso proxy contract.
    """
    if not re.search(r"(?m)^\s*listen\s+(?:\[::\]:)?\d+.*\bdefault_server\b", config):
        return False
    if not re.search(r"(?m)^\s*proxy_pass\s+http://127\.0\.0\.1:\d+;", config):
        return False
    https_enabled = bool(re.search(r"(?m)^\s*listen\s+(?:\[::\]:)?\d+\s+ssl\b", config))
    if not https_enabled:
        return True
    certificate_match = re.search(r"(?m)^\s*ssl_certificate\s+([^;]+);", config)
    key_match = re.search(r"(?m)^\s*ssl_certificate_key\s+([^;]+);", config)
    if certificate_match is None or key_match is None:
        return False
    return Path(certificate_match.group(1).strip()).is_file() and Path(
        key_match.group(1).strip()
    ).is_file()


def _console_nginx_main_config_activates_atlaso(config: str) -> bool:
    """Return whether nginx actively includes the Atlaso site bridge.

    Args:
        config: Applied nginx main configuration text.

    Returns:
        Whether an uncommented exact or wildcard include activates ``atlaso.conf``.
    """
    return bool(
        re.search(
            r"(?m)^\s*include\s+/etc/nginx/conf\.d/(?:atlaso\.conf|\*\.conf);"
            r"[ \t]*(?:#[^\r\n]*)?$",
            config,
        )
    )


def _console_first_boot_https_contract_is_complete() -> bool:
    """Return whether durable bootstrap evidence matches applied nginx state."""
    try:
        marker_stat = FIRST_BOOT_HTTPS_MARKER_PATH.lstat()
        main_config_stat = NGINX_MAIN_CONFIG_PATH.lstat()
        include_stat = NGINX_CONF_INCLUDE_PATH.lstat()
        management_stat = NGINX_MANAGEMENT_SITE_PATH.lstat()
        if (
            FIRST_BOOT_HTTPS_MARKER_PATH.is_symlink()
            or NGINX_MAIN_CONFIG_PATH.is_symlink()
            or NGINX_CONF_INCLUDE_PATH.is_symlink()
            or NGINX_MANAGEMENT_SITE_PATH.is_symlink()
            or not FIRST_BOOT_HTTPS_MARKER_PATH.is_file()
            or not NGINX_MAIN_CONFIG_PATH.is_file()
            or not NGINX_CONF_INCLUDE_PATH.is_file()
            or not NGINX_MANAGEMENT_SITE_PATH.is_file()
            or not 0 < marker_stat.st_size <= 256
            or not 0 < main_config_stat.st_size <= 1048576
            or not 0 < include_stat.st_size <= 4096
            or not 0 < management_stat.st_size <= 262144
        ):
            return False
        marker = FIRST_BOOT_HTTPS_MARKER_PATH.read_text(encoding="utf-8")
        main_config = NGINX_MAIN_CONFIG_PATH.read_text(encoding="utf-8")
        include = NGINX_CONF_INCLUDE_PATH.read_text(encoding="utf-8")
        management = NGINX_MANAGEMENT_SITE_PATH.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return False
    return (
        marker == FIRST_BOOT_HTTPS_MARKER_TEXT
        and _console_nginx_main_config_activates_atlaso(main_config)
        and include == FIRST_BOOT_HTTPS_INCLUDE_TEXT
        and _console_management_config_contract_is_complete(management)
    )


def _recover_console_management_plane(timeout_seconds: int = 60) -> int:
    """Recover and verify the complete local management plane.

    Args:
        timeout_seconds: Maximum readiness wait after service recovery.
    """
    bootstrap_retried = False
    atlaso_restarted = False
    try:
        if not _console_first_boot_https_contract_is_complete():
            _console_recovery_command(
                "resetting the first-boot HTTPS bootstrap failure",
                ["systemctl", "reset-failed", FIRST_BOOT_HTTPS_UNIT],
            )
            _console_recovery_command(
                "retrying first-boot HTTPS bootstrap",
                ["systemctl", "restart", FIRST_BOOT_HTTPS_UNIT],
            )
            bootstrap_retried = True
            if not _console_first_boot_https_contract_is_complete():
                raise ValueError("first-boot HTTPS bootstrap returned without a complete durable contract")

        nginx = shutil.which("nginx")
        if nginx is None:
            raise ValueError("nginx is not installed")
        curl = shutil.which("curl")
        if curl is None:
            raise ValueError("curl is not installed for management readiness checks")

        _console_recovery_command("validating nginx configuration", [nginx, "-t"])
        _console_recovery_command(
            "enabling management services",
            ["systemctl", "enable", *MANAGEMENT_PLANE_UNITS],
        )
        _console_recovery_command("starting Atlaso", ["systemctl", "start", "atlaso.service"])
        nginx_active = _run(["systemctl", "is-active", "nginx.service"])
        nginx_action = "reload" if nginx_active.returncode == 0 else "start"
        _console_recovery_command(
            f"{nginx_action}ing nginx",
            ["systemctl", nginx_action, "nginx.service"],
        )
        management_https_enabled, readiness_checks = _console_management_readiness_checks()

        deadline = time.monotonic() + timeout_seconds
        consecutive_successes = 0
        statuses: dict[str, str] = {}
        while time.monotonic() < deadline:
            statuses = {
                label: _console_management_http_status(curl, url, insecure=insecure)
                for label, url, insecure, _expected in readiness_checks
            }
            ready = all(
                statuses[label] == expected
                for label, _url, _insecure, expected in readiness_checks
            )
            if ready:
                consecutive_successes += 1
                if consecutive_successes >= 5:
                    break
            else:
                consecutive_successes = 0
                if statuses.get("Atlaso application loopback") != "200" and not atlaso_restarted:
                    _console_recovery_command(
                        "restarting an unready Atlaso service",
                        ["systemctl", "restart", "atlaso.service"],
                    )
                    atlaso_restarted = True
            time.sleep(1)
        else:
            summary = ", ".join(f"{label}={status}" for label, status in statuses.items())
            raise ValueError(f"management readiness did not stabilize within {timeout_seconds} seconds ({summary})")

        _console_recovery_command(
            "checking management service state",
            ["systemctl", "is-active", *MANAGEMENT_PLANE_UNITS],
        )
    except ValueError as exc:
        print(f"Management plane recovery failed: {exc}", file=sys.stderr)
        return 1

    print(
        json.dumps(
            {
                "management_plane": "ready",
                "bootstrap_marker": str(FIRST_BOOT_HTTPS_MARKER_PATH),
                "bootstrap_retried": bootstrap_retried,
                "atlaso_restarted": atlaso_restarted,
                "management_https_enabled": management_https_enabled,
                "readiness": statuses,
                "stable_samples": consecutive_successes,
            },
            sort_keys=True,
        )
    )
    return 0


def _handle_console(action: str, args: list[str]) -> int:
    """Handle console.

    Args:
        action: Action consumed by handle console.
        args: Parsed command-line options consumed by the operation.
    """
    if args:
        print(f"console {action} does not accept a path", file=sys.stderr)
        return 2
    if action == "status":
        print(
            json.dumps(
                {
                    "maintenance_isolation": CONSOLE_SERVICE_STATE_PATH.exists(),
                    "state_path": str(CONSOLE_SERVICE_STATE_PATH),
                    "managed_units": list(CONSOLE_MANAGED_SERVICE_UNITS),
                    "preserved": ["atlaso-console.service", "systemd-networkd.service", "systemd-resolved.service", "atlaso-firewall.service"],
                },
                sort_keys=True,
            )
        )
        return 0
    if action == "disable-services":
        return _disable_console_managed_services()
    if action == "recover-management-plane":
        return _recover_console_management_plane()
    if action == "restore-services":
        return _restore_console_managed_services()
    print(f"unsupported console action: {action}", file=sys.stderr)
    return 2


def _esx_storage_safe_slug(value: object) -> str:
    """Perform ESX storage safe slug.

    Args:
        value: Candidate value consumed by ESX storage safe slug.
    """
    slug = re.sub(r"[^a-z0-9]+", "-", str(value or "").strip().lower()).strip("-")
    if not slug:
        raise ValueError("ESX Storage names must contain at least one letter or number")
    return slug[:63]


def _esx_storage_config_path(value: str) -> Path:
    """Perform ESX storage config path.

    Args:
        value: Candidate value consumed by ESX storage config path.
    """
    path = Path(value).resolve(strict=True)
    root = ESX_STORAGE_APPLY_DIR.resolve(strict=True)
    if not path.is_relative_to(root) or path.name != "atlaso-esx-storage.json":
        raise ValueError(f"ESX Storage manifest must be {ESX_STORAGE_APPLY_DIR / 'atlaso-esx-storage.json'}")
    return path


def _esx_storage_manifest(path: Path) -> dict[str, object]:
    """Perform ESX storage manifest.

    Args:
        path: Filesystem path read, validated, or updated by the operation.
    """
    payload = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(payload, dict):
        raise ValueError("ESX Storage manifest must be a JSON object")
    return payload


def _esx_storage_manifest_hash(payload: dict[str, object]) -> str:
    """Perform ESX storage manifest hash.

    Args:
        payload: Validated request or task payload consumed by the operation.
    """
    desired = dict(payload)
    desired.pop("format_authorizations", None)
    encoded = json.dumps(desired, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()


def _esx_storage_by_id_map() -> dict[str, str]:
    """Perform ESX storage by identifier map.

    """
    result: dict[str, str] = {}
    root = Path("/dev/disk/by-id")
    if not root.is_dir():
        return result
    for link in sorted(root.iterdir()):
        if "-part" in link.name:
            continue
        try:
            target = str(link.resolve(strict=True))
        except OSError:
            continue
        current = result.get(target)
        if current is None or ("wwn-" in link.name and "wwn-" not in current):
            result[target] = str(link)
    return result


def _esx_storage_os_devices() -> set[str]:
    """Perform ESX storage operating-system devices.

    """
    findmnt = _command_path("findmnt")
    lsblk = _command_path("lsblk")
    if findmnt is None or lsblk is None:
        return set()
    source_result = _run([findmnt, "-nro", "SOURCE", "/"])
    source = source_result.stdout.strip()
    if source_result.returncode != 0 or not source.startswith("/dev/"):
        return set()
    result = _run([lsblk, "-sno", "PATH", source])
    return {line.strip() for line in result.stdout.splitlines() if line.strip().startswith("/dev/")}


def _esx_storage_inventory() -> list[dict[str, object]]:
    """Perform ESX storage inventory.

    """
    lsblk = _command_path("lsblk")
    if lsblk is None:
        raise ValueError("lsblk is required for ESX Storage disk inventory")
    result = _run(
        [
            lsblk,
            "-J",
            "-b",
            "-o",
            "NAME,KNAME,PATH,TYPE,SIZE,MODEL,SERIAL,WWN,FSTYPE,UUID,LABEL,MOUNTPOINTS,PKNAME,RO,RM",
        ]
    )
    if result.returncode != 0:
        raise ValueError(result.stderr.strip() or "lsblk inventory failed")
    payload = json.loads(result.stdout)
    by_id = _esx_storage_by_id_map()
    os_devices = _esx_storage_os_devices()
    swap_devices = {
        line.split()[0]
        for line in Path("/proc/swaps").read_text(encoding="utf-8").splitlines()[1:]
        if line.split()
    } if Path("/proc/swaps").exists() else set()
    inventory: list[dict[str, object]] = []

    def walk(item: dict[str, object], parent_disk: str = "") -> None:
        """Perform walk.

        Args:
            item: Item consumed by walk.
            parent_disk: Parent disk consumed by walk.
        """
        device_path = str(item.get("path") or "")
        device_type = str(item.get("type") or "")
        disk_path = device_path if device_type == "disk" else parent_disk
        mountpoints = [str(value) for value in (item.get("mountpoints") or []) if value]
        primary_mount_path = next(
            (path for path in mountpoints if path.startswith(f"{ESX_STORAGE_MOUNT_ROOT.as_posix().rstrip('/')}/")),
            next(
                (path for path in mountpoints if not path.startswith(f"{ESX_STORAGE_EXPORT_ROOT.as_posix().rstrip('/')}/")),
                mountpoints[0] if mountpoints else "",
            ),
        )
        writable_mount_paths = [path for path in mountpoints if _esx_storage_mount_is_writable(path)]
        kname = str(item.get("kname") or item.get("name") or "")
        holders_root = Path("/sys/class/block") / kname / "holders"
        holders = sorted(path.name for path in holders_root.iterdir()) if holders_root.is_dir() else []
        children = list(item.get("children") or [])
        filesystem_type = str(item.get("fstype") or "")
        filesystem_uuid = str(item.get("uuid") or "")
        stable_id = by_id.get(device_path, "") or (f"UUID={filesystem_uuid}" if filesystem_uuid else "")
        candidate_type = ""
        if device_type == "disk" and not children and not filesystem_type and not mountpoints:
            candidate_type = "blank_disk"
        elif filesystem_type == "ext4" and mountpoints and not any(path in {"/", "/boot", "/boot/efi"} for path in mountpoints):
            candidate_type = "mounted_ext4"
        inventory.append(
            {
                "stable_device_id": stable_id,
                "device_path": device_path,
                "type": device_type,
                "parent_disk": disk_path,
                "model": str(item.get("model") or "").strip(),
                "serial": str(item.get("serial") or "").strip(),
                "wwn": str(item.get("wwn") or "").strip(),
                "size_bytes": int(item.get("size") or 0),
                "filesystem_type": filesystem_type,
                "filesystem_uuid": filesystem_uuid,
                "filesystem_label": str(item.get("label") or ""),
                "mount_path": primary_mount_path,
                "mount_paths": mountpoints,
                "writable_mount_paths": writable_mount_paths,
                "partitions": [str(child.get("path") or child.get("name") or "") for child in children],
                "swap": device_path in swap_devices or filesystem_type == "swap",
                "lvm": filesystem_type == "LVM2_member" or any("dm-" in holder for holder in holders),
                "raid": filesystem_type == "linux_raid_member" or any("md" in holder for holder in holders),
                "holders": holders,
                "read_only": bool(item.get("ro")),
                "removable": bool(item.get("rm")),
                "os_related": device_path in os_devices or disk_path in os_devices,
                "persistent_uuid_mount": _esx_storage_uuid_fstab_entry_exists(filesystem_uuid, primary_mount_path),
                "candidate_type": candidate_type,
            }
        )
        for child in children:
            walk(child, disk_path)

    for block_device in payload.get("blockdevices", []):
        walk(block_device)
    return inventory


def _esx_storage_mount_is_writable(mount_path: str) -> bool:
    """Return whether one exact active mount has the read-write option.

    Args:
        mount_path: Exact active mount path to inspect.
    """
    findmnt = _command_path("findmnt")
    if findmnt is None or not mount_path:
        return False
    result = _run([findmnt, "-nro", "OPTIONS", "--mountpoint", mount_path])
    lines = [line.strip() for line in result.stdout.splitlines() if line.strip()]
    return result.returncode == 0 and len(lines) == 1 and "rw" in lines[0].split(",")


def _esx_storage_fstab_escape_field(value: object) -> str:
    """Escape one fstab field without changing its filesystem meaning.

    Args:
        value: Field value to encode for fstab storage.
    """
    return str(value).replace("\\", "\\134").replace(" ", "\\040").replace("\t", "\\011")


def _esx_storage_fstab_decode_field(value: str) -> str:
    """Decode the standard octal escapes accepted in one fstab field.

    Args:
        value: Encoded fstab field to decode.
    """
    escapes = {"040": " ", "011": "\t", "012": "\n", "134": "\\"}
    return re.sub(r"\\(040|011|012|134)", lambda match: escapes[match.group(1)], value)


def _esx_storage_uuid_fstab_entry_exists(filesystem_uuid: str, mount_path: str) -> bool:
    """Return whether fstab persistently mounts one ext4 UUID at the expected path.

    Args:
        filesystem_uuid: Filesystem UUID that must own the mount.
        mount_path: Exact persistent mount path.
    """
    if not filesystem_uuid or not mount_path or not ESX_STORAGE_FSTAB_PATH.exists():
        return False
    source = f"UUID={filesystem_uuid}"
    matches: list[bool] = []
    for raw_line in ESX_STORAGE_FSTAB_PATH.read_text(encoding="utf-8").splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        fields = line.split()
        decoded_fields = [_esx_storage_fstab_decode_field(field) for field in fields[:4]]
        if len(fields) < 4 or decoded_fields[:3] != [source, mount_path, "ext4"]:
            continue
        writable = True
        for option in decoded_fields[3].split(","):
            if option == "ro":
                writable = False
            elif option == "rw":
                writable = True
        matches.append(writable)
    return matches == [True]


def _esx_storage_managed_bind_fstab_entry_exists(mount_path: str) -> bool:
    """Return whether the root-owned ESX Storage block defines one bind target.

    Args:
        mount_path: Exact additional bind mount target to verify.
    """
    matches = 0
    for line in _esx_storage_managed_fstab_lines():
        fields = line.split()
        decoded_fields = [_esx_storage_fstab_decode_field(field) for field in fields[:4]]
        if (
            len(fields) >= 4
            and decoded_fields[1] == mount_path
            and decoded_fields[2] == "none"
            and "bind" in decoded_fields[3].split(",")
        ):
            matches += 1
    return matches == 1


def _esx_storage_blank_disk_errors(entry: dict[str, object]) -> list[str]:
    """Perform ESX storage blank disk errors.

    Args:
        entry: Entry consumed by ESX storage blank disk errors.
    """
    errors: list[str] = []
    if str(entry.get("type")) != "disk":
        errors.append("not a whole disk")
    if not str(entry.get("stable_device_id") or "").startswith("/dev/disk/by-id/"):
        errors.append("missing stable /dev/disk/by-id identity")
    for key, label in [
        ("partitions", "has partitions"),
        ("filesystem_type", "has a filesystem"),
        ("mount_path", "is mounted"),
        ("swap", "is swap"),
        ("lvm", "belongs to LVM"),
        ("raid", "belongs to RAID"),
        ("holders", "has holders"),
        ("os_related", "is related to the operating-system disk"),
        ("read_only", "is read-only"),
    ]:
        if entry.get(key):
            errors.append(label)
    return errors


def _esx_storage_mounted_disk_errors(entry: dict[str, object], *, mount_path: Path) -> list[str]:
    """Return boot-safety errors for an existing mounted ext4 whole disk.

    Args:
        entry: Current helper inventory row for the mounted filesystem.
        mount_path: Exact mount path claimed by ESX Storage.
    """
    errors: list[str] = []
    if str(entry.get("type") or "") != "disk":
        errors.append("not a whole disk")
    if not str(entry.get("stable_device_id") or "").startswith("/dev/disk/by-id/"):
        errors.append("missing stable /dev/disk/by-id identity")
    if str(entry.get("filesystem_type") or "") != "ext4":
        errors.append("not ext4")
    if not str(entry.get("filesystem_uuid") or ""):
        errors.append("missing filesystem UUID")
    selected_mount = str(mount_path)
    mount_paths = [str(path) for path in entry.get("mount_paths", [])]
    if selected_mount not in mount_paths:
        errors.append("not mounted at the selected path")
    unexpected_mounts = [
        path
        for path in mount_paths
        if path != selected_mount and not _esx_storage_managed_bind_fstab_entry_exists(path)
    ]
    if unexpected_mounts:
        errors.append("has unexpected additional mounts")
    writable_mount_paths = [str(path) for path in entry.get("writable_mount_paths", [])]
    if selected_mount not in writable_mount_paths:
        errors.append("selected mount is read-only")
    for key, label in [
        ("partitions", "has partitions"),
        ("holders", "has holders"),
        ("os_related", "is related to the operating-system disk"),
        ("read_only", "is read-only"),
    ]:
        if entry.get(key):
            errors.append(label)
    if not entry.get("persistent_uuid_mount"):
        errors.append("is not persisted by UUID in /etc/fstab")
    return errors


def _esx_storage_disk_is_initialized(entry: dict[str, object], *, label: str, mount_path: Path) -> bool:
    """Perform ESX storage disk is initialized.

    Args:
        entry: Entry consumed by ESX storage disk is initialized.
        label: Human-readable label used to identify the result.
        mount_path: Filesystem path used for mount.
    """
    return (
        str(entry.get("filesystem_type") or "") == "ext4"
        and str(entry.get("filesystem_label") or "") == label
        and bool(entry.get("filesystem_uuid"))
        and not entry.get("partitions")
        and (
            not entry.get("mount_paths")
            or str(mount_path) in [str(path) for path in entry.get("mount_paths", [])]
        )
        and not entry.get("holders")
        and not entry.get("os_related")
    )


def _esx_storage_reserved_mount_owner(value: str) -> str:
    """Perform ESX storage reserved mount owner.

    Args:
        value: Candidate value consumed by ESX storage reserved mount owner.
    """
    raw = value.strip()
    if not raw.startswith("/"):
        return ""
    path = PurePosixPath(raw)
    for reserved, owner in ESX_STORAGE_RESERVED_MOUNT_PATHS.items():
        if path == reserved or reserved in path.parents:
            return owner
    return ""


def _esx_storage_manifest_errors(payload: dict[str, object], *, require_authorization: bool = False) -> list[str]:
    """Perform ESX storage manifest errors.

    Args:
        payload: Validated request or task payload consumed by the operation.
        require_authorization: Whether require authorization applies to the operation.
    """
    errors: list[str] = []
    if payload.get("schema_version") != 1:
        errors.append("ESX Storage schema_version must be 1")
    validation = payload.get("validation") if isinstance(payload.get("validation"), dict) else {}
    errors.extend(str(error) for error in validation.get("errors", []) if str(error))
    volumes = payload.get("volumes") if isinstance(payload.get("volumes"), list) else []
    shares = payload.get("shares") if isinstance(payload.get("shares"), list) else []
    volumes_by_id: dict[object, dict[str, object]] = {}
    for volume in volumes:
        if not isinstance(volume, dict):
            errors.append("ESX Storage volume entries must be objects")
            continue
        volumes_by_id[volume.get("id")] = volume
        source_type = str(volume.get("source_type") or "")
        if source_type not in {"blank_disk", "mounted_ext4"}:
            errors.append(f"volume {volume.get('name')} has unsupported source_type")
        if source_type == "blank_disk" and not str(volume.get("stable_device_id") or "").startswith("/dev/disk/by-id/"):
            errors.append(f"volume {volume.get('name')} must use /dev/disk/by-id identity")
        mount_value = str(volume.get("mount_path") or "")
        if not mount_value.startswith("/"):
            errors.append(f"volume {volume.get('name')} mount path must be absolute")
        elif source_type == "blank_disk" and not mount_value.startswith(f"{ESX_STORAGE_MOUNT_ROOT.as_posix().rstrip('/')}/"):
            errors.append(f"new volume {volume.get('name')} mount path must be under {ESX_STORAGE_MOUNT_ROOT}")
        elif source_type == "mounted_ext4":
            owner = _esx_storage_reserved_mount_owner(mount_value)
            if owner:
                errors.append(f"existing volume {volume.get('name')} mount path is reserved for {owner}")
    enabled_shares = [share for share in shares if isinstance(share, dict) and share.get("enabled")]
    if payload.get("enabled") and not enabled_shares:
        errors.append("enabled ESX Storage requires at least one enabled share")
    for share in enabled_shares:
        if share.get("volume_id") not in volumes_by_id:
            errors.append(f"share {share.get('datastore_name')} references an unknown volume")
        if str(share.get("preferred_nfs_version")) not in {"3", "4.1"}:
            errors.append(f"share {share.get('datastore_name')} must prefer NFS 3 or 4.1")
        families = share.get("address_families") if isinstance(share.get("address_families"), list) else []
        if not families or any(family not in {"ipv4", "ipv6"} for family in families):
            errors.append(f"share {share.get('datastore_name')} must enable IPv4, IPv6, or both")
        clients = share.get("clients") if isinstance(share.get("clients"), dict) else {}
        for family in families:
            values = clients.get(family) if isinstance(clients.get(family), list) else []
            if not values:
                values = ["0.0.0.0/0" if family == "ipv4" else "::/0"]
                clients[family] = values
            for value in values:
                try:
                    network = ip_network(str(value), strict=False)
                    if network.version != (4 if family == "ipv4" else 6):
                        raise ValueError
                except ValueError:
                    errors.append(f"share {share.get('datastore_name')} has invalid {family} client {value}")
    if require_authorization:
        manifest_sha256 = _esx_storage_manifest_hash(payload)
        authorizations = payload.get("format_authorizations") if isinstance(payload.get("format_authorizations"), list) else []
        by_device = {str(item.get("stable_device_id") or ""): item for item in authorizations if isinstance(item, dict)}
        for volume in volumes:
            if not isinstance(volume, dict) or not volume.get("requires_format"):
                continue
            stable_id = str(volume.get("stable_device_id") or "")
            authorization = by_device.get(stable_id)
            expected = f"FORMAT {volume.get('name')}"
            if not authorization:
                errors.append(f"volume {volume.get('name')} is missing job-scoped format authorization")
            elif authorization.get("manifest_sha256") != manifest_sha256 or authorization.get("confirmation") != expected or not authorization.get("job_id"):
                errors.append(f"volume {volume.get('name')} format authorization does not match this job and manifest")
    return errors


def _esx_storage_replace_managed_fstab(lines: list[str]) -> None:
    """Perform ESX storage replace managed fstab.

    Args:
        lines: Source or output lines being parsed.
    """
    existing = ESX_STORAGE_FSTAB_PATH.read_text(encoding="utf-8") if ESX_STORAGE_FSTAB_PATH.exists() else ""
    pattern = re.compile(
        rf"(?ms)^\s*{re.escape(ESX_STORAGE_FSTAB_BEGIN)}\s*$.*?^\s*{re.escape(ESX_STORAGE_FSTAB_END)}\s*$\n?"
    )
    cleaned = pattern.sub("", existing).rstrip()
    block = "\n".join([ESX_STORAGE_FSTAB_BEGIN, *lines, ESX_STORAGE_FSTAB_END])
    _write_secret_file(ESX_STORAGE_FSTAB_PATH, f"{cleaned}\n\n{block}\n" if cleaned else f"{block}\n", 0o644)


def _esx_storage_managed_fstab_lines() -> list[str]:
    """Return the current root-owned ESX Storage fstab block entries."""
    if not ESX_STORAGE_FSTAB_PATH.is_file():
        return []
    text = ESX_STORAGE_FSTAB_PATH.read_text(encoding="utf-8")
    pattern = re.compile(
        rf"(?ms)^\s*{re.escape(ESX_STORAGE_FSTAB_BEGIN)}\s*$\n(?P<body>.*?)"
        rf"^\s*{re.escape(ESX_STORAGE_FSTAB_END)}\s*$"
    )
    match = pattern.search(text)
    if match is None:
        return []
    return [line for line in match.group("body").splitlines() if line.strip()]


def _esx_storage_managed_disk_fstab_lines() -> list[str]:
    """Return retained UUID/ext4 disk mounts without stale bind entries."""
    retained: list[str] = []
    for line in _esx_storage_managed_fstab_lines():
        fields = line.split()
        if len(fields) >= 3 and fields[0].startswith("UUID=") and fields[2] == "ext4":
            retained.append(line)
    return retained


def _esx_storage_reject_retained_mount_collision(
    lines: list[str],
    *,
    filesystem_uuid: str,
    mount_path: Path,
) -> None:
    """Reject a retained UUID mount owned by another filesystem.

    Args:
        lines: Retained root-owned UUID/ext4 fstab entries.
        filesystem_uuid: Filesystem UUID requested by the current volume.
        mount_path: Exact primary mount path requested by the current volume.

    Raises:
        ValueError: If another retained filesystem already owns the mount path.
    """
    requested_source = f"UUID={filesystem_uuid}"
    requested_target = mount_path.as_posix()
    for line in lines:
        fields = line.split()
        if len(fields) < 3:
            continue
        source, target, filesystem_type = (
            _esx_storage_fstab_decode_field(field) for field in fields[:3]
        )
        if filesystem_type == "ext4" and target == requested_target and source != requested_source:
            raise ValueError(
                f"ESX Storage mount path {mount_path} is retained for a different filesystem"
            )


def _esx_storage_write_disk_allowlist(lines: list[str], *, preserve_existing: bool) -> None:
    """Persist exact mounted-disk claims before boot-sensitive host changes.

    Args:
        lines: Validated tab-separated UUID, stable identity, and mount claims.
        preserve_existing: Whether to retain prior claims until apply succeeds.
    """
    existing = (
        ESX_STORAGE_DISK_ALLOWLIST_PATH.read_text(encoding="utf-8").splitlines()
        if preserve_existing and ESX_STORAGE_DISK_ALLOWLIST_PATH.is_file()
        else []
    )
    incoming_uuids = {line.split("\t", 1)[0] for line in lines if line.strip()}
    retained = [
        line
        for line in existing
        if line.strip() and line.split("\t", 1)[0] not in incoming_uuids
    ]
    claims = list(dict.fromkeys(retained + lines))
    _write_secret_file(
        ESX_STORAGE_DISK_ALLOWLIST_PATH,
        "\n".join(claims) + ("\n" if claims else ""),
        0o644,
    )


def _esx_storage_write_runtime_config(payload: dict[str, object]) -> None:
    """Perform ESX storage write runtime config.

    Args:
        payload: Validated request or task payload consumed by the operation.
    """
    enabled_shares = [share for share in payload.get("shares", []) if isinstance(share, dict) and share.get("enabled")]
    root_clients: list[str] = []
    export_lines: list[str] = []
    for share in enabled_shares:
        clients = share.get("clients") if isinstance(share.get("clients"), dict) else {}
        share_clients = list(
            dict.fromkeys(
                str(value)
                for family in ("ipv4", "ipv6")
                for value in (clients.get(family, []) or (["0.0.0.0/0"] if family == "ipv4" else ["::/0"]))
                if family in share.get("address_families", [])
            )
        )
        root_clients.extend(share_clients)
        options = "rw,sync,no_subtree_check,no_root_squash"
        export_lines.append(f"{share['bind_path']} " + " ".join(f"{client}({options})" for client in share_clients))
    root_options = "ro,fsid=0,crossmnt,sync,no_subtree_check,root_squash"
    if root_clients:
        export_lines.insert(0, f"{ESX_STORAGE_EXPORT_ROOT} " + " ".join(f"{client}({root_options})" for client in dict.fromkeys(root_clients)))
    _write_secret_file(ESX_STORAGE_EXPORTS_PATH, "\n".join(export_lines) + ("\n" if export_lines else ""), 0o644)
    nfs_config = """[nfsd]
vers2=n
vers3=y
vers4=y
vers4.0=n
vers4.1=y
tcp=y
udp=n

[mountd]
port=20048
manage-gids=y
"""
    _write_secret_file(ESX_STORAGE_NFS_CONFIG_PATH, nfs_config, 0o644)


def _esx_storage_bind_mount_matches(findmnt: str, source: Path, target: Path) -> bool:
    """Perform ESX storage bind mount matches.

    Args:
        findmnt: Findmnt consumed by ESX storage bind mount matches.
        source: Source object or location from which data is obtained.
        target: Target resource or location affected by the operation.
    """
    mounted = _run([findmnt, "-n", "--mountpoint", str(target)])
    if mounted.returncode != 0:
        return False
    source_stat = os.stat(source, follow_symlinks=True)
    target_stat = os.stat(target, follow_symlinks=True)
    if (source_stat.st_dev, source_stat.st_ino) != (target_stat.st_dev, target_stat.st_ino):
        raise ValueError(f"existing mount at {target} does not match ESX Storage source {source}")
    return True


def _esx_storage_apply(payload: dict[str, object]) -> dict[str, object]:
    """Perform ESX storage apply.

    Args:
        payload: Validated request or task payload consumed by the operation.
    """
    inventory = _esx_storage_inventory()
    inventory_by_id = {str(item.get("stable_device_id") or ""): item for item in inventory}
    fstab_lines: list[str] = []
    rollback_safe_fstab_lines = _esx_storage_managed_disk_fstab_lines()
    disk_allowlist_lines: list[str] = []
    commands: list[list[str]] = []
    volumes_by_id: dict[object, dict[str, object]] = {}
    for volume in payload.get("volumes", []):
        if not isinstance(volume, dict):
            continue
        volumes_by_id[volume.get("id")] = volume
        mount_path = Path(str(volume["mount_path"]))
        mount_path.mkdir(parents=True, exist_ok=True)
        if volume.get("source_type") == "blank_disk":
            stable_id = str(volume["stable_device_id"])
            entry = inventory_by_id.get(stable_id)
            if volume.get("requires_format"):
                if entry is None:
                    raise ValueError(f"approved disk disappeared before format: {stable_id}")
                label = f"lf-{hashlib.sha256(str(volume['name']).encode()).hexdigest()[:12]}"
                fingerprint = volume.get("fingerprint") if isinstance(volume.get("fingerprint"), dict) else {}
                for manifest_key, inventory_key, label_name in [
                    ("model", "model", "model"),
                    ("serial", "serial", "serial"),
                    ("wwn", "wwn", "WWN"),
                    ("size_bytes", "size_bytes", "capacity"),
                ]:
                    expected_value = fingerprint.get(manifest_key)
                    if expected_value in {None, "", 0}:
                        continue
                    if str(entry.get(inventory_key) or "") != str(expected_value):
                        raise ValueError(f"disk {stable_id} {label_name} changed after approval")
                already_initialized = _esx_storage_disk_is_initialized(entry, label=label, mount_path=mount_path)
                if not already_initialized:
                    safety_errors = _esx_storage_blank_disk_errors(entry)
                    if safety_errors:
                        raise ValueError(f"disk {stable_id} is no longer blank and eligible: {', '.join(safety_errors)}")
                    mkfs = _command_path("mkfs.ext4")
                    if mkfs is None:
                        raise ValueError("mkfs.ext4 is required for ESX Storage initialization")
                    command = [mkfs, "-F", "-L", label, stable_id]
                    result = _run(command, timeout=300)
                    commands.append(command)
                    if result.returncode != 0:
                        raise ValueError(result.stderr.strip() or f"mkfs.ext4 failed for {stable_id}")
            blkid = _command_path("blkid")
            if blkid is None:
                raise ValueError("blkid is required for ESX Storage UUID mounts")
            uuid_result = _run([blkid, "-s", "UUID", "-o", "value", stable_id])
            fs_uuid = uuid_result.stdout.strip()
            type_result = _run([blkid, "-s", "TYPE", "-o", "value", stable_id])
            if uuid_result.returncode != 0 or not fs_uuid or type_result.stdout.strip() != "ext4":
                raise ValueError(f"disk {stable_id} is not a readable ext4 filesystem after initialization")
            _esx_storage_reject_retained_mount_collision(
                rollback_safe_fstab_lines,
                filesystem_uuid=fs_uuid,
                mount_path=mount_path,
            )
            fstab_lines.append(
                f"{_esx_storage_fstab_escape_field(f'UUID={fs_uuid}')} "
                f"{_esx_storage_fstab_escape_field(mount_path)} "
                "ext4 defaults,nofail,x-systemd.device-timeout=30 0 2"
            )
            _esx_storage_replace_managed_fstab(
                list(dict.fromkeys([*rollback_safe_fstab_lines, *fstab_lines]))
            )
            if any(character in value for value in (fs_uuid, stable_id, str(mount_path)) for character in "\t\r\n"):
                raise ValueError(f"disk {stable_id} has an unsupported identity or mount path")
            disk_allowlist_lines.append(f"{fs_uuid}\t{stable_id}\t{mount_path}\tblank_disk")
            _esx_storage_write_disk_allowlist(disk_allowlist_lines, preserve_existing=True)
            volume["filesystem_uuid"] = fs_uuid
        else:
            findmnt = _command_path("findmnt")
            if findmnt is None:
                raise ValueError("findmnt is required for existing ESX Storage volumes")
            find_result = _run([findmnt, "-nro", "FSTYPE", "--target", str(mount_path)])
            if find_result.returncode != 0 or find_result.stdout.strip() != "ext4":
                raise ValueError(f"existing volume {volume.get('name')} is not mounted as ext4 at {mount_path}")
            matches = [
                entry
                for entry in inventory
                if entry.get("candidate_type") == "mounted_ext4"
                and str(entry.get("mount_path") or "") == str(mount_path)
                and str(entry.get("stable_device_id") or "") == str(volume.get("stable_device_id") or "")
            ]
            if len(matches) != 1:
                raise ValueError(f"existing volume {volume.get('name')} no longer has one stable inventory identity")
            entry = matches[0]
            safety_errors = _esx_storage_mounted_disk_errors(entry, mount_path=mount_path)
            if safety_errors:
                raise ValueError(f"existing volume {volume.get('name')} is not boot-safe: {', '.join(safety_errors)}")
            fs_uuid = str(entry["filesystem_uuid"])
            stable_id = str(entry["stable_device_id"])
            if any(character in value for value in (fs_uuid, stable_id, str(mount_path)) for character in "\t\r\n"):
                raise ValueError(f"existing volume {volume.get('name')} has an unsupported identity or mount path")
            disk_allowlist_lines.append(f"{fs_uuid}\t{stable_id}\t{mount_path}\tmounted_ext4")
            _esx_storage_write_disk_allowlist(disk_allowlist_lines, preserve_existing=True)
            volume["filesystem_uuid"] = fs_uuid
    _esx_storage_replace_managed_fstab(
        list(dict.fromkeys([*rollback_safe_fstab_lines, *fstab_lines]))
    )
    mount = _command_path("mount")
    if mount is None:
        raise ValueError("mount is required for ESX Storage")
    for volume in payload.get("volumes", []):
        if isinstance(volume, dict) and volume.get("source_type") == "blank_disk":
            result = _run([mount, str(volume["mount_path"])])
            commands.append([mount, str(volume["mount_path"])])
            if result.returncode != 0 and "already mounted" not in result.stderr.lower():
                raise ValueError(result.stderr.strip() or f"unable to mount {volume['mount_path']}")
    ESX_STORAGE_EXPORT_ROOT.mkdir(parents=True, exist_ok=True)
    desired_bind_paths = {
        str(share.get("bind_path"))
        for share in payload.get("shares", [])
        if isinstance(share, dict) and share.get("enabled")
    }
    findmnt_command = _command_path("findmnt")
    if findmnt_command is None:
        raise ValueError("findmnt is required for ESX Storage bind mounts")
    umount_command = _command_path("umount")
    if umount_command:
        mounted_targets = _run([findmnt_command, "-rn", "-o", "TARGET"]).stdout.splitlines()
        for raw_target in sorted(mounted_targets, key=len, reverse=True):
            target = raw_target.strip()
            if not target.startswith(f"{ESX_STORAGE_EXPORT_ROOT}/") or target in desired_bind_paths:
                continue
            result = _run([umount_command, target])
            commands.append([umount_command, target])
            if result.returncode != 0:
                raise ValueError(result.stderr.strip() or f"unable to remove stale ESX Storage bind mount {target}")
            try:
                Path(target).rmdir()
            except OSError:
                pass
    for share in payload.get("shares", []):
        if not isinstance(share, dict) or not share.get("enabled"):
            continue
        volume = volumes_by_id[share["volume_id"]]
        volume_root = Path(str(volume["mount_path"])).resolve(strict=True)
        source = Path(str(share["source_path"]))
        source.mkdir(parents=True, exist_ok=True)
        resolved_source = source.resolve(strict=True)
        if not resolved_source.is_relative_to(volume_root):
            raise ValueError(f"share {share.get('datastore_name')} escapes its backing volume")
        bind_path = Path(str(share["bind_path"]))
        bind_path.mkdir(parents=True, exist_ok=True)
        if not _esx_storage_bind_mount_matches(findmnt_command, resolved_source, bind_path):
            bind_result = _run([mount, "--bind", str(resolved_source), str(bind_path)])
            commands.append([mount, "--bind", str(resolved_source), str(bind_path)])
            if bind_result.returncode != 0:
                raise ValueError(bind_result.stderr.strip() or f"unable to bind {resolved_source} to {bind_path}")
        fstab_lines.append(
            f"{_esx_storage_fstab_escape_field(resolved_source)} "
            f"{_esx_storage_fstab_escape_field(bind_path)} none "
            f"{_esx_storage_fstab_escape_field(f'bind,nofail,x-systemd.requires-mounts-for={volume_root}')} 0 0"
        )
    _esx_storage_replace_managed_fstab(
        list(dict.fromkeys([*rollback_safe_fstab_lines, *fstab_lines]))
    )
    _esx_storage_write_runtime_config(payload)
    systemctl = _command_path("systemctl")
    exportfs = _command_path("exportfs")
    if systemctl is None or exportfs is None:
        raise ValueError("systemctl and exportfs from nfs-utils are required for ESX Storage")
    if payload.get("enabled") and any(isinstance(share, dict) and share.get("enabled") for share in payload.get("shares", [])):
        daemon_reload = _run([systemctl, "daemon-reload"])
        if daemon_reload.returncode != 0:
            raise ValueError(daemon_reload.stderr.strip() or "systemd daemon-reload failed")
        enable = _run([systemctl, "enable", "--now", "rpcbind.service", "nfs-server.service"], timeout=120)
        commands.append([systemctl, "enable", "--now", "rpcbind.service", "nfs-server.service"])
        if enable.returncode != 0:
            raise ValueError(enable.stderr.strip() or "unable to start NFS services")
        exports = _run([exportfs, "-rav"])
        commands.append([exportfs, "-rav"])
        if exports.returncode != 0:
            raise ValueError(exports.stderr.strip() or "exportfs refresh failed")
    else:
        _run([exportfs, "-ua"])
        _run([systemctl, "disable", "--now", "nfs-server.service", "rpcbind.service", "rpcbind.socket"], timeout=120)
    _esx_storage_write_disk_allowlist(disk_allowlist_lines, preserve_existing=True)
    return {"status": "applied", "volumes": payload.get("volumes", []), "shares": len(payload.get("shares", [])), "commands": commands}


def _handle_esx_storage(action: str, args: list[str]) -> int:
    """Handle ESX storage.

    Args:
        action: Action consumed by handle ESX storage.
        args: Parsed command-line options consumed by the operation.
    """
    if action == "inventory":
        try:
            print(json.dumps(_esx_storage_inventory(), sort_keys=True, separators=(",", ":")))
            return 0
        except (OSError, ValueError, json.JSONDecodeError) as exc:
            print(str(exc), file=sys.stderr)
            return 1
    if action == "status":
        status: dict[str, object] = {"rpcbind": "unknown", "nfs_server": "unknown", "exports": []}
        systemctl = _command_path("systemctl")
        exportfs = _command_path("exportfs")
        if systemctl:
            status["rpcbind"] = _run([systemctl, "is-active", "rpcbind.service"]).stdout.strip() or "inactive"
            status["nfs_server"] = _run([systemctl, "is-active", "nfs-server.service"]).stdout.strip() or "inactive"
        if exportfs:
            status["exports"] = [line for line in _run([exportfs, "-v"]).stdout.splitlines() if line.strip()]
        print(json.dumps(status, sort_keys=True, separators=(",", ":")))
        return 0
    if action == "logs":
        journalctl = _command_path("journalctl")
        if journalctl is None:
            print("journalctl command not found", file=sys.stderr)
            return 127
        result = _run([journalctl, "-u", "nfs-server.service", "-u", "rpcbind.service", "-n", "200", "--no-pager"])
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        return result.returncode
    if len(args) != 1:
        print(f"esx-storage {action} requires exactly one staged manifest path", file=sys.stderr)
        return 2
    try:
        config_path = _esx_storage_config_path(args[0])
        payload = _esx_storage_manifest(config_path)
        errors = _esx_storage_manifest_errors(payload, require_authorization=action == "apply")
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    if errors:
        for error in errors:
            print(error, file=sys.stderr)
        return 2
    if action == "validate":
        print(json.dumps({"esx_storage": "validation complete", "config_path": str(config_path)}, sort_keys=True))
        return 0
    if action == "apply":
        try:
            print(json.dumps(_esx_storage_apply(payload), sort_keys=True))
            return 0
        except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
            print(str(exc), file=sys.stderr)
            return 1
    print(f"unsupported esx-storage action: {action}", file=sys.stderr)
    return 2


def _handle_automation(action: str, args: list[str]) -> int:
    """Handle automation.

    Args:
        action: Action consumed by handle automation.
        args: Parsed command-line options consumed by the operation.
    """
    if action != "run" or len(args) < 3:
        print("automation run requires script path, interpreter, timeout seconds, and optional arguments after --", file=sys.stderr)
        return 2
    script_value, interpreter, timeout_value, *remaining = args
    vault_value = ""
    if remaining[:1] == ["--vault"]:
        if len(remaining) < 2:
            print("automation --vault requires a staged credential path", file=sys.stderr)
            return 2
        vault_value = remaining[1]
        remaining = remaining[2:]
    if remaining and remaining[0] != "--":
        print("automation script arguments must follow --", file=sys.stderr)
        return 2
    script_arguments = remaining[1:] if remaining else []
    vault_path: Path | None = None
    vault_values: list[str] = []
    try:
        script_path = Path(script_value).resolve(strict=True)
        script_root = AUTOMATION_SCRIPT_DIR.resolve(strict=True)
        if not script_path.is_relative_to(script_root) or not script_path.is_file():
            raise ValueError(f"automation script must be a regular file under {AUTOMATION_SCRIPT_DIR}")
        timeout_seconds = int(timeout_value)
        if timeout_seconds < 1 or timeout_seconds > 86400:
            raise ValueError("automation timeout must be between 1 and 86400 seconds")
        command_name = {"bash": "bash", "python": "python3", "powershell": "pwsh"}.get(interpreter)
        if command_name is None:
            raise ValueError("automation interpreter must be bash, python, or powershell")
        executable = _command_path(command_name)
        systemd_run = shutil.which("systemd-run")
        if executable is None:
            raise ValueError(f"automation interpreter is not installed: {command_name}")
        if systemd_run is None:
            raise ValueError("systemd-run is required for managed automation scripts")
        account = pwd.getpwnam(AUTOMATION_USER)
        if vault_value:
            vault_path = Path(vault_value).resolve(strict=True)
            vault_root = AUTOMATION_VAULT_DIR.resolve(strict=True)
            if not vault_path.is_relative_to(vault_root) or not vault_path.is_file():
                raise ValueError(f"automation vault credential must be a regular file under {AUTOMATION_VAULT_DIR}")
            if os.name != "nt" and vault_path.stat().st_mode & 0o077:
                raise ValueError("automation vault credential must not be group or world accessible")
            vault_payload = json.loads(vault_path.read_text(encoding="utf-8"))
            values = vault_payload.get("values")
            if vault_payload.get("version") != 1 or not isinstance(values, dict):
                raise ValueError("automation vault credential is invalid")
            if any(not isinstance(key, str) or not isinstance(value, str) for key, value in values.items()):
                raise ValueError("automation vault credential values are invalid")
            vault_values = [value for value in values.values() if value]
    except (KeyError, OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 2

    AUTOMATION_RUN_DIR.mkdir(parents=True, exist_ok=True)
    os.chmod(AUTOMATION_RUN_DIR, 0o750)
    _chown_path(script_path, int(account.pw_uid), int(account.pw_gid))
    os.chmod(script_path, 0o400)
    unit_suffix = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S%f")
    run_home = AUTOMATION_RUN_DIR / unit_suffix
    writable_directories = [run_home, run_home / ".cache", run_home / ".config", run_home / ".local", run_home / ".local" / "share"]
    for directory in writable_directories:
        directory.mkdir(parents=True, exist_ok=True)
        os.chmod(directory, 0o700)
        _chown_path(directory, int(account.pw_uid), int(account.pw_gid))
    execution_script = script_path
    if interpreter == "powershell":
        wrapper_path = run_home / "atlaso-managed-script.ps1"
        script_literal = str(script_path).replace("'", "''")
        vault_command_literal = str(ATLASO_VENV_LINK / "bin" / "atlaso-vault").replace("'", "''")
        wrapper_path.write_text(
            "function global:Get-AtlasoVault {\n"
            "  [CmdletBinding()]\n"
            "  param([Parameter(Mandatory=$true)][string]$Key)\n"
            f"  $value = & '{vault_command_literal}' get --key $Key\n"
            "  if ($LASTEXITCODE -ne 0) { throw \"Atlaso vault lookup failed for key: $Key\" }\n"
            "  return ($value -join [Environment]::NewLine)\n"
            "}\n"
            f"& '{script_literal}' @args\n"
            "exit $LASTEXITCODE\n",
            encoding="utf-8",
        )
        os.chmod(wrapper_path, 0o400)
        _chown_path(wrapper_path, int(account.pw_uid), int(account.pw_gid))
        execution_script = wrapper_path
    credential_property = [f"--property=LoadCredential=atlaso-vault:{vault_path}"] if vault_path else []
    try:
        result = _run(
            [
                systemd_run,
                "--quiet",
                "--wait",
                "--pipe",
                "--collect",
                "--service-type=exec",
                f"--unit=atlaso-automation-{unit_suffix}",
                f"--uid={AUTOMATION_USER}",
                f"--setenv=HOME={run_home}",
                f"--setenv=XDG_CACHE_HOME={run_home / '.cache'}",
                f"--setenv=XDG_CONFIG_HOME={run_home / '.config'}",
                f"--setenv=XDG_DATA_HOME={run_home / '.local' / 'share'}",
                f"--setenv=PATH={ATLASO_VENV_LINK / 'bin'}:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin",
                *credential_property,
                "--property=NoNewPrivileges=yes",
                "--property=PrivateTmp=yes",
                "--property=ProtectSystem=strict",
                "--property=ProtectHome=yes",
                f"--property=ReadWritePaths={run_home}",
                f"--property=WorkingDirectory={run_home}",
                f"--property=TimeoutStartSec={timeout_seconds}",
                executable,
                str(execution_script),
                *script_arguments,
            ]
        )
    finally:
        if execution_script != script_path:
            os.chmod(execution_script, 0o600)
        shutil.rmtree(run_home, ignore_errors=True)
    stdout = result.stdout
    stderr = result.stderr
    for value in sorted(set(vault_values), key=len, reverse=True):
        stdout = stdout.replace(value, "[redacted]")
        stderr = stderr.replace(value, "[redacted]")
    print(stdout[-8000:], end="")
    print(stderr[-8000:], end="", file=sys.stderr)
    return result.returncode


def _schedule_appliance_power(action: str) -> int:
    """Perform schedule appliance power.

    Args:
        action: Action consumed by schedule appliance power.
    """
    systemctl = _command_path("systemctl")
    systemd_run = shutil.which("systemd-run")
    if systemctl is None:
        print("systemctl command not found", file=sys.stderr)
        return 127
    if systemd_run is None:
        print("systemd-run command not found; refusing an immediate appliance power action", file=sys.stderr)
        return 127
    systemctl_action = "reboot" if action == "reboot" else "poweroff"
    unit_suffix = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S%f")
    result = _run(
        [
            systemd_run,
            "--quiet",
            "--on-active=5",
            f"--unit=atlaso-{action}-{unit_suffix}",
            systemctl,
            systemctl_action,
        ]
    )
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


def _handle_appliance_power(action: str, args: list[str]) -> int:
    """Handle appliance power.

    Args:
        action: Action consumed by handle appliance power.
        args: Parsed command-line options consumed by the operation.
    """
    if args:
        print(f"appliance-power {action} does not accept a path", file=sys.stderr)
        return 2
    return _schedule_appliance_power(action)


def _write_factory_reset_marker(payload: dict) -> None:
    """Write one root-owned, non-secret factory-reset marker atomically.

    Args:
        payload: Bounded reset state to persist.
    """
    directory_descriptor = _open_factory_reset_directory()
    temporary_name = ".request.json.tmp"
    try:
        if directory_descriptor is None:
            temporary = ATLASO_FACTORY_RESET_DIR / temporary_name
            with temporary.open("w", encoding="utf-8") as handle:
                json.dump(payload, handle, indent=2, sort_keys=True)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary, 0o640)
            os.replace(temporary, ATLASO_FACTORY_RESET_REQUEST_PATH)
            return
        flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
        temporary_descriptor = os.open(
            temporary_name,
            flags,
            0o640,
            dir_fd=directory_descriptor,
        )
        try:
            os.fchmod(temporary_descriptor, 0o640)
            os.fchown(
                temporary_descriptor,
                0,
                int(pwd.getpwnam(ATLASO_SERVICE_USER).pw_gid),
            )
            with os.fdopen(temporary_descriptor, "w", encoding="utf-8", closefd=False) as handle:
                json.dump(payload, handle, indent=2, sort_keys=True)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
        finally:
            os.close(temporary_descriptor)
        os.replace(
            temporary_name,
            ATLASO_FACTORY_RESET_REQUEST_PATH.name,
            src_dir_fd=directory_descriptor,
            dst_dir_fd=directory_descriptor,
        )
        os.fsync(directory_descriptor)
    except Exception:
        if directory_descriptor is not None:
            try:
                os.unlink(temporary_name, dir_fd=directory_descriptor)
            except FileNotFoundError:
                pass
        raise
    finally:
        if directory_descriptor is not None:
            os.close(directory_descriptor)


def _open_factory_reset_directory() -> int | None:
    """Open the reset state directory without following service-user links.

    Returns:
        A securely opened POSIX directory descriptor, or ``None`` on non-POSIX hosts.
    """
    if os.name != "posix":
        if ATLASO_FACTORY_RESET_DIR.is_symlink():
            raise ValueError("factory-reset state directory is unsafe")
        ATLASO_FACTORY_RESET_DIR.mkdir(parents=True, exist_ok=True)
        if (
            ATLASO_FACTORY_RESET_DIR.is_symlink()
            or not ATLASO_FACTORY_RESET_DIR.is_dir()
            or ATLASO_FACTORY_RESET_DIR.resolve() != ATLASO_FACTORY_RESET_DIR
        ):
            raise ValueError("factory-reset state directory is unsafe")
        os.chmod(ATLASO_FACTORY_RESET_DIR, 0o750)
        return None

    parent = ATLASO_FACTORY_RESET_DIR.parent
    parent_flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    parent_descriptor = os.open(parent, parent_flags)
    try:
        parent_stat = os.fstat(parent_descriptor)
        if (
            not stat.S_ISDIR(parent_stat.st_mode)
            or parent_stat.st_uid != 0
            or parent_stat.st_mode & 0o022
        ):
            raise ValueError("factory-reset state parent directory is unsafe")
        try:
            os.mkdir(
                ATLASO_FACTORY_RESET_DIR.name,
                0o750,
                dir_fd=parent_descriptor,
            )
        except FileExistsError:
            pass
        directory_descriptor = os.open(
            ATLASO_FACTORY_RESET_DIR.name,
            parent_flags,
            dir_fd=parent_descriptor,
        )
    finally:
        os.close(parent_descriptor)
    try:
        directory_stat = os.fstat(directory_descriptor)
        if not stat.S_ISDIR(directory_stat.st_mode) or directory_stat.st_uid != 0:
            raise ValueError("factory-reset state directory is unsafe")
        atlaso_gid = int(pwd.getpwnam(ATLASO_SERVICE_USER).pw_gid)
        os.fchmod(directory_descriptor, 0o750)
        os.fchown(directory_descriptor, 0, atlaso_gid)
        return directory_descriptor
    except Exception:
        os.close(directory_descriptor)
        raise


def _normalize_factory_reset_credentials(payload: object) -> dict[str, str | int]:
    """Validate and normalize one factory-reset credential payload.

    Args:
        payload: Parsed JSON value containing password choices.
    """
    allowed_keys = {
        "schema_version",
        "admin_action",
        "admin_password",
        "root_action",
        "root_password",
    }
    if (
        not isinstance(payload, dict)
        or payload.get("schema_version") != 1
        or set(payload) - allowed_keys
    ):
        raise ValueError("factory-reset credential file is invalid")
    normalized: dict[str, str | int] = {"schema_version": 1}
    for account in ("admin", "root"):
        action = payload.get(f"{account}_action")
        password = payload.get(f"{account}_password", "")
        if action not in {"keep", "change"} or not isinstance(password, str):
            raise ValueError("factory-reset credential file is invalid")
        if (action == "change") != bool(password):
            raise ValueError("factory-reset credential file is incomplete")
        if password and (
            len(password) > 1024
            or any(character in password for character in ("\x00", "\r", "\n"))
        ):
            raise ValueError("factory-reset password contains unsupported characters")
        normalized[f"{account}_action"] = action
        if action == "change":
            normalized[f"{account}_password"] = password
    return normalized


def _factory_reset_staged_credentials_path(path_value: str) -> Path:
    """Validate one request-bound factory-reset credential staging path.

    Args:
        path_value: Transient staging path supplied by the control plane.
    """
    path = Path(path_value)
    staging_directory = ATLASO_FACTORY_RESET_STAGED_CREDENTIALS_PATH.parent
    if (
        path.parent != staging_directory
        or not ATLASO_FACTORY_RESET_STAGED_CREDENTIAL_NAME_PATTERN.fullmatch(
            path.name
        )
    ):
        raise ValueError(
            "factory-reset credentials must use a request-bound staging path"
        )
    if (
        staging_directory.is_symlink()
        or not staging_directory.is_dir()
        or staging_directory.resolve() != staging_directory
    ):
        raise ValueError("factory-reset credential staging directory is unsafe")
    return path


def _read_factory_reset_credentials(path_value: str) -> dict[str, str | int]:
    """Validate one request-bound, protected credential-choice file.

    Args:
        path_value: Transient staging path supplied by the control plane.
    """
    path = _factory_reset_staged_credentials_path(path_value)
    if path.is_symlink() or not path.is_file() or path.resolve() != path:
        raise ValueError("factory-reset credential staging path is unsafe")
    file_stat = path.stat()
    if file_stat.st_size > 16 * 1024:
        raise ValueError("factory-reset credential staging file is too large")
    if os.name == "posix":
        if file_stat.st_mode & 0o077:
            raise ValueError("factory-reset credential staging file must use mode 0600")
        try:
            atlaso_uid = int(pwd.getpwnam(ATLASO_SERVICE_USER).pw_uid)
        except (KeyError, TypeError, ValueError) as exc:
            raise ValueError("factory-reset could not resolve the Atlaso service account") from exc
        if file_stat.st_uid != atlaso_uid:
            raise ValueError("factory-reset credential staging file must be owned by Atlaso")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ValueError("factory-reset credential staging file is invalid") from exc
    return _normalize_factory_reset_credentials(payload)


def _read_durable_factory_reset_credentials() -> dict[str, str | int]:
    """Read the root-only credential payload admitted with the active reset."""
    path = ATLASO_FACTORY_RESET_CREDENTIALS_PATH
    if path.is_symlink() or not path.is_file() or path.resolve() != path:
        raise ValueError("factory-reset durable credential path is unsafe")
    file_stat = path.stat()
    if file_stat.st_size > 16 * 1024:
        raise ValueError("factory-reset durable credential file is too large")
    if os.name == "posix":
        if file_stat.st_mode & 0o077:
            raise ValueError("factory-reset durable credential file must use mode 0600")
        if file_stat.st_uid != 0:
            raise ValueError("factory-reset durable credential file must be owned by root")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise ValueError("factory-reset durable credential file is invalid") from exc
    return _normalize_factory_reset_credentials(payload)


def _persist_factory_reset_credentials(payload: dict[str, str | int]) -> None:
    """Persist validated reset credentials as a root-only durable recovery input.

    Args:
        payload: Validated keep-or-change actions and any selected new passwords.
    """
    directory_descriptor = _open_factory_reset_directory()
    temporary_name = ".credentials.json.tmp"
    try:
        if directory_descriptor is None:
            temporary = ATLASO_FACTORY_RESET_DIR / temporary_name
            with temporary.open("w", encoding="utf-8") as handle:
                json.dump(payload, handle, sort_keys=True)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary, 0o600)
            os.replace(temporary, ATLASO_FACTORY_RESET_CREDENTIALS_PATH)
            return
        descriptor = os.open(
            temporary_name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_descriptor,
        )
        try:
            os.fchmod(descriptor, 0o600)
            os.fchown(descriptor, 0, 0)
            with os.fdopen(descriptor, "w", encoding="utf-8", closefd=False) as handle:
                json.dump(payload, handle, sort_keys=True)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
        finally:
            os.close(descriptor)
        os.replace(
            temporary_name,
            ATLASO_FACTORY_RESET_CREDENTIALS_PATH.name,
            src_dir_fd=directory_descriptor,
            dst_dir_fd=directory_descriptor,
        )
        os.fsync(directory_descriptor)
    except Exception:
        if directory_descriptor is not None:
            try:
                os.unlink(temporary_name, dir_fd=directory_descriptor)
            except FileNotFoundError:
                pass
        raise
    finally:
        if directory_descriptor is not None:
            os.close(directory_descriptor)


def _factory_reset_state_payload() -> dict:
    """Read a bounded reset marker without exposing request metadata."""
    for path in (ATLASO_FACTORY_RESET_REQUEST_PATH, ATLASO_FACTORY_RESET_RESULT_PATH):
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except (FileNotFoundError, OSError, json.JSONDecodeError):
            continue
        if isinstance(payload, dict):
            return {
                "schema_version": int(payload.get("schema_version") or 1),
                "state": str(payload.get("state") or "unknown"),
                "updated_at": str(payload.get("updated_at") or payload.get("requested_at") or ""),
                "message": str(payload.get("message") or ""),
            }
    return {"schema_version": 1, "state": "idle", "updated_at": "", "message": ""}


def _factory_reset_runner(*, boot_resume: bool) -> subprocess.CompletedProcess[str]:
    """Run the installed reset transaction synchronously.

    Args:
        boot_resume: Whether the run is resuming from service startup.
    """
    if not ATLASO_FACTORY_RESET_PYTHON.is_file():
        return subprocess.CompletedProcess(
            [str(ATLASO_FACTORY_RESET_PYTHON), "-m", "atlaso.app.factory_reset"],
            127,
            "",
            "Atlaso factory-reset runtime is unavailable.\n",
        )
    environment = os.environ.copy()
    if boot_resume:
        environment["ATLASO_FACTORY_RESET_BOOT_RESUME"] = "1"
    return _run(
        [str(ATLASO_FACTORY_RESET_PYTHON), "-m", "atlaso.app.factory_reset"],
        env=environment,
    )


def _factory_reset_activation_pending() -> bool:
    """Return whether defaults are committed and only readiness remains."""
    try:
        payload = json.loads(ATLASO_FACTORY_RESET_REQUEST_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return False
    applied_unit_count = payload.get("applied_unit_count")
    return (
        payload.get("state") in {"awaiting_readiness", "failed"}
        and type(applied_unit_count) is int
        and applied_unit_count > 0
    )


def _schedule_factory_reset_finalizer() -> subprocess.CompletedProcess[str]:
    """Queue readiness verification without blocking the service preflight."""
    systemd_run = shutil.which("systemd-run")
    if systemd_run is None:
        return subprocess.CompletedProcess(
            ["systemd-run"],
            127,
            "",
            "systemd-run is required to verify factory-reset readiness.\n",
        )
    return _run(
        [
            systemd_run,
            "--quiet",
            "--collect",
            "--no-block",
            f"--unit=atlaso-factory-reset-readiness-resume-{os.getpid()}",
            "--property=Type=oneshot",
            f"--property=WorkingDirectory={ATLASO_STATE_DIR}",
            f"--property=EnvironmentFile={ATLASO_ENV_PATH}",
            str(ATLASO_FACTORY_RESET_PYTHON),
            "-m",
            "atlaso.app.factory_reset",
            "finalize",
        ]
    )


def _schedule_factory_reset_locked(
    credentials: dict[str, str | int],
) -> int:
    """Persist credentials and dispatch the reset transaction while serialized.

    Args:
        credentials: Validated protected password choices for the admitted reset.
    """
    systemd_run = shutil.which("systemd-run")
    if systemd_run is None:
        print("systemd-run is required to schedule factory reset", file=sys.stderr)
        return 127
    units = ("atlaso-factory-reset.service", "atlaso-factory-reset.timer")
    active = _run(["systemctl", "is-active", "--quiet", *units])
    if active.returncode == 0:
        print(json.dumps(_factory_reset_state_payload(), sort_keys=True))
        print(
            "Factory reset admission is busy; retry after the active reset reaches a terminal state.",
            file=sys.stderr,
        )
        return ATLASO_FACTORY_RESET_ADMISSION_BUSY_EXIT_CODE
    request_payload: dict = {}
    request_path = ATLASO_FACTORY_RESET_REQUEST_PATH
    if request_path.is_symlink():
        raise ValueError("factory-reset request marker is unsafe")
    if request_path.exists():
        if (
            not request_path.is_file()
            or request_path.resolve() != request_path
            or request_path.stat().st_size > 64 * 1024
        ):
            raise ValueError("factory-reset request marker is unsafe")
        try:
            parsed_request = json.loads(request_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            raise ValueError("factory-reset request marker is invalid") from exc
        if not isinstance(parsed_request, dict):
            raise ValueError("factory-reset request marker is invalid")
        request_payload = parsed_request
        scheduling_retry = (
            request_payload.get("schema_version") == 1
            and request_payload.get("state") == "failed"
            and request_payload.get("failure_phase") == "scheduling"
            and "applied_unit_count" not in request_payload
        )
        if not scheduling_retry:
            raise ValueError(
                "factory-reset request requires console recovery before another reset can be scheduled"
            )
    now = datetime.now(timezone.utc).isoformat()
    requested_at = str(request_payload.get("requested_at") or now)
    _persist_factory_reset_credentials(credentials)
    _write_factory_reset_marker(
        {
            "schema_version": 1,
            "state": "scheduled",
            "requested_at": requested_at,
            "updated_at": now,
            "message": "Factory reset is scheduled.",
            "admin_password_action": credentials["admin_action"],
            "root_password_action": credentials["root_action"],
        }
    )
    _run(
        [
            "systemctl",
            "reset-failed",
            "atlaso-factory-reset.service",
            "atlaso-factory-reset.timer",
        ]
    )
    result = _run(
        [
            systemd_run,
            "--quiet",
            "--collect",
            "--on-active=2",
            "--unit=atlaso-factory-reset",
            "--property=Type=oneshot",
            f"--property=WorkingDirectory={ATLASO_STATE_DIR}",
            f"--property=EnvironmentFile={ATLASO_ENV_PATH}",
            "--setenv=ATLASO_HELPER_USE_SYSTEMD_RUN=1",
            str(ATLASO_FACTORY_RESET_PYTHON),
            "-m",
            "atlaso.app.factory_reset",
        ]
    )
    if result.returncode != 0:
        failed = _factory_reset_state_payload()
        failed.update(
            {
                "state": "failed",
                "failure_phase": "scheduling",
                "updated_at": datetime.now(timezone.utc).isoformat(),
                "message": "Factory reset could not be scheduled. Use the console recovery path.",
            }
        )
        _write_factory_reset_marker(failed)
        print(result.stderr or result.stdout, end="", file=sys.stderr)
        return result.returncode
    logger = shutil.which("logger")
    if logger is not None:
        _run([logger, "-t", "atlaso-factory-reset", "Factory reset accepted; durable recovery marker created."])
    print(json.dumps(_factory_reset_state_payload(), sort_keys=True))
    return 0


def _schedule_factory_reset(credentials_path: str) -> int:
    """Serialize protected reset admission before creating its marker and timer.

    Args:
        credentials_path: Request-bound transient credential-choice staging path.
    """
    try:
        staged_path = _factory_reset_staged_credentials_path(credentials_path)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2
    try:
        directory_descriptor = _open_factory_reset_directory()
        if directory_descriptor is None:
            lock_path = ATLASO_FACTORY_RESET_DIR / "transaction.lock"
            lock_handle_context = lock_path.open("a+b")
            os.chmod(lock_path, 0o600)
        else:
            lock_descriptor = os.open(
                "transaction.lock",
                os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW,
                0o600,
                dir_fd=directory_descriptor,
            )
            os.fchmod(lock_descriptor, 0o600)
            os.fchown(lock_descriptor, 0, 0)
            lock_handle_context = os.fdopen(lock_descriptor, "a+b")
        try:
            with lock_handle_context as lock_handle:
                if fcntl is not None:
                    try:
                        fcntl.flock(
                            lock_handle.fileno(),
                            fcntl.LOCK_EX | fcntl.LOCK_NB,
                        )
                    except BlockingIOError:
                        print(json.dumps(_factory_reset_state_payload(), sort_keys=True))
                        print(
                            "Factory reset admission is busy; retry after the active request is recorded.",
                            file=sys.stderr,
                        )
                        return ATLASO_FACTORY_RESET_ADMISSION_BUSY_EXIT_CODE
                try:
                    credentials = _read_factory_reset_credentials(credentials_path)
                    return _schedule_factory_reset_locked(credentials)
                finally:
                    if fcntl is not None:
                        fcntl.flock(lock_handle.fileno(), fcntl.LOCK_UN)
        finally:
            if directory_descriptor is not None:
                os.close(directory_descriptor)
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 2
    finally:
        staging_directory = staged_path.parent
        staged_path.unlink(missing_ok=True)
        if staging_directory.is_dir():
            _fsync_factory_reset_directory(staging_directory)


def _factory_reset_runtime_cleanup_is_admitted() -> bool:
    """Return whether the durable marker admits reset-only runtime cleanup."""
    if os.name == "posix":
        directory_descriptor: int | None = None
        marker_descriptor: int | None = None
        try:
            directory_descriptor = _open_factory_reset_directory()
            if directory_descriptor is None:
                return False
            marker_descriptor = os.open(
                ATLASO_FACTORY_RESET_REQUEST_PATH.name,
                os.O_RDONLY | os.O_NOFOLLOW,
                dir_fd=directory_descriptor,
            )
            marker_stat = os.fstat(marker_descriptor)
            if (
                not stat.S_ISREG(marker_stat.st_mode)
                or marker_stat.st_uid != 0
                or marker_stat.st_mode & 0o022
                or marker_stat.st_size > 64 * 1024
            ):
                return False
            with os.fdopen(marker_descriptor, encoding="utf-8") as handle:
                marker_descriptor = None
                payload = json.load(handle)
        except (FileNotFoundError, OSError, ValueError, json.JSONDecodeError):
            return False
        finally:
            if marker_descriptor is not None:
                os.close(marker_descriptor)
            if directory_descriptor is not None:
                os.close(directory_descriptor)
        return (
            isinstance(payload, dict)
            and payload.get("schema_version") == 1
            and payload.get("state") == "applying"
        )
    try:
        payload = json.loads(ATLASO_FACTORY_RESET_REQUEST_PATH.read_text(encoding="utf-8"))
    except (FileNotFoundError, OSError, json.JSONDecodeError):
        return False
    return payload.get("schema_version") == 1 and payload.get("state") == "applying"


def _factory_reset_managed_vlan_names() -> list[str]:
    """Inventory VLAN links from bounded Atlaso-owned networkd definitions."""
    names: set[str] = set()
    for path in sorted(NETWORKD_CONFIG_DIR.glob(f"{NETWORKD_MANAGED_PREFIX}*.netdev")):
        if path.is_symlink() or not path.is_file():
            continue
        try:
            if path.stat().st_size > 64 * 1024:
                raise ValueError(f"managed networkd definition is unexpectedly large: {path.name}")
            lines = path.read_text(encoding="utf-8").splitlines()
        except OSError as exc:
            raise ValueError(f"could not read managed networkd definition: {path.name}") from exc
        if not lines or lines[0].strip() != "# Managed by Atlaso. Local changes may be overwritten.":
            continue
        section = ""
        values: dict[str, str] = {}
        for raw_line in lines:
            line = raw_line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1]
                continue
            if section == "NetDev" and "=" in line:
                key, value = [part.strip() for part in line.split("=", 1)]
                values[key] = value
        name = values.get("Name", "")
        if values.get("Kind") != "vlan" or not _valid_network_interface_name(name):
            raise ValueError(f"managed VLAN definition is invalid: {path.name}")
        if path.name != _networkd_managed_filename(name, "netdev"):
            raise ValueError(f"managed VLAN definition name does not match its filename: {path.name}")
        names.add(name)
    return sorted(names)


def _factory_reset_login_session_rows(loginctl: str) -> list[tuple[str, str]]:
    """Return bounded login-session identifiers and usernames.

    Args:
        loginctl: Absolute loginctl command path.
    """
    result = _run([loginctl, "list-sessions", "--no-legend", "--no-pager"])
    if result.returncode != 0:
        raise ValueError("factory-reset could not inventory operating-system login sessions")
    rows: list[tuple[str, str]] = []
    for raw_line in result.stdout.splitlines():
        fields = raw_line.split()
        if not fields:
            continue
        if (
            len(fields) < 3
            or not re.fullmatch(r"[A-Za-z0-9_.-]{1,128}", fields[0])
            or not fields[1].isdigit()
            or not LOCAL_USERS_USERNAME_PATTERN.fullmatch(fields[2])
        ):
            raise ValueError("factory-reset received an unsafe login-session inventory")
        rows.append((fields[0], fields[2]))
    return rows


def _terminate_factory_reset_login_sessions() -> int:
    """Stop SSH admission, terminate, and verify bounded pre-reset logins."""
    if not _factory_reset_runtime_cleanup_is_admitted():
        print("factory-reset login cleanup requires an active applying marker", file=sys.stderr)
        return 2
    loginctl = shutil.which("loginctl")
    if loginctl is None:
        print("factory-reset could not locate loginctl", file=sys.stderr)
        return 1
    try:
        targets = {"root", *_managed_local_usernames()}
        ssh_stop = _run(["systemctl", "stop", "sshd.service"])
        if ssh_stop.returncode != 0:
            raise ValueError("factory-reset could not stop SSH login admission")
        ssh_active = _run(["systemctl", "is-active", "--quiet", "sshd.service"])
        if ssh_active.returncode not in {3, 4}:
            raise ValueError("factory-reset could not verify SSH login admission stopped")
        sessions = [
            session_id
            for session_id, username in _factory_reset_login_session_rows(loginctl)
            if username in targets
        ]
        for session_id in sessions:
            terminated = _run([loginctl, "terminate-session", session_id])
            if terminated.returncode != 0:
                raise ValueError("factory-reset could not terminate an operating-system login session")
        remaining = [
            session_id
            for session_id, username in _factory_reset_login_session_rows(loginctl)
            if username in targets
        ]
        if remaining:
            raise ValueError("factory-reset could not verify operating-system login sessions terminated")
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(
        json.dumps(
            {
                "factory_reset_login_sessions": "terminated",
                "session_count": len(sessions),
            },
            sort_keys=True,
        )
    )
    return 0


def _factory_reset_wan_route_interfaces() -> list[str]:
    """Inventory interfaces referenced by Atlaso's dedicated live lab route table."""
    interfaces: set[str] = set()
    for family_arguments in ([], ["-6"]):
        command = ["ip", "-j", *family_arguments, "route", "show", "table", str(LAB_ROUTE_TABLE_ID)]
        result = _run(command)
        if result.returncode != 0:
            empty_output = not result.stdout.strip()
            if not empty_output:
                try:
                    empty_output = json.loads(result.stdout) == []
                except json.JSONDecodeError:
                    empty_output = False
            if result.returncode == 2 and empty_output and "FIB table does not exist" in result.stderr:
                continue
            print(result.stdout, end="")
            print(result.stderr, end="", file=sys.stderr)
            raise ValueError(f"could not inventory Atlaso route table {LAB_ROUTE_TABLE_ID}")
        try:
            routes = json.loads(result.stdout or "[]")
        except json.JSONDecodeError as exc:
            raise ValueError(f"Atlaso route table {LAB_ROUTE_TABLE_ID} returned invalid JSON") from exc
        if not isinstance(routes, list):
            raise ValueError(f"Atlaso route table {LAB_ROUTE_TABLE_ID} returned an invalid route inventory")
        for route in routes:
            interface_name = route.get("dev", "") if isinstance(route, dict) else ""
            if interface_name and not _valid_network_interface_name(interface_name):
                raise ValueError(f"Atlaso route table {LAB_ROUTE_TABLE_ID} returned an invalid interface name")
            if interface_name:
                interfaces.add(interface_name)
    return sorted(interfaces)


def _factory_reset_root_netem_interfaces(candidates: list[str]) -> list[str]:
    """Select only route-bound interfaces with Atlaso's root netem qdisc shape.

    Args:
        candidates: Validated interface names referenced by Atlaso-owned routes.
    """
    interfaces: list[str] = []
    for interface_name in candidates:
        command = ["tc", "-j", "qdisc", "show", "dev", interface_name]
        result = _run(command)
        if result.returncode != 0:
            print(result.stdout, end="")
            print(result.stderr, end="", file=sys.stderr)
            raise ValueError(f"could not inventory qdisc state for {interface_name}")
        try:
            qdiscs = json.loads(result.stdout or "[]")
        except json.JSONDecodeError as exc:
            raise ValueError(f"qdisc inventory for {interface_name} returned invalid JSON") from exc
        if not isinstance(qdiscs, list):
            raise ValueError(f"qdisc inventory for {interface_name} returned an invalid result")
        if any(isinstance(qdisc, dict) and qdisc.get("kind") == "netem" and qdisc.get("root") is True for qdisc in qdiscs):
            interfaces.append(interface_name)
    return interfaces


def _reset_factory_network_runtime() -> int:
    """Clear bounded live VLAN, route-table, and WAN impairment state during reset."""
    if not _factory_reset_runtime_cleanup_is_admitted():
        print("factory-reset network runtime cleanup requires an active applying marker", file=sys.stderr)
        return 2
    if shutil.which("ip") is None:
        print("ip command not found", file=sys.stderr)
        return 127
    if shutil.which("tc") is None:
        print("tc command not found", file=sys.stderr)
        return 127
    try:
        vlan_names = _factory_reset_managed_vlan_names()
        wan_route_interfaces = _factory_reset_wan_route_interfaces()
        netem_interfaces = _factory_reset_root_netem_interfaces(wan_route_interfaces)
    except ValueError as exc:
        print(str(exc), file=sys.stderr)
        return 2

    for interface_name in netem_interfaces:
        result = _run(["tc", "qdisc", "del", "dev", interface_name, "root"])
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        if result.returncode not in {0, 2}:
            return result.returncode

    for family_arguments in ([], ["-6"]):
        for table_id in (MANAGEMENT_ROUTE_TABLE_ID, LAB_ROUTE_TABLE_ID):
            command = ["ip", *family_arguments, "route", "flush", "table", str(table_id)]
            result = _run(command)
            print(result.stdout, end="")
            print(result.stderr, end="", file=sys.stderr)
            absent_table = (
                result.returncode == 2
                and "FIB table does not exist" in result.stderr
            )
            if result.returncode != 0 and not absent_table:
                return result.returncode

    removed_vlans: list[str] = []
    for name in vlan_names:
        if not _link_exists(name):
            continue
        if not _is_vlan_link(name):
            print(f"refusing to delete non-VLAN link from managed definition: {name}", file=sys.stderr)
            return 2
        result = _run(["ip", "link", "delete", "dev", name])
        print(result.stdout, end="")
        print(result.stderr, end="", file=sys.stderr)
        if result.returncode != 0:
            return result.returncode
        removed_vlans.append(name)

    print(
        json.dumps(
            {
                "factory_reset_network_runtime": "cleanup complete",
                "qdisc_interfaces": netem_interfaces,
                "removed_vlans": removed_vlans,
                "route_tables": [MANAGEMENT_ROUTE_TABLE_ID, LAB_ROUTE_TABLE_ID],
            },
            sort_keys=True,
        )
    )
    return 0


def _factory_reset_synchronized_powershell_repositories() -> list[str]:
    """Return the validated PowerShell repository names synchronized by Atlaso."""
    path = UPDATE_SOURCE_STATE_PATH
    if path.is_symlink():
        raise ValueError("factory-reset update-source state path is unsafe")
    if not path.exists():
        return []
    if not path.is_file() or path.resolve() != path:
        raise ValueError("factory-reset update-source state path is unsafe")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError("factory-reset could not read synchronized update-source state") from exc
    names = payload.get("powershell_repositories") if isinstance(payload, dict) else None
    if not isinstance(names, list):
        raise ValueError("factory-reset synchronized update-source state is invalid")
    repositories: set[str] = set()
    for value in names:
        if not isinstance(value, str) or not value.strip() or "\x00" in value:
            raise ValueError("factory-reset synchronized PowerShell repository name is unsafe")
        repositories.add(value.strip())
    return sorted(repositories)


def _factory_reset_retained_runtime_paths_are_safe() -> list[str]:
    """Validate fixed credential-bearing runtime paths before cleanup."""
    if KMS_STATE_DIR.exists() and (
        KMS_STATE_DIR.is_symlink()
        or not KMS_STATE_DIR.is_dir()
        or KMS_STATE_DIR.resolve() != KMS_STATE_DIR
    ):
        raise ValueError("factory-reset KMIP state directory is unsafe")
    if KMS_STATE_DIR.is_dir():
        for child in KMS_STATE_DIR.iterdir():
            if not child.is_symlink() and not child.is_file():
                raise ValueError(f"factory-reset KMIP state entry is unsafe: {child.name}")
    for path, label in (
        (MANAGED_PHOTON_REPO_PATH, "managed Photon repository"),
        (UPDATE_SOURCE_STATE_PATH, "update-source state"),
    ):
        if path.is_symlink() or (path.exists() and (not path.is_file() or path.resolve() != path)):
            raise ValueError(f"factory-reset {label} path is unsafe")
    repositories = _factory_reset_synchronized_powershell_repositories()
    if repositories and _command_path("pwsh") is None:
        raise ValueError("factory-reset could not locate PowerShell to remove synchronized repositories")
    return repositories


def _fsync_factory_reset_directory(path: Path) -> None:
    """Synchronize one directory after retained runtime state removal.

    Args:
        path: Directory whose removed entries must be durable.
    """
    if os.name != "posix":
        return
    descriptor = os.open(path, os.O_RDONLY)
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _reset_factory_retained_runtime() -> int:
    """Remove bounded KMIP and synchronized package-source runtime state."""
    if not _factory_reset_runtime_cleanup_is_admitted():
        print("factory-reset retained runtime cleanup requires an active applying marker", file=sys.stderr)
        return 2
    try:
        repositories = _factory_reset_retained_runtime_paths_are_safe()
        _cleanup_stale_photon_repository_views(force=True)
        managed_photon_repo_existed = MANAGED_PHOTON_REPO_PATH.is_file()
        result = _sync_appliance_update_sources({"source_definitions": []})
        if managed_photon_repo_existed and not MANAGED_PHOTON_REPO_PATH.exists():
            _fsync_factory_reset_directory(MANAGED_PHOTON_REPO_PATH.parent)
        if result.get("status") != "succeeded":
            print("factory-reset could not remove synchronized package-source runtime state", file=sys.stderr)
            return 1
        if MANAGED_PHOTON_REPO_PATH.exists():
            raise ValueError("factory-reset managed Photon repository cleanup did not complete")
        removed_kmip_entries = 0
        if KMS_STATE_DIR.is_dir():
            for child in KMS_STATE_DIR.iterdir():
                child.unlink()
                removed_kmip_entries += 1
            if removed_kmip_entries:
                _fsync_factory_reset_directory(KMS_STATE_DIR)
        if UPDATE_SOURCE_STATE_PATH.is_file():
            UPDATE_SOURCE_STATE_PATH.unlink()
            _fsync_factory_reset_directory(UPDATE_SOURCE_STATE_PATH.parent)
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    print(
        json.dumps(
            {
                "factory_reset_retained_runtime": "cleanup complete",
                "kmip_entries_removed": removed_kmip_entries,
                "powershell_repositories_removed": len(repositories),
            },
            sort_keys=True,
        )
    )
    return 0


def _apply_factory_reset_root_password() -> int:
    """Apply the admitted root password action without exposing its value."""
    if not _factory_reset_runtime_cleanup_is_admitted():
        print(
            "factory-reset root password action requires an active applying marker",
            file=sys.stderr,
        )
        return 2
    try:
        credentials = _read_durable_factory_reset_credentials()
    except (OSError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1
    if credentials["root_action"] == "change":
        result = _set_os_user_password("root", str(credentials["root_password"]))
        if result != 0:
            return result
    print(
        json.dumps(
            {"factory_reset_root_password": credentials["root_action"]},
            sort_keys=True,
        )
    )
    return 0


def _validate_management_handoff_manifest_path(path_value: str) -> Path:
    """Validate a staged management-handoff manifest path.

    Args:
        path_value: Candidate path value to validate.

    Returns:
        The validated manifest path.
    """
    path = Path(_validate_path(path_value)).resolve()
    if path.name != "atlaso-management-handoff.json" or not path.is_relative_to(MANAGEMENT_HANDOFF_APPLY_DIR):
        raise ValueError(f"management handoff manifest must be staged under {MANAGEMENT_HANDOFF_APPLY_DIR}")
    if not path.is_file():
        raise ValueError(f"management handoff manifest does not exist: {path}")
    return path


def _load_management_handoff_manifest(path: Path) -> dict:
    """Load and validate a management-handoff manifest.

    Args:
        path: Filesystem path read by the operation.

    Returns:
        The validated manifest payload.
    """
    payload = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(payload, dict) or int(payload.get("schema_version", 0)) != 1:
        raise ValueError("management handoff manifest schema_version must be 1")
    required = {
        "job_id",
        "network_config_path",
        "firewall_config_path",
        "appliance_settings_config_path",
        "public_services_config_path",
        "previous_management_interfaces",
        "previous_management_addresses",
    }
    missing = sorted(required.difference(payload))
    if missing:
        raise ValueError(f"management handoff manifest is missing: {', '.join(missing)}")
    if not re.fullmatch(r"job_[a-z0-9]{8,40}", str(payload["job_id"])):
        raise ValueError("management handoff job_id is invalid")
    for field, directory in (
        ("network_config_path", NETWORK_APPLY_DIR),
        ("firewall_config_path", FIREWALL_APPLY_DIR),
        ("appliance_settings_config_path", APPLIANCE_SETTINGS_APPLY_DIR),
        ("public_services_config_path", PUBLIC_SERVICES_APPLY_DIR),
    ):
        candidate = Path(_validate_path(str(payload[field]))).resolve()
        if not candidate.is_file() or not candidate.is_relative_to(directory):
            raise ValueError(f"management handoff {field} must name a staged file under {directory}")
        payload[field] = str(candidate)
    ca_value = str(payload.get("ca_config_path") or "")
    if ca_value:
        ca_path = Path(_validate_path(ca_value)).resolve()
        if not ca_path.is_file() or not ca_path.is_relative_to(CA_APPLY_DIR):
            raise ValueError(f"management handoff ca_config_path must name a staged file under {CA_APPLY_DIR}")
        payload["ca_config_path"] = str(ca_path)
    wan_value = str(payload.get("wan_config_path") or "")
    wan_rollback_value = str(payload.get("wan_rollback_config_path") or "")
    if bool(wan_value) != bool(wan_rollback_value):
        raise ValueError("management handoff WAN candidate and rollback paths must be supplied together")
    for field, value in (
        ("wan_config_path", wan_value),
        ("wan_rollback_config_path", wan_rollback_value),
    ):
        if not value:
            payload[field] = ""
            continue
        candidate = Path(_validate_path(value)).resolve()
        if candidate.suffix != ".conf" or not candidate.is_file() or not candidate.is_relative_to(WAN_APPLY_DIR):
            raise ValueError(f"management handoff {field} must name a staged WAN config under {WAN_APPLY_DIR}")
        payload[field] = str(candidate)
    payload.setdefault("previous_management_parent_interfaces", [])
    for field in (
        "previous_management_interfaces",
        "previous_management_parent_interfaces",
        "previous_management_addresses",
    ):
        values = payload[field]
        if not isinstance(values, list) or any(not isinstance(value, str) for value in values):
            raise ValueError(f"management handoff {field} must be a string list")
    previous_paths = payload.setdefault("previous_management_paths", [])
    if not isinstance(previous_paths, list) or len(previous_paths) > 256:
        raise ValueError("management handoff previous_management_paths must be a bounded list")
    normalized_previous_paths: list[dict[str, str]] = []
    for path in previous_paths:
        if not isinstance(path, dict):
            raise ValueError("management handoff previous_management_paths entries must be objects")
        name = str(path.get("name") or "")
        ipv4_method = str(path.get("ipv4_method") or "")
        ipv6_enabled = str(path.get("ipv6_enabled") or "").lower()
        ipv6_cidr = str(path.get("ipv6_cidr") or "")
        if not _valid_network_interface_name(name):
            raise ValueError("management handoff previous management interface is invalid")
        if ipv4_method not in {"", "static", "dhcp"}:
            raise ValueError("management handoff previous IPv4 method is invalid")
        if ipv6_enabled not in {"", "true", "false"}:
            raise ValueError("management handoff previous IPv6 state is invalid")
        if ipv6_cidr:
            parsed_ipv6 = ip_interface(ipv6_cidr)
            if parsed_ipv6.version != 6:
                raise ValueError("management handoff previous IPv6 CIDR is invalid")
        normalized_previous_paths.append(
            {
                "name": name,
                "ipv4_method": ipv4_method,
                "ipv6_enabled": ipv6_enabled,
                "ipv6_cidr": ipv6_cidr,
            }
        )
    payload["previous_management_paths"] = normalized_previous_paths
    previous_port = payload.get("previous_management_public_port")
    if previous_port is not None:
        try:
            previous_port = int(previous_port)
        except (TypeError, ValueError) as exc:
            raise ValueError("management handoff previous public port must be an integer") from exc
        if previous_port < 1 or previous_port > 65535:
            raise ValueError("management handoff previous public port must be between 1 and 65535")
        payload["previous_management_public_port"] = previous_port
    return payload


def _management_handoff_validation_errors(payload: dict) -> list[str]:
    """Return bounded validation failures for a handoff manifest.

    Args:
        payload: Validated handoff payload.

    Returns:
        The validation failures.
    """
    errors: list[str] = []
    network_path = Path(payload["network_config_path"])
    ca_path_value = str(payload.get("ca_config_path") or "")
    staged_ca_path = Path(ca_path_value) if ca_path_value else None
    errors.extend(f"network: {error}" for error in _network_config_errors(network_path))
    firewall_result = _validate_firewall_config(Path(payload["firewall_config_path"]))
    if firewall_result.returncode != 0:
        errors.append(f"firewall: {(firewall_result.stderr or firewall_result.stdout).strip()}")
    errors.extend(
        f"appliance settings: {error}"
        for error in _appliance_settings_config_errors(
            Path(payload["appliance_settings_config_path"]),
            staged_ca_path=staged_ca_path,
        )
    )
    errors.extend(
        f"public services: {error}"
        for error in _public_services_config_errors(
            Path(payload["public_services_config_path"]),
            staged_ca_path=staged_ca_path,
        )
    )
    if staged_ca_path is not None:
        errors.extend(f"certificate: {error}" for error in _ca_payload_errors(staged_ca_path))
    for label, field in (
        ("WAN candidate", "wan_config_path"),
        ("WAN rollback", "wan_rollback_config_path"),
    ):
        value = str(payload.get(field) or "")
        if not value:
            continue
        wan_path = Path(value)
        errors.extend(f"{label}: {error}" for error in _wan_config_errors(wan_path))
        parsed_wan = _parse_wan_config(wan_path)
        if _wan_feature_settings(parsed_wan)["effective_nat_enabled"]:
            nat_validation = _validate_wan_nat_config(_render_wan_nat_config(parsed_wan["nat_rules"]))
            if nat_validation.returncode != 0:
                errors.append(f"{label}: {(nat_validation.stderr or nat_validation.stdout).strip()}")
    return [error for error in errors if error]


def _management_handoff_certificate_paths(payload: dict) -> list[Path]:
    """Return CA-managed certificate artifacts touched by the handoff.

    Args:
        payload: Validated handoff payload.

    Returns:
        The certificate artifact paths.
    """
    ca_path = str(payload.get("ca_config_path") or "")
    if not ca_path:
        return []
    try:
        ca_payload = json.loads(Path(ca_path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []
    paths: list[Path] = []
    root = ca_payload.get("root") or {}
    if isinstance(root, dict):
        for key in ("root_cert_path", "legacy_root_cert_path", "ca_bundle_path", "crl_path"):
            value = str(root.get(key) or "")
            if value:
                paths.append(_ca_managed_path(value, key))
    for certificate in ca_payload.get("certificates", []):
        if not isinstance(certificate, dict):
            continue
        for key in ("cert_path", "key_path", "chain_path"):
            value = str(certificate.get(key) or "")
            if value:
                paths.append(_ca_managed_path(value, key))
    return paths


def _management_handoff_previous_certificate_paths() -> list[Path]:
    """Return certificate files referenced by the applied management site.

    Returns:
        The validated certificate and key paths used by the previous listener.
    """
    if not NGINX_MANAGEMENT_SITE_PATH.is_file():
        return []
    try:
        site_text = NGINX_MANAGEMENT_SITE_PATH.read_text(encoding="utf-8")
    except OSError:
        return []
    paths: list[Path] = []
    for directive, field in (
        ("ssl_certificate", "management_https_cert_path"),
        ("ssl_certificate_key", "management_https_key_path"),
    ):
        match = re.search(rf"(?m)^\s*{directive}\s+([^;]+);\s*$", site_text)
        if match is not None:
            paths.append(_ca_managed_path(match.group(1).strip(), field))
    return paths


def _management_handoff_runtime_paths(payload: dict) -> list[Path]:
    """Return runtime files that require exact rollback snapshots.

    Args:
        payload: Validated handoff payload.

    Returns:
        The runtime paths.
    """
    paths = [
        NETWORKD_MGMT_CONFIG_PATH,
        *sorted(NETWORKD_CONFIG_DIR.glob(f"{NETWORKD_MANAGED_PREFIX}*")),
        *[NETWORKD_CONFIG_DIR / name for name in sorted(NETWORKD_DEFAULT_APPLIANCE_FILES)],
        FIREWALL_CONFIG_PATH,
        FIREWALL_SERVICE_PATH,
        NGINX_MAIN_CONFIG_PATH,
        NGINX_CONF_INCLUDE_PATH,
        NGINX_MANAGEMENT_SITE_PATH,
        NGINX_PUBLIC_SERVICES_SITE_PATH,
        VCF_DEPOT_HTPASSWD_PATH,
        ATLASO_SERVICE_HTTPS_DROPIN_PATH,
        WAN_NAT_CONFIG_PATH,
        WAN_NAT_SERVICE_PATH,
        WAN_SYSCTL_PATH,
        WAN_RUNTIME_CONFIG_PATH,
        WAN_SERVICE_PATH,
        *_management_handoff_certificate_paths(payload),
        *_management_handoff_previous_certificate_paths(),
    ]
    unique: dict[str, Path] = {}
    for path in paths:
        unique[str(path)] = path
    return list(unique.values())


def _sync_management_handoff_candidate(state: dict, payload: dict) -> None:
    """Persist final candidate artifacts before application commit can be acknowledged.

    Args:
        state: Durable management-handoff transaction state.
        payload: Validated handoff payload used to derive final networkd files.
    """
    paths = {
        Path(str(item["path"]))
        for item in state.get("snapshots", [])
        if isinstance(item, dict) and item.get("path")
    }
    network_files, _reconfigure, _admin_down = _systemd_networkd_files(
        Path(str(payload["network_config_path"]))
    )
    paths.update(NETWORKD_CONFIG_DIR / filename for filename in network_files)
    directories: set[Path] = set()
    for path in sorted(paths, key=str):
        if path.is_file():
            _fsync_file(path)
        parent = path.parent
        while parent != parent.parent:
            if parent.is_dir():
                directories.add(parent)
            parent = parent.parent
    for directory in sorted(directories, key=lambda item: len(item.parts), reverse=True):
        _fsync_directory(directory)


def _management_handoff_candidate_links(payload: dict) -> tuple[list[str], list[str], dict[str, dict[str, object]]]:
    """Capture candidate link identity and pre-mutation administrative state.

    Args:
        payload: Validated handoff payload.

    Returns:
        Candidate physical links, VLAN links, and their pre-mutation state.
    """
    physical, vlans, _removed = _parse_network_config(Path(str(payload["network_config_path"])))
    physical_names = list(dict.fromkeys(str(row.get("name") or "") for row in physical if row.get("name")))
    vlan_names = list(dict.fromkeys(str(row.get("name") or "") for row in vlans if row.get("name")))
    link_states: dict[str, dict[str, object]] = {}
    for interface in [*physical_names, *vlan_names]:
        existed = _link_exists(interface)
        admin_up = False
        mtu: int | None = None
        if existed:
            result = _run(["ip", "-j", "link", "show", "dev", interface])
            if result.returncode != 0:
                raise ValueError(f"candidate link state could not be captured for {interface}")
            try:
                rows = json.loads(result.stdout)
            except json.JSONDecodeError as exc:
                raise ValueError(f"candidate link state was malformed for {interface}") from exc
            flags = rows[0].get("flags", []) if rows else []
            admin_up = "UP" in flags
            try:
                mtu = int(rows[0].get("mtu")) if rows else None
            except (TypeError, ValueError) as exc:
                raise ValueError(f"candidate link MTU was malformed for {interface}") from exc
            if mtu is None or mtu <= 0:
                raise ValueError(f"candidate link MTU could not be captured for {interface}")
        link_states[interface] = {"existed": existed, "admin_up": admin_up, "mtu": mtu}
    return physical_names, vlan_names, link_states


def _management_handoff_previous_addresses(payload: dict) -> list[str]:
    """Merge configured and runtime addresses for every previous listener interface.

    Args:
        payload: Validated management-handoff manifest.

    Returns:
        Deduplicated global addresses that comprise the previous management path.
    """
    previous_addresses = [str(ip_address(address)) for address in payload["previous_management_addresses"]]
    for interface in payload["previous_management_interfaces"]:
        result = _run(["ip", "-j", "address", "show", "dev", str(interface)])
        if result.returncode != 0:
            raise ValueError(f"previous management addresses could not be observed on {interface}")
        try:
            entries = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise ValueError(f"previous management addresses were malformed on {interface}") from exc
        if not isinstance(entries, list):
            raise ValueError(f"previous management addresses were malformed on {interface}")
        for entry in entries:
            for info in entry.get("addr_info", []):
                local = str(info.get("local") or "")
                if info.get("scope") == "global" and local:
                    previous_addresses.append(str(ip_address(local)))
    if not previous_addresses:
        raise ValueError("previous management listener addresses could not be captured")
    return list(dict.fromkeys(previous_addresses))


def _snapshot_management_handoff(payload: dict) -> dict:
    """Create the durable pre-mutation snapshot and interruption marker.

    Args:
        payload: Validated handoff payload.

    Returns:
        The durable transaction state.
    """
    if MANAGEMENT_HANDOFF_STATE_PATH.exists():
        raise ValueError("another management handoff requires recovery")
    state_dir_existed = MANAGEMENT_HANDOFF_STATE_DIR.is_dir()
    MANAGEMENT_HANDOFF_STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    if not state_dir_existed:
        _fsync_directory(MANAGEMENT_HANDOFF_STATE_DIR.parent)
    os.chmod(MANAGEMENT_HANDOFF_STATE_DIR, 0o700)
    shutil.rmtree(MANAGEMENT_HANDOFF_BACKUP_DIR, ignore_errors=True)
    MANAGEMENT_HANDOFF_BACKUP_DIR.mkdir(mode=0o700)
    snapshots: list[dict[str, object]] = []
    for index, path in enumerate(_management_handoff_runtime_paths(payload)):
        item: dict[str, object] = {"path": str(path), "existed": path.is_file()}
        if path.is_file():
            backup = MANAGEMENT_HANDOFF_BACKUP_DIR / f"{index:03d}.bin"
            shutil.copy2(path, backup)
            with backup.open("rb") as stream:
                os.fsync(stream.fileno())
            item["backup"] = str(backup)
            stat = path.stat()
            item["mode"] = stat.st_mode & 0o777
            item["uid"] = stat.st_uid
            item["gid"] = stat.st_gid
        snapshots.append(item)
    _fsync_directory(MANAGEMENT_HANDOFF_BACKUP_DIR)
    settings_payload = _load_appliance_settings_config(
        Path(str(payload["appliance_settings_config_path"]))
    )
    candidate_management_interface = str(settings_payload.get("management_interface") or "")
    if not _valid_network_interface_name(candidate_management_interface):
        raise ValueError("candidate management resolver interface is invalid")
    previous_addresses = _management_handoff_previous_addresses(payload)
    candidate_physical, candidate_vlans, candidate_link_states = _management_handoff_candidate_links(payload)
    previous_firewall_config_existed = FIREWALL_CONFIG_PATH.is_file()
    previous_firewall_service_existed = FIREWALL_SERVICE_PATH.is_file()
    if previous_firewall_config_existed != previous_firewall_service_existed:
        raise ValueError("previous firewall config and service state are incoherent")
    state = {
        "schema_version": 1,
        "job_id": payload["job_id"],
        "phase": "snapshotted",
        "snapshots": snapshots,
        "previous_management_interfaces": payload["previous_management_interfaces"],
        "previous_management_parent_interfaces": payload.get(
            "previous_management_parent_interfaces",
            [],
        ),
        "previous_management_addresses": list(dict.fromkeys(previous_addresses)),
        "previous_management_paths": list(payload.get("previous_management_paths") or []),
        "previous_https_enabled": bool(payload.get("previous_https_enabled", True)),
        "previous_management_public_port": int(
            payload.get("previous_management_public_port")
            or (443 if payload.get("previous_https_enabled", True) else 80)
        ),
        "candidate_physical_interfaces": candidate_physical,
        "candidate_vlan_interfaces": candidate_vlans,
        "candidate_link_states": candidate_link_states,
        "candidate_management_interface": candidate_management_interface,
        "resolver_apply_started": False,
        "previous_firewall_config_existed": previous_firewall_config_existed,
        "previous_firewall_service_existed": previous_firewall_service_existed,
        "wan_rollback_config_path": str(payload.get("wan_rollback_config_path") or ""),
    }
    _durable_management_handoff_state_write(state, MANAGEMENT_HANDOFF_STATE_PATH)
    MANAGEMENT_HANDOFF_COMMIT_PATH.unlink(missing_ok=True)
    return state


def _durable_management_handoff_state_write(state: dict, target: Path) -> None:
    """Write and sync a root-only transaction marker.

    Args:
        state: Durable transaction state.
        target: Final marker path.
    """
    temporary = target.with_suffix(f"{target.suffix}.tmp")
    with temporary.open("w", encoding="utf-8") as stream:
        json.dump(state, stream, indent=2, sort_keys=True)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(temporary, 0o600)
    temporary.replace(target)
    try:
        directory_fd = os.open(target.parent, os.O_RDONLY)
    except OSError:
        if os.name == "nt":
            return
        raise
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def _write_management_handoff_state(state: dict, phase: str) -> None:
    """Persist the current handoff phase atomically.

    Args:
        state: Durable transaction state.
        phase: New transaction phase.
    """
    state["phase"] = phase
    _durable_management_handoff_state_write(state, MANAGEMENT_HANDOFF_STATE_PATH)


def _networkd_handoff_text(previous: str, candidate: str) -> str:
    """Merge previous reachability values into a candidate networkd file.

    Args:
        previous: Previous networkd configuration.
        candidate: Candidate networkd configuration.

    Returns:
        A transitional configuration that carries old and candidate paths.
    """
    candidate_lines = candidate.rstrip().splitlines()
    previous_lines = previous.rstrip().splitlines()
    network_values = [
        line
        for line in previous_lines
        if re.match(r"^(Address|DHCP|DNS|Domains|IPv6AcceptRA|LinkLocalAddressing)=", line)
        and line not in candidate_lines
        and not (line == "IPv6AcceptRA=no" and "IPv6AcceptRA=yes" in candidate_lines)
        and not (line == "LinkLocalAddressing=no" and "LinkLocalAddressing=ipv6" in candidate_lines)
    ]
    next_section = next(
        (
            index
            for index, line in enumerate(candidate_lines)
            if index > candidate_lines.index("[Network]") and line.startswith("[")
        ),
        len(candidate_lines),
    )
    candidate_lines[next_section:next_section] = network_values
    previous_blocks: list[list[str]] = []
    index = 0
    while index < len(previous_lines):
        if previous_lines[index] not in {"[Route]", "[RoutingPolicyRule]"}:
            index += 1
            continue
        end = index + 1
        while end < len(previous_lines) and not previous_lines[end].startswith("["):
            end += 1
        previous_blocks.append(previous_lines[index:end])
        index = end
    candidate_text = "\n".join(candidate_lines)
    for block in previous_blocks:
        block_text = "\n".join(block).strip()
        if block_text and block_text not in candidate_text:
            candidate_lines.extend(["", *block])
            candidate_text = "\n".join(candidate_lines)
    return "\n".join(candidate_lines).rstrip() + "\n"


def _management_handoff_previous_link_interfaces(state: dict) -> set[str]:
    """Return prior listener and VLAN-parent links retained for rollback.

    Args:
        state: Durable management-handoff transaction state.

    Returns:
        Interfaces whose network state must survive candidate readiness.
    """
    return {
        str(value)
        for field in ("previous_management_interfaces", "previous_management_parent_interfaces")
        for value in state.get(field, [])
        if value
    }


def _install_management_holdovers(state: dict, payload: dict) -> list[Path]:
    """Install higher-priority copies of the previous management network files.

    Args:
        state: Durable transaction state.
        payload: Validated handoff payload.

    Returns:
        The installed holdover files.
    """
    previous_interfaces = _management_handoff_previous_link_interfaces(state)
    candidate_files, _reconfigure, _admin_down = _systemd_networkd_files(Path(payload["network_config_path"]))
    candidate_by_interface: dict[str, str] = {}
    for content in candidate_files.values():
        match = re.search(r"(?m)^Name=(\S+)\s*$", content)
        if match is not None:
            candidate_by_interface[match.group(1)] = content
    installed: list[Path] = []
    for item in state.get("snapshots", []):
        backup_value = str(item.get("backup") or "")
        if not backup_value or not str(item.get("path") or "").endswith(".network"):
            continue
        previous_text = Path(backup_value).read_text(encoding="utf-8")
        match = re.search(r"(?m)^Name=(\S+)\s*$", previous_text)
        if match is None or match.group(1) not in previous_interfaces:
            continue
        text = previous_text
        if match.group(1) in candidate_by_interface:
            text = _networkd_handoff_text(previous_text, candidate_by_interface[match.group(1)])
        target = NETWORKD_CONFIG_DIR / f"{MANAGEMENT_HANDOFF_HOLDOVER_PREFIX}{len(installed):02d}.network"
        target.write_text(text, encoding="utf-8")
        os.chmod(target, 0o644)
        installed.append(target)
    if previous_interfaces and not installed:
        raise ValueError("previous management networkd configuration could not be preserved")
    return installed


def _apply_management_candidate_network(path: Path, state: dict) -> None:
    """Activate candidate paths without retiring previous management paths.

    Args:
        path: Candidate staged network configuration.
        state: Durable transaction state.
    """
    previous_interfaces = _management_handoff_previous_link_interfaces(state)
    install_result, _installed, _reconfigure, _admin_down = _install_systemd_networkd_files(
        path,
        defer_down_links=previous_interfaces,
    )
    if install_result != 0:
        raise ValueError("candidate systemd-networkd file installation failed")
    if _apply_vlan_interfaces(
        path,
        preserve_address_links=previous_interfaces,
        defer_removed=True,
    ) != 0:
        raise ValueError("candidate VLAN activation failed")
    physical, _vlans, _removed = _parse_network_config(path)
    candidate_interfaces = {
        str(row.get("name") or "")
        for row in physical
        if row.get("role") == "management"
        or (
            row.get("role") == "access"
            and row.get("mode") == "access"
            and row.get("admin_state") == "up"
            and row.get("access_management_ui_enabled", "false").lower() == "true"
        )
    }
    for interface in sorted(candidate_interfaces | previous_interfaces):
        if not interface or not _link_exists(interface):
            continue
        result = _run(["networkctl", "reconfigure", interface])
        if result.returncode != 0:
            raise ValueError(f"candidate networkd reconfigure failed for {interface}")


def _management_handoff_candidate_firewall_rules(
    network_path: Path,
    public_port: int,
    candidate_firewall: str,
) -> list[str]:
    """Return minimal candidate-listener admission rules for a transition.

    Args:
        network_path: Candidate staged network configuration.
        public_port: Candidate management HTTP or HTTPS front-door port.
        candidate_firewall: Candidate nftables configuration.

    Returns:
        Nftables input rules for effective candidate management listeners.
    """
    if public_port < 1 or public_port > 65535:
        raise ValueError("candidate management firewall port must be between 1 and 65535")
    physical, vlans, _removed = _parse_network_config(network_path)
    management_ports = ", ".join(str(port) for port in sorted({22, 80, 443, public_port}))
    candidate_disabled = "Atlaso firewall desired state is disabled" in candidate_firewall
    target_rules: list[tuple[str, str, str]] = []
    for row in physical:
        name = str(row.get("name") or "")
        if row.get("role") == "management":
            target_rules.append((name, "mgmt-console", management_ports))
        elif (
            row.get("role") == "access"
            and row.get("mode") == "access"
            and row.get("admin_state") == "up"
            and row.get("access_management_ui_enabled", "false").lower() == "true"
        ):
            target_rules.append((name, f"management-ui-{name}", management_ports))
    for row in vlans:
        name = str(row.get("name") or "")
        if (
            row.get("role") == "access"
            and row.get("access_management_ui_enabled", "false").lower() == "true"
        ):
            target_rules.append((name, f"management-ui-{name}", management_ports))

    rules: list[str] = []
    for name, marker, ports in target_rules:
        if candidate_disabled:
            rules.append(
                f'    iifname "{name}" tcp dport {{ {ports} }} accept comment "{marker}"'
            )
            continue
        candidate_lines = [
            line
            for line in candidate_firewall.splitlines()
            if " accept " in f" {line} "
            and (
                f'comment "{marker}"' in line
                or (marker == "mgmt-console" and 'comment "Atlaso management access"' in line)
            )
        ]
        for line in candidate_lines:
            match = re.search(r"\btcp dport (?:\{[^}]+\}|\d+(?:-\d+)?)", line)
            if match is None:
                continue
            port_expression = match.group(0).removeprefix("tcp dport ")
            port_tokens = [token.strip() for token in port_expression.strip("{} ").split(",")]
            port_is_present = any(
                token.isdigit() and int(token) == public_port
                or "-" in token
                and all(part.strip().isdigit() for part in token.split("-", 1))
                and int(token.split("-", 1)[0]) <= public_port <= int(token.split("-", 1)[1])
                for token in port_tokens
            )
            if not port_is_present:
                rules.append(f"{line[:match.start()]}tcp dport {public_port}{line[match.end():]}")
    return rules


def _management_handoff_firewall_text(
    candidate: str,
    previous: str,
    *,
    candidate_management_rules: list[str] | None = None,
) -> str:
    """Add the previous management accept rules to the candidate firewall.

    Args:
        candidate: Candidate nftables configuration.
        previous: Previous applied nftables configuration.
        candidate_management_rules: Minimal candidate admission rules.

    Returns:
        The transitional nftables configuration.
    """
    previous_rules = [
        line
        for line in previous.splitlines()
        if " accept " in f" {line} "
        and any(
            marker in line
            for marker in (
                'comment "mgmt-console"',
                'comment "management-ui-',
                "Management console",
                "Management UI",
                "Atlaso management access",
            )
        )
    ]
    candidate_disabled = "Atlaso firewall desired state is disabled" in candidate
    previous_filtered = "chain input {" in previous
    if not previous_filtered:
        if previous.strip():
            return previous
        return (
            "flush ruleset\n"
            "# Atlaso management handoff preserves the previous open firewall policy.\n"
        )
    base = previous if candidate_disabled else candidate
    desired_rules = previous_rules + list(candidate_management_rules or [])
    additions = [line for line in desired_rules if line not in base]
    if not additions:
        return base
    lines = base.splitlines()
    insert_at = next((index + 1 for index, line in enumerate(lines) if line.strip() == "chain input {"), 0)
    if not insert_at:
        raise ValueError("candidate firewall has no input chain for management holdover")
    while insert_at < len(lines) and lines[insert_at].strip().startswith("type "):
        insert_at += 1
    lines[insert_at:insert_at] = additions
    return "\n".join(lines) + "\n"


def _management_handoff_addresses(
    network_path: Path,
    *,
    previous_addresses: set[str] | None = None,
    previous_dynamic_families: set[tuple[str, str]] | None = None,
    discovery_attempts: int = 45,
) -> list[str]:
    """Return configured candidate management listener addresses.

    Args:
        network_path: Candidate staged network configuration.
        previous_addresses: Addresses retained only for the old-path transition.
        previous_dynamic_families: Interface/address families that were already dynamic.
        discovery_attempts: Bounded runtime-address discovery attempts.

    Returns:
        The configured address list.
    """
    physical, vlans, _removed = _parse_network_config(network_path)
    rows = [
        row for row in physical
        if row.get("role") == "management"
        or (
            row.get("role") == "access"
            and row.get("mode") == "access"
            and row.get("admin_state") == "up"
            and row.get("access_management_ui_enabled", "false").lower() == "true"
        )
    ]
    rows.extend(
        row for row in vlans
        if row.get("role") == "access"
        and row.get("access_management_ui_enabled", "false").lower() == "true"
    )
    addresses: list[str] = []
    previous_addresses = {
        str(ip_address(address)) for address in (previous_addresses or set())
    }
    previous_dynamic_families = previous_dynamic_families or set()
    dynamic_requirements: list[tuple[str, set[str]]] = []
    for row in rows:
        for key in ("ip_cidr", "ipv6_cidr"):
            value = str(row.get(key) or "")
            if value:
                addresses.append(str(ip_interface(value).ip))
        needs_runtime_ipv4 = row.get("ipv4_method") == "dhcp"
        needs_runtime_ipv6 = (
            str(row.get("ipv6_enabled", "false")).lower() == "true"
            and not str(row.get("ipv6_cidr") or "")
        )
        required_families = set()
        if needs_runtime_ipv4:
            required_families.add("inet")
        if needs_runtime_ipv6:
            required_families.add("inet6")
        if required_families:
            dynamic_requirements.append((str(row.get("name") or ""), required_families))
    discovered: dict[tuple[str, str], list[str]] = {}
    for attempt in range(max(1, discovery_attempts)):
        for interface, families in dynamic_requirements:
            if all(discovered.get((interface, family)) for family in families):
                continue
            result = _run(["ip", "-j", "address", "show", "dev", interface])
            if result.returncode != 0:
                continue
            try:
                entries = json.loads(result.stdout)
            except json.JSONDecodeError:
                continue
            for entry in entries:
                for info in entry.get("addr_info", []):
                    local = str(info.get("local") or "")
                    family = str(info.get("family") or "")
                    if info.get("scope") != "global" or not local or family not in families:
                        continue
                    try:
                        normalized = str(ip_address(local))
                    except ValueError:
                        continue
                    if (
                        normalized in previous_addresses
                        and (interface, family) not in previous_dynamic_families
                    ):
                        continue
                    discovered.setdefault((interface, family), []).append(normalized)
        if all(
            discovered.get((interface, family))
            for interface, families in dynamic_requirements
            for family in families
        ):
            break
        if attempt + 1 < max(1, discovery_attempts):
            time.sleep(1)
    missing = [
        f"{interface} {'DHCP IPv4' if family == 'inet' else 'SLAAC IPv6'}"
        for interface, families in dynamic_requirements
        for family in sorted(families)
        if not discovered.get((interface, family))
    ]
    if missing:
        raise ValueError(
            "candidate runtime address was not acquired for " + ", ".join(missing)
        )
    for runtime_addresses in discovered.values():
        addresses.extend(runtime_addresses)
    return list(dict.fromkeys(addresses))


def _management_handoff_readiness(
    addresses: list[str],
    https_enabled: bool,
    public_port: int,
    *,
    samples: int = 3,
    upstream_host: str = "127.0.0.1",
    upstream_port: int = 8000,
) -> dict:
    """Require stable loopback and direct-address management readiness.

    Args:
        addresses: Management listener addresses to probe.
        https_enabled: Whether the applied management front door uses HTTPS.
        public_port: Configured host-facing management listener port.
        samples: Required consecutive successful samples.
        upstream_host: Atlaso application endpoint host behind nginx.
        upstream_port: Atlaso application endpoint port behind nginx.

    Returns:
        Bounded readiness evidence.
    """
    curl = shutil.which("curl")
    if curl is None:
        raise ValueError("curl is not installed for management handoff readiness")
    if not addresses:
        raise ValueError("management handoff has no candidate listener address")
    if public_port < 1 or public_port > 65535:
        raise ValueError("management handoff readiness port must be between 1 and 65535")
    deadline = time.monotonic() + 45
    consecutive = 0
    statuses: dict[str, str] = {}
    upstream_address = f"[{upstream_host}]" if ":" in upstream_host else upstream_host
    while time.monotonic() < deadline:
        statuses = {
            "Atlaso application loopback": _console_management_http_status(
                curl,
                f"http://{upstream_address}:{upstream_port}/openapi.json",
            )
        }
        for address in addresses:
            host = f"[{address}]" if ":" in address else address
            scheme = "https" if https_enabled else "http"
            statuses[f"management {address}"] = _console_management_http_status(
                curl,
                f"{scheme}://{host}:{public_port}/openapi.json",
                insecure=https_enabled,
            )
        if all(status == "200" for status in statuses.values()):
            consecutive += 1
            if consecutive >= samples:
                return {"statuses": statuses, "stable_samples": consecutive}
        else:
            consecutive = 0
        time.sleep(1)
    summary = ", ".join(f"{label}={status}" for label, status in statuses.items())
    raise ValueError(f"management readiness did not stabilize ({summary})")


def _management_handoff_upstream_readiness(
    *,
    samples: int = 3,
    upstream_host: str = "127.0.0.1",
    upstream_port: int = 8000,
) -> dict:
    """Require stable Atlaso loopback readiness before nginx activation.

    Args:
        samples: Required consecutive successful samples.
        upstream_host: Atlaso application endpoint host behind nginx.
        upstream_port: Atlaso application endpoint port behind nginx.

    Returns:
        Bounded upstream readiness evidence.
    """
    curl = shutil.which("curl")
    if curl is None:
        raise ValueError("curl is not installed for Atlaso upstream readiness")
    deadline = time.monotonic() + 45
    consecutive = 0
    status = "not-probed"
    upstream_address = f"[{upstream_host}]" if ":" in upstream_host else upstream_host
    upstream_url = f"http://{upstream_address}:{upstream_port}/openapi.json"
    while time.monotonic() < deadline:
        status = _console_management_http_status(curl, upstream_url)
        if status == "200":
            consecutive += 1
            if consecutive >= samples:
                return {"status": status, "stable_samples": consecutive}
        else:
            consecutive = 0
        time.sleep(1)
    raise ValueError(f"Atlaso loopback upstream did not stabilize (status={status})")


def _management_handoff_snapshot_text(state: dict, runtime_path: Path) -> str:
    """Return snapshotted text for one runtime path.

    Args:
        state: Durable transaction state.
        runtime_path: Runtime file whose pre-mutation text is required.

    Returns:
        The captured text, or an empty string when the file did not exist.
    """
    for item in state.get("snapshots", []):
        if str(item.get("path") or "") != str(runtime_path):
            continue
        backup = str(item.get("backup") or "")
        return Path(backup).read_text(encoding="utf-8") if backup else ""
    return ""


def _management_handoff_snapshot_backup_path(state: dict, runtime_path: Path) -> Path:
    """Return the durable backup for one snapshotted runtime file.

    Args:
        state: Durable transaction state.
        runtime_path: Runtime file whose pre-mutation bytes are required.

    Returns:
        The separate backup path retained for the transaction.

    Raises:
        ValueError: If the runtime file was not captured with backup bytes.
    """
    for item in state.get("snapshots", []):
        if str(item.get("path") or "") != str(runtime_path):
            continue
        backup = Path(str(item.get("backup") or ""))
        if bool(item.get("existed")) and backup.is_file():
            return backup
        break
    raise ValueError(f"previous management TLS artifact was not captured: {runtime_path}")


def _management_handoff_protocol_holdover(state: dict, payload: dict) -> str:
    """Render address-specific previous listeners during a handoff.

    Args:
        state: Durable transaction state containing the old listener contract.
        payload: Candidate Appliance Settings payload.

    Returns:
        Transitional nginx server blocks, or an empty string when no holdover is required.
    """
    previous_https = bool(state.get("previous_https_enabled", True))
    candidate_https = bool(payload.get("management_https_enabled"))
    public_port = int(state.get("previous_management_public_port") or (443 if previous_https else 80))
    candidate_port = int(
        payload.get("management_public_https_port" if candidate_https else "management_public_http_port")
        or (443 if candidate_https else 80)
    )
    if not previous_https and not candidate_https and public_port == candidate_port:
        return ""
    upstream_host = str(payload.get("management_upstream_host") or "127.0.0.1")
    upstream_port = int(payload.get("management_upstream_port") or payload.get("management_http_port") or 8000)
    certificate_lines: list[str] = []
    if previous_https:
        previous_site = _management_handoff_snapshot_text(state, NGINX_MANAGEMENT_SITE_PATH)
        cert = re.search(r"(?m)^\s*ssl_certificate\s+([^;]+);\s*$", previous_site)
        key = re.search(r"(?m)^\s*ssl_certificate_key\s+([^;]+);\s*$", previous_site)
        if cert is None or key is None:
            raise ValueError("previous HTTPS listener certificate paths could not be preserved")
        previous_cert_path = _ca_managed_path(cert.group(1).strip(), "management_https_cert_path")
        previous_key_path = _ca_managed_path(key.group(1).strip(), "management_https_key_path")
        holdover_cert_path = _management_handoff_snapshot_backup_path(state, previous_cert_path)
        holdover_key_path = _management_handoff_snapshot_backup_path(state, previous_key_path)
        certificate_lines = [
            f"  ssl_certificate {holdover_cert_path};",
            f"  ssl_certificate_key {holdover_key_path};",
        ]
    blocks: list[str] = []
    for address in state.get("previous_management_addresses", []):
        parsed = ip_address(str(address))
        listen_address = f"[{parsed}]" if parsed.version == 6 else str(parsed)
        ssl = " ssl" if previous_https else ""
        blocks.extend(
            [
                "server {",
                f"  listen {listen_address}:{public_port}{ssl} bind;",
                "  server_name _;",
                *certificate_lines,
                *_management_proxy_location(
                    upstream_host,
                    upstream_port,
                    "https" if previous_https else "http",
                ),
                "}",
                "",
            ]
        )
    if not blocks:
        raise ValueError("previous listener addresses are unavailable for protocol preservation")
    return "\n".join(blocks)


def _management_handoff_vlan_parents(vlan_interfaces: set[str]) -> set[str]:
    """Return restored physical parents that declare the supplied VLAN links.

    Args:
        vlan_interfaces: VLAN interface names requiring recreation or reconfiguration.

    Returns:
        Physical parent interface names found in restored networkd configuration.
    """
    parents: set[str] = set()
    for path in NETWORKD_CONFIG_DIR.glob("*.network"):
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        match = re.search(r"(?m)^Name=(\S+)\s*$", text)
        if match is None:
            continue
        declared_vlans = set(re.findall(r"(?m)^VLAN=(\S+)\s*$", text))
        if declared_vlans.intersection(vlan_interfaces):
            parents.add(match.group(1))
    return parents


def _restore_management_handoff_links(state: dict, commands: list[dict[str, object]]) -> None:
    """Reconfigure restored links and remove candidate-only VLAN devices.

    Args:
        state: Durable transaction state.
        commands: Bounded rollback command evidence to extend.
    """
    previous_interfaces = _management_handoff_previous_link_interfaces(state)
    candidate_physical = set(str(value) for value in state.get("candidate_physical_interfaces", []))
    candidate_vlans = set(str(value) for value in state.get("candidate_vlan_interfaces", []))
    raw_link_states = state.get("candidate_link_states") or {}
    link_states = raw_link_states if isinstance(raw_link_states, dict) else {}
    vlan_parents = _management_handoff_vlan_parents(candidate_vlans | previous_interfaces)
    errors: list[str] = []

    # Reconfiguring restored physical parents first recreates any previous VLAN
    # that the final candidate apply may already have retired.
    for interface in sorted(candidate_physical | vlan_parents):
        if not interface or not _link_exists(interface):
            continue
        result = _run(["networkctl", "reconfigure", interface])
        commands.append({"stage": "network rollback", "interface": interface, "returncode": result.returncode})
        if result.returncode != 0:
            errors.append(f"candidate parent {interface} reconfigure failed")

    for interface in sorted(candidate_vlans):
        saved = link_states.get(interface) if isinstance(link_states.get(interface), dict) else {}
        if bool(saved.get("existed")) or not _link_exists(interface):
            continue
        result = _run(["ip", "link", "delete", "dev", interface])
        commands.append({"stage": "network rollback", "interface": interface, "delete": result.returncode})
        if result.returncode != 0:
            errors.append(f"candidate VLAN {interface} removal failed")

    restored_interfaces = previous_interfaces | {
        interface
        for interface in candidate_vlans
        if bool((link_states.get(interface) or {}).get("existed"))
    }
    for interface in sorted(restored_interfaces):
        for _attempt in range(10):
            if _link_exists(interface):
                break
            time.sleep(0.5)
        if not _link_exists(interface):
            errors.append(f"restored link {interface} is missing")
            continue
        saved = link_states.get(interface) if isinstance(link_states.get(interface), dict) else {}
        saved_mtu = saved.get("mtu")
        if interface in candidate_vlans and bool(saved.get("existed")) and saved_mtu is not None:
            if not isinstance(saved_mtu, int) or saved_mtu <= 0:
                errors.append(f"restored link {interface} MTU evidence is invalid")
            else:
                mtu_result = _run(["ip", "link", "set", "dev", interface, "mtu", str(saved_mtu)])
                commands.append(
                    {
                        "stage": "network rollback",
                        "interface": interface,
                        "mtu": saved_mtu,
                        "returncode": mtu_result.returncode,
                    }
                )
                if mtu_result.returncode != 0:
                    errors.append(f"restored link {interface} MTU restore failed")
        if interface in previous_interfaces:
            link_up = _run(["ip", "link", "set", "dev", interface, "up"])
            commands.append({"stage": "network rollback", "interface": interface, "link_up": link_up.returncode})
            if link_up.returncode != 0:
                errors.append(f"restored link {interface} activation failed")
        result = _run(["networkctl", "reconfigure", interface])
        commands.append({"stage": "network rollback", "interface": interface, "returncode": result.returncode})
        if result.returncode != 0:
            errors.append(f"restored link {interface} reconfigure failed")

    # A candidate physical or pre-existing VLAN may have been administratively
    # raised only for the handoff. Restore its pre-mutation state last so parent
    # reconfiguration can first recreate the old management topology.
    for interface in sorted(candidate_physical | candidate_vlans):
        if interface in previous_interfaces or not _link_exists(interface):
            continue
        saved = link_states.get(interface) if isinstance(link_states.get(interface), dict) else {}
        if not bool(saved.get("existed")):
            continue
        desired = "up" if bool(saved.get("admin_up")) else "down"
        result = _run(["ip", "link", "set", "dev", interface, desired])
        commands.append({"stage": "network rollback", "interface": interface, "admin_state": desired, "returncode": result.returncode})
        if result.returncode != 0:
            errors.append(f"candidate link {interface} administrative restore failed")
    if errors:
        bounded = errors[:8]
        if len(errors) > len(bounded):
            bounded.append(f"{len(errors) - len(bounded)} additional link rollback errors")
        raise ValueError("network link rollback incomplete: " + "; ".join(bounded))


def _restore_management_handoff_resolver(state: dict, commands: list[dict[str, object]]) -> None:
    """Clear a candidate resolver override before restored links reconfigure.

    Args:
        state: Durable transaction state.
        commands: Bounded rollback command evidence to extend.
    """
    if not bool(state.get("resolver_apply_started")):
        return
    resolver_interface = str(state.get("candidate_management_interface") or "")
    if not _valid_network_interface_name(resolver_interface):
        raise ValueError("resolver rollback interface is invalid")
    result = _run(["resolvectl", "revert", resolver_interface])
    commands.append(
        {
            "stage": "resolver rollback",
            "interface": resolver_interface,
            "returncode": result.returncode,
        }
    )
    if result.returncode != 0:
        raise ValueError("resolver rollback failed")


def _quiesce_management_handoff_firewall(
    state: dict,
    commands: list[dict[str, object]],
) -> None:
    """Stop a candidate firewall service absent from the previous state.

    Args:
        state: Durable transaction state.
        commands: Bounded rollback command evidence to extend.
    """
    previous_service_existed = state.get("previous_firewall_service_existed")
    if previous_service_existed is None:
        previous_service_existed = _management_handoff_previous_firewall_config_existed(state)
    if bool(previous_service_existed) or not FIREWALL_SERVICE_PATH.is_file():
        return
    result = _run(["systemctl", "disable", "--now", "atlaso-firewall.service"])
    commands.append(
        {
            "stage": "firewall service rollback",
            "returncode": result.returncode,
        }
    )
    if result.returncode != 0:
        raise ValueError("firewall service rollback failed")


def _restore_management_handoff_firewall(
    state: dict,
    commands: list[dict[str, object]],
) -> None:
    """Restore the previous filtered or explicitly open nftables state.

    Args:
        state: Durable transaction state.
        commands: Bounded rollback command evidence to extend.
    """
    if _management_handoff_previous_firewall_config_existed(state):
        if not FIREWALL_CONFIG_PATH.is_file():
            raise ValueError("firewall rollback config is missing")
        command = ["nft", "-f", str(FIREWALL_CONFIG_PATH)]
    else:
        command = ["nft", "flush", "ruleset"]
    result = _run(command)
    commands.append(
        {
            "stage": "firewall rollback",
            "command": command,
            "returncode": result.returncode,
        }
    )
    if result.returncode != 0:
        raise ValueError("firewall rollback failed")


def _management_handoff_previous_firewall_config_existed(state: dict) -> bool:
    """Return prior firewall presence, including legacy transaction markers.

    Args:
        state: Durable transaction state.

    Returns:
        Whether the previous Atlaso firewall config existed.
    """
    if "previous_firewall_config_existed" in state:
        return bool(state["previous_firewall_config_existed"])
    for item in state.get("snapshots", []):
        if str(item.get("path") or "") == str(FIREWALL_CONFIG_PATH):
            return bool(item.get("existed"))
    raise ValueError("previous firewall snapshot state is missing")


def _durable_management_handoff_unlink(path: Path) -> None:
    """Remove one rollback-owned path and persist its directory entry.

    Args:
        path: Runtime path that must remain absent after a power loss.
    """
    existed = path.exists() or path.is_symlink()
    path.unlink(missing_ok=True)
    if existed:
        _fsync_directory(path.parent)


def _restore_management_handoff_snapshot(item: dict) -> None:
    """Restore one snapshot and persist its bytes and directory entry.

    Args:
        item: Captured runtime artifact metadata.
    """
    path = Path(str(item["path"]))
    if not bool(item.get("existed")):
        _durable_management_handoff_unlink(path)
        return
    missing_parents: list[Path] = []
    parent = path.parent
    while not parent.exists():
        missing_parents.append(parent)
        if parent.parent == parent:
            break
        parent = parent.parent
    path.parent.mkdir(parents=True, exist_ok=True)
    for created_parent in reversed(missing_parents):
        _fsync_directory(created_parent.parent)
    temporary = path.with_name(f".{path.name}.atlaso-rollback")
    try:
        shutil.copy2(Path(str(item["backup"])), temporary)
        os.chmod(temporary, int(item.get("mode", 0o600)))
        os.chown(temporary, int(item.get("uid", 0)), int(item.get("gid", 0)))
        _fsync_file(temporary)
        temporary.replace(path)
        _fsync_directory(path.parent)
    finally:
        temporary.unlink(missing_ok=True)


def _apply_management_handoff_wan(payload: dict) -> None:
    """Apply the candidate Routes & WAN config when it joined the handoff.

    Args:
        payload: Validated management-handoff manifest.
    """
    wan_path = str(payload.get("wan_config_path") or "")
    if wan_path and _handle_wan("apply", [wan_path]) != 0:
        raise ValueError("candidate Routes & WAN apply failed")


def _restore_management_handoff_wan(state: dict, commands: list[dict[str, object]]) -> None:
    """Restore the last-applied Routes & WAN runtime when it joined the handoff.

    Args:
        state: Durable management-handoff transaction state.
        commands: Bounded rollback evidence populated by the operation.
    """
    rollback_path = str(state.get("wan_rollback_config_path") or "")
    if not rollback_path:
        return
    result = _handle_wan("apply", [rollback_path])
    commands.append(
        {
            "stage": "WAN rollback",
            "command": ["atlaso-helper", "wan", "apply", rollback_path],
            "returncode": result,
        }
    )
    if result != 0:
        raise ValueError("Routes & WAN rollback failed")


def _restore_management_handoff(state: dict) -> dict:
    """Restore every snapshotted management runtime artifact.

    Args:
        state: Durable transaction state.

    Returns:
        Bounded rollback evidence.
    """
    commands: list[dict[str, object]] = []
    errors: list[str] = []

    def attempt(stage: str, operation: Callable[[], None]) -> None:
        """Run one rollback stage without preventing later restoration work.

        Args:
            stage: Bounded rollback layer name used in failure evidence.
            operation: Restore operation to attempt.
        """
        try:
            operation()
        except (KeyError, OSError, TypeError, ValueError, json.JSONDecodeError, shutil.Error) as exc:
            errors.append(f"{stage}: {type(exc).__name__}")

    attempt(
        "firewall service quiesce",
        lambda: _quiesce_management_handoff_firewall(state, commands),
    )
    for path in NETWORKD_CONFIG_DIR.glob(f"{MANAGEMENT_HANDOFF_HOLDOVER_PREFIX}*.network"):
        attempt(
            "network holdover removal",
            lambda path=path: _durable_management_handoff_unlink(path),
        )
    current_managed = [NETWORKD_MGMT_CONFIG_PATH, *NETWORKD_CONFIG_DIR.glob(f"{NETWORKD_MANAGED_PREFIX}*")]
    for path in current_managed:
        if path.is_file():
            attempt(
                "candidate network removal",
                lambda path=path: _durable_management_handoff_unlink(path),
            )
    for index, item in enumerate(state.get("snapshots", [])):
        attempt(
            f"snapshot {index} restore",
            lambda item=item: _restore_management_handoff_snapshot(item),
        )
    for command in (["networkctl", "reload"], ["systemctl", "daemon-reload"]):
        def run_reload(command: list[str] = command) -> None:
            """Run one required rollback reload command.

            Args:
                command: Reload command and arguments.
            """
            result = _run(command)
            commands.append({"stage": "rollback", "command": command, "returncode": result.returncode})
            if result.returncode != 0:
                raise ValueError(f"rollback command failed: {' '.join(command)}")

        attempt(f"{' '.join(command)}", run_reload)
    attempt("resolver restore", lambda: _restore_management_handoff_resolver(state, commands))
    attempt("network link restore", lambda: _restore_management_handoff_links(state, commands))

    attempt(
        "Routes & WAN rollback",
        lambda: _restore_management_handoff_wan(state, commands),
    )
    attempt("firewall restore", lambda: _restore_management_handoff_firewall(state, commands))

    def validate_nginx() -> None:
        if _nginx_binary() is None or _nginx_test_command().returncode != 0:
            raise ValueError("nginx rollback validation failed")

    attempt("nginx validation", validate_nginx)
    for command in (["systemctl", "start", "atlaso.service"], ["systemctl", "reload-or-restart", "nginx.service"]):
        def run_service(command: list[str] = command) -> None:
            """Run one required rollback service command.

            Args:
                command: Service command and arguments.
            """
            result = _run(command)
            commands.append({"stage": "service rollback", "command": command, "returncode": result.returncode})
            if result.returncode != 0:
                raise ValueError(f"service rollback failed: {' '.join(command)}")

        attempt(f"{' '.join(command)}", run_service)
    readiness: dict[str, object] = {}

    def check_readiness() -> None:
        nonlocal readiness
        readiness = _management_handoff_readiness(
            list(state.get("previous_management_addresses") or []),
            bool(state.get("previous_https_enabled", True)),
            int(
                state.get("previous_management_public_port")
                or (443 if state.get("previous_https_enabled", True) else 80)
            ),
        )

    attempt("old-path readiness", check_readiness)
    if errors:
        bounded = errors[:8]
        if len(errors) > len(bounded):
            bounded.append(f"{len(errors) - len(bounded)} additional rollback errors")
        raise ValueError("rollback incomplete: " + "; ".join(bounded))
    return {"commands": commands, "readiness": readiness}


def _clear_management_handoff_state(*, keep_commit_receipt: bool = False) -> None:
    """Remove rollback state while optionally retaining an idempotent commit receipt.

    Args:
        keep_commit_receipt: Whether the last acknowledged job receipt remains durable.
    """
    state_dir_exists = MANAGEMENT_HANDOFF_STATE_DIR.is_dir()
    MANAGEMENT_HANDOFF_STATE_PATH.unlink(missing_ok=True)
    if state_dir_exists:
        _fsync_directory(MANAGEMENT_HANDOFF_STATE_DIR)
    if MANAGEMENT_HANDOFF_BACKUP_DIR.is_dir():
        shutil.rmtree(MANAGEMENT_HANDOFF_BACKUP_DIR)
    if not keep_commit_receipt:
        MANAGEMENT_HANDOFF_COMMIT_PATH.unlink(missing_ok=True)
    if MANAGEMENT_HANDOFF_STATE_DIR.is_dir():
        _fsync_directory(MANAGEMENT_HANDOFF_STATE_DIR)
    networkd_changed = False
    for path in NETWORKD_CONFIG_DIR.glob(f"{MANAGEMENT_HANDOFF_HOLDOVER_PREFIX}*.network"):
        path.unlink(missing_ok=True)
        networkd_changed = True
    if networkd_changed:
        _fsync_directory(NETWORKD_CONFIG_DIR)
    state_dir_removed = False
    try:
        MANAGEMENT_HANDOFF_STATE_DIR.rmdir()
        state_dir_removed = True
    except OSError:
        pass
    if state_dir_removed:
        _fsync_directory(MANAGEMENT_HANDOFF_STATE_DIR.parent)


def _acknowledge_management_handoff(job_id: str) -> int:
    """Commit a candidate only after Atlaso durably records its baselines.

    Args:
        job_id: Appliance Apply task that owns the durable transaction.
    """
    if re.fullmatch(r"[A-Za-z0-9._:-]{1,128}", job_id) is None:
        print("management handoff job id is invalid", file=sys.stderr)
        return 2
    if not MANAGEMENT_HANDOFF_STATE_PATH.is_file():
        try:
            receipt = json.loads(MANAGEMENT_HANDOFF_COMMIT_PATH.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            receipt = {}
        if receipt.get("job_id") == job_id and receipt.get("phase") == "committed":
            try:
                _clear_management_handoff_state(keep_commit_receipt=True)
            except OSError as exc:
                print(
                    json.dumps(
                        {
                            "management_handoff": "acknowledgement failed",
                            "failing_layer": "application commit acknowledgement",
                            "error": f"commit receipt is durable but rollback state cleanup failed: {exc}",
                            "job_id": job_id,
                        },
                        sort_keys=True,
                    ),
                    file=sys.stderr,
                )
                return 1
            print(json.dumps({"management_handoff": "already committed", "job_id": job_id}, sort_keys=True))
            return 0
        print(
            json.dumps(
                {
                    "management_handoff": "acknowledgement failed",
                    "failing_layer": "application commit acknowledgement",
                    "error": "no matching durable handoff transaction or commit receipt",
                    "job_id": job_id,
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    try:
        state = json.loads(MANAGEMENT_HANDOFF_STATE_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        print(f"management handoff state is unreadable: {exc}", file=sys.stderr)
        return 1
    if state.get("job_id") != job_id or state.get("phase") != "awaiting-application-commit":
        print(
            json.dumps(
                {
                    "management_handoff": "acknowledgement failed",
                    "failing_layer": "application commit acknowledgement",
                    "error": "durable handoff owner or phase does not match",
                    "job_id": job_id,
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    receipt = {
        "schema_version": 1,
        "job_id": job_id,
        "phase": "committed",
        "candidate_addresses": list(state.get("candidate_addresses") or []),
    }
    _durable_management_handoff_state_write(receipt, MANAGEMENT_HANDOFF_COMMIT_PATH)
    try:
        _clear_management_handoff_state(keep_commit_receipt=True)
    except OSError as exc:
        print(
            json.dumps(
                {
                    "management_handoff": "acknowledgement failed",
                    "failing_layer": "application commit acknowledgement",
                    "error": f"commit receipt is durable but rollback state cleanup failed: {exc}",
                    "job_id": job_id,
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1
    print(json.dumps({"management_handoff": "committed", "job_id": job_id}, sort_keys=True))
    return 0


def _quiesce_management_handoff_unit(unit_name: str, unit_label: str) -> dict[str, object]:
    """Stop and verify one surviving transient handoff helper.

    Args:
        unit_name: Stable systemd unit identity to serialize.
        unit_label: Bounded evidence label for the unit.

    Returns:
        Bounded systemd unit evidence.
    """
    if shutil.which("systemctl") is None:
        raise ValueError("systemctl is unavailable; surviving management handoff state cannot be serialized")

    def verified_state(result: subprocess.CompletedProcess[str], stage: str) -> str:
        """Return one explicit, recognized systemd unit state.

        Args:
            result: Completed systemctl status probe.
            stage: Probe stage included in bounded failure text.

        Returns:
            The recognized unit state.

        Raises:
            ValueError: If the probe did not return an explicit known state.
        """
        state = result.stdout.strip()
        known_states = {
            "active",
            "activating",
            "deactivating",
            "reloading",
            "inactive",
            "failed",
            "unknown",
        }
        if state not in known_states:
            raise ValueError(f"{stage} handoff helper state could not be verified")
        return state

    status = _run(["systemctl", "is-active", unit_name])
    state = verified_state(status, "initial")
    if state not in {"active", "activating", "deactivating", "reloading"}:
        return {f"{unit_label}_unit": unit_name, "state": state}
    stop = _run(["systemctl", "stop", unit_name])
    if stop.returncode != 0:
        raise ValueError("surviving management handoff helper could not be stopped")
    final = _run(["systemctl", "is-active", unit_name])
    final_state = verified_state(final, "post-stop")
    if final_state in {"active", "activating", "deactivating", "reloading"}:
        raise ValueError("surviving management handoff helper did not stop")
    return {
        f"{unit_label}_unit": unit_name,
        "state": final_state,
        "stop_returncode": stop.returncode,
    }


def _quiesce_appliance_update_unit(unit_name: str) -> dict[str, object]:
    """Stop and verify one fixed-identity Appliance Update helper unit.

    Args:
        unit_name: Exact systemd service unit selected for serialization.

    Returns:
        Bounded systemd unit evidence without command or environment contents.
    """
    def verified_state(result: subprocess.CompletedProcess[str], stage: str) -> str:
        """Return one bounded systemd active state or fail closed.

        Args:
            result: Completed systemctl state inspection.
            stage: Bounded diagnostic stage label.
        """
        state = result.stdout.strip()
        known_states = {
            "active",
            "activating",
            "deactivating",
            "reloading",
            "inactive",
            "failed",
            "unknown",
        }
        if state not in known_states:
            raise ValueError(f"{stage} Appliance Update helper state could not be verified")
        return state

    initial = _run(["systemctl", "is-active", unit_name])
    state = verified_state(initial, "initial")
    stopped = False
    if state in {"active", "activating", "deactivating", "reloading"}:
        stop = _run(["systemctl", "stop", unit_name])
        if stop.returncode != 0:
            raise ValueError("surviving Appliance Update helper could not be stopped")
        stopped = True
    final = _run(["systemctl", "is-active", unit_name])
    final_state = verified_state(final, "post-stop")
    if final_state in {"active", "activating", "deactivating", "reloading"}:
        raise ValueError("surviving Appliance Update helper did not stop")
    return {"unit": unit_name, "state": final_state, "stopped": stopped}


def _quiesce_appliance_update_action_unit(job_id: str, stream: str) -> dict[str, object]:
    """Stop and verify one fixed-identity Appliance Update stream helper.

    Args:
        job_id: Exact Appliance Update parent identifier.
        stream: Interrupted child stream whose helper must be quiescent.

    Returns:
        Bounded systemd unit evidence without command or environment contents.
    """
    return _quiesce_appliance_update_unit(
        f"{_appliance_update_action_unit_name(job_id, stream)}.service"
    )


def _quiesce_appliance_update_status_unit(job_id: str) -> dict[str, object]:
    """Stop and verify a surviving status transition before any retry.

    Args:
        job_id: Exact Appliance Update parent identifier.

    Returns:
