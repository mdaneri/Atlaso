def _set_os_user_password(username: str, password: str) -> int:
    """Perform set operating-system user password.

    Args:
        username: Atlaso account name associated with the operation.
        password: Password consumed by set operating-system user password.
    """
    chpasswd = _command_path("chpasswd")
    if chpasswd is None:
