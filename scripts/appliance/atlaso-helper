def _appliance_update_powershell_environment() -> dict[str, str]:
    """Perform appliance update powershell environment.

    """
    directories = [
        ATLASO_POWERSHELL_HOME,
        ATLASO_POWERSHELL_HOME / ".cache",
        ATLASO_POWERSHELL_HOME / ".config",
        ATLASO_POWERSHELL_HOME / ".local",
        ATLASO_POWERSHELL_HOME / ".local" / "share",
    ]
    for directory in directories:
        directory.mkdir(parents=True, exist_ok=True)
        directory.chmod(0o700)
    env = os.environ.copy()
    env.update(
        {
            "HOME": str(ATLASO_POWERSHELL_HOME),
            "XDG_CACHE_HOME": str(ATLASO_POWERSHELL_HOME / ".cache"),
            "XDG_CONFIG_HOME": str(ATLASO_POWERSHELL_HOME / ".config"),
            "XDG_DATA_HOME": str(ATLASO_POWERSHELL_HOME / ".local" / "share"),
        }
    )
    return env


def _run_real_action_with_systemd(group: str, action: str, args: list[str]) -> int:
    """Run real action with systemd.

    Args:
        group: Group consumed by run real action with systemd.
        action: Action consumed by run real action with systemd.
        args: Parsed command-line options consumed by the operation.
    """
    helper_path = str(Path(__file__).resolve())
    command = [
        shutil.which("systemd-run") or "systemd-run",
        "--quiet",
        "--wait",
        "--pipe",
        "--collect",
        "--service-type=exec",
        f"--setenv={SYSTEMD_RUN_CHILD_ENV}=1",
    ]
    if group == "appliance-update":
        powershell_env = _appliance_update_powershell_environment()
        command.extend(
            [
                f"--property=WorkingDirectory={ATLASO_POWERSHELL_HOME}",
                f"--setenv=HOME={powershell_env['HOME']}",
                f"--setenv=XDG_CACHE_HOME={powershell_env['XDG_CACHE_HOME']}",
                f"--setenv=XDG_CONFIG_HOME={powershell_env['XDG_CONFIG_HOME']}",
                f"--setenv=XDG_DATA_HOME={powershell_env['XDG_DATA_HOME']}",
            ]
        )
    elif group == "appliance-settings":
        command.extend(
            [
                "--setenv=HOME=/root",
                "--setenv=XDG_CACHE_HOME=/root/.cache",
                "--setenv=XDG_CONFIG_HOME=/root/.config",
                "--setenv=XDG_DATA_HOME=/root/.local/share",
            ]
        )
    command.extend([helper_path, group, action, "--real", *args])
    result = _run(command)
    print(result.stdout, end="")
    print(result.stderr, end="", file=sys.stderr)
    return result.returncode


