ENV_PATH = Path("/var/lib/atlaso/apply/ca/first-boot-management.env")
MARKER_PATH = Path("/var/lib/atlaso/first-boot-https.applied")
HELPER_PATH = Path("/opt/atlaso/bin/atlaso-helper")
NGINX_CONF_INCLUDE_PATH = Path("/etc/nginx/conf.d/atlaso.conf")
NGINX_MAIN_CONFIG_PATH = Path("/etc/nginx/nginx.conf")
NGINX_MANAGEMENT_PATH = Path("/etc/atlaso/nginx/sites.d/management.conf")
DEVELOPMENT_ROOT_CA_STAGING_PATH = Path(
    "/var/lib/atlaso/apply/ca/first-boot-development-root-ca.json"
)
DEVELOPMENT_ROOT_CA_IMPORTED_MARKER_PATH = Path(
    "/var/lib/atlaso/first-boot-development-root-ca-imported"
)
DEVELOPMENT_ROOT_CA_IMPORTED_GUESTINFO = (
    "guestinfo.atlaso.test_vm_development_root_ca_imported"
)
COMPLETION_MARKER_TEXT = "Atlaso first-boot HTTPS bootstrap completed.\n"
NGINX_INCLUDE_TEXT = (
    "# Managed by Atlaso. Local changes may be overwritten.\n"
    "include /etc/atlaso/nginx/sites.d/*.conf;\n"
)


def write_text_atomic(path: Path, payload: str, *, mode: int) -> None:
    """Atomically persist text and its directory entry.

    Args:
        path: Destination for the UTF-8 payload.
        payload: Text to persist.
        mode: Final POSIX permission bits for the replacement file.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(
        dir=path.parent,
        prefix=f".{path.name}.",
        suffix=".tmp",
    )
    temporary = Path(temporary_name)
    try:
        os.fchmod(descriptor, mode)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            descriptor = -1
            handle.write(payload)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
        if os.name == "posix":
            parent_descriptor = os.open(path.parent, os.O_RDONLY)
            try:
                os.fsync(parent_descriptor)
            finally:
                os.close(parent_descriptor)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        temporary.unlink(missing_ok=True)


def write_secret_text_atomic(path: Path, payload: str) -> None:
    """Atomically persist secret text without a broader intermediate mode.

    Args:
        path: Destination for the secret-bearing payload.
        payload: UTF-8 text to persist.
    """
    # The apply payload contains decrypted CA private keys. Establish its
    # final mode before opening the descriptor as text or writing bytes.
    write_text_atomic(path, payload, mode=0o600)


def read_regular_text(path: Path, *, maximum_size: int) -> str | None:
    """Read one bounded regular file without accepting a symlink.

    Args:
        path: File whose content is required for recovery evidence.
        maximum_size: Largest accepted byte size.

    Returns:
        UTF-8 content, or ``None`` when the path is absent or unsafe.
    """
    try:
        path_stat = path.lstat()
        if path.is_symlink() or not path.is_file() or not 0 < path_stat.st_size <= maximum_size:
            return None
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return None


def management_nginx_contract_is_complete(config: str) -> bool:
    """Return whether a rendered management site has a usable front door.

    Args:
        config: Applied nginx management-site text.

    Returns:
        Whether the config contains a default listener and Atlaso proxy contract.
    """
    if not re.search(r"(?m)^\s*listen\s+(?:\[::\]:)?\d+.*\bdefault_server\b", config):
        return False
    if not re.search(r"(?m)^\s*proxy_pass\s+http://127\.0\.0\.1:\d+;", config):
        return False
    https_enabled = bool(re.search(r"(?m)^\s*listen\s+(?:\[::\]:)?\d+\s+ssl\b", config))
    if not https_enabled:
        return True
    certificate_match = re.search(r"(?m)^\s*ssl_certificate\s+([^;]+);", config)
    key_match = re.search(r"(?m)^\s*ssl_certificate_key\s+([^;]+);", config)
    if certificate_match is None or key_match is None:
        return False
    return Path(certificate_match.group(1).strip()).is_file() and Path(
        key_match.group(1).strip()
    ).is_file()


def first_boot_https_contract_is_complete() -> bool:
    """Return whether durable marker and applied nginx state agree."""
    marker = read_regular_text(MARKER_PATH, maximum_size=256)
    include = read_regular_text(NGINX_CONF_INCLUDE_PATH, maximum_size=4096)
    management = read_regular_text(NGINX_MANAGEMENT_PATH, maximum_size=262144)
    if (
        marker != COMPLETION_MARKER_TEXT
        or include is None
        or "/etc/atlaso/nginx/sites.d/*.conf" not in include
        or management is None
        or not management_nginx_contract_is_complete(management)
    ):
        return False
    nginx = shutil.which("nginx")
    return nginx is not None and run([nginx, "-t"]).returncode == 0


def import_staged_development_root_ca(
    settings: CaSettings,
    certificates: list[CaCertificate],
) -> bool:
    """Import the normal test VM development root into encrypted database state.

    Args:
        settings: First-boot CA settings row for this unique appliance database.
        certificates: Managed leaf rows that must follow the imported root.

    Returns:
        Whether development root material was staged for this first boot.

    Raises:
        ValueError: If the secret-bearing staging file is unsafe or invalid.
    """
    path = DEVELOPMENT_ROOT_CA_STAGING_PATH
    if not path.exists():
        return False
    path_stat = path.lstat()
    if (
        path.is_symlink()
        or not path.is_file()
        or path_stat.st_mode & 0o777 != 0o600
        or path_stat.st_size > 65536
    ):
        raise ValueError("Development root CA staging is unsafe.")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        raise ValueError("Development root CA staging is invalid.") from exc
    certificate_pem = payload.get("certificate_pem")
    private_key_pem = payload.get("private_key_pem")
    if not isinstance(certificate_pem, str) or not isinstance(private_key_pem, str):
        raise ValueError("Development root CA staging is incomplete.")
    import_root_ca_material(
        settings,
        certificate_pem,
        private_key_pem,
        expected_common_name="Atlaso Development Root CA",
        certificates=certificates,
    )
    return True


def remove_staged_development_root_ca() -> None:
    """Durably remove development signing material after encrypted import."""
    DEVELOPMENT_ROOT_CA_STAGING_PATH.unlink()
    if os.name == "posix":
        descriptor = os.open(DEVELOPMENT_ROOT_CA_STAGING_PATH.parent, os.O_RDONLY)
        try:
            os.fsync(descriptor)
        finally:
            os.close(descriptor)


def scrub_staged_development_root_ca_after_failure() -> bool:
    """Best-effort durable scrub when encrypted import does not complete.

    Returns:
        True when staging is absent after the scrub attempt.
    """
    path = DEVELOPMENT_ROOT_CA_STAGING_PATH
    if not path.exists() and not path.is_symlink():
        return True
    try:
        remove_staged_development_root_ca()
    except OSError:
        return False
    return not path.exists() and not path.is_symlink()


def write_development_root_ca_import_proof(fingerprint: str) -> None:
    """Persist the non-secret fingerprint proving encrypted import and scrub.

    Args:
        fingerprint: Uppercase SHA-256 fingerprint of the imported development root.

    Raises:
        ValueError: If the fingerprint or an existing marker path is unsafe.
    """
    if not re.fullmatch(r"[0-9A-F]{64}", fingerprint):
        raise ValueError("Development root CA import fingerprint is invalid.")
    path = DEVELOPMENT_ROOT_CA_IMPORTED_MARKER_PATH
    if path.exists() and (path.is_symlink() or not path.is_file()):
        raise ValueError("Development root CA import proof path is unsafe.")
    path.write_text(fingerprint, encoding="ascii")
    path.chmod(0o640)


def publish_development_root_ca_import_proof() -> bool:
    """Publish and read back the normal-test-VM import proof through guest-info.

    Returns:
        True when no development proof applies or exact guest-info readback succeeds.

    Raises:
        ValueError: If the durable proof marker is unsafe or malformed.
    """
    path = DEVELOPMENT_ROOT_CA_IMPORTED_MARKER_PATH
    if not path.exists():
        return True
    path_stat = path.lstat()
    if path.is_symlink() or not path.is_file() or path_stat.st_size != 64:
        raise ValueError("Development root CA import proof path is unsafe.")
    fingerprint = path.read_text(encoding="ascii").strip()
    if not re.fullmatch(r"[0-9A-F]{64}", fingerprint):
        raise ValueError("Development root CA import proof is invalid.")
    command_pairs = (
        (
            "vmware-rpctool",
            [f"info-set {DEVELOPMENT_ROOT_CA_IMPORTED_GUESTINFO} {fingerprint}"],
            [f"info-get {DEVELOPMENT_ROOT_CA_IMPORTED_GUESTINFO}"],
        ),
        (
            "vmtoolsd",
            ["--cmd", f"info-set {DEVELOPMENT_ROOT_CA_IMPORTED_GUESTINFO} {fingerprint}"],
            ["--cmd", f"info-get {DEVELOPMENT_ROOT_CA_IMPORTED_GUESTINFO}"],
        ),
    )
    for command_name, setter_arguments, getter_arguments in command_pairs:
        command = shutil.which(command_name)
        if command is None:
            continue
        if run([command, *setter_arguments]).returncode != 0:
            continue
        readback = run([command, *getter_arguments])
        if readback.returncode == 0 and readback.stdout.strip() == fingerprint:
            return True
    return False


def run(command: list[str]) -> subprocess.CompletedProcess[str]:
    """Perform run.

    Args:
        command: Command and arguments to execute.
    """
    return subprocess.run(command, check=False, text=True, capture_output=True)


def ensure_nginx_main_config_includes_atlaso() -> None:
    """Ensure nginx main config includes atlaso.

    """
    if not NGINX_MAIN_CONFIG_PATH.exists():
        return
    text = NGINX_MAIN_CONFIG_PATH.read_text(encoding="utf-8")
    if "/etc/nginx/conf.d/atlaso.conf" in text or "include /etc/nginx/conf.d/*.conf;" in text:
        return
    start = text.find("http")
    brace = text.find("{", start)
    if start < 0 or brace < 0:
        return
    depth = 1
    index = brace + 1
    while index < len(text):
        char = text[index]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                include = "\n    # Managed by Atlaso. Local changes may be overwritten.\n    include /etc/nginx/conf.d/atlaso.conf;\n"
                write_text_atomic(
                    NGINX_MAIN_CONFIG_PATH,
                    text[:index].rstrip() + include + text[index:],
                    mode=0o644,
                )
                return
        index += 1


def write_nginx_management_config(*, fqdn: str, cert_path: str, key_path: str) -> None:
    """Write nginx management config.

    Args:
        fqdn: Fqdn consumed by write nginx management config.
        cert_path: Filesystem path used for cert.
        key_path: Filesystem path used for key.
    """
    NGINX_CONF_INCLUDE_PATH.parent.mkdir(parents=True, exist_ok=True)
    NGINX_MANAGEMENT_PATH.parent.mkdir(parents=True, exist_ok=True)
    for default_path in (Path("/etc/nginx/conf.d/default.conf"), Path("/etc/nginx/conf.d/default_server.conf")):
        default_path.unlink(missing_ok=True)
    write_text_atomic(NGINX_CONF_INCLUDE_PATH, NGINX_INCLUDE_TEXT, mode=0o644)
    write_text_atomic(
        NGINX_MANAGEMENT_PATH,
        f"""# Managed by Atlaso. Local changes may be overwritten.
server {{
  listen 80 default_server;
  server_name _;
  location = /ca/downloads/root-ca.pem {{
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto http;
  }}
  location = /ca/downloads/ca-bundle.pem {{
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto http;
  }}
  location / {{
    return 308 https://$host$request_uri;
  }}
}}

server {{
  listen 443 ssl default_server;
  server_name {fqdn} _;
  ssl_certificate {cert_path};
  ssl_certificate_key {key_path};
  client_max_body_size 1g;
  location / {{
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
  }}
}}
""",
        mode=0o644,
    )
    ensure_nginx_main_config_includes_atlaso()


def apply_ca_files() -> int:
    """Perform apply CA files.

    """
    for action in ("validate", "apply"):
        result = run([str(HELPER_PATH), "ca", action, str(CA_STAGED_CONFIG_PATH), "--real"])
        if result.stdout:
            print(result.stdout, end="")
        if result.stderr:
            print(result.stderr, end="")
        if result.returncode != 0:
            return result.returncode
    return 0


def fix_state_permissions() -> None:
    """Perform fix state permissions.

    """
    state_path = Path("/var/lib/atlaso")
    for db_file in state_path.glob("atlaso.db*"):
        if not db_file.exists():
            continue
        try:
            shutil.chown(db_file, user="atlaso", group="atlaso")
        except (LookupError, PermissionError):
            pass
        db_file.chmod(0o640)

    ca_apply_path = Path(CA_STAGED_CONFIG_PATH).parent
    if ca_apply_path.exists():
        for path in [ca_apply_path, *ca_apply_path.rglob("*")]:
            try:
                shutil.chown(path, user="atlaso", group="atlaso")
            except (LookupError, PermissionError):
                pass
            path.chmod(0o750 if path.is_dir() else 0o600)


def main() -> int:
    """Run the command-line entry point.

    """
    if first_boot_https_contract_is_complete():
        try:
            published = publish_development_root_ca_import_proof()
        except (OSError, UnicodeError, ValueError) as exc:
            print(str(exc))
            return 2
        if not published:
            print("Development root CA encrypted-import proof could not be published.")
            return 2
        return 0

    init_db()
    development_root_fingerprint = ""
    with SessionLocal() as db:
        seed_initial_data(db, include_examples=False, appliance_mode=True)
        sync_host_physical_interfaces(db)
        appliance_settings = db.execute(select(ApplianceSettings)).scalar_one()
        ca_settings = db.execute(select(CaSettings)).scalar_one()
        appliance_settings.management_https_enabled = True
        ca_settings.enabled = True
        managed_certificates = (
            db.execute(select(CaCertificate).where(CaCertificate.managed_owner != ""))
            .scalars()
            .all()
        )
        try:
            development_root_imported = import_staged_development_root_ca(
                ca_settings,
                managed_certificates,
            )
            db.commit()
        except Exception as exc:  # noqa: BLE001 - fail closed and scrub shared signer
            if isinstance(exc, ValueError):
                print(str(exc))
            else:
                print("Development root CA encrypted import failed.")
            if not scrub_staged_development_root_ca_after_failure():
                print("Development root CA staging could not be scrubbed after import failure.")
            return 2
        if development_root_imported:
            try:
                remove_staged_development_root_ca()
            except OSError:
                print("Development root CA staging could not be removed after encrypted import.")
                return 2
        if (
            ca_settings.root_common_name == "Atlaso Development Root CA"
            and ca_settings.root_fingerprint
            and not DEVELOPMENT_ROOT_CA_STAGING_PATH.exists()
        ):
            development_root_fingerprint = ca_settings.root_fingerprint.upper()

        errors = ensure_ca_state(db)
        if errors:
            for error in errors:
                print(error)
            return 2

        ca_settings = db.execute(select(CaSettings)).scalar_one()
        certificates = db.execute(select(CaCertificate).order_by(CaCertificate.common_name)).scalars().all()
        config_path = Path(CA_STAGED_CONFIG_PATH)
        write_secret_text_atomic(
            config_path,
            render_ca_apply_payload(ca_settings, certificates, include_private_keys=True),
        )

        cert_path, key_path, _chain_path = ca_managed_certificate_paths(db, "appliance:https")
        if not cert_path or not key_path:
            print("managed appliance HTTPS certificate was not issued")
            return 2
        fqdn = appliance_settings.fqdn

        ENV_PATH.parent.mkdir(parents=True, exist_ok=True)
        ENV_PATH.write_text(
            "\n".join(
                [
                    f"ATLASO_FIRST_BOOT_FQDN={shlex.quote(appliance_settings.fqdn)}",
                    f"ATLASO_FIRST_BOOT_CERT_PATH={shlex.quote(cert_path)}",
                    f"ATLASO_FIRST_BOOT_KEY_PATH={shlex.quote(key_path)}",
                    "",
                ]
            ),
            encoding="utf-8",
        )
        ENV_PATH.chmod(0o600)

    result = apply_ca_files()
    if result != 0:
        return result

    certificate = Path(cert_path)
    key = Path(key_path)
    if not certificate.is_file() or not key.is_file():
        print("CA apply completed without the managed appliance HTTPS certificate and key")
        return 2
    try:
        shutil.chown(key, user="root", group="atlaso")
    except (LookupError, PermissionError):
        pass
    key.chmod(0o640)

    write_nginx_management_config(fqdn=fqdn, cert_path=cert_path, key_path=key_path)
    nginx = shutil.which("nginx")
    if nginx is None:
        print("nginx is unavailable; first-boot HTTPS configuration was not validated")
        return 2
    validation = run([nginx, "-t"])
    if validation.stdout:
        print(validation.stdout, end="")
    if validation.stderr:
        print(validation.stderr, end="")
    if validation.returncode != 0:
        return validation.returncode

    fix_state_permissions()
    if development_root_fingerprint:
        try:
            write_development_root_ca_import_proof(development_root_fingerprint)
            published = publish_development_root_ca_import_proof()
        except (OSError, UnicodeError, ValueError) as exc:
            print(str(exc))
            return 2
        if not published:
            print("Development root CA encrypted-import proof could not be published.")
            return 2
    write_text_atomic(MARKER_PATH, COMPLETION_MARKER_TEXT, mode=0o640)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
