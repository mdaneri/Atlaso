#!/bin/sh
set -eu

theme_source="${1:?GRUB theme source path required}"
background_source="${2:?GRUB background source path required}"
grub_config="${ATLASO_GRUB_CONFIG:-/boot/grub2/grub.cfg}"
theme_dir="${ATLASO_GRUB_THEME_DIR:-/boot/grub2/themes/atlaso}"

if [ "$(id -u)" -ne 0 ]; then
    echo "Atlaso boot branding installation requires root." >&2
    exit 2
fi
if [ ! -f "$theme_source" ] || [ ! -f "$background_source" ]; then
    echo "Atlaso boot branding assets are missing." >&2
    exit 2
fi
if [ ! -f "$grub_config" ]; then
    echo "Photon GRUB configuration not found: $grub_config" >&2
    exit 2
fi
if ! grep -Eq '^set theme=' "$grub_config"; then
    echo "Photon GRUB configuration does not declare a theme." >&2
    exit 2
fi
if ! grep -Eq '^[[:space:]]*linux /\$photon_linux([[:space:]]|$)' "$grub_config"; then
    echo "Photon GRUB configuration does not declare a Photon kernel entry." >&2
    exit 2
fi
if grep -Eq '^set[[:space:]]+(gfxmode|gfxpayload)=' "$grub_config"; then
    echo "Photon GRUB framebuffer assignments use unsupported set syntax." >&2
    exit 2
fi

install -d -o root -g root -m 0755 "$theme_dir"
install -o root -g root -m 0644 "$theme_source" "$theme_dir/theme.txt"
install -o root -g root -m 0644 "$background_source" "$theme_dir/atlaso.png"

if [ ! -f "$grub_config.atlaso-backup" ]; then
    install -o root -g root -m 0644 "$grub_config" "$grub_config.atlaso-backup"
fi
sed -i 's#^set theme=.*#set theme=/grub2/themes/atlaso/theme.txt#' "$grub_config"
sed -i '/^menuentry "\(Photon\|Atlaso Appliance\|Atlaso\)" {/s//menuentry " " {/' "$grub_config"
if grep -Eq '^gfxmode=' "$grub_config"; then
    sed -i 's/^gfxmode=.*/gfxmode="1280x800"/' "$grub_config"
else
    sed -i '/^set theme=/i gfxmode="1280x800"' "$grub_config"
fi
if grep -Eq '^gfxpayload=' "$grub_config"; then
    sed -i 's/^gfxpayload=.*/gfxpayload=keep/' "$grub_config"
else
    sed -i '/^set theme=/i gfxpayload=keep' "$grub_config"
fi
sed -i '/^[[:space:]]*linux \/\$photon_linux\([[:space:]]\|$\)/ {
    s/\([[:space:]]\)fbcon=font:[^[:space:]]*/\1fbcon=font:VGA8x16/g
    /[[:space:]]fbcon=font:VGA8x16\([[:space:]]\|$\)/! s/$/ fbcon=font:VGA8x16/
}' "$grub_config"

grep -q '^set theme=/grub2/themes/atlaso/theme.txt$' "$grub_config"
grep -q '^menuentry " " {$' "$grub_config"
grep -q '^gfxmode="1280x800"$' "$grub_config"
grep -q '^gfxpayload=keep$' "$grub_config"
grep -Eq '^[[:space:]]*linux /\$photon_linux .* fbcon=font:VGA8x16([[:space:]]|$)' "$grub_config"
printf 'Installed Atlaso GRUB branding and 1280x800 console mode in %s\n' "$theme_dir"
