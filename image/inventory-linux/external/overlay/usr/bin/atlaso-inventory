#!/bin/sh
set -eu

. /usr/lib/atlaso-inventory-lib.sh

api_base=""
for argument in $(cat "${PROC_ROOT}/cmdline"); do
  case "${argument}" in
    atlaso.url=*) api_base="${argument#atlaso.url=}" ;;
  esac
done
if [ -z "${api_base}" ]; then
  next_server="$(ip route show default | awk 'NR==1 {print $3}')"
  api_base="http://${next_server}"
fi

session_json="$(curl --fail --silent --show-error --max-time 20 \
  --request POST "${api_base}/pxe/inventory/sessions")"
token="$(printf '%s' "${session_json}" | jq -r '.access_token')"
auth_config="${RUNTIME_ROOT}/atlaso-inventory-curl.conf"
mkdir -p "${RUNTIME_ROOT}"
umask 077
printf 'header = "Authorization: Bearer %s"\n' "${token}" >"${auth_config}"

boot_interface="$(ip route show default | awk 'NR==1 {print $5}')"
boot_mac="$(optional_ethernet_mac "$(read_value "${SYSFS_ROOT}/class/net/${boot_interface}/address")")"
firmware_mode="bios"
[ -d "${SYSFS_ROOT}/firmware/efi" ] && firmware_mode="uefi"

pci_devices_file="${RUNTIME_ROOT}/atlaso-inventory-pci.json"
storage_controllers_file="${RUNTIME_ROOT}/atlaso-inventory-controllers.json"
interfaces_file="${RUNTIME_ROOT}/atlaso-inventory-interfaces.json"
disks_file="${RUNTIME_ROOT}/atlaso-inventory-disks.json"
dimms_file="${RUNTIME_ROOT}/atlaso-inventory-dimms.json"
usb_devices_file="${RUNTIME_ROOT}/atlaso-inventory-usb.json"
collect_pci_devices >"${pci_devices_file}"
collect_storage_controllers "${pci_devices_file}" >"${storage_controllers_file}"
collect_interfaces "${boot_interface}" >"${interfaces_file}"
collect_disks >"${disks_file}"
collect_dimms >"${dimms_file}"
collect_usb_devices >"${usb_devices_file}"
cpu="$(collect_cpu)"
memory_bytes="$(awk '/MemTotal:/ {print $2 * 1024}' "${PROC_ROOT}/meminfo" | cut -d. -f1)"
memory_bytes="$(unsigned_value "${memory_bytes}")"
assigned_addresses="$(ip -j address show dev "${boot_interface}" 2>/dev/null |
  jq '[.[0].addr_info[]? | "\(.local)/\(.prefixlen)"][0:64]' 2>/dev/null || printf '[]')"

report="$(jq -cn \
  --arg boot_interface "${boot_interface}" --arg boot_mac "${boot_mac}" \
  --argjson assigned_addresses "${assigned_addresses}" --arg firmware_mode "${firmware_mode}" \
  --arg dmi_uuid "$(read_value "${DMI_ROOT}/product_uuid")" \
  --arg manufacturer "$(read_value "${DMI_ROOT}/sys_vendor")" \
  --arg product_name "$(read_value "${DMI_ROOT}/product_name")" \
  --arg serial_number "$(read_value "${DMI_ROOT}/product_serial")" \
  --arg product_version "$(read_value "${DMI_ROOT}/product_version")" \
  --arg product_sku "$(read_value "${DMI_ROOT}/product_sku")" \
  --arg product_family "$(read_value "${DMI_ROOT}/product_family")" \
  --arg bios_vendor "$(read_value "${DMI_ROOT}/bios_vendor")" \
  --arg bios_version "$(read_value "${DMI_ROOT}/bios_version")" \
  --arg bios_date "$(read_value "${DMI_ROOT}/bios_date")" \
  --arg bios_release "$(read_value "${DMI_ROOT}/bios_release")" \
  --arg board_manufacturer "$(read_value "${DMI_ROOT}/board_vendor")" \
  --arg board_product "$(read_value "${DMI_ROOT}/board_name")" \
  --arg board_version "$(read_value "${DMI_ROOT}/board_version")" \
  --arg board_serial "$(read_value "${DMI_ROOT}/board_serial")" \
  --arg board_asset_tag "$(read_value "${DMI_ROOT}/board_asset_tag")" \
  --arg chassis_manufacturer "$(read_value "${DMI_ROOT}/chassis_vendor")" \
  --arg chassis_type "$(read_value "${DMI_ROOT}/chassis_type")" \
  --arg chassis_version "$(read_value "${DMI_ROOT}/chassis_version")" \
  --arg chassis_serial "$(read_value "${DMI_ROOT}/chassis_serial")" \
  --arg chassis_asset_tag "$(read_value "${DMI_ROOT}/chassis_asset_tag")" \
  --argjson cpu "${cpu}" \
  --argjson total_bytes "${memory_bytes}" --arg total_human "$(human_size "${memory_bytes}")" \
  --slurpfile dimms "${dimms_file}" --slurpfile disks "${disks_file}" \
  --slurpfile interfaces "${interfaces_file}" --slurpfile storage_controllers "${storage_controllers_file}" \
  --slurpfile pci_devices "${pci_devices_file}" --slurpfile usb_devices "${usb_devices_file}" \
  '{
    schema_version: 2,
    boot_interface: $boot_interface,
    boot_mac: $boot_mac,
    assigned_addresses: $assigned_addresses,
    firmware_mode: $firmware_mode,
    system: {
      dmi_uuid: $dmi_uuid, manufacturer: $manufacturer, product_name: $product_name,
      serial_number: $serial_number, product_version: $product_version,
      product_sku: $product_sku, product_family: $product_family,
      bios_vendor: $bios_vendor, bios_version: $bios_version, bios_date: $bios_date,
      bios_release: $bios_release,
      baseboard: {manufacturer:$board_manufacturer,product:$board_product,
        version:$board_version,serial:$board_serial,asset_tag:$board_asset_tag},
      chassis: {manufacturer:$chassis_manufacturer,type:$chassis_type,
        version:$chassis_version,serial:$chassis_serial,asset_tag:$chassis_asset_tag}
    },
    cpu: $cpu,
    memory: {total_bytes:$total_bytes,total_human:$total_human,dimms:$dimms[0]},
    disks: $disks[0],
    interfaces: $interfaces[0],
    storage_controllers: $storage_controllers[0],
    pci_devices: $pci_devices[0],
    usb_devices: $usb_devices[0]
  }')"
rm -f "${pci_devices_file}" "${storage_controllers_file}" "${interfaces_file}" \
  "${disks_file}" "${dimms_file}" "${usb_devices_file}"
report_bytes="$(printf '%s' "${report}" | wc -c | tr -d ' ')"
if [ "${report_bytes}" -gt 262144 ]; then
  printf 'Inventory report exceeds the 256 KiB boundary.\n' >&2
  exit 1
fi

report_response="${RUNTIME_ROOT}/atlaso-inventory-report.json"
report_attempt=1
while :; do
  report_status="$(printf '%s' "${report}" | curl --config "${auth_config}" \
    --silent --show-error --max-time 30 --header "Content-Type: application/json" \
    --output "${report_response}" --write-out '%{http_code}' \
    --data-binary @- "${api_base}/pxe/inventory/report")"
  if [ "${report_status}" = "201" ]; then
    submission="$(cat "${report_response}")"
    rm -f "${report_response}"
    break
  fi
  if [ "${report_status}" != "503" ] || [ "${report_attempt}" -ge 6 ]; then
    printf 'Inventory report submission failed (HTTP %s).\n' "${report_status}" >&2
    rm -f "${report_response}"
    exit 1
  fi
  sleep $((report_attempt * 2))
  report_attempt=$((report_attempt + 1))
done
host_id="$(printf '%s' "${submission}" | jq -r '.host_id')"
identity_key="$(printf '%s' "${submission}" | jq -r '.identity_key')"

# The reboot timer begins only after the API has accepted the complete report.
page=1
remaining=120
paused=false
pending_reboot_id=""
last_tick="$(date +%s)"
next_poll="${last_tick}"
rendered_page=0
network_start=0
network_page_size=5
network_total="$(printf '%s' "${report}" | jq -r '.interfaces | length')"
storage_start=0
storage_page_size=5
storage_total="$(printf '%s' "${report}" | jq -r '(.disks | length) + (.storage_controllers | length)')"
dimm_start=0
dimm_page_size=5
dimm_total="$(printf '%s' "${report}" | jq -r '.memory.dimms | length')"
while :; do
  now="$(date +%s)"
  elapsed=$((now - last_tick))
  [ "${elapsed}" -ge 0 ] || elapsed=0
  remaining="$(countdown_after_elapsed "${remaining}" "${paused}" "${elapsed}")"
  [ "${remaining}" -gt 0 ] || reboot -f
  last_tick="${now}"

  if [ "${now}" -ge "${next_poll}" ]; then
    curl --config "${auth_config}" --fail --silent --max-time 10 \
      --header "Content-Type: application/json" \
      --data "$(jq -cn --arg identity_key "${identity_key}" '{identity_key: $identity_key}')" \
      "${api_base}/pxe/inventory/heartbeat" >/dev/null || true
    command="$(curl --config "${auth_config}" --fail --silent --max-time 10 \
      "${api_base}/pxe/inventory/commands" || printf '{"command":null}')"
    action="$(printf '%s' "${command}" | jq -r '.command.action // empty')"
    command_id="$(printf '%s' "${command}" | jq -r '.command.id // empty')"
    if [ "${action}" = "reboot" ] && [ -n "${command_id}" ]; then
      pending_reboot_id="${command_id}"
    fi
    if [ -n "${pending_reboot_id}" ] && acknowledge_remote_reboot \
      "${api_base}" "${auth_config}" "${pending_reboot_id}"; then
      reboot -f
    fi
    next_poll=$((now + 10))
  fi

  render_state="${page}:${network_start}:${storage_start}:${dimm_start}"
  if [ "${render_state}" != "${rendered_page}" ]; then
    render_inventory_console "${report}" "${page}" "${remaining}" "${paused}" "${host_id}" "${network_start}" "${storage_start}" "${dimm_start}"
    rendered_page="${render_state}"
  else
    refresh_inventory_console_footer "${page}" "${remaining}" "${paused}" "${host_id}"
  fi
  key=""
  if read -r -n 1 -t 1 key; then
    key_now="$(date +%s)"
    key_elapsed=$((key_now - last_tick))
    [ "${key_elapsed}" -ge 0 ] || key_elapsed=0
    remaining="$(countdown_after_elapsed "${remaining}" "${paused}" "${key_elapsed}")"
    [ "${remaining}" -gt 0 ] || reboot -f
    last_tick="${key_now}"
    key_result="$(console_key_action "${key}" "${page}" "${paused}")"
    page="$(printf '%s' "${key_result}" | cut -d'|' -f1)"
    paused="$(printf '%s' "${key_result}" | cut -d'|' -f2)"
    key_action="$(printf '%s' "${key_result}" | cut -d'|' -f3)"
    case "${key}" in
      j|J)
        [ "${page}" != "1" ] || dimm_start="$(console_window_offset "${dimm_start}" "${dimm_total}" "${dimm_page_size}" next)"
        [ "${page}" != "2" ] || network_start="$(console_window_offset "${network_start}" "${network_total}" "${network_page_size}" next)"
        [ "${page}" != "3" ] || storage_start="$(console_window_offset "${storage_start}" "${storage_total}" "${storage_page_size}" next)"
        ;;
      k|K)
        [ "${page}" != "1" ] || dimm_start="$(console_window_offset "${dimm_start}" "${dimm_total}" "${dimm_page_size}" previous)"
        [ "${page}" != "2" ] || network_start="$(console_window_offset "${network_start}" "${network_total}" "${network_page_size}" previous)"
        [ "${page}" != "3" ] || storage_start="$(console_window_offset "${storage_start}" "${storage_total}" "${storage_page_size}" previous)"
        ;;
    esac
    [ "${key_action}" != "reboot" ] || reboot -f
  fi
done
