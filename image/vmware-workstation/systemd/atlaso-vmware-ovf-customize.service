[Unit]
Description=Atlaso VMware OVF first-boot customization
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target systemd-networkd.service atlaso-firewall.service atlaso-bootstrap-https.service nginx.service atlaso.service

[Service]
Type=oneshot
ExecStart=/opt/atlaso/bin/atlaso-vmware-ovf-customize.py
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
