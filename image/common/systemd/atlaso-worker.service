[Unit]
Description=Atlaso durable task worker and scheduler
After=network-online.target atlaso-data-disks.service atlaso.service
Wants=network-online.target atlaso.service
Requires=atlaso-data-disks.service

[Service]
Type=simple
User=atlaso
Group=atlaso
TimeoutStartSec=30min
WorkingDirectory=/var/lib/atlaso
EnvironmentFile=/etc/atlaso/atlaso.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ATLASO_HELPER_USE_SYSTEMD_RUN=1
UMask=0027
RuntimeDirectory=atlaso-automation-vaults
RuntimeDirectoryMode=0700
ExecStartPre=+/opt/atlaso/bin/atlaso-helper appliance-update recover-release --real
ExecStart=/opt/atlaso/.venv/bin/python -m atlaso.app.worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/atlaso /var/log/atlaso /mnt/atlaso-vcf-offline-depot

[Install]
WantedBy=multi-user.target
