{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false,
      "stern": false,
      "strict": false
    },
    "MD024": {
      "siblings_only": true
    },
    "MD025": {
      "front_matter_title": ""
    },
    "MD033": {
      "allowed_elements": []
    }
  },
  "globs": [
    "**/*.md",
    "!node_modules/**",
    "!site/**",
    "!.venv*/**",
    "!build/**",
    "!dist/**",
    "!test-results/**"
  ]
}
