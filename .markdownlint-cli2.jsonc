{
  "config": {
    "default": true,
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false,
      "stern": false,
      "strict": false
    },
    "MD024": {
      "siblings_only": true
    },
    "MD025": {
      "front_matter_title": ""
    },
    "MD033": {
      "allowed_elements": []
    }
  },
  "globs": [
    "**/*.md",
    // Exclude only root task state, not every Git-ignored or nested namesake directory.
    // Explicit arguments combine with these globs; opt in to fixture validation with:
    // npm run lint:markdown -- --no-globs .atlaso-local/example/fixture.md
    "!.atlaso-local/**",
    "!node_modules/**",
    "!site/**",
    "!.venv*/**",
    "!build/**",
    "!dist/**",
    "!image/inventory-linux/.build/**",
    "!test-results/**"
  ]
}
