# Keep interpreter entrypoints stable across Windows and Unix checkouts.
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Buildroot copies these extensionless shell entrypoints verbatim.
image/inventory-linux/external/overlay/etc/init.d/S99atlaso-inventory text eol=lf
image/inventory-linux/external/overlay/usr/bin/atlaso-inventory text eol=lf

image/hyperv/sudoers.d/* text eol=lf
image/hyperv/systemd/* text eol=lf
scripts/appliance/atlaso-helper text eol=lf
docs/assets/screenshots/manifest.json text eol=lf
docs/reference/interface-gallery.md text eol=lf
