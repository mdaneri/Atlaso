# Keep interpreter entrypoints stable across Windows and Unix checkouts.
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.psd1 text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf

# Buildroot parses or copies every external-tree input verbatim.
image/inventory-linux/external/** text eol=lf
image/inventory-linux/external/overlay/usr/share/atlaso/*.png binary
image/inventory-linux/external/overlay/usr/share/atlaso/*.ppm binary

image/hyperv/sudoers.d/* text eol=lf
image/hyperv/systemd/* text eol=lf

# First boot sources these platform policies as shell input.
image/hyperv/data-disks.conf text eol=lf
image/vmware-workstation/data-disks.conf text eol=lf
image/vmware-workstation/development-trust/*.pem text eol=lf

scripts/appliance/atlaso-helper text eol=lf
docs/assets/screenshots/manifest.json text eol=lf
docs/reference/interface-gallery.md text eol=lf
